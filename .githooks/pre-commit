#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/../scripts" >/dev/null 2>&1 && pwd)"

if [[ ! -f "${SCRIPT_DIR}/lib/agent_rigor.sh" ]]; then
   exit 0
fi

# Guard: block direct edits to git subtree directories
# Bypass: set K3DM_SUBTREE_SYNC=1 when running git subtree pull/add
if [[ "${K3DM_SUBTREE_SYNC:-0}" != "1" ]]; then
   foundation_changes="$(git diff --cached --name-only | grep '^scripts/lib/foundation/' || true)"
   if [[ -n "$foundation_changes" ]]; then
      echo "Pre-commit hook: direct edits to scripts/lib/foundation/ are not allowed." >&2
      echo "This directory is a git subtree from lib-foundation." >&2
      echo "Fix the issue upstream in lib-foundation, then run:" >&2
      echo "  K3DM_SUBTREE_SYNC=1 git subtree pull --prefix=scripts/lib/foundation ..." >&2
      echo "" >&2
      echo "Blocked files:" >&2
      printf '  %s\n' "${foundation_changes}" >&2
      exit 1
   fi
fi

# Guard: broken relative links / heading anchors in staged Markdown
# Staged files only — pre-existing debt elsewhere must not block an unrelated commit.
# Bypass: K3DM_SKIP_DOC_LINKS=1
if [[ "${K3DM_SKIP_DOC_LINKS:-0}" != "1" && -f "${SCRIPT_DIR}/check-doc-links.py" ]]; then
   staged_md=()
   while IFS= read -r _f; do
      [[ -n "${_f}" && -f "${_f}" ]] && staged_md+=("${_f}")
   done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.md')
   if (( ${#staged_md[@]} > 0 )); then
      if ! python3 "${SCRIPT_DIR}/check-doc-links.py" "${staged_md[@]}"; then
         echo "Pre-commit hook: broken doc link(s) in staged Markdown — fix the path or anchor" >&2
         echo "  full sweep: make check-doc-links" >&2
         echo "  bypass:     K3DM_SKIP_DOC_LINKS=1 git commit ..." >&2
         exit 1
      fi
   fi
fi

# Guard: test/job debris at the repo root, written by a path derived from an empty
# variable (usually an unchecked "$(mktemp)"). Staged files only.
# Bypass: K3DM_SKIP_ROOT_DEBRIS=1
if [[ "${K3DM_SKIP_ROOT_DEBRIS:-0}" != "1" && -x "${SCRIPT_DIR}/check-repo-root-debris.sh" ]]; then
   if ! "${SCRIPT_DIR}/check-repo-root-debris.sh"; then
      echo "Pre-commit hook: repo-root debris staged — fix the producer, not the symptom" >&2
      echo "  bypass: K3DM_SKIP_ROOT_DEBRIS=1 git commit ..." >&2
      exit 1
   fi
fi

# shellcheck source=/dev/null
source "${SCRIPT_DIR}/lib/system.sh"
# IP allowlist — files with intentional CIDR literals (e.g. CloudFormation templates)
export AGENT_IP_ALLOWLIST="${SCRIPT_DIR}/etc/agent/hardcoded-ip-allowlist"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/lib/agent_rigor.sh"

if ! _agent_audit; then
   echo "Pre-commit hook: _agent_audit failed — fix violations before committing" >&2
   exit 1
fi

gate_var="${AGENT_LINT_GATE_VAR:-K3DM_ENABLE_AI}"
if [[ "${!gate_var:-0}" == "1" ]]; then
   export AGENT_LINT_AI_FUNC="_ai_agent_review"
   export AGENT_LINT_GATE_VAR="K3DM_ENABLE_AI"
   export K3DM_ENABLE_AI="${K3DM_ENABLE_AI:-0}"
   if ! _agent_lint; then
      echo "Pre-commit hook: _agent_lint failed — fix architectural violations before committing" >&2
      exit 1
   fi
fi
