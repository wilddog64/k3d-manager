#!/usr/bin/env bash
set -euo pipefail

remote="$1"

bases=()
while IFS=' ' read -r local_ref _ remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]] && \
     [[ "$local_ref" != "refs/heads/main" ]]; then
    if [[ "${ALLOW_MAIN_PUSH:-0}" == "1" ]]; then
      echo "pre-push: ALLOW_MAIN_PUSH=1 — bypassing main-guard for '$local_ref' → ${remote}/main" >&2
    else
      echo "pre-push: refusing to push '$local_ref' directly to ${remote}/main" >&2
      echo "  Use a feature branch + PR instead." >&2
      echo "  To override intentionally: ALLOW_MAIN_PUSH=1 git push ..." >&2
      exit 1
    fi
  fi
  if [[ "$local_ref" != "(delete)" && ! "$remote_sha" =~ ^0+$ ]]; then bases+=("$remote_sha"); fi
done
if [[ "${K3DM_SKIP_FAST_GATE:-0}" == 1 ]]; then
  echo "pre-push: fast gate skipped (K3DM_SKIP_FAST_GATE=1)"
elif (( ${#bases[@]} )); then
  for base in "${bases[@]}"; do scripts/ci/fast_gate.sh "$base"; done
else
  scripts/ci/fast_gate.sh
fi
