# --- OpenLDAP chart (jp-gouin/openldap-stack-ha, Symas jpgouin/openldap) ---
fullnameOverride: "openldap"
replicaCount: 1

image:
  repository: "${LDAP_IMAGE_REPOSITORY}"
  tag: "${LDAP_IMAGE_TAG}"
  pullPolicy: "${LDAP_IMAGE_PULL_POLICY}"

global:
  ldapDomain: "${LDAP_DOMAIN}"
  adminUser: "${LDAP_ADMIN_USERNAME}"
  configUser: "admin"
  existingSecret: "${LDAP_ADMIN_SECRET_NAME}"
  ldapPort: ${LDAP_PORT}
  sslLdapPort: ${LDAP_TLS}

customLdifCm: "${LDAP_LDIF_SECRET_NAME}"

env:
  BITNAMI_DEBUG: "false"
  LDAP_LOGLEVEL: "256"

initTLSSecret:
  tls_enabled: false

service:
  type: "ClusterIP"
  enableLdapPort: true
  enableSslLdapPort: true

persistence:
  enabled: true
  accessModes:
    - ReadWriteOnce
  size: 8Gi

replication:
  enabled: false
ltb-passwd:
  enabled: false
phpldapadmin:
  enabled: false

podAnnotations:
  sidecar.istio.io/inject: "false"

resources:
  requests:
    cpu: "${LDAP_REQ_CPU}"
    memory: "${LDAP_REQ_MEM}"
  limits:
    memory: "${LDAP_LIMIT_MEM}"

nodeSelector: {}
tolerations: []
affinity: {}
