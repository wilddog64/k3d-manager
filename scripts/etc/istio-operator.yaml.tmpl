apiVersion: install.istio.io/v1alpha1
kind: IstioOperator
metadata:
  namespace: istio-system
  name: istio-control-plane
spec:
  profile: default
  components:
    pilot:
      k8s:
        # Single-node hub: one replica, no HPA. The default HPA (max 5 @ 80% of a small request) scales out under CPU pressure and worsens overcommit; an HPA pinned at min = max = 1 fires KubeHpaMaxedOut forever.
        replicaCount: 1
        resources:
          requests:
            cpu: "${PILOT_K8S_CPU}" # 100m
            memory: "${PILOT_K8S_MEM}" # 256Mi
          limits:
            cpu: "500m"
            memory: "1Gi"
    ingressGateways:
      - name: istio-ingressgateway
        enabled: true
        k8s:
          # One replica, no HPA, on the single-node hub (see pilot note above).
          replicaCount: 1
          resources:
            requests:
              cpu: "${ING_K8S_CPU}" # 100m
              memory: "${ING_K8S_MEM}" # 256Mi
            limits:
              cpu: "500m"
              memory: "512Mi"
          service:
            type: LoadBalancer
  values:
    pilot:
      autoscaleEnabled: false
    gateways:
      istio-ingressgateway:
        autoscaleEnabled: false
    global:
      proxy:
        resources:
          requests:
            cpu: "${GLO_PROXY_CPU}" # 50m
            memory: "${GLO_PROXY_MEM}" # 64Mi
