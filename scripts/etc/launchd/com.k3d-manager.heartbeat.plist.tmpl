<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.k3d-manager.heartbeat</string>
  <key>ProgramArguments</key><array>
    <string>{{PYTHON3}}</string><string>{{K3DM_HEARTBEAT_BIN}}</string>
    <string>--config</string><string>{{K3DM_HEARTBEAT_CONFIG}}</string>
  </array>
  <key>RunAtLoad</key><true/><key>StartInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>{{K3DM_HEARTBEAT_LOG}}</string>
  <key>StandardErrorPath</key><string>{{K3DM_HEARTBEAT_LOG}}</string>
</dict></plist>
