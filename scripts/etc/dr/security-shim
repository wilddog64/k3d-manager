#!/usr/bin/env bash
set -euo pipefail

log_file="${DR_SECURITY_CREDENTIALS_FILE:?DR_SECURITY_CREDENTIALS_FILE is required}"
unexpected_file="${DR_SECURITY_UNEXPECTED_FILE:-${log_file}.unexpected}"
allowlist="${DR_SECURITY_ALLOWLIST:?DR_SECURITY_ALLOWLIST is required}"
policy="${DR_DRILL_CREDENTIAL_POLICY:-audit}"
real_security="${DR_SECURITY_REAL:-/usr/bin/security}"
scopes=" ${DR_SECURITY_SCOPES:?DR_SECURITY_SCOPES is required} "
context="${DR_SECURITY_CONTEXT:-}"

_security_pair_allowed() {
  local op="$1" service="$2" account="$3" scope allowed_op allowed_service allowed_account
  while IFS=$'\t' read -r scope allowed_op allowed_service allowed_account; do
    [[ -z "$scope" || "$scope" == \#* ]] && continue
    [[ "$scopes" == *" $scope "* ]] || continue
    # shellcheck disable=SC2016
    if [[ "$allowed_account" == '${context}' ]]; then
      [[ -n "$context" ]] || continue
      allowed_account="$context"
    fi
    # shellcheck disable=SC2053
    if [[ "$op" == "$allowed_op" && "$service" == $allowed_service && "$account" == $allowed_account ]]; then
      return 0
    fi
  done < "$allowlist"
  return 1
}

_security_record() {
  local op="$1" service="$2" account="$3"
  printf '%s\t%s\t%s\n' "$op" "$service" "$account" >> "$log_file"
  if ! _security_pair_allowed "$op" "$service" "$account"; then
    printf '%s\t%s\t%s\n' "$op" "$service" "$account" >> "$unexpected_file"
    [[ "$policy" == audit ]] || return 44
  fi
}

_security_parse() {
  local -a args=("$@")
  local op="other" service="" account="" arg i
  [[ ${#args[@]} -gt 0 ]] || { _security_record "$op" "$service" "$account"; return; }
  case "${args[0]}" in
    find-generic-password) op='find' ;;
    add-generic-password) op='add' ;;
    delete-generic-password) op='delete' ;;
    *) _security_record "$op" "$service" "$account"; return ;;
  esac
  for ((i = 1; i < ${#args[@]}; i++)); do
    arg="${args[i]}"
    case "$arg" in
      -s) ((i++)); service="${args[i]:-}" ;;
      -a) ((i++)); account="${args[i]:-}" ;;
      -w) ((i++)) ;;
    esac
  done
  _security_record "$op" "$service" "$account"
}

_security_parse_stdin() {
  local input line
  local -a security_args=("$@")
  input="$(cat; printf '\001')"
  input="${input%$'\001'}"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    read -r -a line_args <<< "$line"
    _security_parse "${line_args[@]}"
  done <<< "$input"
  printf '%s' "$input" | "$real_security" "${security_args[@]}"
}

if [[ "${1:-}" == -i ]]; then
  _security_parse_stdin "$@"
else
  _security_parse "$@"
  exec "$real_security" "$@"
fi
