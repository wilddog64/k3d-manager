#!/usr/bin/env bash
# shellcheck disable=SC2016
set -euo pipefail

_watch_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$_watch_dir/../scripts/lib/system.sh"
_dispatch="${K3DM_STALL_DISPATCH_BIN:-$_watch_dir/k3dm-codex-dispatch}"
_notify="${K3DM_STALL_NOTIFY_BIN:-$_watch_dir/k3dm-slack-notify}"
_root="${K3DM_WORKTREE_ROOT:-$HOME/.local/share/k3d-manager/worktrees}"

_watch_refresh() {
  local run="$1" sample db steps old_db old_steps since now started
  [[ "$(<"$run/agent")" == agy ]] 2>/dev/null || return 0
  sample="$(_run_command --soft --quiet "$_dispatch" _stall-sample "$run" 2>/dev/null)" || return 0
  IFS=$'\t' read -r db steps <<< "$sample"
  [[ -n "$db" && "$steps" =~ ^[0-9]+$ ]] || return 0
  now="$(_run_command --soft --quiet perl -e 'print time')"
  started="$(_run_command --soft --quiet awk -F= '$1=="started" {print $2; exit}' "$run/start")"
  old_db=""; old_steps=""; since="$now"
  if [[ -f "$run/stall-watch.state" ]]; then
    IFS= read -r sample < "$run/stall-watch.state" || true
    old_db="${sample%% steps=*}"; old_db="${old_db#db=}"
    old_steps="${sample##* steps=}"; since="${old_steps##* since=}"; old_steps="${old_steps%% since=*}"
  fi
  if [[ "$old_db" != "$db" || "$old_steps" != "$steps" || ! "$since" =~ ^[0-9]+$ || ! "$started" =~ ^[0-9]+$ ]] || (( since < started )); then since="$now"; fi
  printf 'db=%s steps=%s since=%s\n' "$db" "$steps" "$since" > "$run/stall-watch.state" || echo "[stall-watch] state write failed: $run" >&2
}

_watch_notice() {
  local dir="$1" message
  [[ -f "$dir/notified" ]] && return 0
  [[ -f "$dir/notice.txt" ]] || return 0
  IFS= read -r message < "$dir/notice.txt" || true
  if printf '%s\n' "$message" | _run_command --soft --quiet "$_notify"; then
    : > "$dir/notified" || echo "[stall-watch] cannot mark notice: $dir" >&2
  else
    echo "[stall-watch] notice failed: $dir" >&2
  fi
}

_watch_capture() {
  local slug="$1" version="$2" run="$3" tree="$4" silent="$5" procs="$6" pid started id dir stamp file newest="" mtime latest=-1 reason=procs repo=k3d-manager json run_number=1 n
  pid="$(_run_command --soft --quiet awk -F= '$1=="pid" {print $2; exit}' "$run/start")"
  started="$(_run_command --soft --quiet awk -F= '$1=="started" {print $2; exit}' "$run/start")"
  [[ "$pid" =~ ^[0-9]+$ && "$started" =~ ^[0-9]+$ ]] || return 0
  id="$pid-$started"
  [[ ! -e "$run/stall-handled-$id" ]] || return 0
  stamp="$(_run_command --soft --quiet date -u +%Y%m%dT%H%M%SZ)"
  dir="$run/stall-$stamp"
  [[ ! -e "$dir" ]] || dir="$dir-$id"
  ( set -o noclobber; printf '%s\n' "$dir" > "$run/stall-handled-$id" ) 2>/dev/null || return 0
  _run_command --soft --quiet mkdir -p "$dir" || { echo "[stall-watch] cannot create $dir" >&2; return 0; }
  if ! _run_command --soft --quiet ps -axo pid,ppid,etime,command 2>> "$dir/errors.txt" | _watch_path="$tree" _run_command --soft --quiet awk 'NR==1 {print; next} {p=index($0, ENVIRON["_watch_path"]); c=substr($0,p+length(ENVIRON["_watch_path"]),1); if (p && (c=="" || c=="/" || c ~ /[[:space:]]/)) print}' > "$dir/ps.txt"; then echo 'ps capture failed' >> "$dir/errors.txt"; fi
  for file in "$run/agy.log" "$run/agy"-[0-9]*.log "$run/codex.log" "$run/codex"-[0-9]*.log; do
    [[ -f "$file" ]] || continue
    mtime="$(_run_command --soft --quiet perl -e 'print((stat shift)[9] // 0)' "$file")" || continue
    if (( mtime > latest )); then newest="$file"; latest="$mtime"; fi
  done
  if [[ -n "$newest" ]]; then _run_command --soft --quiet tail -n 200 "$newest" > "$dir/log-tail.txt" 2>> "$dir/errors.txt" || echo 'log capture failed' >> "$dir/errors.txt"; else : > "$dir/log-tail.txt"; fi
  _run_command --soft --quiet perl -e 'alarm shift; exec @ARGV' 60 git -C "$tree" status --short > "$dir/status.txt" 2>> "$dir/errors.txt" || echo 'status capture failed' >> "$dir/errors.txt"
  _run_command --soft --quiet perl -e 'alarm shift; exec @ARGV' 60 git -C "$tree" diff > "$dir/diff.patch" 2>> "$dir/errors.txt" || echo 'diff capture failed' >> "$dir/errors.txt"
  printf 'slug: %s\nversion: %s\nsilent: %s\nprocs: %s\nseconds threshold: %s\nprocess threshold: %s\n' "$slug" "$version" "$silent" "$procs" "${K3DM_DISPATCH_STALL_SECONDS:-2700}" "${K3DM_DISPATCH_STALL_MAX_PROCS:-200}" > "$dir/summary.txt"
  local limit="${K3DM_DISPATCH_STALL_SECONDS:-2700}"
  [[ "$limit" =~ ^[0-9]+$ ]] || limit=2700
  if (( 10#$limit > 0 && silent > 10#$limit )); then reason=silent; fi
  [[ ! -s "$run/repo-name" ]] || repo="$(<"$run/repo-name")"
  for file in "$run"/prompt-[0-9]*.md; do
    [[ -f "$file" ]] || continue
    n="${file##*/prompt-}"; n="${n%.md}"
    [[ "$n" =~ ^[0-9]+$ ]] || continue
    (( 10#$n > run_number )) && run_number=$((10#$n))
  done
  json="$(_run_command --soft --quiet jq -nc --arg version "$version" --arg slug "$slug" --arg repo "$repo" --arg stall "${dir##*/}" --argjson run "$run_number" --arg reason "$reason" --argjson silent "$silent" --argjson procs "$procs" --argjson ts "$(_run_command --soft --quiet perl -e 'print time')" '{ts:$ts,event:"stall_detected",version:$version,slug:$slug,repo:$repo,stall:$stall,run:$run,reason:$reason,silent_s:$silent,procs:$procs,killed:0}')" && printf '%s\n' "$json" >> "$_root/ledger.jsonl" || echo "[stall-watch] ledger write failed: $run" >&2
  local shown="$dir" home_mark=\~
  [[ -z "${HOME:-}" || "$dir" != "$HOME"/* ]] || shown="$home_mark/${dir#"$HOME"/}"
  printf 'Dispatch stalled: %s %s silent %s seconds, %s processes; evidence %s\n' "$slug" "$version" "$silent" "$procs" "$shown" > "$dir/notice.txt"
  _watch_notice "$dir"
}

(($# == 0)) || { echo 'usage: k3dm-dispatch-stall-watch' >&2; exit 2; }
while IFS=$'\t' read -r slug version run tree; do
  [[ -n "$run" ]] || continue
  _watch_refresh "$run"
done < <(_run_command --soft --quiet "$_dispatch" stalled --live || true)

version_dir="$(_run_command --soft --quiet find "$_root" -mindepth 1 -maxdepth 1 -type d -name 'v*' 2>/dev/null | _run_command --soft --quiet sort -V | _run_command --soft --quiet tail -n 1)" || version_dir=""
if [[ -n "$version_dir" ]]; then
  for marker in "$version_dir"/*.run/stall-handled-*; do
    [[ -f "$marker" ]] || continue
    IFS= read -r dir < "$marker" || true
    [[ -d "$dir" ]] && _watch_notice "$dir"
  done
fi

while IFS=$'\t' read -r slug version run tree silent procs; do
  [[ -n "$run" ]] || continue
  if [[ ! "$silent" =~ ^[0-9]+$ || ! "$procs" =~ ^[0-9]+$ ]]; then
    echo "[stall-watch] invalid stall values for $slug" >&2
    continue
  fi
  _watch_capture "$slug" "$version" "$run" "$tree" "$silent" "$procs"
done < <(_run_command --soft --quiet "$_dispatch" stalled || true)

