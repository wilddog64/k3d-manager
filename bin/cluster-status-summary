#!/usr/bin/env bash
set -euo pipefail
_mode=summary; _service=""
while [[ $# -gt 0 ]]; do case "$1" in --mode) [[ $# -ge 2 ]] || exit 3; _mode="$2"; shift;; --service) [[ $# -ge 2 ]] || exit 3; _service="$2"; shift;; *) exit 3;; esac; shift; done
case "${_mode}" in summary|json) ;; *) exit 3;; esac
_provider="${CLUSTER_PROVIDER:-k3s-aws}"; _context="${APP_CONTEXT:-}"
_color() { local code="$1" text="$2"; if [[ "${_mode}" == json || "${NO_COLOR:-}" == 1 || "${STATUS_COLOR:-}" == never || ( ! -t 1 && "${STATUS_COLOR:-}" != always ) ]]; then printf '%s' "${text}"; else printf '\033[%sm%s\033[0m' "${code}" "${text}"; fi; }
_token="${K3DM_WEBHOOK_TOKEN:-$(security find-generic-password -s k3dm-webhook-token -a k3dm -w 2>/dev/null || true)}"; _port="${K3DM_WEBHOOK_PORT:-7443}"; _tmp="$(mktemp -t k3dm-status.XXXXXX)"; trap 'rm -f "${_tmp}"' EXIT
if [[ -z "${_token}" ]] || ! curl -sf --max-time 15 -H "Authorization: Bearer ${_token}" "http://localhost:${_port}/api/v1/health?provider=${_provider}" >"${_tmp}" 2>/dev/null; then
  if [[ "${_mode}" == json ]]; then printf '{"overall":"unknown","provider":"%s","context":"%s","errors":[],"warnings":[{"id":"status_source","status":"unknown","reason":"webhook unavailable"}],"checks":[],"counts":{}}\n' "${_provider}" "${_context}"; else printf '%s\n' "$(_color 33 'Overall: UNKNOWN')" '  ! status source: webhook unavailable' '  hint: make restart-webhook'; fi; exit 2
fi
_parsed="$(python3 - "${_tmp}" "${_service}" <<'PY'
import json,re,sys
d=json.load(open(sys.argv[1])); w=sys.argv[2].lower(); a={"shopping-cart-order":"order","shopping-cart-payment":"payment","shopping-cart-basket":"basket","shopping-cart-frontend":"frontend","shopping-cart-product-catalog":"product-catalog"}; rows=[]
for x in d.get("services",[]):
 n=str(x.get("name","")); l=n.lower()
 if w and not (l==w or l==a.get(w,w) or a.get(w,w) in l): continue
 s="healthy" if x.get("ok") is True else ("error" if x.get("ok") is False else "warning"); rows.append((l.replace(" ","_"),n,s,str(x.get("detail",""))))
if w and not rows: print("__UNKNOWN__")
else:
 for r in rows: print("\t".join(r))
PY
)" || true
if [[ "${_parsed}" == __UNKNOWN__ ]]; then echo "unknown service: ${_service}" >&2; exit 3; fi
if [[ -z "${_parsed}" ]]; then echo "status source returned no services" >&2; exit 2; fi
if [[ "${_mode}" == json ]]; then
  python3 - "${_parsed}" "${_provider}" "${_context}" <<'PY'
import json,re,sys
c=[]
for l in sys.argv[1].splitlines():
 i,s,t,m=l.split("\t",3); item={"id":i,"service":s,"status":t,"message":m}; h=re.search(r"HTTP (\d+)",m); r=re.search(r"readiness ([0-9]+/[0-9]+)",m)
 if h: item["http_code"]=int(h.group(1))
 if r: item["ready"]=r.group(1)
 c.append(item)
e=[x for x in c if x["status"]=="error"]; w=[x for x in c if x["status"]=="warning"]
print(json.dumps({"overall":"fail" if e else ("warn" if w else "healthy"),"provider":sys.argv[2],"context":sys.argv[3],"errors":e,"warnings":w,"checks":c,"counts":{"services_failed":len(e),"services_warning":len(w),"services_healthy":sum(x["status"]=="healthy" for x in c)}}))
PY
  grep -q $'\terror\t' <<<"${_parsed}" && exit 1 || exit 0
fi
_errors=0; _warnings=0
while IFS=$'\t' read -r _id _name _status _message; do
 case "${_status}" in error) _errors=$((_errors+1)); printf '  %s %s: %s\n' "$(_color 31 '✗')" "${_name}" "${_message}";; warning) _warnings=$((_warnings+1)); printf '  %s %s: %s\n' "$(_color 33 '!')" "${_name}" "${_message}";; healthy) printf '  %s %s: %s\n' "$(_color 32 '✓')" "${_name}" "${_message}";; esac
done <<<"${_parsed}"
if (( _errors > 0 )); then printf '%s\n' "$(_color 31 "Overall: FAIL (${_errors} errors, ${_warnings} warnings)")"; elif (( _warnings > 0 )); then printf '%s\n' "$(_color 33 "Overall: WARN (${_warnings} warnings)")"; else printf '%s\n' "$(_color 32 'Overall: HEALTHY')"; fi
printf '%s\n' 'Details: make status-full'; (( _errors == 0 )) || exit 1
