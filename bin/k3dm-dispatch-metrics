def _repo_root():
    return Path(os.environ.get("K3DM_REPO_ROOT", Path(__file__).resolve().parent.parent))


def _prices(path):
    try:
        data = json.loads(Path(path).read_text(encoding="utf-8"))
        return data.get("models", {}), data.get("subscriptions_usd_per_month", {}), data.get("checked"), data.get("claude_models", {})
    except (OSError, ValueError, TypeError):
        return {}, {}, None, {}


def _spec_stats(path):
    """Count declared spec scope and acceptance items without affecting dispatch."""
    result = {"files": None, "must": None, "must_not": None, "evidence": None, "live_evidence": None}
    try:
        text = Path(path).read_text(encoding="utf-8")
    except (OSError, UnicodeError, TypeError):
        return result
    match = re.search(r"(?ms)^## Files\s*\n(.*?)(?=^## |\Z)", text)
    if match:
        body = match.group(1)
        bullets = re.findall(r"(?m)^\s*[-*+]\s+", body)
        rows = [line for line in body.splitlines() if line.strip().startswith("|")]
        table_rows = [line for line in rows if not re.match(r"\s*\|\s*:?-{2,}", line)]
        table_count = max(0, len(table_rows) - 1)
        result["files"] = len(bullets) + table_count
    acceptance = re.search(r"(?ms)^## Acceptance\s*\n```ya?ml\s*\n(.*?)^```", text)
    if acceptance:
        body = acceptance.group(1)
        for key in ("must", "must_not", "evidence"):
            section = re.search(rf"(?ms)^{key}:\s*\n(.*?)(?=^[A-Za-z_][A-Za-z0-9_]*:|\Z)", body)
            if section:
                items = re.findall(r"(?m)^\s+-\s+id\s*:", section.group(1))
                result[key] = len(items)
        if result["evidence"] is not None:
            evidence_section = re.search(r"(?ms)^evidence:\s*\n(.*?)(?=^[A-Za-z_][A-Za-z0-9_]*:|\Z)", body)
            result["live_evidence"] = len(re.findall(r"(?m)^\s+kind:\s*live\s*$", evidence_section.group(1))) if evidence_section else 0
    return result


def _bash_reads(command, cwd):
    """Conservatively identify file operands in a read-only first pipeline stage."""
    if not isinstance(command, str):
        return []
    try:
        lexer = shlex.shlex(command, posix=True, punctuation_chars="|&;<>")
        lexer.whitespace_split = True
        tokens = list(lexer)
    except (ValueError, TypeError):
        return []
    if not tokens or any(any(c in token for c in ";&<>") or ("|" in token and token != "|") for token in tokens):
        return []
    if any(token == "tee" or token.startswith("-i") for token in tokens):
        return []
    stage = tokens[:tokens.index("|")] if "|" in tokens else tokens
    if not stage or stage[0] not in ("cat", "head", "tail", "sed", "awk", "grep", "rg"):
        return []
    program = stage[0]
    options, operands = [], []
    skip = False
    has_pattern = program not in ("sed", "awk", "grep", "rg")
    for token in stage[1:]:
        if skip:
            options.append(token)
            skip = False
        elif token.startswith("-"):
            options.append(token)
            skip = token in ("-e", "--regexp", "-f", "--file") or (program in ("head", "tail") and token in ("-n", "--lines", "-c", "--bytes"))
            if token in ("-e", "--regexp", "-f", "--file"):
                has_pattern = True
        elif not has_pattern:
            options.append(token)
            has_pattern = True
        else:
            operands.append(token)
    if program == "sed" and "-n" not in options:
        return []
    if not operands or len(operands) > 5:
        return []
    repo = _repo_root().resolve()
    result = []
    for operand in operands:
        path = Path(operand)
        if not path.is_absolute():
            path = Path(cwd or repo) / path
            path = path.resolve()
            if not path.is_relative_to(repo):
                return []
        result.append((str(path), (program, *options)))
    return result


def _result_hash(block):
    content = block.get("content")
    if block.get("is_error") or content is None:
        return None
    body = content if isinstance(content, str) else json.dumps(content, sort_keys=True, ensure_ascii=False)
    if re.search(r"(?:<persisted-output>|output truncated|truncated output|exceeded.*(?:limit|characters))", body, re.I):
        return None
    return hashlib.sha256(body.encode()).digest()


def _claude_rollup(projects_dir, cache_path, context_out=None):
    cache = {"offsets": {}, "records": {}}
    try:
        cache = json.loads(Path(cache_path).read_text(encoding="utf-8"))
        if not isinstance(cache.get("offsets"), dict) or not isinstance(cache.get("records"), dict):
            raise ValueError("invalid cache")
    except (OSError, ValueError, TypeError):
        pass
    compactions = []
    reads = []
    context_turns = []
    context_boundaries = []
    root = Path(projects_dir)
    if root.is_dir():
        for path in sorted(root.rglob("*.jsonl")):
            key = str(path)
            try:
                size = path.stat().st_size
                offset = int(cache["offsets"].get(key, 0))
                if size < offset:
                    offset = 0
                start_offset = 0 if context_out is not None else offset
                latest = {}
                before = {}
                edited = defaultdict(int)
                segment_seen = set()
                pending = {}
                seen_read_calls = set()
                pos = start_offset
                with path.open("rb") as stream:
                    stream.seek(start_offset)
                    for raw in stream:
                        line_pos = pos
                        pos += len(raw)
                        stripped = raw.replace(b" ", b"")
                        is_assistant = b'"type":"assistant"' in stripped
                        is_boundary = context_out is not None and b'"subtype":"compact_boundary"' in stripped
                        if not is_assistant and not is_boundary and not (context_out is not None and b'"type":"user"' in stripped):
                            continue
                        try:
                            item = json.loads(raw)
                        except (ValueError, TypeError):
                            continue
                        if not isinstance(item, dict):
                            continue
                        if context_out is not None and item.get("type") == "system" and item.get("subtype") == "compact_boundary":
                            meta = item.get("compactMetadata")
                            meta = meta if isinstance(meta, dict) else {}
                            trigger = meta.get("trigger")
                            trigger = trigger if trigger in COMPACT_TRIGGERS else "unknown"
                            pre_tokens = meta.get("preTokens")
                            pre = pre_tokens if type(pre_tokens) is int and pre_tokens >= 0 else 0
                            compactions.append({"ts": item.get("timestamp"), "trigger": trigger, "pre_tokens": pre})
                            context_boundaries.append({"ts": item.get("timestamp"), "session": hashlib.sha256(key.encode()).hexdigest()})
                            before = {name: dict(ranges) for name, ranges in latest.items()}
                            segment_seen.clear()
                            continue
                        if item.get("type") == "user" and context_out is not None:
                            content = (item.get("message") or {}).get("content")
                            for block in content if isinstance(content, list) else []:
                                if not isinstance(block, dict) or block.get("type") != "tool_result":
                                    continue
                                digest = _result_hash(block)
                                for fpath, read_range, record, generation, previous in pending.pop(block.get("tool_use_id"), []):
                                    if record["reread"] and digest is not None and previous == (digest, generation):
                                        record["classification"] = "unchanged"
                                    latest.setdefault(fpath, {})[read_range] = (digest, generation)
                            continue
                        if item.get("type") != "assistant":
                            continue
                        try:
                            message = item.get("message") or {}
                            if context_out is not None:
                                content = message.get("content")
                                if isinstance(content, list):
                                    for idx, block in enumerate(content):
                                        if not isinstance(block, dict):
                                            continue
                                        if block.get("type") != "tool_use":
                                            continue
                                        call_id = block.get("id") or (message.get("id"), idx)
                                        if call_id in seen_read_calls:
                                            continue
                                        seen_read_calls.add(call_id)
                                        inp = block.get("input") or {}
                                        if not isinstance(inp, dict):
                                            continue
                                        name = block.get("name")
                                        fpath = inp.get("file_path") or inp.get("notebook_path")
                                        if name in ("Edit", "Write", "NotebookEdit") and isinstance(fpath, str):
                                            edited[fpath] += 1
                                        candidates = []
                                        if name == "Read" and isinstance(fpath, str) and fpath:
                                            candidates = [(fpath, (inp.get("offset"), inp.get("limit"), inp.get("pages")))]
                                        elif name == "Bash":
                                            candidates = _bash_reads(inp.get("command"), item.get("cwd"))
                                        for fpath, read_range in candidates:
                                            reread = fpath in before and fpath not in segment_seen
                                            record = {"ts": item.get("timestamp"), "reread": reread,
                                                      "classification": "changed" if reread else None,
                                                      "tool": name.lower()}
                                            reads.append(record)
                                            segment_seen.add(fpath)
                                            previous = before.get(fpath, {}).get(read_range)
                                            generation = edited[fpath]
                                            pending.setdefault(call_id, []).append((fpath, read_range, record, generation, previous))
                                            latest.setdefault(fpath, {})[read_range] = (None, generation)
                            if line_pos < offset:
                                continue
                            mid, model = message.get("id"), message.get("model")
                            usage = message.get("usage") or {}
                            if context_out is not None and isinstance(mid, str) and isinstance(model, str):
                                creation = usage.get("cache_creation") or {}
                                cache5 = creation.get("ephemeral_5m_input_tokens", usage.get("cache_creation_input_tokens", 0))
                                cache1 = creation.get("ephemeral_1h_input_tokens", 0)
                                values = [usage.get("input_tokens", 0), usage.get("cache_read_input_tokens", 0), cache5, cache1]
                                if all(isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value) and value >= 0 for value in values):
                                    context_turns.append({"id": mid, "ts": item.get("timestamp"), "context": sum(values),
                                        "session": hashlib.sha256(key.encode()).hexdigest(), "subagent": "/subagents/" in key,
                                        "model": model, "speed": usage.get("speed"), "cache_5m": cache5, "cache_1h": cache1})
                                if mid in cache["records"]:
                                    cached = cache["records"][mid]
                                    cached.setdefault("id", mid)
                                    cached.setdefault("subagent", "/subagents/" in key)
                                    cached.setdefault("session", hashlib.sha256(key.encode()).hexdigest())
                            if not isinstance(mid, str) or not isinstance(model, str) or model == "<synthetic>" or mid in cache["records"]:
                                continue
                            creation = usage.get("cache_creation") or {}
                            cache5 = creation.get("ephemeral_5m_input_tokens", usage.get("cache_creation_input_tokens", 0))
                            cache1 = creation.get("ephemeral_1h_input_tokens", 0)
                            cache["records"][mid] = {"id": mid, "ts": item.get("timestamp"), "model": model,
                                "speed": usage.get("speed"), "input": usage.get("input_tokens", 0),
                                "cache_5m": cache5, "cache_1h": cache1,
                                "cache_read": usage.get("cache_read_input_tokens", 0),
                                "output": usage.get("output_tokens", 0), "subagent": "/subagents/" in key,
                                "session": hashlib.sha256(key.encode()).hexdigest()}
                        except (ValueError, TypeError, AttributeError):
                            continue
                    cache["offsets"][key] = stream.tell()
            except (OSError, ValueError, TypeError):
                continue
    if context_out is not None:
        context_out["compactions"] = compactions
        context_out["reads"] = reads
        context_out["turns"] = context_turns
        context_out["boundaries"] = context_boundaries
    target = Path(cache_path)
    temp = None
    try:
        target.parent.mkdir(parents=True, exist_ok=True)
        fd, temp_path = tempfile.mkstemp(dir=target.parent, prefix=target.name + ".", suffix=".tmp")
        temp = Path(temp_path)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(cache, stream, separators=(",", ":"))
        os.replace(temp, target)
    except OSError as exc:
        if temp is not None:
            try:
                temp.unlink()
            except OSError:
                pass
        print(f"claude rollup cache not saved: {exc}", file=sys.stderr)
    return list(cache["records"].values())


def _verified_specs(repo_root, now):
    counts = {w: {"live": 0, "verified": 0, "unverified": 0} for w in WINDOWS}
    root = Path(repo_root) if repo_root else _repo_root()
    if not (root / ".git").exists():
        return counts
    since = int(now - max(WINDOWS.values()))
    try:
        proc = subprocess.run(
            ["git", "log", f"--since=@{since}", "-p", "--format=commit %ct", "--", "docs/bugs", "docs/plans"],
            cwd=str(root), capture_output=True, text=True, timeout=30,
        )
    except (OSError, subprocess.SubprocessError):
        return counts
    if proc.returncode != 0:
        return counts
    seen = {w: {} for w in WINDOWS}
    commit_ts = 0
    current_file = None
    created = False
    added_status = None
    removed_status = None

    def record_file():
        if not current_file or not added_status or not _CLOSED_RE.search(added_status):
            return
        if not created and (removed_status is None or _CLOSED_RE.search(removed_status)):
            return
        status_word = added_status.split()[0].rstrip("—-:").upper()
        if status_word == "LIVE-VERIFIED":
            level = "live"
        elif status_word in {"VERIFIED", "FIXED"} or added_status.upper().startswith(("FIXED ON ", "FIXED IN ")):
            level = "verified"
        else:
            level = "unverified"
        for window, seconds in WINDOWS.items():
            if now - seconds <= commit_ts <= now:
                seen[window].setdefault(current_file, level)

    for line in proc.stdout.splitlines():
        if line.startswith("commit "):
            record_file()
            parts = line.split()
            try:
                commit_ts = int(parts[1])
            except (IndexError, ValueError):
                commit_ts = 0
            current_file = None
            created = False
            added_status = None
            removed_status = None
        elif line.startswith("diff --git "):
            record_file()
            current_file = None
            created = False
            added_status = None
            removed_status = None
        elif line.startswith("--- "):
            created = line[4:].strip() == "/dev/null"
        elif line.startswith("+++ "):
            target = line[4:].strip()
            current_file = None if target == "/dev/null" else (target[2:] if target.startswith("b/") else target)
        elif line.startswith("+**Status:**"):
            added_status = line[len("+**Status:**"):].strip()
        elif line.startswith("-**Status:**"):
            removed_status = line[len("-**Status:**"):].strip()
    record_file()
    for window, files in seen.items():
        for level in counts[window]:
            counts[window][level] = sum(1 for value in files.values() if value == level)
    return counts


def _read_context_tally(repo_root, now):
    from datetime import date, datetime
    root = Path(repo_root) if repo_root else _repo_root()
    path = root / "docs/metrics/context-window-experiment.md"
    incidents = {w: {k: 0 for k in INCIDENT_KINDS} for w in WINDOWS}
    if not path.is_file():
        return incidents, None
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return incidents, None
    today = datetime.fromtimestamp(now).astimezone().date()
    mode = None
    latest_setting = None
    for idx, raw in enumerate(lines):
        line = raw.strip()
        if not line.startswith("|") or not line.endswith("|"):
            mode = None
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        lower = [c.lower() for c in cells]
        if lower == ["date", "auto_compact_tokens", "note"]:
            mode = "settings"
            continue
        if lower == ["date", "kind", "spec", "note"]:
            mode = "incidents"
            continue
        if all(c and set(c) <= {"-", ":"} for c in cells):
            continue
        if mode == "settings" and len(cells) >= 2:
            try:
                row_date = date.fromisoformat(cells[0])
                tokens = int(cells[1])
                if tokens <= 0 or row_date > today:
                    continue
                candidate = (row_date, idx, tokens)
                if latest_setting is None or (candidate[0], candidate[1]) >= (latest_setting[0], latest_setting[1]):
                    latest_setting = candidate
            except ValueError:
                continue
        elif mode == "incidents" and len(cells) >= 2:
            try:
                row_date = date.fromisoformat(cells[0])
            except ValueError:
                continue
            kind = cells[1]
            if kind not in INCIDENT_KINDS or row_date > today:
                continue
            age_days = (today - row_date).days
            for window, seconds in WINDOWS.items():
                if age_days <= seconds // 86400:
                    incidents[window][kind] += 1
    return incidents, (latest_setting[2] if latest_setting is not None else None)


def _claude_cost(record, prices):
    key = record["model"] if record.get("speed") in (None, "standard") else f'{record["model"]}@{record["speed"]}'
    rates = prices.get(key)
    if not isinstance(rates, dict) or any(rates.get(k) is None for k in ("input", "cache_write_5m", "cache_write_1h", "cache_read", "output")):
        return None
    kinds = ("input", "cache_5m", "cache_1h", "cache_read", "output")
    ratekeys = ("input", "cache_write_5m", "cache_write_1h", "cache_read", "output")
    values = [record.get(kind, 0) or 0 for kind in kinds]
    if any(not isinstance(value, (int, float)) or isinstance(value, bool) or not math.isfinite(value) or value < 0
           for value in values):
        return None
    try:
        return sum(float(value) * float(rates[rk]) for value, rk in zip(values, ratekeys)) / 1_000_000
    except (TypeError, ValueError, OverflowError):
        return None


def _render_claude(lines, window, records, rates, landed, now, cutoff=None, tasks=None,
                   all_tasks=None, time_scope=False, shown_keys=None):
    task_scoped = not time_scope
    selected_tasks = tasks or []
    overlap_tasks = all_tasks or selected_tasks
    cost = 0.0
    cost_by_kind = defaultdict(float)
    unpriced = 0.0
    totals = defaultdict(lambda: defaultdict(float))
    task_costs = defaultdict(float)
    for record in records:
        timestamp = _timestamp(record.get("ts"))
        if not task_scoped and cutoff is not None and timestamp < cutoff:
            continue
        overlaps = [task for task in overlap_tasks if task[0] <= timestamp <= task[1]]
        if task_scoped and not overlaps:
            continue
        selected_n = sum(1 for task in overlaps if task in selected_tasks) if task_scoped else 0
        if task_scoped and not selected_n:
            continue
        share = selected_n / len(overlaps) if task_scoped else 1
        chosen_for_release = not task_scoped or selected_n > 0
        model = record["model"]
        amount = _claude_cost(record, rates)
        if chosen_for_release:
            for kind, sources in (("input", ("input",)),
                                  ("cache_write", ("cache_5m", "cache_1h")),
                                  ("cache_read", ("cache_read",)),
                                  ("output", ("output",))):
                for source in sources:
                    value = record.get(source, 0) or 0
                    if isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value) and value >= 0:
                        totals[model][kind] += int(value) * share
            if amount is None:
                unpriced += share
            else:
                cost += amount * share
                key = record["model"] if record.get("speed") in (None, "standard") else f'{record["model"]}@{record["speed"]}'
                model_rates = rates.get(key, {})
                for kind, source, ratekey in (("input", "input", "input"),
                                               ("cache_write", "cache_5m", "cache_write_5m"),
                                               ("cache_write", "cache_1h", "cache_write_1h"),
                                               ("cache_read", "cache_read", "cache_read"),
                                               ("output", "output", "output")):
                    value = record.get(source, 0) or 0
                    cost_by_kind[kind] += float(value) * float(model_rates[ratekey]) / 1_000_000 * share
        if amount is not None:
            for task in selected_tasks:
                if task[0] <= timestamp <= task[1]:
                    task_costs[(task[2], task[3])] += amount / len(overlaps)
    lines.append(f'k3dm_dispatch_claude_api_cost_usd{{window="{window}"}} {cost}')
    for kind in ("input", "cache_write", "cache_read", "output"):
        lines.append(f'k3dm_dispatch_claude_api_cost_by_kind_usd{{window="{window}",kind="{kind}"}} {cost_by_kind[kind]}')
    if landed and task_scoped:
        lines.append(f'k3dm_dispatch_claude_api_cost_per_landed_usd{{window="{window}"}} {cost / landed}')
        tokens = sum(value for kinds in totals.values() for value in kinds.values())
        lines.append(f'k3dm_dispatch_claude_tokens_per_landed{{window="{window}"}} {tokens / landed}')
    for model, kinds in totals.items():
        for kind, value in kinds.items():
            lines.append(f'k3dm_dispatch_claude_tokens{{window="{window}",model="{model}",kind="{kind}"}} {value}')
    lines.append(f'k3dm_dispatch_claude_unpriced_messages{{window="{window}"}} {unpriced}')
    observed = [r for r in records if cutoff is None or _timestamp(r.get("ts")) >= cutoff]
    if time_scope and observed:
        earliest = max(cutoff or 0, min(_timestamp(r["ts"]) for r in records))
        lines.append(f'k3dm_dispatch_claude_api_cost_observed_days{{window="{window}"}} {max(0, (now-earliest)/86400):.2f}')
    if selected_tasks:
        for task in selected_tasks:
            _, _, version, slug, *_ = task
            if shown_keys is not None and (version, slug) not in shown_keys:
                continue
            if not (isinstance(version, str) and VERSION_RE.fullmatch(version)
                    and isinstance(slug, str) and SLUG_RE.fullmatch(slug)):
                continue
            amount = task_costs[(version, slug)]
            repo = task[4] if len(task) > 4 and isinstance(task[4], str) else "k3d-manager"
            if not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", repo):
                repo = "k3d-manager"
            lines.append(f'k3dm_dispatch_task_claude_api_cost_usd{{window="{window}",version="{version}",slug="{slug}",repo="{repo}"}} {amount}')


def _session_records(events):
    sessions = defaultdict(list)
    for index, event in enumerate(events):
        if event.get("event") != "codex_usage" or not event.get("session"):
            continue
        sessions[event["session"]].append((index, event))
    usage = {}
    fields = ("input", "cached_input", "output")
    for session, records in sessions.items():
        records.sort(key=lambda pair: (_timestamp(pair[1].get("ts", 0)), pair[0]))
        previous = None
        shares = []
        for _, event in records:
            totals = {key: int(event.get(key, 0) or 0) for key in fields}
            if previous is None or any(totals[key] < previous[key] for key in fields):
                share = totals
            else:
                share = {key: totals[key] - previous[key] for key in fields}
            previous = totals
            shares.append({**event, **share})
        usage[session] = shares
    return usage


def _dispatch_worktree_repos(events):
    latest = {}
    for event in events:
        if event.get("event") != "start":
            continue
        version, slug = event.get("version"), event.get("slug")
        if not isinstance(version, str) or not isinstance(slug, str) or slug.endswith(".run"):
            continue
        key = (version, slug)
        if key not in latest or event.get("ts", 0) >= latest[key].get("ts", 0):
            latest[key] = event
    result = {}
    for key, event in latest.items():
        repo = event.get("repo")
        result[key] = repo if isinstance(repo, str) and re.fullmatch(r"[A-Za-z0-9._-]{1,64}", repo) else "k3d-manager"
    return result


def _worktree_repo(cwd, repo_by_worktree):
    if not isinstance(cwd, str):
        return "other"
    try:
        path = Path(cwd).resolve()
        relative = path.relative_to(_root().resolve())
    except (OSError, RuntimeError, ValueError):
        return None
    parts = relative.parts
    if len(parts) < 2 or parts[1].endswith(".run"):
        return None
    key = (parts[0], parts[1])
    if key in repo_by_worktree:
        return repo_by_worktree[key]
    try:
        git_file = _root() / parts[0] / parts[1] / ".git"
        if not git_file.is_file():
            return "other"
        match = re.fullmatch(r"\s*gitdir:\s*(.+?)\s*", git_file.read_text(encoding="utf-8"))
        if not match:
            return "other"
        gitdir = Path(match.group(1))
        if not gitdir.is_absolute():
            gitdir = git_file.parent / gitdir
        git_parts = gitdir.resolve().parts
        for index in range(len(git_parts) - 2):
            if git_parts[index:index + 3] == (".git", "worktrees", git_parts[index + 2]):
                repo = git_parts[index - 1] if index else ""
                if re.fullmatch(r"[A-Za-z0-9._-]{1,64}", repo):
                    return repo
                break
    except (OSError, RuntimeError, ValueError):
        pass
    return "other"


def _session_files(codex_home, now, repo_by_worktree=None):
    repo_by_worktree = repo_by_worktree or {}
    cutoff = now - WINDOWS["30d"]
    for name in glob.glob(str(Path(codex_home) / "sessions" / "*" / "*" / "*" / "rollout-*.jsonl")):
        try:
            if os.path.getmtime(name) < cutoff:
                continue
            session = model = mode = repo = None
            start = None
            usage = None
            active = 0
            quota = None
            originator = thread_source = parent_thread_id = cwd = None
            with open(name, encoding="utf-8") as stream:
                for index, line in enumerate(stream):
                    try:
                        item = json.loads(line)
                    except (ValueError, TypeError):
                        continue
                    if not isinstance(item, dict):
                        continue
                    if index == 0 and item.get("type") == "session_meta":
                        payload = item.get("payload", {})
                        if not isinstance(payload, dict):
                            continue
                        session, start = payload.get("id"), payload.get("timestamp")
                        origin = payload.get("originator")
                        originator = origin
                        thread_source = payload.get("thread_source")
                        parent_thread_id = payload.get("parent_thread_id")
                        mode = "exec" if origin == "codex_exec" else "interactive" if origin == "codex-tui" else "other"
                        cwd = payload.get("cwd")
                        repo = _worktree_repo(cwd, repo_by_worktree)
                        if repo is None:
                            repo = Path(cwd).name if isinstance(cwd, str) else "other"
                        if not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", repo or ""):
                            repo = "other"
                    if item.get("type") == "event_msg":
                        payload = item.get("payload", {})
                        if not isinstance(payload, dict):
                            continue
                        event_type = payload.get("type")
                        if event_type == "task_complete":
                            duration = payload.get("duration_ms")
                            if isinstance(duration, (int, float)) and duration >= 0:
                                active += duration / 1000
                        if event_type in ("token_count", None):
                            info = payload.get("info", {})
                            if isinstance(info, dict):
                                value = info.get("total_token_usage")
                                if isinstance(value, dict):
                                    usage = value
                                model_value = payload.get("model") or info.get("model")
                                if isinstance(model_value, str):
                                    model = model_value
                        limits = payload.get("rate_limits")
                        if isinstance(limits, dict):
                            stamp = item.get("timestamp") or start
                            quota = (stamp, limits)
                    elif item.get("type") == "turn_context":
                        payload = item.get("payload", {})
                        if isinstance(payload, dict) and isinstance(payload.get("model"), str):
                            model = payload["model"]
            if isinstance(session, str) and session and isinstance(start, str):
                yield {"session": session, "start": start, "model": model, "usage": usage,
                       "mode": mode or "other", "repo": repo or "other", "active": active, "quota": quota,
                       "originator": originator, "cwd": cwd, "thread_source": thread_source,
                       "parent_thread_id": parent_thread_id}
        except (OSError, ValueError, TypeError):
            continue


def _cost(event, prices):
    rates = prices.get(event.get("model"))
    if not isinstance(rates, dict):
        return None
    try:
        inp, cached, output = (int(event[k]) for k in ("input", "cached_input", "output"))
        return ((inp - cached) * float(rates["input"]) + cached * float(rates["cached_input"])
                + output * float(rates["output"])) / 1_000_000
    except (KeyError, TypeError, ValueError):
        return None


def _agy_run_usage(events):
    """Return one validated agy usage record per dispatch run."""
    starts = {}
    usage_events = defaultdict(list)
    for index, event in enumerate(events):
        if event.get("event") not in {"start", "agent_exit", "agent_usage"}:
            continue
        key = (event.get("version"), event.get("slug"), event.get("run"))
        if not isinstance(key[0], str) or not isinstance(key[1], str) or type(key[2]) is not int:
            continue
        if event.get("event") == "start":
            starts[key] = event
        elif event.get("event") in {"agent_exit", "agent_usage"}:
            usage = event.get("usage")
            if isinstance(usage, dict):
                usage_events[key].append((index, usage))
    records = []
    for key, start in starts.items():
        if start.get("agent") != "agy":
            continue
        model = start.get("model")
        if isinstance(model, str):
            model = re.sub(r"-(?:low|medium|high)$", "", model)
        candidates = usage_events.get(key, [])
        # agent_exit and agent_usage carry the same per-run totals. Keep one copy.
        usage = candidates[0][1] if candidates else {}
        fields = ("input_tokens", "cache_read_tokens", "output_tokens", "thinking_tokens")
        valid = all(type(usage.get(field)) is int and usage[field] >= 0 for field in fields)
        records.append({"session": f"agy:{key[0]}:{key[1]}:{key[2]}", "version": key[0],
                        "slug": key[1], "run": key[2], "ts": start.get("ts"), "model": model,
                        "agy_usage": True,
                        "input": usage.get("input_tokens") if valid else None,
                        "cached_input": usage.get("cache_read_tokens") if valid else None,
                        "output": (usage["output_tokens"] + usage["thinking_tokens"]) if valid else None})
    return records


def _agy_cost(event, prices):
    rates = prices.get(event.get("model"))
    if not isinstance(rates, dict):
        return None
    try:
        if any(type(event.get(field)) is not int or event[field] < 0
               for field in ("input", "cached_input", "output")):
            return None
        return (event["input"] * float(rates["input"])
                + event["cached_input"] * float(rates["cached_input"])
                + event["output"] * float(rates["output"])) / 1_000_000
    except (KeyError, TypeError, ValueError):
        return None


def _root():
    return Path(os.environ.get("K3DM_WORKTREE_ROOT", "~/.local/share/k3d-manager/worktrees")).expanduser()


def _is_under_worktree_root(cwd, root=None):
    if not cwd or not isinstance(cwd, (str, Path)):
        return False
    try:
        wt_root = (Path(root) if root else _root()).resolve()
        cwd_path = Path(cwd).expanduser().resolve()
        return cwd_path == wt_root or cwd_path.is_relative_to(wt_root)
    except (ValueError, OSError, RuntimeError):
        return False


def _classify_session(session_item, ledgered, wt_root=None):
    if session_item.get("thread_source") == "guardian_review":
        return "guardian"
    if session_item.get("session") in ledgered:
        return "dispatch"
    cwd = session_item.get("cwd")
    if _is_under_worktree_root(cwd, wt_root):
        return "dispatch_unrecorded"
    origin = session_item.get("originator")
    if origin == "codex-tui":
        return "interactive"
    if origin == "codex_exec":
        return "exec_untracked"
    return "other"


def _display_path(path):
    """Show a local path without the operator's home directory, so labels carry no username."""
    resolved = path.absolute()
    try:
        return "~/" + str(resolved.relative_to(Path.home().resolve()))
    except ValueError:
        pass
    try:
        return str(resolved.relative_to(_root().resolve()))
    except ValueError:
        return resolved.name


def _evidence_details(version, slug, evidence, event=None):
    """Return a bounded, redacted summary and local evidence path."""
    run_dir = _root() / version / f"{slug}.run"
    path = ""
    summary = evidence
    if evidence in {"land-test.log", "land_refused.tests"}:
        validation = (event or {}).get("validation")
        name = Path(validation).name if isinstance(validation, str) and validation else "land-test.log"
        if not re.fullmatch(r"land-test(?:\.\d+)?\.log", name):
            name = "land-test.log"
        log_path = run_dir / name
        path = _display_path(log_path)
        try:
            content = log_path.read_text(errors="replace")
        except OSError:
            content = ""
        lines = content.splitlines()
        tap_ok = sum(line.startswith("ok ") for line in lines)
        tap_bad = sum(line.startswith("not ok ") for line in lines)
        tap = f"{tap_ok}/{tap_ok + tap_bad} ok" if tap_ok + tap_bad else None
        pytest = re.findall(r"(?m)^(\d+ (?:passed|failed)[^\n]*?)(?: in |$)", content)
        summaries = [value for value in (tap, pytest[-1].strip() if pytest else None) if value]
        summary = "; ".join(summaries) if summaries else (evidence if evidence == "land_refused.tests" else "unknown")
        if evidence == "land_refused.tests":
            failure = next((line[7:].strip() for line in lines if line.startswith("not ok ")), None)
            if failure is None:
                failure = next((line.split()[1] for line in lines if line.startswith("FAILED ") and len(line.split()) > 1), None)
            if failure:
                failure = redact(failure.replace(str(Path.home()), "~"))
                failure = re.sub(r"(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{20,}|hvs\.[A-Za-z0-9]{20,}|sk_(?:test|live)_[A-Za-z0-9]{10,}|xox[abpr]-[A-Za-z0-9-]{6,}|AKIA[0-9A-Z]{16}|hooks\.slack\.com/services/\S+|-----BEGIN [A-Z ]*PRIVATE KEY-----)", "<redacted>", failure)
                summary += "; first fail: " + failure[:80]
    elif evidence == "codex_exit.exit":
        path = _display_path(run_dir / "codex.log")
        summary = "local only (not shipped)"
    return summary, path


def _label_value(value, limit=120):
    return str(value).replace('"', "").replace("\\", "").replace("\n", "").replace("\r", "")[:limit]


def read_ledger(path):
    events = []
    bad = 0
    if not path.exists():
        return events, bad
    for line in path.read_text(encoding="utf-8").splitlines():
        try:
            item = json.loads(line)
            if not isinstance(item, dict) or not isinstance(item.get("ts"), (int, float)):
                raise ValueError("invalid event")
            events.append(item)
        except (ValueError, TypeError, json.JSONDecodeError):
            bad += 1
    return events, bad


def _task_states(events):
    states = defaultdict(list)
    for event in events:
        if event.get("event") in NEW_S1_EVENTS or not event.get("slug"):
            continue
        key = (event.get("version"), event.get("slug"))
        states[key].append(event)
    return states


def _task_state(task_events):
    names = {event.get("event") for event in task_events}
    if names & {"land", "abandon"}:
        return None
    launches = [e["ts"] for e in task_events if e.get("event") in {"start", "resume"}]
    exits = [e["ts"] for e in task_events if e.get("event") in {"codex_exit", "agent_exit"}]
    if not launches:
        return None
    if not exits or max(exits) < max(launches):
        return "running"
    return "awaiting"


DISPATCH_LIFECYCLE_EVENTS = {"start", "resume", "codex_exit", "agent_exit", "land", "land_refused", "abandon"}


def _dispatch_state(task_events):
    lifecycle = [e for e in task_events if e.get("event") in DISPATCH_LIFECYCLE_EVENTS]
    ordered = sorted(enumerate(lifecycle), key=lambda item: (item[1].get("ts", 0), item[0]))
    last = ordered[-1][1].get("event") if ordered else None
    if last == "land":
        return "landed"
    if last == "abandon":
        return "abandoned"
    last_exit = max((e.get("ts", 0) for _, e in ordered if e.get("event") in {"codex_exit", "agent_exit"}), default=None)
    later_launch = any(e.get("event") in {"start", "resume"} and
                       (last_exit is None or e.get("ts", 0) > last_exit) for _, e in ordered)
    if later_launch:
        return "running"
    latest_refusal = max((e.get("ts", 0) for _, e in ordered if e.get("event") == "land_refused"), default=None)
    if latest_refusal is not None and (last_exit is None or latest_refusal > last_exit):
        return "refused"
    if last_exit is not None:
        exit_event = next(e for _, e in reversed(ordered)
                          if e.get("event") in {"codex_exit", "agent_exit"} and e.get("ts", 0) == last_exit)
        return "awaiting_land" if exit_event.get("exit") == 0 else "codex_failed"
    return "running" if any(e.get("event") in {"start", "resume"} for _, e in ordered) else "unknown"


def _task_metrics(task_events, land_event, prices=None):
    ordered = sorted(enumerate(task_events), key=lambda item: (item[1]["ts"], item[0]))
    exits = [event for _, event in ordered if event.get("event") in {"codex_exit", "agent_exit"}]
    codex_exits = [event for event in exits if event.get("event") == "codex_exit"]
    launches = [event for _, event in ordered if event.get("event") in {"start", "resume"}]
    codex_seconds = 0
    previous_exit = None
    for exit_event in codex_exits:
        candidates = [
            launch for launch in launches
            if launch["ts"] <= exit_event["ts"]
            and (previous_exit is None or launch["ts"] > previous_exit)
        ]
        if candidates:
            codex_seconds += exit_event["ts"] - max(candidates, key=lambda event: event["ts"])["ts"]
        previous_exit = exit_event["ts"]
    agent_seconds = 0
    previous_exit = None
    for exit_event in exits:
        candidates = [launch for launch in launches if launch["ts"] <= exit_event["ts"]
                      and (previous_exit is None or launch["ts"] > previous_exit)]
        if candidates:
            agent_seconds += exit_event["ts"] - max(candidates, key=lambda event: event["ts"])["ts"]
        previous_exit = exit_event["ts"]

    token_events = [event for event in codex_exits if isinstance(event.get("tokens"), int)]
    agent_token_total = token_events[-1]["tokens"] if token_events else 0
    has_agent_tokens = bool(token_events)
    for event in exits:
        if event.get("event") != "agent_exit":
            continue
        usage = event.get("usage")
        usage_tokens = usage.get("total_tokens") if isinstance(usage, dict) else None
        if type(usage_tokens) is int and usage_tokens >= 0:
            agent_token_total += usage_tokens
            has_agent_tokens = True
    start_events = [event for event in task_events if event.get("event") == "start"]
    latest_start = max(enumerate(start_events), key=lambda item: (item[1].get("ts", 0), item[0]))[1] if start_events else {}
    identity_events = [event for event in ordered if event[1].get("event") == "identity"]
    valid_identities = []
    latest_runtime_identity = None
    for _, identity_event in identity_events:
        identity = identity_event.get("worker_identity")
        if (isinstance(identity, dict) and identity.get("source") == "runtime"
                and identity.get("status") == "reported"
                and identity.get("vendor") in {"openai", "google"}
                and isinstance(identity.get("model"), str)
                and re.fullmatch(r"[A-Za-z0-9._:-]{1,64}", identity["model"])):
            latest_runtime_identity = identity
            if identity not in valid_identities:
                valid_identities.append(identity)
    if latest_runtime_identity is not None:
        worker_identity = latest_runtime_identity
    else:
        worker_identity = latest_start.get("worker_identity") if isinstance(latest_start.get("worker_identity"), dict) else {}
    declared_coordinators = [event.get("coordinator_identity") for _, event in ordered
                             if event.get("event") in {"start", "resume"}
                             and isinstance(event.get("coordinator_identity"), dict)
                             and event["coordinator_identity"].get("source") == "declared"
                             and event["coordinator_identity"].get("status") == "declared"]
    coordinator_identity = declared_coordinators[-1] if declared_coordinators else (
        latest_start.get("coordinator_identity") if isinstance(latest_start.get("coordinator_identity"), dict) else {})
    primary_assignments = [event for _, event in ordered
                           if event.get("event") in {"start", "primary_coordinator"}
                           and isinstance(event.get("primary_coordinator_identity"), dict)]
    primary_identity = (primary_assignments[0].get("primary_coordinator_identity")
                        if primary_assignments else {"vendor": "unknown", "model": "unknown", "source": "unknown", "status": "unknown"})
    handoffs = [event for _, event in ordered if event.get("event") == "handoff"]
    acting_identity = (handoffs[-1].get("acting_coordinator_identity") if handoffs
                       and isinstance(handoffs[-1].get("acting_coordinator_identity"), dict)
                       else {"vendor": "unknown", "model": "unknown", "source": "unknown", "status": "unknown"})
    landing = land_event.get("landing_actor") if isinstance(land_event.get("landing_actor"), dict) else {}
    landing_actor = landing.get("actor") if landing.get("actor") in {"human", "claude", "codex", "other_agent", "unknown"} else "unknown"
    landing_identity = {"vendor": landing.get("vendor", "unknown"), "model": landing.get("model", "unknown"),
                        "source": landing.get("source", "unknown"), "status": "declared" if landing_actor != "unknown" else "unknown"}
    measured_coordinator_costs = [event for _, event in ordered
                                  if event.get("event") == "primary_coordinator_cost"
                                  and isinstance(event.get("source"), str)
                                  and event.get("source") in {"declared", "runtime-reported"}
                                  and isinstance(event.get("amount_usd"), (int, float))
                                  and not isinstance(event.get("amount_usd"), bool)
                                  and math.isfinite(event["amount_usd"]) and event["amount_usd"] >= 0]
    primary_coordinator_cost = measured_coordinator_costs[-1]["amount_usd"] if measured_coordinator_costs else None
    elapsed = None
    if start_events:
        elapsed = land_event["ts"] - min(event["ts"] for event in start_events)
    def valid_timestamp(value):
        return (type(value) in {int, float} and math.isfinite(value) and value >= 0)
    land_ts = land_event.get("ts")
    qualifying_exits = [event.get("ts") for event in task_events
                        if event.get("event") == "codex_exit"
                        and valid_timestamp(event.get("ts")) and valid_timestamp(land_ts)
                        and event["ts"] <= land_ts]
    post_exit_land = max(0, land_ts - max(qualifying_exits)) if qualifying_exits else None
    usage = _session_records(task_events)
    session_costs = [_cost(item, prices or {}) for records in usage.values() for item in records]
    session_costs.extend(_agy_cost(item, prices or {}) for item in _agy_run_usage(task_events))
    return {
        "tokens": token_events[-1]["tokens"] if token_events else None,
        "codex_seconds": codex_seconds,
        "agent_tokens": agent_token_total if has_agent_tokens else None,
        "agent_seconds": agent_seconds,
        "elapsed_seconds": elapsed,
        "post_exit_land_seconds": post_exit_land,
        "runs": len(exits),
        "api_cost_usd": sum(session_costs) if session_costs and all(x is not None for x in session_costs) else None,
        "spec": latest_start.get("spec"),
        "agent": latest_start.get("agent") if latest_start.get("agent") in {"codex", "agy"} else ("codex" if "agent" not in latest_start else "other"),
        "worker_identity": worker_identity,
        "worker_runtime_identities": valid_identities,
        "coordinator_identity": coordinator_identity,
        "primary_coordinator_identity": primary_identity,
        "acting_coordinator_identity": acting_identity,
        "landing_actor": landing_actor,
        "landing_identity": landing_identity,
        "handoff_count": len(handoffs),
        "handoff_reason": (handoffs[-1].get("handoff_reason") if handoffs and handoffs[-1].get("handoff_reason") in {"quota_exhausted", "manual", "unavailable", "scheduled", "other", "unknown"} else "unknown"),
        "primary_coordinator_cost_usd": primary_coordinator_cost,
    }


def _verification_metrics(events, landed, repo_root, cutoff=None, release=None):
    states = _task_states(events)
    known = delivered = awaiting = unknown = claimed = codex_delivered = 0
    delivered_tokens = []
    review = 0
    for land in landed:
        key = (land.get("version"), land.get("slug"))
        task_events = states.get(key, [])
        verifies = sorted((event for event in task_events if event.get("event") == "verify"),
                          key=lambda event: event.get("ts", 0))
        if any(event.get("result") == "fail" for event in verifies):
            review += 1
        latest = verifies[-1] if verifies else None
        if latest and latest.get("result") == "pass" and not latest.get("evidence_sha256"):
            claimed += 1
        starts = [event for event in task_events if event.get("event") == "start"]
        start = max(starts, key=lambda event: event.get("ts", 0)) if starts else {}
        spec = start.get("spec")
        if not isinstance(spec, str) or not SPEC_PATH_RE.fullmatch(spec):
            unknown += 1
            continue
        path = Path(repo_root) / spec
        try:
            text = path.read_text(encoding="utf-8")
        except OSError:
            unknown += 1
            continue
        known += 1
        acceptance = re.search(r"(?ms)^## Acceptance\s*\n(.*?)(?=^## |\Z)", text)
        requires_live = bool(acceptance and re.search(r"(?m)^\s*(?:-\s*)?kind:\s*live\s*$", acceptance.group(1)))
        if requires_live:
            is_live = doc_verification(text) == "live" and bool(doc_live_evidence(text))
            if latest is None or latest.get("result") != "pass" or not latest.get("evidence_sha256") or not is_live:
                awaiting += 1
                continue
            live_commit_ts = _live_status_commit_timestamp(repo_root, spec)
            if live_commit_ts is None:
                awaiting += 1
                continue
            delivered_at = max(int(latest.get("ts", 0)), live_commit_ts)
        else:
            if latest is None or latest.get("result") != "pass" or not latest.get("evidence_sha256"):
                awaiting += 1
                continue
            delivered_at = int(latest.get("ts", 0))
        if release and _normalize_version(land.get("version")) != release:
            continue
        if cutoff is not None and delivered_at < cutoff:
            continue
        delivered += 1
        if start.get("agent", "codex") != "codex":
            continue
        codex_delivered += 1
        task = _task_metrics(task_events, land)
        token_values = [event.get("tokens") for event in verifies
                        if event.get("result") == "pass" and type(event.get("tokens")) is int]
        if type(task.get("tokens")) is int:
            delivered_tokens.append(task["tokens"] + (token_values[-1] if token_values else 0))
    token_mean = (sum(delivered_tokens) / len(delivered_tokens)
                  if codex_delivered and len(delivered_tokens) == codex_delivered else None)
    return {
        "delivered": delivered,
        "delivered_tokens": token_mean,
        "awaiting": awaiting,
        "claimed": claimed,
        "unknown": unknown,
        "review": review,
    }


def _live_status_commit_timestamp(repo_root, spec):
    try:
        commits = subprocess.run(["git", "-C", str(repo_root), "log", "--format=%H %ct", "--", spec],
                                 capture_output=True, text=True, check=True).stdout.splitlines()
        last_live = None
        for row in commits:
            commit, timestamp = row.split(maxsplit=1)
            content = subprocess.run(["git", "-C", str(repo_root), "show", f"{commit}:{spec}"],
                                     capture_output=True, text=True, check=True).stdout
            if doc_verification(content) != "live":
                break
            last_live = int(timestamp)
        return last_live
    except (OSError, ValueError, subprocess.CalledProcessError):
        return None


def _run_spec_url(version, launches, launch):
    """Link the recorded start document; resumes inherit that start's spec."""
    start = next((event for event in reversed(launches)
                  if event.get("event") == "start" and
                  event.get("ts", 0) <= launch.get("ts", 0)), {})
    spec = start.get("spec")
    base = "https://github.com/wilddog64/k3d-manager"
    branch = f"k3d-manager-{version}"
    if (isinstance(spec, str) and len(spec) <= 256 and
            re.fullmatch(r"docs/(?:plans|bugs|issues)/[A-Za-z0-9_-][A-Za-z0-9._-]*\.md", spec)):
        return f"{base}/blob/{branch}/{spec}"
    return f"{base}/tree/{branch}"


def _run_outcome_metrics(events, repo_root, cutoff=None, release=None, now=None):
    now = time.time() if now is None else now
    states = _task_states(events)
    outcomes = {name: 0 for name in ("accepted", "progress", "rework", "failed", "unrecorded", "superseded", "open", "stale", "unknown")}
    rows = []
    rejected_tokens = 0
    rejected_known = False
    rejected_seen = False
    for (version, slug), task_events in states.items():
        if release and _normalize_version(version) != release:
            continue
        ordered = sorted(enumerate(task_events), key=lambda item: (item[1].get("ts", 0), item[0]))
        all_launches = [event for _, event in ordered if event.get("event") in {"start", "resume"}]
        launches = [event for event in all_launches if cutoff is None or event.get("ts", 0) >= cutoff]
        if not launches:
            continue
        exits = [event for _, event in ordered if event.get("event") in {"codex_exit", "agent_exit"}]
        land = next((event for _, event in reversed(ordered) if event.get("event") == "land"), None)
        refusals = [event for _, event in ordered if event.get("event") == "land_refused" and event.get("reason") == "tests"]
        abandon = any(event.get("event") == "abandon" for _, event in ordered)
        previous_tokens = 0
        counter_known = True
        seen_runs = set()
        task_rows = []
        for index, exit_event in enumerate(exits, 1):
            run_number = exit_event.get("run")
            if type(run_number) is not int or run_number < 1:
                run_number = index
            if run_number in seen_runs:
                continue
            seen_runs.add(run_number)
            matching_launch = next((event for event in all_launches
                                    if event.get("run", event.get("n")) == run_number), None)
            if matching_launch is None and index <= len(all_launches):
                matching_launch = all_launches[index - 1]
            if matching_launch is None:
                continue
            token_count = (exit_event.get("tokens") if exit_event.get("event") == "codex_exit"
                           and type(exit_event.get("tokens")) is int else None)
            agent_token_count = None
            if exit_event.get("event") == "agent_exit":
                usage = exit_event.get("usage")
                value = usage.get("total_tokens") if isinstance(usage, dict) else None
                if type(value) is int and value >= 0:
                    agent_token_count = value
            if exit_event.get("event") != "codex_exit":
                increment = None
            elif token_count is None or not counter_known or token_count < previous_tokens:
                increment = None
                if token_count is None or token_count < previous_tokens:
                    counter_known = False
            else:
                increment = token_count - previous_tokens
                previous_tokens = token_count
            ordered_events = [event for _, event in ordered]
            exit_index = next(i for i, event in enumerate(ordered_events) if event is exit_event)
            following = ordered_events[exit_index + 1:]
            next_event = next((event for event in following if event.get("event") in {"start", "resume"}), None)
            next_launch = next_event.get("ts", 0) if next_event else None
            between = following[:next(i for i, event in enumerate(following) if event is next_event)] if next_event else following
            intervention = next((event for event in reversed(between) if event.get("event") == "intervention"), None)
            reason = next_event.get("reason") if next_event else None
            source = "resume"
            if not reason and intervention:
                reason, source = intervention.get("reason"), "intervention"
            refusal = next((event for event in between if event in refusals), None)
            test_refusal = refusal is not None
            accepted = bool(land and land.get("test_result") == "passed" and land.get("tree")
                            and land.get("tree") == exit_event.get("tree"))
            if accepted:
                outcome, evidence = "accepted", "land-test.log"
            elif test_refusal and next_launch is not None:
                outcome, evidence = "rework", "land_refused.tests"
            elif test_refusal:
                outcome, evidence = "failed", "land_refused.tests"
            elif exit_event.get("exit") not in (None, 0):
                outcome, evidence = "failed", "codex_exit.exit"
            elif abandon and land is None:
                outcome, evidence = "failed", "abandon.event"
            elif land and (not land.get("tree") or not land.get("test_result")):
                outcome, evidence = "unrecorded", "none"
            elif next_launch is not None:
                if exit_event.get("exit") == 0 and reason == "correction":
                    outcome, evidence = "rework", f"{source}.correction"
                elif exit_event.get("exit") == 0 and reason in {"continue_prompt", "clarification"}:
                    outcome, evidence = "progress", f"{source}.{reason}"
                else:
                    outcome, evidence = "superseded", "none"
            elif land is None and not abandon:
                outcome = "open" if ordered[-1][1].get("ts", 0) > now - 7 * 86400 else "stale"
                evidence = "none"
            else:
                outcome, evidence = "unknown", "none"
            if matching_launch not in launches:
                continue
            evidence_summary, evidence_path = _evidence_details(version, slug, evidence, land if accepted else refusal)
            if evidence == "codex_exit.exit":
                evidence_summary = f"exit {exit_event.get('exit', 'unknown')}; {evidence_summary}"
            outcomes[outcome] += 1
            task_rows.append({"run": run_number, "outcome": outcome, "tokens": increment,
                              "agent_tokens": increment if exit_event.get("event") == "codex_exit" else agent_token_count,
                              "evidence": evidence, "evidence_summary": evidence_summary,
                              "evidence_path": evidence_path,
                              "spec_url": _run_spec_url(version, all_launches, matching_launch),
                              "loki_url": (f"/d/k3dm-agent-run-log?var-version={version}&var-slug={slug}"
                                           f"&var-run={run_number}&from=now-30d&to=now"
                                           if evidence in {"land-test.log", "land_refused.tests"} else None)})
            if outcome in {"rework", "failed"} and evidence in {"land_refused.tests", "codex_exit.exit"}:
                rejected_seen = True
                if increment is not None:
                    rejected_tokens += increment
                    rejected_known = True
        repo = next((item.get("repo") for item in task_events if item.get("event") == "start"), "k3d-manager")
        if not isinstance(repo, str) or not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", repo):
            repo = "k3d-manager"
        rows.append((version, slug, repo, task_rows))
    bug_cost, bug_first_pass = _direct_bug_costs(states, repo_root, release, cutoff)
    run_total = sum(outcomes.values())
    return {
        "outcomes": outcomes,
        "coverage": sum(count for name, count in outcomes.items() if name in {"accepted", "progress", "rework", "failed"}) / run_total if run_total else None,
        "rejected_tokens": (rejected_tokens if rejected_known else 0 if run_total and not rejected_seen else None),
        "bug_cost": bug_cost,
        "bug_first_pass": bug_first_pass,
        "rows": rows,
    }


def _direct_bug_costs(states, repo_root, release=None, cutoff=None):
    attempts = defaultdict(list)
    verifications = defaultdict(list)
    closures = {}
    for (version, _), task_events in states.items():
        if release and _normalize_version(version) != release:
            continue
        starts = [event for event in task_events if event.get("event") == "start"]
        spec = next((event.get("spec") for event in reversed(starts) if event.get("spec")), None)
        if not isinstance(spec, str) or not spec.startswith("docs/bugs/") or not SPEC_PATH_RE.fullmatch(spec):
            continue
        try:
            text = (Path(repo_root) / spec).read_text(encoding="utf-8")
        except OSError:
            continue
        if doc_verification(text) != "live" or not doc_live_evidence(text):
            continue
        exits = sorted((event for event in task_events if event.get("event") == "codex_exit"),
                       key=lambda event: event.get("ts", 0))
        previous = 0
        known = True
        total = 0
        seen = set()
        for index, event in enumerate(exits, 1):
            run_number = event.get("run") if type(event.get("run")) is int else index
            if run_number in seen:
                continue
            seen.add(run_number)
            value = event.get("tokens") if type(event.get("tokens")) is int else None
            if value is None or value < previous or not known:
                known = False
                continue
            total += value - previous
            previous = value
        attempts[spec].append(total if known and exits else None)
        task_verifications = [event for event in task_events if event.get("event") == "verify"
                              and event.get("result") in {"pass", "fail"}]
        verifications[spec].extend(task_verifications)
        if (any(event.get("event") == "land" and event.get("test_result") == "passed" for event in task_events)
                and any(event.get("result") == "pass" and event.get("evidence_sha256") for event in task_verifications)):
            closure_ts = max([event.get("ts", 0) for event in task_verifications if event.get("result") == "pass" and event.get("evidence_sha256")])
            closures[spec] = max(closures.get(spec, 0), closure_ts)
    costs = []
    first_pass = {"pass": 0, "fail": 0}
    for spec, closure_ts in closures.items():
        live_ts = _live_status_commit_timestamp(repo_root, spec)
        if live_ts is None:
            continue
        delivery_ts = max(closure_ts, live_ts)
        if cutoff is not None and delivery_ts < cutoff:
            continue
        values = attempts.get(spec, [])
        if values and all(type(value) is int for value in values):
            costs.append(sum(values))
        ordered = sorted(verifications.get(spec, []), key=lambda event: event.get("ts", 0))
        first = next((event.get("result") for event in ordered), None)
        if first in first_pass:
            first_pass[first] += 1
    return (sum(costs) / len(costs) if costs else None), first_pass


def _scope_metrics(events, selected, landed_selected, prices=None, cutoff=None, release=None,
                   verification_landed=None, repo_root=None, now=None):
    attempts = {result: 0 for result in RESULTS}
    for event in selected:
        if event.get("event") == "land":
            attempts["landed"] += 1
        elif event.get("event") == "land_refused" and event.get("reason") in attempts:
            attempts[event["reason"]] += 1
    landed = {}
    for event in landed_selected:
        key = (event.get("version"), event.get("slug"))
        if key not in landed or event["ts"] >= landed[key]["ts"]:
            landed[key] = event

    states = _task_states(events)
    token_values = []
    verifier_values = []
    wait_values = []
    elapsed_values = []
    codex_values = []
    post_exit_land_values = []
    verification = _verification_metrics(events, verification_landed if verification_landed is not None else landed_selected,
                                         repo_root or _repo_root(), cutoff, release)
    run_outcomes = _run_outcome_metrics(events, repo_root or _repo_root(), cutoff, release, now)
    rework = {cause: 0 for cause in REWORK_CAUSES}
    tasks = []
    for key, event in landed.items():
        task = _task_metrics(states[key], event, prices)
        causes = {
            "rerun": task["runs"] > 1,
            "tests": any(item.get("event") == "land_refused" and item.get("reason") == "tests"
                         and item["ts"] <= event["ts"] for item in states[key]),
            "claude_edit": isinstance(event.get("verifier_lines"), (int, float))
            and event["verifier_lines"] > 0,
            "review": any(item.get("event") == "verify" and item.get("result") == "fail"
                          for item in states[key]),
        }
        causes["any"] = any(causes.values())
        for cause, hit in causes.items():
            rework[cause] += int(hit)
        if task["tokens"] is not None:
            token_values.append(task["tokens"])
        if isinstance(event.get("verifier_lines"), (int, float)):
            verifier_values.append(event["verifier_lines"])
        if isinstance(event.get("wait_seconds"), (int, float)):
            wait_values.append(event["wait_seconds"] / 60)
        if task["elapsed_seconds"] is not None:
            elapsed_values.append(task["elapsed_seconds"] / 60)
        if task["post_exit_land_seconds"] is not None:
            post_exit_land_values.append(task["post_exit_land_seconds"] / 60)
        if task["runs"]:
            codex_values.append(task["codex_seconds"] / 60)
        repo = next((item.get("repo") for item in states[key] if item.get("event") == "start"), "k3d-manager")
        if not isinstance(repo, str) or not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", repo):
            repo = "k3d-manager"
        tasks.append((event["ts"], key[0], key[1], task["tokens"], task["codex_seconds"],
                      task["elapsed_seconds"], task["runs"], task["api_cost_usd"], task["spec"], task["agent"],
                      task["agent_tokens"], task["agent_seconds"], repo,
                      task["worker_identity"], task["coordinator_identity"], task["post_exit_land_seconds"],
                      task["worker_runtime_identities"], task["primary_coordinator_identity"],
                      task["acting_coordinator_identity"], task["landing_identity"], task["landing_actor"],
                      task["handoff_count"], task["handoff_reason"], task["primary_coordinator_cost_usd"]))

    return {
        "landed": len(landed),
        "attempts": attempts,
        "tokens": sum(token_values) / len(token_values) if token_values else 0,
        "verifier": sum(verifier_values) / len(verifier_values) if verifier_values else 0,
        "wait": sum(wait_values) / len(wait_values) if wait_values else None,
        "elapsed": sum(elapsed_values) / len(elapsed_values) if elapsed_values else None,
        "post_exit_land": sum(post_exit_land_values) / len(post_exit_land_values) if post_exit_land_values else None,
        "codex_minutes": sum(codex_values) / len(codex_values) if codex_values else None,
        "rework": rework,
        "verification": verification,
        "run_outcomes": run_outcomes,
        "rework_ratio": rework["any"] / len(landed) if landed else None,
        "tasks": tasks,
        "handoff_reasons": {reason: sum(1 for item in selected if item.get("event") == "handoff"
                                         and item.get("handoff_reason") == reason)
                            for reason in ("quota_exhausted", "manual", "unavailable", "scheduled", "other", "unknown")},
    }


def _window_metrics(events, now, seconds, prices=None, repo_root=None):
    cutoff = now - seconds
    selected = [event for event in events if event["ts"] >= cutoff]
    latest_lands = {}
    for event in events:
        if event.get("event") != "land":
            continue
        key = (event.get("version"), event.get("slug"))
        if key not in latest_lands or event["ts"] >= latest_lands[key]["ts"]:
            latest_lands[key] = event
    landed_selected = [event for event in latest_lands.values() if event["ts"] >= cutoff]
    return _scope_metrics(events, selected, landed_selected, prices, cutoff=cutoff,
                          verification_landed=list(latest_lands.values()), repo_root=repo_root, now=now)


def _normalize_version(value):
    if not isinstance(value, str) or not VERSION_RE.fullmatch(value):
        return None
    return "v" + value.lstrip("v")


def _window_order(window):
    if window in WINDOWS:
        return {"1d": 3, "7d": 2, "30d": 1}[window]
    version = _normalize_version(window)
    if version is None:
        return None
    major, minor, patch = (int(part) for part in version[1:].split("."))
    return major * 1_000_000 + minor * 1_000 + patch


def _releases(events):
    releases = {_normalize_version(event.get("version")) for event in events
                if event.get("event") == "start"}
    releases.discard(None)
    return sorted(releases, key=lambda version: tuple(int(part) for part in version[1:].split(".")))


def _release_metrics(events, release, prices=None, repo_root=None, now=None):
    selected = [event for event in events
                if _normalize_version(event.get("version")) == release
                and event.get("event") in {"land", "land_refused"}]
    landed = [event for event in events
              if _normalize_version(event.get("version")) == release and event.get("event") == "land"]
    latest_lands = {}
    for event in landed:
        key = (release, event.get("slug"))
        if key not in latest_lands or event["ts"] >= latest_lands[key]["ts"]:
            latest_lands[key] = event
    return _scope_metrics(events, selected, list(latest_lands.values()), prices, release=release,
                          repo_root=repo_root, now=now)


def _render_release_duration(lines, window, events):
    scoped = [event for event in events if _normalize_version(event.get("version")) == window]
    lands = [event for event in scoped if event.get("event") == "land"]
    if not lands:
        return
    starts_by_slug = defaultdict(list)
    lands_by_slug = defaultdict(list)
    for event in scoped:
        slug = event.get("slug")
        if not isinstance(slug, str) or slug == "release":
            continue
        if event.get("event") == "start" and isinstance(event.get("ts"), (int, float)):
            starts_by_slug[slug].append(event["ts"])
        elif event.get("event") == "land" and isinstance(event.get("ts"), (int, float)):
            lands_by_slug[slug].append(event["ts"])
    starts = [ts for values in starts_by_slug.values() for ts in values]
    all_lands = [ts for values in lands_by_slug.values() for ts in values]
    if not starts or not all_lands:
        return
    merged_events = [event for event in scoped if event.get("event") == "release_merged"
                     and isinstance(event.get("merged_at"), (int, float))]
    if merged_events:
        end_ts = merged_events[-1]["merged_at"]
        end_label = "merge"
    else:
        end_ts = max(all_lands)
        end_label = "last_land"
    lines.append(f'k3dm_dispatch_release_span_minutes{{window="{window}",end="{end_label}"}} '
                 f'{(end_ts - min(starts)) / 60:g}')
    intervals = sorted((min(starts_by_slug[slug]), max(task_lands))
                       for slug, task_lands in lands_by_slug.items()
                       if starts_by_slug.get(slug))
    merged_seconds = 0
    current_start = current_end = None
    for start, end in intervals:
        if current_start is None:
            current_start, current_end = start, end
        elif start <= current_end:
            current_end = max(current_end, end)
        else:
            merged_seconds += current_end - current_start
            current_start, current_end = start, end
    if current_start is not None:
        merged_seconds += current_end - current_start
    lines.append(f'k3dm_dispatch_release_active_minutes{{window="{window}"}} {merged_seconds / 60:g}')


def _render_scope(lines, window, metrics, events=None, prices=None, coverage=None, time_scope=False, now=None,
                  claude_records=None, claude_prices=None, cutoff=None):
    verification = metrics["verification"]
    lines.append(f'k3dm_dispatch_delivered{{window="{window}"}} {verification["delivered"]}')
    if verification["delivered_tokens"] is not None:
        lines.append(f'k3dm_dispatch_codex_tokens_per_delivered{{window="{window}"}} {verification["delivered_tokens"]}')
    lines.append(f'k3dm_dispatch_awaiting_verification{{window="{window}"}} {verification["awaiting"]}')
    lines.append(f'k3dm_dispatch_verification_claimed{{window="{window}"}} {verification["claimed"]}')
    lines.append(f'k3dm_dispatch_verification_unknown{{window="{window}"}} {verification["unknown"]}')
    run_metrics = metrics["run_outcomes"]
    for outcome, count in run_metrics["outcomes"].items():
        lines.append(f'k3dm_dispatch_run_outcomes{{window="{window}",outcome="{outcome}"}} {count}')
    if run_metrics["coverage"] is not None:
        lines.append(f'k3dm_dispatch_run_outcome_coverage{{window="{window}"}} {run_metrics["coverage"]}')
    if run_metrics["rejected_tokens"] is not None:
        lines.append(f'k3dm_dispatch_objectively_rejected_codex_tokens{{window="{window}"}} {run_metrics["rejected_tokens"]}')
    if run_metrics["bug_cost"] is not None:
        lines.append(f'k3dm_dispatch_codex_tokens_per_live_verified_bug{{window="{window}"}} {run_metrics["bug_cost"]}')
    for result, count in run_metrics["bug_first_pass"].items():
        lines.append(f'k3dm_dispatch_live_verified_bug_first_pass{{window="{window}",result="{result}"}} {count}')
    run_rows = []
    for version, slug, repo, rows in run_metrics["rows"]:
        if isinstance(version, str) and VERSION_RE.fullmatch(version) and isinstance(slug, str) and SLUG_RE.fullmatch(slug):
            run_rows.extend((version, slug, repo, row) for row in rows)
    skipped_runs = max(0, len(run_rows) - TASK_CAP * RUN_CAP)
    for version, slug, repo, row in run_rows[:TASK_CAP * RUN_CAP]:
        if type(row["run"]) is not int or row["run"] < 1 or row["run"] > RUN_CAP:
            continue
        labels = f'window="{window}",version="{version}",slug="{slug}",run="{row["run"]}",repo="{repo}"'
        evidence_summary = _label_value(row.get("evidence_summary", "unknown"))
        evidence_path = _label_value(row.get("evidence_path", ""), limit=512)
        loki_url = row.get("loki_url")
        spec_url = _label_value(row["spec_url"], limit=512)
        loki_label = f',loki_url="{_label_value(loki_url, limit=512)}"' if isinstance(loki_url, str) and loki_url else ""
        lines.append(f'k3dm_dispatch_task_run_outcome{{{labels},outcome="{row["outcome"]}",evidence="{row["evidence"]}",evidence_summary="{evidence_summary}",evidence_path="{evidence_path}",spec_url="{spec_url}"{loki_label}}} 1')
        if type(row["tokens"]) is int:
            lines.append(f'k3dm_dispatch_task_run_codex_tokens{{{labels}}} {row["tokens"]}')
        if type(row.get("agent_tokens")) is int:
            lines.append(f'k3dm_dispatch_task_run_agent_tokens{{{labels}}} {row["agent_tokens"]}')
    lines.append(f'k3dm_dispatch_task_run_skipped{{window="{window}"}} {skipped_runs}')
    lines.append(f'k3dm_dispatch_landed{{window="{window}"}} {metrics["landed"]}')
    lines.append(f'k3dm_dispatch_window_order{{window="{window}"}} {_window_order(window)}')
    for result in RESULTS:
        lines.append(f'k3dm_dispatch_land_attempts{{window="{window}",result="{result}"}} '
                     f'{metrics["attempts"][result]}')
    lines.append(f'k3dm_dispatch_codex_tokens_per_landed{{window="{window}"}} '
                 f'{metrics["tokens"]}')
    lines.append(f'k3dm_dispatch_verifier_lines_per_landed{{window="{window}"}} '
                 f'{metrics["verifier"]}')
    if metrics["wait"] is not None:
        lines.append(f'k3dm_dispatch_wait_minutes_per_landed{{window="{window}"}} '
                     f'{metrics["wait"]}')
    if metrics["elapsed"] is not None:
        lines.append(f'k3dm_dispatch_elapsed_minutes_per_landed{{window="{window}"}} '
                     f'{metrics["elapsed"]}')
    if metrics["post_exit_land"] is not None:
        lines.append(f'k3dm_dispatch_post_exit_land_minutes_per_landed{{window="{window}"}} '
                     f'{metrics["post_exit_land"]}')
    source_events = events or []
    if time_scope:
        scoped = [event for event in source_events if cutoff is None or event.get("ts", 0) >= cutoff]
    else:
        scoped = [event for event in source_events if _normalize_version(event.get("version")) == window]
        _render_release_duration(lines, window, scoped)
    complexity = {}
    complexity_events = source_events if time_scope else scoped
    for task_events in _task_states(complexity_events).values():
        starts = [event for event in task_events if event.get("event") == "start"]
        lands = [event for event in task_events if event.get("event") == "land"]
        if time_scope and not any(cutoff is None or land.get("ts", 0) >= cutoff for land in lands):
            continue
        if not time_scope and not lands:
            continue
        if not starts or not lands:
            continue
        start = max(starts, key=lambda event: event.get("ts", 0))
        land = max(lands, key=lambda event: event.get("ts", 0))
        key = (land.get("version"), land.get("slug"))
        if not isinstance(key[0], str) or not VERSION_RE.fullmatch(key[0]) or not isinstance(key[1], str) or not SLUG_RE.fullmatch(key[1]):
            continue
        complexity[key] = (start.get("spec_stats"), land.get("change"))
    measured_specs = []
    measured_acceptance = []
    measured_changes = []
    shown_complexity = []
    shown_task_keys = {(task[1], task[2]) for task in sorted(metrics["tasks"], key=lambda item: item[0], reverse=True)[:TASK_CAP]}
    for (version, slug), (spec_stats, change) in sorted(complexity.items(), key=lambda item: item[0], reverse=True):
        repo = next((event.get("repo") for event in scoped if event.get("slug") == slug and event.get("version") == version and event.get("event") == "land"), "k3d-manager")
        repo = repo if isinstance(repo, str) and re.fullmatch(r"[A-Za-z0-9._-]{1,64}", repo) else "k3d-manager"
        labels = f'window="{window}",version="{version}",slug="{slug}",repo="{repo}"'
        if isinstance(spec_stats, dict):
            files, must, must_not = spec_stats.get("files"), spec_stats.get("must"), spec_stats.get("must_not")
            if type(files) is int and files >= 0:
                measured_specs.append(spec_stats)
            if (version, slug) in shown_task_keys and type(files) is int and files >= 0:
                lines.append(f'k3dm_dispatch_task_spec_files{{{labels}}} {files}')
            if type(must) is int and must >= 0 and type(must_not) is int and must_not >= 0:
                measured_acceptance.append(must + must_not)
                if (version, slug) in shown_task_keys:
                    lines.append(f'k3dm_dispatch_task_spec_acceptance_items{{{labels}}} {must + must_not}')
        if isinstance(change, dict) and type(change.get("files")) is int and change["files"] >= 0:
            values = {kind: change.get(kind) for kind in ("code", "tests", "docs")}
            if all(type(value) is int and value >= 0 for value in values.values()):
                measured_changes.append((change["files"], values))
                shown_complexity.append((change["files"], values))
                if (version, slug) in shown_task_keys:
                    lines.append(f'k3dm_dispatch_task_change_files{{{labels}}} {change["files"]}')
                    for kind, value in values.items():
                        lines.append(f'k3dm_dispatch_task_change_lines{{{labels},kind="{kind}"}} {value}')
    lines.append(f'k3dm_dispatch_complexity_measured_tasks{{window="{window}",measure="spec"}} {len(measured_specs)}')
    lines.append(f'k3dm_dispatch_complexity_measured_tasks{{window="{window}",measure="change"}} {len(measured_changes)}')
    if measured_acceptance:
        lines.append(f'k3dm_dispatch_spec_acceptance_items_total{{window="{window}"}} {sum(measured_acceptance)}')
    if measured_changes:
        for kind in ("code", "tests", "docs"):
            lines.append(f'k3dm_dispatch_change_lines_total{{window="{window}",kind="{kind}"}} {sum(item[1][kind] for item in measured_changes)}')
        lines.append(f'k3dm_dispatch_change_files_total{{window="{window}"}} {sum(item[0] for item in measured_changes)}')
        totals = sorted(sum(item[1].values()) for item in measured_changes)
        mid = len(totals) // 2
        median = totals[mid] if len(totals) % 2 else (totals[mid - 1] + totals[mid]) / 2
        lines.append(f'k3dm_dispatch_change_lines_median{{window="{window}"}} {median:g}')
    markers = [event for event in source_events if event.get("event") == "intervention_coverage_start"]
    if markers:
        marker_ts = min(event["ts"] for event in markers)
        tracked = {(event.get("version"), event.get("slug")) for event in scoped
                   if event.get("event") in {"start", "intervention"}
                   and event.get("ts", 0) >= marker_ts}
        lines.append(f'k3dm_dispatch_intervention_tracking_tasks{{window="{window}"}} {len(tracked)}')
        interventions = [event for event in scoped if event.get("event") == "intervention"
                         and event.get("reason") in {"continue_prompt", "clarification", "correction", "other"}]
        for reason in ("continue_prompt", "clarification", "correction", "other"):
            count = sum(1 for event in interventions if event.get("reason") == reason)
            lines.append(f'k3dm_dispatch_human_continuation_prompts{{window="{window}",reason="{reason}"}} {count}')
    if metrics["codex_minutes"] is not None:
        lines.append(f'k3dm_dispatch_codex_minutes_per_landed{{window="{window}"}} '
                     f'{metrics["codex_minutes"]}')
    for cause in REWORK_CAUSES:
        lines.append(f'k3dm_dispatch_rework_landed{{window="{window}",cause="{cause}"}} '
                     f'{metrics["rework"][cause]}')
    if metrics["rework_ratio"] is not None:
        lines.append(f'k3dm_dispatch_rework_ratio{{window="{window}"}} '
                     f'{metrics["rework_ratio"]}')
    for reason, count in metrics["handoff_reasons"].items():
        lines.append(f'k3dm_dispatch_handoffs{{window="{window}",reason="{reason}"}} {count}')
    valid_tasks = []
    skipped = 0
    for task in sorted(metrics["tasks"], key=lambda item: item[0], reverse=True):
        _, version, slug, *_ = task
        if not (isinstance(version, str) and VERSION_RE.fullmatch(version)
                and isinstance(slug, str) and SLUG_RE.fullmatch(slug)):
            skipped += 1
            continue
        valid_tasks.append(task)
    for (_, version, slug, tokens, codex_seconds, elapsed_seconds, runs, api_cost, spec, agent,
         agent_tokens, agent_seconds, repo, worker_identity, coordinator_identity, post_exit_land,
         worker_runtime_identities, primary_identity, acting_identity, landing_identity,
         landing_actor, handoff_count, handoff_reason, primary_coordinator_cost) in valid_tasks[:TASK_CAP]:
        labels = f'window="{window}",version="{version}",slug="{slug}",agent="{agent}",repo="{repo}"'
        emitted_identity_labels = set()
        def identity_labels(identity, role):
            raw_source = identity.get("source")
            source = raw_source if isinstance(raw_source, str) and raw_source in {"explicit", "default", "inherited", "runtime", "runtime-reported", "unreported", "declared", "unknown"} else "unreported"
            if source == "runtime-reported":
                source = "runtime"
            raw_vendor = identity.get("vendor")
            vendor = raw_vendor if isinstance(raw_vendor, str) and raw_vendor in {"openai", "google", "anthropic", "other", "unknown"} else "unknown"
            model = identity.get("model")
            if not isinstance(model, str) or not re.fullmatch(r"[A-Za-z0-9._:-]{1,64}", model):
                model = "unknown"
            elif model != "unknown" and model not in MODEL_IDENTITY_ALLOWLIST:
                model = "other"
            raw_status = identity.get("status")
            status = raw_status if isinstance(raw_status, str) and raw_status in {"selected", "runtime_reported", "reported", "unverified", "unknown", "declared"} else "unknown"
            display = "unknown" if vendor == "unknown" else (
                f"{vendor}/model not recorded ({status})" if model == "unknown" else f"{vendor}/{model} ({status})")
            if role == "worker" and worker_runtime_identities:
                runtime_models = list(dict.fromkeys(
                    item["model"] for item in worker_runtime_identities
                    if isinstance(item.get("model"), str)
                    and re.fullmatch(r"[A-Za-z0-9._:-]{1,64}", item["model"])))
                if runtime_models:
                    display = " → ".join(runtime_models)
            identity_labels_tuple = (role, vendor, model, source, status, display)
            if identity_labels_tuple in emitted_identity_labels:
                return
            emitted_identity_labels.add(identity_labels_tuple)
            lines.append(f'k3dm_dispatch_model_identity{{{labels},role="{role}",vendor="{vendor}",model="{model}",source="{source}",status="{status}",display="{display}"}} 1')
        identity_labels(worker_identity, "worker")
        for reported_identity in worker_runtime_identities:
            if reported_identity != worker_identity:
                identity_labels(reported_identity, "worker_history")
        identity_labels(coordinator_identity, "coordinator")
        identity_labels(primary_identity, "primary_coordinator")
        identity_labels(acting_identity, "acting_coordinator")
        identity_labels(landing_identity, "landing_actor")
        landing_actor = landing_actor if landing_actor in {"human", "claude", "codex", "other_agent", "unknown"} else "unknown"
        lines.append(f'k3dm_dispatch_task_landing_actor{{{labels},actor="{landing_actor}"}} 1')
        lines.append(f'k3dm_dispatch_task_handoff_count{{{labels}}} {handoff_count}')
        if handoff_count:
            safe_reason = handoff_reason if handoff_reason in {"quota_exhausted", "manual", "unavailable", "scheduled", "other", "unknown"} else "unknown"
            lines.append(f'k3dm_dispatch_task_handoff_reason{{{labels},reason="{safe_reason}"}} 1')
        cost_state = "measured" if primary_coordinator_cost is not None else "not measured"
        lines.append(f'k3dm_dispatch_task_primary_coordinator_cost_state{{{labels},state="{cost_state}"}} 1')
        if primary_coordinator_cost is not None:
            lines.append(f'k3dm_dispatch_task_primary_coordinator_cost_usd{{{labels}}} {primary_coordinator_cost}')
        if isinstance(spec, str) and SPEC_PATH_RE.fullmatch(spec):
            lines.append(f'k3dm_dispatch_task_spec{{{labels},spec="{spec}"}} 1')
        if agent == "codex" and tokens is not None:
            lines.append(f"k3dm_dispatch_task_codex_tokens{{{labels}}} {tokens}")
        if agent == "codex" and runs:
            lines.append(f"k3dm_dispatch_task_codex_seconds{{{labels}}} {codex_seconds}")
        if agent_tokens is not None:
            lines.append(f"k3dm_dispatch_task_agent_tokens{{{labels}}} {agent_tokens}")
        if runs:
            lines.append(f"k3dm_dispatch_task_agent_seconds{{{labels}}} {agent_seconds}")
        if elapsed_seconds is not None:
            lines.append(f"k3dm_dispatch_task_elapsed_seconds{{{labels}}} {elapsed_seconds}")
        if post_exit_land is not None:
            gap_labels = f'window="{window}",version="{version}",slug="{slug}",repo="{repo}"'
            lines.append(f"k3dm_dispatch_task_post_exit_land_seconds{{{gap_labels}}} {post_exit_land}")
        if agent == "codex" and runs:
            lines.append(f"k3dm_dispatch_task_runs{{{labels}}} {runs}")
        if runs:
            lines.append(f"k3dm_dispatch_task_agent_runs{{{labels}}} {runs}")
        if api_cost is not None:
            lines.append(f"k3dm_dispatch_task_api_cost_usd{{{labels}}} {api_cost}")
    lines.append(f'k3dm_dispatch_task_skipped{{window="{window}"}} {skipped}')
    truncated = int(len(valid_tasks) > TASK_CAP)
    lines.append(f'k3dm_dispatch_task_truncated{{window="{window}"}} {truncated}')
    usage = _session_records(events or [])
    now = time.time() if now is None else now
    if time_scope:
        session_starts = {item["session"]: _timestamp(item["start"])
                          for item in coverage or []}
        usage = {key: records for key, records in usage.items()
                 if key in session_starts and session_starts[key] >= now - WINDOWS[window]}
    else:
        usage = {key: selected for key, records in usage.items()
                 if (selected := [item for item in records if item.get("version") == window])}
    agy_records = _agy_run_usage(events or [])
    if time_scope:
        agy_records = [item for item in agy_records
                       if _timestamp(item.get("ts")) >= now - WINDOWS[window]]
    else:
        agy_records = [item for item in agy_records if item.get("version") == window]
    for item in agy_records:
        usage[item["session"]] = [item]
    _render_cost(lines, window, usage, metrics["landed"], prices or {})
    if time_scope and coverage is not None:
        in_window = [item for item in coverage if _timestamp(item["start"]) >= now - WINDOWS[window]]
        ledgered = {item.get("session") for item in events if item.get("event") == "codex_usage"}
        ledgered_starts = [session_starts[session] for session in ledgered if session in session_starts]
        observed_days = min(WINDOWS[window] / 86400,
                            max(0, (now - min(ledgered_starts)) / 86400)) if ledgered_starts else 0
        lines.append(f'k3dm_dispatch_api_cost_observed_days{{window="{window}"}} {observed_days:.2f}')
        lines.append(f'k3dm_dispatch_codex_sessions{{window="{window}",ledgered="true"}} '
                     f'{sum(item["session"] in ledgered for item in in_window)}')
        lines.append(f'k3dm_dispatch_codex_sessions{{window="{window}",ledgered="false"}} '
                     f'{sum(item["session"] not in ledgered for item in in_window)}')
        unledgered = [item for item in in_window if item["session"] not in ledgered]
        cost = sum(_cost(_coverage_event(item), prices or {}) or 0 for item in unledgered)
        lines.append(f'k3dm_dispatch_unledgered_api_cost_usd{{window="{window}"}} {cost}')
        _render_cost_attribution(lines, window, in_window, coverage, ledgered, prices)
    if claude_records is not None:
        all_tasks = []
        scoped_tasks = []
        scoped_keys = {(task[1], task[2]) for task in metrics["tasks"]}
        for key, task_events in _task_states(events or []).items():
            starts = [e["ts"] for e in task_events if e.get("event") == "start"]
            lands = [e["ts"] for e in task_events if e.get("event") == "land"]
            if starts and lands:
                task_version = _normalize_version(key[0]) if not time_scope else key[0]
                task_repo = next((e.get("repo") for e in task_events if e.get("event") == "start"), "k3d-manager")
                if not isinstance(task_repo, str) or not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", task_repo):
                    task_repo = "k3d-manager"
                interval = (min(starts), max(lands), task_version or key[0], key[1], task_repo)
                all_tasks.append(interval)
                normalized_key = (_normalize_version(key[0]) or key[0], key[1])
                if key in scoped_keys or normalized_key in scoped_keys:
                    scoped_tasks.append(interval)
        shown_keys = set()
        for task in valid_tasks[:TASK_CAP]:
            shown_keys.add((task[1], task[2]))
            shown_keys.add((_normalize_version(task[1]) or task[1], task[2]))
        _render_claude(lines, window, claude_records, claude_prices or {}, metrics["landed"], now,
                       cutoff=cutoff, tasks=scoped_tasks, all_tasks=all_tasks,
                       time_scope=time_scope, shown_keys=shown_keys)


def _timestamp(value):
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        return float(value)
    try:
        from datetime import datetime
        return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except (ValueError, TypeError, AttributeError):
        return 0


def _coverage_event(item):
    usage = item.get("usage") or {}
    return {"model": item.get("model"), "input": usage.get("input_tokens"),
            "cached_input": usage.get("cached_input_tokens"), "output": usage.get("output_tokens")}


def _render_cost(lines, window, usage, landed, prices):
    total = cached = 0
    total_cost = 0
    unpriced_sessions = set()
    by_model, tokens_by_model = defaultdict(float), defaultdict(lambda: defaultdict(int))
    for item in (record for records in usage.values() for record in records):
        model = item.get("model") or "unknown"
        inp, cache, output = (int(item.get(k, 0) or 0) for k in ("input", "cached_input", "output"))
        if not item.get("agy_usage"):
            total += inp
            cached += cache
            tokens_by_model[model]["uncached_input"] += inp - cache
            tokens_by_model[model]["cached_input"] += cache
            tokens_by_model[model]["output"] += output
        amount = _agy_cost(item, prices) if item.get("agy_usage") else _cost(item, prices)
        if amount is None:
            unpriced_sessions.add(item.get("session"))
        else:
            total_cost += amount
            by_model[model] += amount
    lines.append(f'k3dm_dispatch_api_cost_usd{{window="{window}"}} {total_cost}')
    if landed:
        lines.append(f'k3dm_dispatch_api_cost_per_landed_usd{{window="{window}"}} {total_cost / landed}')
    for model, amount in by_model.items():
        lines.append(f'k3dm_dispatch_api_cost_by_model_usd{{window="{window}",model="{model}"}} {amount}')
    for model, kinds in tokens_by_model.items():
        for kind, value in kinds.items():
            lines.append(f'k3dm_dispatch_codex_tokens_by_model{{window="{window}",model="{model}",kind="{kind}"}} {value}')
    if total:
        lines.append(f'k3dm_dispatch_cached_input_ratio{{window="{window}"}} {cached / total}')
    lines.append(f'k3dm_dispatch_api_cost_unpriced_sessions{{window="{window}"}} {len(unpriced_sessions)}')


def _render_cost_attribution(lines, window, in_window, all_scanned_list, ledgered, prices):
    categories = ("dispatch", "dispatch_unrecorded", "guardian", "interactive", "exec_untracked", "other")
    session_counts = {c: 0 for c in categories}
    category_costs = {c: 0.0 for c in ("dispatch", "dispatch_unrecorded", "interactive", "exec_untracked", "other")}
    guardian_missing_cost = 0.0
    has_missing_guardian = False
    unpriced_tokens = defaultdict(lambda: {"input": 0, "cached_input": 0, "output": 0})

    all_scanned = {item["session"]: item for item in (all_scanned_list or []) if item.get("session")}

    for item in in_window:
        cat = _classify_session(item, ledgered)
        session_counts[cat] += 1

        usage = item.get("usage") or {}
        inp = int(usage.get("input_tokens") or 0)
        cached = int(usage.get("cached_input_tokens") or 0)
        out = int(usage.get("output_tokens") or 0)
        model = item.get("model")
        if not isinstance(model, str) or not re.fullmatch(r"[A-Za-z0-9._:-]{1,64}", model):
            model = "unknown"

        rates = (prices or {}).get(model)
        if isinstance(rates, dict):
            cost = _cost({"model": model, "input": inp, "cached_input": cached, "output": out}, prices or {}) or 0.0
        else:
            cost = 0.0
            if inp or cached or out:
                unpriced_tokens[model]["input"] += inp
                unpriced_tokens[model]["cached_input"] += cached
                unpriced_tokens[model]["output"] += out

        if cat != "guardian":
            category_costs[cat] += cost
        else:
            parent_id = item.get("parent_thread_id")
            parent = all_scanned.get(parent_id) if parent_id else None
            if parent is None or parent.get("thread_source") == "guardian_review":
                has_missing_guardian = True
                guardian_missing_cost += cost
            else:
                parent_cat = _classify_session(parent, ledgered)
                category_costs[parent_cat] += cost

    def _fmt_cost(val):
        rounded = round(val, 6)
        if abs(rounded) < 1e-9:
            return "0"
        return f"{rounded:g}"

    for cat in categories:
        lines.append(f'k3dm_codex_sessions{{window="{window}",category="{cat}"}} {session_counts[cat]}')

    for cat in ("dispatch", "dispatch_unrecorded", "interactive", "exec_untracked", "other"):
        lines.append(f'k3dm_codex_api_cost_usd{{window="{window}",category="{cat}"}} {_fmt_cost(category_costs[cat])}')
    if has_missing_guardian or guardian_missing_cost > 0:
        lines.append(f'k3dm_codex_api_cost_usd{{window="{window}",category="guardian",parent="missing"}} {_fmt_cost(guardian_missing_cost)}')

    for model, kinds in sorted(unpriced_tokens.items()):
        for kind in ("input", "cached_input", "output"):
            lines.append(f'k3dm_codex_unpriced_tokens{{window="{window}",model="{model}",kind="{kind}"}} {kinds[kind]}')


def _activity_metrics(lines, events, files, now, prices):
    associated = {e.get("session") for e in events if e.get("event") == "codex_usage"}
    counts = defaultdict(int)
    for row in files:
        if _timestamp(row.get("start")) >= now - WINDOWS["30d"]:
            counts[row["repo"]] += 1
    top = {name for name, _ in sorted(counts.items(), key=lambda pair: (-pair[1], pair[0]))[:10]}
    rows = [{**row, "repo": row["repo"] if row["repo"] in top else "other"} for row in files]
    for window, seconds in WINDOWS.items():
        selected = [r for r in rows if now-seconds <= _timestamp(r.get("start")) <= now]
        grouped = defaultdict(list)
        for row in selected:
            grouped[(row["mode"], row["repo"])].append(row)
        by_mode = defaultdict(list)
        for (mode, repo), group in grouped.items():
            by_mode[mode].extend(group)
            lines.append(f'k3dm_codex_sessions{{window="{window}",mode="{mode}",repo="{repo}"}} {len(group)}')
            lines.append(f'k3dm_codex_untracked_sessions{{window="{window}",mode="{mode}",repo="{repo}"}} {sum(r["session"] not in associated for r in group)}')
            for kind, key in (("uncached_input", "input_tokens"), ("cached_input", "cached_input_tokens"), ("output", "output_tokens")):
                def token_value(row, field):
                    raw = (row.get("usage") or {}).get(field)
                    return int(raw) if isinstance(raw, (int, float)) and not isinstance(raw, bool) and raw >= 0 else 0
                value = sum(max(0, token_value(r, key) - (token_value(r, "cached_input_tokens") if kind == "uncached_input" else 0)) for r in group)
                lines.append(f'k3dm_codex_tokens{{window="{window}",mode="{mode}",repo="{repo}",kind="{kind}"}} {value}')
        for mode, group in by_mode.items():
            lines.append(f'k3dm_codex_active_seconds{{window="{window}",mode="{mode}"}} {sum(r["active"] for r in group)}')
            total = 0.0
            unpriced = defaultdict(int)
            for row in group:
                usage = row.get("usage")
                fields = ("input_tokens", "cached_input_tokens", "output_tokens")
                if not isinstance(usage, dict) or any(not isinstance(usage.get(k), (int, float)) or isinstance(usage.get(k), bool) or usage[k] < 0 for k in fields):
                    amount = None
                else:
                    amount = _cost({"model": row.get("model"), "input": int(usage[fields[0]]),
                                    "cached_input": int(usage[fields[1]]), "output": int(usage[fields[2]])}, prices)
                if amount is None:
                    reason = "usage" if not isinstance(usage, dict) or any(
                        not isinstance(usage.get(k), (int, float)) or isinstance(usage.get(k), bool) or usage[k] < 0
                        for k in fields
                    ) else "model"
                    unpriced[reason] += 1
                else:
                    total += amount
            if total or len(group) > sum(unpriced.values()):
                lines.append(f'k3dm_codex_api_cost_usd{{window="{window}",mode="{mode}"}} {total}')
            for reason, count in unpriced.items():
                lines.append(f'k3dm_codex_unpriced_sessions{{window="{window}",mode="{mode}",reason="{reason}"}} {count}')
    newest = None
    for row in files:
        sample = row.get("quota")
        if sample:
            stamp = _timestamp(sample[0])
            if stamp and (newest is None or stamp > newest[0]): newest = (stamp, sample[1])
    if newest:
        stamp, limits = newest
        lines.append(f"k3dm_codex_quota_sample_timestamp_seconds {stamp}")
        for limit in ("primary", "secondary"):
            data = limits.get(limit)
            if not isinstance(data, dict): continue
            used, minutes = data.get("used_percent"), data.get("window_minutes")
            if isinstance(used, (int, float)) and not isinstance(used, bool):
                label = f'limit="{limit}",window_minutes="{minutes}"'
                lines.append(f"k3dm_codex_quota_used_ratio{{{label}}} {used / 100}")
                if isinstance(data.get("resets_at"), (int, float)):
                    lines.append(f"k3dm_codex_quota_resets_at_seconds{{{label}}} {data['resets_at']}")


def _claude_quota(lines, cache_path):
    if not cache_path:
        return
    path = Path(cache_path)
    try:
        if not path.is_file():
            return
        mtime = path.stat().st_mtime
        data = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            return
    except (OSError, ValueError, TypeError):
        return

    lines.append(f"k3dm_claude_quota_sample_timestamp_seconds {mtime}")
    for limit, minutes in (("five_hour", "300"), ("seven_day", "10080")):
        obj = data.get(limit)
        if not isinstance(obj, dict):
            continue
        util = obj.get("utilization")
        if not isinstance(util, (int, float)) or isinstance(util, bool):
            continue
        label = f'limit="{limit}",window_minutes="{minutes}"'
        lines.append(f"k3dm_claude_quota_used_ratio{{{label}}} {util / 100}")
        resets_at = obj.get("resets_at")
        if isinstance(resets_at, str):
            try:
                from datetime import datetime
                stamp = datetime.fromisoformat(resets_at.replace("Z", "+00:00")).timestamp()
                lines.append(f"k3dm_claude_quota_resets_at_seconds{{{label}}} {stamp}")
            except (ValueError, TypeError, AttributeError):
                pass

    limits = data.get("limits")
    if isinstance(limits, list):
        for item in limits:
            if not isinstance(item, dict):
                continue
            if item.get("kind") != "weekly_scoped":
                continue
            scope = item.get("scope")
            if not isinstance(scope, dict):
                continue
            model = scope.get("model")
            if not isinstance(model, dict):
                continue
            display_name = model.get("display_name")
            if not isinstance(display_name, str) or not display_name.strip():
                continue
            percent = item.get("percent")
            if not isinstance(percent, (int, float)) or isinstance(percent, bool):
                continue
            limit_name = f"weekly_{display_name.strip().lower()}"
            label = f'limit="{limit_name}",window_minutes="10080"'
            lines.append(f"k3dm_claude_quota_used_ratio{{{label}}} {percent / 100}")
            resets_at = item.get("resets_at")
            if isinstance(resets_at, str):
                try:
                    from datetime import datetime
                    stamp = datetime.fromisoformat(resets_at.replace("Z", "+00:00")).timestamp()
                    lines.append(f"k3dm_claude_quota_resets_at_seconds{{{label}}} {stamp}")
                except (ValueError, TypeError, AttributeError):
                    pass
            elif isinstance(resets_at, (int, float)) and not isinstance(resets_at, bool):
                lines.append(f"k3dm_claude_quota_resets_at_seconds{{{label}}} {resets_at}")


def _quota_efficiency(lines, events, quota, now):
    observation_file = _root() / "codex-quota-observations.jsonl"
    observations = []
    try:
        for line in observation_file.read_text(encoding="utf-8").splitlines():
            try:
                row = json.loads(line)
                if isinstance(row, dict) and isinstance(row.get("timestamp"), (int, float)) and isinstance(row.get("used_percent"), (int, float)) and isinstance(row.get("resets_at"), (int, float)):
                    observations.append(row)
            except (ValueError, TypeError):
                continue
    except OSError:
        pass
    reversed_sample = False
    if quota:
        stamp = _timestamp(quota[0]); secondary = quota[1].get("secondary")
        if stamp and isinstance(secondary, dict) and all(isinstance(secondary.get(k), (int, float)) for k in ("used_percent", "resets_at")):
            candidate = {"timestamp": stamp, "used_percent": secondary["used_percent"], "resets_at": secondary["resets_at"]}
            if observations and stamp < max(x["timestamp"] for x in observations):
                reversed_sample = True
            elif not any(x["timestamp"] == stamp for x in observations): observations.append(candidate)
            observations = sorted(observations, key=lambda x: x["timestamp"])[-1000:]
            try:
                observation_file.parent.mkdir(parents=True, exist_ok=True)
                tmp = observation_file.with_suffix(".tmp")
                tmp.write_text("".join(json.dumps(x, separators=(",", ":")) + "\n" for x in observations), encoding="utf-8")
                os.replace(tmp, observation_file)
            except OSError:
                pass
    valid = sorted(observations, key=lambda x: x["timestamp"])
    pair = valid[-2:] if len(valid) >= 2 else []
    points = float("nan"); verified_count = float("nan"); ratio = float("nan"); covered = 0
    start_used = end_used = start_ts = end_ts = float("nan")
    if len(pair) == 2 and not reversed_sample:
        before, after = pair
        delta = after["used_percent"] - before["used_percent"]
        if before["timestamp"] < after["timestamp"] and before["resets_at"] == after["resets_at"] and delta > 0.01:
            start, end = before["timestamp"], after["timestamp"]
            start_used, end_used, start_ts, end_ts = before["used_percent"], after["used_percent"], start, end
            states = _task_states(events)
            lands = [event for event in events if event.get("event") == "land"]
            eligible = 0
            for key, task_events in states.items():
                verifies = [e for e in task_events if e.get("event") == "verify"]
                if not verifies: continue
                latest = max(verifies, key=lambda e: e.get("ts", 0))
                if latest.get("result") != "pass" or not (start < latest.get("ts", 0) <= end): continue
                matching_lands = [l for l in lands if l.get("version") == key[0] and l.get("slug") == key[1]]
                if not matching_lands: continue
                check_events = task_events + matching_lands
                if _verification_metrics(check_events, matching_lands, _repo_root(), cutoff=start)["delivered"]:
                    eligible += 1
            covered = 1
            points, verified_count = delta, eligible
            ratio = eligible / delta
    lines.extend([f"k3dm_codex_verified_outputs {verified_count}",
                  f"k3dm_codex_weekly_quota_delta_percentage_points {points}",
                  f"k3dm_codex_verified_outputs_per_quota_point {ratio}",
                  f"k3dm_codex_quota_efficiency_coverage {covered}",
                  f"k3dm_codex_weekly_quota_used_percent_start {start_used}",
                  f"k3dm_codex_weekly_quota_used_percent_end {end_used}",
                  f"k3dm_codex_quota_efficiency_interval_start_timestamp_seconds {start_ts}",
                  f"k3dm_codex_quota_efficiency_interval_end_timestamp_seconds {end_ts}"])


def _agy_ledger_metrics(lines, ledger, now):
    rows = []
    try:
        for raw in Path(ledger).read_text(encoding="utf-8").splitlines():
            try:
                row = json.loads(raw)
                if isinstance(row, dict) and isinstance(row.get("start"), (int, float)):
                    rows.append(row)
            except (ValueError, TypeError):
                continue
    except OSError:
        return
    counts = defaultdict(int)
    for row in rows:
        repo = row.get("repo")
        if isinstance(repo, str) and re.fullmatch(r"[A-Za-z0-9._-]{1,64}", repo):
            counts[repo] += 1
    top = {name for name, _ in sorted(counts.items(), key=lambda pair: (-pair[1], pair[0]))[:10]}
    for window, seconds in WINDOWS.items():
        selected = [r for r in rows if now-seconds <= r["start"] <= now]
        by_mode = defaultdict(list)
        groups = defaultdict(list)
        for row in selected:
            mode = row.get("mode") if row.get("mode") in ("print", "interactive") else "other"
            repo = row.get("repo") if row.get("repo") in top else "other"
            by_mode[mode].append(row)
            groups[(mode, repo)].append(row)
        for (mode, repo), group in groups.items():
            labels = f'window="{window}",mode="{mode}",repo="{repo}"'
            lines.append(f"k3dm_agy_sessions{{{labels}}} {len(group)}")
            lines.append(f"k3dm_agy_untracked_sessions{{{labels}}} {sum(r.get('dispatch_slug') is None for r in group)}")
        for mode, group in by_mode.items():
            lines.append(f'k3dm_agy_active_seconds{{window="{window}",mode="{mode}"}} {sum(r.get("duration_s", 0) or 0 for r in group)}')
            without_usage = 0
            tokens = defaultdict(int)
            for row in group:
                usage = row.get("usage")
                if not isinstance(usage, dict):
                    without_usage += 1
                    continue
                for kind, value in usage.items():
                    if isinstance(kind, str) and re.fullmatch(r"[A-Za-z0-9_]{1,48}", kind) and "token" in kind.lower() and type(value) is int and value >= 0:
                        tokens[kind.lower()] += value
            lines.append(f'k3dm_agy_runs_without_usage{{window="{window}",mode="{mode}"}} {without_usage}')
            for kind, value in tokens.items():
                lines.append(f'k3dm_agy_tokens{{window="{window}",mode="{mode}",kind="{kind}"}} {value}')


def _agy_metrics(lines, ledger, now, brain_root=None, events=None):
    brain_root = Path(brain_root or os.environ.get(
        "K3DM_AGY_BRAIN_DIR", str(Path.home() / ".gemini/antigravity-cli/brain")))
    host = re.sub(r"[^A-Za-z0-9_.-]", "_", socket.gethostname().split(".", 1)[0])
    if brain_root.is_dir():
        lines.append(f'k3dm_agy_source_present{{host="{host}",source="transcripts"}} 1')
        dispatch_sessions = {event.get("session") for event in (events or [])
                             if event.get("event") == "agent_exit"
                             and isinstance(event.get("session"), str) and event.get("session")}
        skipped = 0
        sessions = []
        latest = None
        cutoff = now - WINDOWS["30d"]
        try:
            paths = brain_root.glob("*/.system_generated/logs/transcript_full.jsonl")
            for path in paths:
                try:
                    if path.stat().st_mtime < cutoff:
                        continue
                    session_id = path.parents[2].name
                    steps = []
                    with path.open("rb") as stream:
                        for raw_bytes in stream:
                            try:
                                raw = raw_bytes.decode("utf-8")
                                row = json.loads(raw)
                                stamp = row.get("created_at") if isinstance(row, dict) else None
                                parsed = time.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ") if isinstance(stamp, str) else None
                                ts = calendar.timegm(parsed) if parsed else None
                                if ts is None:
                                    skipped += 1
                                    continue
                                tokens = {}
                                bad_token = False
                                for kind in ("input_tokens", "cache_read_tokens", "output_tokens"):
                                    value = row.get(kind)
                                    if value is not None:
                                        if type(value) is not int or value < 0:
                                            bad_token = True
                                            continue
                                        tokens[kind] = value
                                if bad_token:
                                    skipped += 1
                                steps.append((ts, tokens))
                                latest = ts if latest is None else max(latest, ts)
                            except (ValueError, TypeError, OverflowError):
                                skipped += 1
                    if steps:
                        sessions.append((session_id, steps))
                except OSError:
                    skipped += 1
        except OSError:
            skipped += 1
        lines.append(f"k3dm_agy_transcript_skipped_lines {skipped}")
        if latest is not None:
            lines.append(f"k3dm_agy_latest_step_timestamp {latest}")
        for window, seconds in WINDOWS.items():
            cutoff = now - seconds
            selected = []
            for session_id, steps in sessions:
                in_window = [(ts, tokens) for ts, tokens in steps if cutoff <= ts <= now]
                if in_window:
                    selected.append((session_id, in_window))
            if not selected:
                continue
            count = len(selected)
            untracked = sum(session_id not in dispatch_sessions for session_id, _ in selected)
            active = 0
            totals = defaultdict(int)
            for _, steps in selected:
                stamps = sorted(ts for ts, _ in steps)
                active += sum(min(300, max(0, right-left)) for left, right in zip(stamps, stamps[1:]))
                for _, tokens in steps:
                    for kind, value in tokens.items():
                        totals[kind] += value
            labels = f'window="{window}",mode="unknown",repo="unknown"'
            lines.append(f"k3dm_agy_sessions{{{labels}}} {count}")
            lines.append(f"k3dm_agy_untracked_sessions{{{labels}}} {untracked}")
            lines.append(f'k3dm_agy_active_seconds{{window="{window}",mode="unknown"}} {active}')
            for kind, value in totals.items():
                lines.append(f'k3dm_agy_tokens{{window="{window}",mode="unknown",kind="{kind}"}} {value}')
        return
    ledger_path = Path(ledger)
    if ledger_path.is_file():
        lines.append(f'k3dm_agy_source_present{{host="{host}",source="ledger"}} 1')
        _agy_ledger_metrics(lines, ledger_path, now)
    else:
        lines.append(f'k3dm_agy_source_present{{host="{host}",source="none"}} 1')


def _render_claude_context(lines, now, claude_context, repo_root, metric_windows=None, legacy=True):
    windows = metric_windows or WINDOWS
    verified = _verified_specs(repo_root, now) if legacy else None
    incidents, auto_tokens = _read_context_tally(repo_root, now) if legacy else ({}, None)
    compactions = (claude_context or {}).get("compactions") or []
    reads = (claude_context or {}).get("reads") or []
    turns_by_id = {}
    for turn in (claude_context or {}).get("turns") or []:
        turns_by_id.setdefault(turn.get("id"), turn)
    turns = list(turns_by_id.values())
    boundaries = (claude_context or {}).get("boundaries") or []
    for window, seconds in windows.items():
        cutoff = now - seconds
        if legacy and claude_context is not None:
            comp_counts = {t: 0 for t in COMPACT_TRIGGERS}
            comp_tokens = {t: 0 for t in COMPACT_TRIGGERS}
            for item in compactions:
                ts = _timestamp(item.get("ts"))
                if ts >= cutoff:
                    trig = item.get("trigger")
                    if trig not in comp_counts:
                        comp_counts[trig] = 0
                        comp_tokens[trig] = 0
                    comp_counts[trig] += 1
                    comp_tokens[trig] += int(item.get("pre_tokens", 0) or 0)
            for trig in comp_counts:
                lines.append(f'k3dm_claude_compactions{{window="{window}",trigger="{trig}"}} {comp_counts[trig]}')
                lines.append(f'k3dm_claude_compaction_pre_tokens_sum{{window="{window}",trigger="{trig}"}} {comp_tokens[trig]}')
            all_reads = 0
            rereads = 0
            for item in reads:
                if _timestamp(item.get("ts")) >= cutoff:
                    all_reads += 1
                    if item.get("reread"):
                        rereads += 1
            lines.append(f'k3dm_claude_reads{{window="{window}",kind="all"}} {all_reads}')
            lines.append(f'k3dm_claude_reads{{window="{window}",kind="reread_after_compaction"}} {rereads}')
            for kind in ("unchanged", "changed"):
                count = sum(1 for item in reads if _timestamp(item.get("ts")) >= cutoff and item.get("classification") == kind)
                lines.append(f'k3dm_claude_reads{{window="{window}",kind="reread_{kind}"}} {count}')
            for tool in ("read", "bash"):
                count = sum(1 for item in reads if _timestamp(item.get("ts")) >= cutoff and item.get("tool") == tool)
                lines.append(f'k3dm_claude_reads_by_tool{{window="{window}",tool="{tool}"}} {count}')
        scoped = [turn for turn in turns if _timestamp(turn.get("ts")) >= cutoff]
        main = [turn for turn in scoped if not turn.get("subagent")]
        for agent in ("main", "subagent"):
            selected = [turn for turn in scoped if bool(turn.get("subagent")) == (agent == "subagent")]
            if not selected:
                continue
            values = sorted(float(turn["context"]) for turn in selected)
            days = {time.strftime("%Y-%m-%d", time.gmtime(_timestamp(turn.get("ts")))) for turn in selected}
            for quantile, fraction in (("0.5", 0.5), ("0.9", 0.9)):
                rank = max(1, math.ceil(fraction * len(values)))
                lines.append(f'k3dm_claude_context_tokens{{window="{window}",agent="{agent}",quantile="{quantile}"}} {values[rank - 1]:g}')
            lines.append(f'k3dm_claude_context_tokens_sum{{window="{window}",agent="{agent}"}} {sum(values):g}')
            lines.append(f'k3dm_claude_context_turns{{window="{window}",agent="{agent}"}} {len(values)}')
            lines.append(f'k3dm_claude_turns_per_active_day{{window="{window}",agent="{agent}"}} {len(values) / len(days):g}')
        if main:
            lines.append(f'k3dm_claude_context_ceiling_tokens{{window="{window}"}} {max(float(t["context"]) for t in main):g}')
            after_boundary = []
            for boundary in boundaries:
                bt = _timestamp(boundary.get("ts"))
                if bt < cutoff:
                    continue
                candidates = [turn for turn in main if turn.get("session") == boundary.get("session") and _timestamp(turn.get("ts")) >= bt]
                if candidates:
                    after_boundary.append(min(candidates, key=lambda turn: _timestamp(turn.get("ts"))))
            if after_boundary:
                vals = sorted(float(turn["context"]) for turn in after_boundary)
                median = (vals[(len(vals)-1)//2] + vals[len(vals)//2]) / 2
                lines.append(f'k3dm_claude_context_floor_tokens{{window="{window}"}} {median:g}')
            rebuilds = {cause: [] for cause in ("compaction", "idle", "other")}
            by_session = defaultdict(list)
            for turn in turns:
                if not turn.get("subagent"):
                    by_session[turn.get("session")].append(turn)
            scoped_ids = {turn.get("id") for turn in main}
            for session_turns in by_session.values():
                session_turns.sort(key=lambda turn: _timestamp(turn.get("ts")))
                for index, turn in enumerate(session_turns):
                    if turn.get("id") not in scoped_ids:
                        continue
                    writes = sum(float(turn.get(field, 0) or 0) for field in ("cache_5m", "cache_1h"))
                    if writes <= 50000:
                        continue
                    ts = _timestamp(turn.get("ts"))
                    previous_ts = _timestamp(session_turns[index-1].get("ts")) if index else None
                    same_session_boundaries = [_timestamp(b.get("ts")) for b in boundaries if b.get("session") == turn.get("session")]
                    cause = "compaction" if any((previous_ts is None or previous_ts < b) and b <= ts for b in same_session_boundaries) else "idle" if previous_ts is not None and ts - previous_ts > 3600 else "other"
                    rebuilds[cause].append(turn)
            for cause, rows in rebuilds.items():
                lines.append(f'k3dm_claude_cache_rebuilds{{window="{window}",cause="{cause}"}} {len(rows)}')
                costs = sum((_cache_write_cost(turn, (claude_context or {}).get("rates") or {}) or 0) for turn in rows)
                lines.append(f'k3dm_claude_cache_rebuild_cost_usd{{window="{window}",cause="{cause}"}} {costs:g}')
        if legacy:
            for level in ("live", "verified", "unverified"):
                lines.append(f'k3dm_claude_verified_specs{{window="{window}",level="{level}"}} {verified[window][level]}')
            for kind in INCIDENT_KINDS:
                lines.append(f'k3dm_claude_context_incidents{{window="{window}",kind="{kind}"}} {incidents[window][kind]}')
    if legacy and auto_tokens is not None:
        lines.append(f"k3dm_claude_auto_compact_tokens {auto_tokens}")


def _cache_write_cost(turn, prices):
    key = turn.get("model")
    if turn.get("speed") not in (None, "standard"):
        key = f'{key}@{turn["speed"]}'
    rates = prices.get(key) if isinstance(key, str) else None
    if not isinstance(rates, dict):
        return None
    values = (turn.get("cache_5m", 0), turn.get("cache_1h", 0))
    rates_for_writes = (rates.get("cache_write_5m"), rates.get("cache_write_1h"))
    if any(not isinstance(value, (int, float)) or isinstance(value, bool) or value < 0 for value in values):
        return None
    if any(not isinstance(rate, (int, float)) or isinstance(rate, bool) or rate < 0 for rate in rates_for_writes):
        return None
    return sum(value * rate for value, rate in zip(values, rates_for_writes)) / 1_000_000


def _render_dispatch_gates(lines, events):
    cov_idx = None
    for idx, e in enumerate(events):
        if e.get("event") == "gate_coverage_start":
            cov_idx = idx
            break

    versions_latest = {}
    for idx, e in enumerate(events):
        v = e.get("version")
        if isinstance(v, str) and v:
            versions_latest[v] = idx

    sorted_versions = sorted(versions_latest.keys(), key=lambda v: versions_latest[v], reverse=True)[:10]
    covered_versions = sorted(sorted_versions)

    tasks_events = {}
    for idx, e in enumerate(events):
        v = e.get("version")
        s = e.get("slug")
        if v and s:
            tasks_events.setdefault((v, s), []).append((idx, e))

    tasks = {k: v for k, v in tasks_events.items() if any(e.get("event") == "start" for _, e in v)}

    task_parent_role = {}
    task_parent_idx = {}
    task_earliest_start = {}
    combines_by_parent = {}

    for idx, e in enumerate(events):
        v = e.get("version")
        if not v or not isinstance(v, str):
            continue
        evt = e.get("event")
        s = e.get("slug")
        if evt == "start" and s:
            if (v, s) not in task_earliest_start and isinstance(e.get("ts"), (int, float)):
                task_earliest_start[(v, s)] = e["ts"]
            if "parent" in e:
                p = e.get("parent")
                r = e.get("role")
                if isinstance(p, str):
                    task_parent_role[(v, s)] = (p, r if r in ROLES else None)
                    task_parent_idx[(v, s)] = idx
        elif evt == "link" and s:
            if (v, s) in tasks and "parent" in e:
                p = e.get("parent")
                r = e.get("role")
                if isinstance(p, str):
                    task_parent_role[(v, s)] = (p, r if r in ROLES else None)
                    task_parent_idx[(v, s)] = idx
        elif evt == "combine":
            p = e.get("parent")
            if isinstance(p, str):
                combines_by_parent.setdefault((v, p), []).append((idx, e))

    parents_by_version = {}
    for (v, s), (p, r) in task_parent_role.items():
        idx = task_parent_idx.get((v, s), -1)
        cur = parents_by_version.setdefault(v, {})
        cur[p] = max(cur.get(p, -1), idx)

    for (v, p), c_list in combines_by_parent.items():
        last_c_idx = c_list[-1][0]
        cur = parents_by_version.setdefault(v, {})
        cur[p] = max(cur.get(p, -1), last_c_idx)

    all_valid_parents = {}
    for v, p_dict in parents_by_version.items():
        for p, idx in p_dict.items():
            if PARENT_RE.fullmatch(p):
                all_valid_parents[(v, p)] = idx

    sorted_valid_parents = sorted(all_valid_parents.keys(), key=lambda vp: all_valid_parents[vp], reverse=True)
    top_20_parents = set(sorted_valid_parents[:20])

    for v in covered_versions:
        v_tasks = [evts for (tv, s), evts in tasks.items() if tv == v]

        ladder_counts = {r: {st: 0 for st in STATUSES} for r in RUNGS}
        stalled_count = 0
        live_pending_count = 0

        for evts in v_tasks:
            first_start_idx = next(idx for idx, e in evts if e.get("event") == "start")
            outside_cov = cov_idx is None or first_start_idx < cov_idx

            last_start_idx = max(idx for idx, e in evts if e.get("event") == "start")
            attempt_evts = [(idx, e) for idx, e in evts if idx >= last_start_idx]

            distinct_runs = set()
            latest_run = None
            run_exits = {}
            run_natural_charge = {}
            run_assessments = {}
            has_land = any(e.get("event") == "land" for _, e in attempt_evts)
            has_abandon = any(e.get("event") == "abandon" for _, e in attempt_evts)
            stall_clear_idx = None

            for idx, e in attempt_evts:
                evt_name = e.get("event")
                if evt_name == "start":
                    r = e.get("run") if isinstance(e.get("run"), int) else 1
                    latest_run = r
                    distinct_runs.add(r)
                elif evt_name == "resume":
                    if e.get("reason") == "correction" and latest_run is not None:
                        if latest_run not in run_natural_charge:
                            run_natural_charge[latest_run] = idx
                    if isinstance(e.get("run"), int):
                        r = e["run"]
                    elif isinstance(e.get("n"), int):
                        r = e["n"]
                    else:
                        r = (latest_run or 0) + 1
                    latest_run = r
                    distinct_runs.add(r)
                elif evt_name in ("codex_exit", "agent_exit"):
                    r = e.get("run") if isinstance(e.get("run"), int) else latest_run
                    run_exits[r] = e.get("exit")
                    if e.get("exit") not in (0, None):
                        if r not in run_natural_charge:
                            run_natural_charge[r] = idx
                elif evt_name == "verify":
                    if e.get("result") == "fail" and latest_run is not None:
                        if latest_run not in run_natural_charge:
                            run_natural_charge[latest_run] = idx
                elif evt_name == "land_refused":
                    if e.get("reason") in ("tests", "fast-gate") and latest_run is not None:
                        if latest_run not in run_natural_charge:
                            run_natural_charge[latest_run] = idx
                elif evt_name == "attempt_assessed":
                    r = e.get("run")
                    if isinstance(r, int):
                        run_assessments[r] = (idx, e)
                elif evt_name == "gate_cleared":
                    if e.get("gate") == "stall":
                        stall_clear_idx = idx

            unsuccessful = []
            charge_lines = {}
            P = 0
            for r in distinct_runs:
                if r in run_assessments:
                    a_idx, a_evt = run_assessments[r]
                    if a_evt.get("outcome") == "progress" and a_evt.get("new_evidence_sha256"):
                        P = max(P, r)

            for r in distinct_runs:
                if r in run_assessments:
                    a_idx, a_evt = run_assessments[r]
                    outc = a_evt.get("outcome")
                    if outc in ("failed", "rework"):
                        unsuccessful.append(r)
                        charge_lines[r] = a_idx
                    elif outc in ("progress", "quota"):
                        pass
                    else:
                        if r in run_natural_charge:
                            unsuccessful.append(r)
                            charge_lines[r] = run_natural_charge[r]
                else:
                    if r in run_natural_charge:
                        unsuccessful.append(r)
                        charge_lines[r] = run_natural_charge[r]
            unsuccessful.sort()

            streak = 0
            for r in unsuccessful:
                if r > P:
                    if stall_clear_idx is None or charge_lines[r] > stall_clear_idx:
                        streak += 1

            if has_land or has_abandon:
                stall = "closed"
            elif streak >= 2:
                stall = "open"
            else:
                stall = "clear"

            if stall == "open":
                stalled_count += 1

            task_ladder = {}
            last_exit = run_exits.get(latest_run)
            task_ladder["implemented"] = "done" if last_exit == 0 else "pending"

            for rung in ("offline_tested", "deployed", "live_verified"):
                if any(e.get("event") == "state_mark" and e.get("state") == rung for _, e in attempt_evts):
                    task_ladder[rung] = "done"
                elif outside_cov:
                    task_ladder[rung] = "unknown"
                else:
                    task_ladder[rung] = "pending"

            verifies = [e for _, e in attempt_evts if e.get("event") == "verify"]
            if verifies:
                last_v = verifies[-1]
                if last_v.get("result") == "pass":
                    task_ladder["independently_verified"] = "done" if last_v.get("evidence_sha256") else "unknown"
                else:
                    task_ladder["independently_verified"] = "pending"
            else:
                task_ladder["independently_verified"] = "pending"

            task_ladder["landed"] = "done" if has_land else "pending"

            if task_ladder["landed"] == "done" and task_ladder["live_verified"] == "pending":
                live_pending_count += 1

            for rung in RUNGS:
                st = task_ladder[rung]
                ladder_counts[rung][st] += 1

        for rung in RUNGS:
            for st in STATUSES:
                lines.append(f'k3dm_dispatch_ladder_tasks{{version="{v}",rung="{rung}",status="{st}"}} {ladder_counts[rung][st]}')

        lines.append(f'k3dm_dispatch_stalled_tasks{{version="{v}"}} {stalled_count}')
        lines.append(f'k3dm_dispatch_live_pending_tasks{{version="{v}"}} {live_pending_count}')

        gate_counts = {ge: 0 for ge in GATE_EVENTS}
        for e in events:
            if e.get("version") == v and e.get("event") in gate_counts:
                gate_counts[e["event"]] += 1

        for ge in GATE_EVENTS:
            lines.append(f'k3dm_dispatch_gate_events{{version="{v}",event="{ge}"}} {gate_counts[ge]}')

        named_in_v = parents_by_version.get(v, {})
        valid_in_v = {p: idx for p, idx in named_in_v.items() if PARENT_RE.fullmatch(p)}
        invalid_in_v = {p: idx for p, idx in named_in_v.items() if not PARENT_RE.fullmatch(p)}

        exported_in_v = sorted(p for p in valid_in_v if (v, p) in top_20_parents)
        dropped_in_v = len(invalid_in_v) + len([p for p in valid_in_v if (v, p) not in top_20_parents])

        for p in exported_in_v:
            members = [(s, r) for (tv, s), (tp, r) in task_parent_role.items() if tv == v and tp == p]
            combines = combines_by_parent.get((v, p), [])
            if combines:
                last_c = combines[-1][1]
                comb_res = last_c.get("result")
                conflicts = last_c.get("conflicts")
                last_c_ts = last_c.get("ts", 0)
                if members:
                    member_starts = [task_earliest_start[(v, s)] for s, _ in members if (v, s) in task_earliest_start]
                    elapsed = max(0, int(last_c_ts - min(member_starts))) if member_starts else None
                else:
                    elapsed = None
            else:
                comb_res = "pending"
                conflicts = None
                elapsed = None

            if comb_res in COMBINE_RESULTS:
                lines.append(f'k3dm_dispatch_split_parent_info{{version="{v}",parent="{p}",combine="{comb_res}"}} 1')

            for r in ROLES:
                r_cnt = sum(1 for _, mr in members if mr == r)
                lines.append(f'k3dm_dispatch_split_parent_parts{{version="{v}",parent="{p}",role="{r}"}} {r_cnt}')

            if conflicts is not None and type(conflicts) is int:
                lines.append(f'k3dm_dispatch_split_parent_conflicts{{version="{v}",parent="{p}"}} {conflicts}')

            if elapsed is not None:
                lines.append(f'k3dm_dispatch_split_parent_elapsed_seconds{{version="{v}",parent="{p}"}} {elapsed}')

        lines.append(f'k3dm_dispatch_split_parents_dropped{{version="{v}"}} {dropped_in_v}')


def render(events, bad_lines, now=None, prices=None, subscriptions=None, checked=None,
           codex_home=None, claude_records=None, claude_prices=None, claude_context=None, repo_root=None,
           claude_usage_cache=None):
    now = time.time() if now is None else now
    doc_root = Path(repo_root) if repo_root is not None else _repo_root()
    prices = prices or {}
    repo_by_worktree = _dispatch_worktree_repos(events)
    coverage = list(_session_files(codex_home, now, repo_by_worktree)) if codex_home else None
    lines = [f"k3dm_dispatch_ledger_bad_lines {bad_lines}"]
    for window, seconds in WINDOWS.items():
        _render_scope(lines, window, _window_metrics(events, now, seconds, prices, doc_root), events,
                      prices, coverage, True, now, claude_records, claude_prices, now-seconds)
    for release in _releases(events):
        _render_scope(lines, release, _release_metrics(events, release, prices, doc_root, now), events, prices,
                      now=now, claude_records=claude_records, claude_prices=claude_prices)
    if claude_records is not None:
        if claude_records:
            lines.append(f'k3dm_dispatch_claude_coverage_start_timestamp_seconds {min(_timestamp(r["ts"]) for r in claude_records)}')
        from datetime import datetime, timedelta
        today = datetime.fromtimestamp(now).astimezone().date()
        daily = defaultdict(int)
        daily_by_kind = defaultdict(int)
        for record in claude_records:
            try:
                stamp = datetime.fromisoformat(record["ts"].replace("Z", "+00:00")).astimezone().date()
            except (ValueError, TypeError, AttributeError):
                continue
            if stamp >= today - timedelta(days=29) and record.get("model") != "<synthetic>":
                for kind, sources in (("input", ("input",)), ("cache_write", ("cache_5m", "cache_1h")),
                                      ("cache_read", ("cache_read",)), ("output", ("output",))):
                    value = 0
                    for source in sources:
                        raw = record.get(source, 0) or 0
                        if isinstance(raw, (int, float)) and not isinstance(raw, bool) and math.isfinite(raw) and raw >= 0:
                            value += int(raw)
                    daily_by_kind[(stamp.isoformat(), kind)] += value
                values = [record.get(k, 0) or 0 for k in ("input", "cache_5m", "cache_1h", "cache_read", "output")]
                daily[(stamp.isoformat(), record["model"])] += sum(int(v) if isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v) and v >= 0 else 0 for v in values)
        for (date, model), value in sorted(daily.items()):
            lines.append(f'k3dm_dispatch_claude_daily_tokens{{date="{date}",model="{model}"}} {value}')
        for (date, kind), value in sorted(daily_by_kind.items()):
            if value:
                lines.append(f'k3dm_dispatch_claude_daily_tokens_by_kind{{date="{date}",kind="{kind}"}} {value}')
    for plan, amount in (subscriptions or {}).items():
        lines.append(f'k3dm_dispatch_subscription_usd_per_month{{plan="{plan}"}} {amount}')
    task_states = [_task_state(task_events) for task_events in _task_states(events).values()]
    lines.append(f"k3dm_dispatch_running {task_states.count('running')}")
    lines.append(f"k3dm_dispatch_awaiting_land {task_states.count('awaiting')}")
    plan_tasks, skipped = {}, 0
    for key, task_events in _task_states(events).items():
        starts = [event for event in task_events if event.get("event") == "start" and event.get("spec")]
        if not starts:
            continue
        start = max(starts, key=lambda event: event.get("ts", 0))
        spec = start.get("spec")
        stem = Path(spec).stem if isinstance(spec, str) else ""
        if not PLAN_STEM_RE.fullmatch(stem):
            skipped += 1
            continue
        candidate = (start.get("ts", 0), key, task_events)
        if stem not in plan_tasks or candidate[0] > plan_tasks[stem][0]:
            plan_tasks[stem] = candidate
    for stem, (_, key, task_events) in sorted(plan_tasks.items()):
        version, slug = key
        lines.append(f'k3dm_dispatch_plan_state{{plan="{stem}",version="{version}",slug="{slug}",dispatch_state="{_dispatch_state(task_events)}"}} 1')
    lines.append(f"k3dm_dispatch_plan_state_skipped {skipped}")
    bug_tasks = {}
    for key, task_events in _task_states(events).items():
        starts = [event for event in task_events if event.get("event") == "start" and event.get("spec")]
        if not starts:
            continue
        start = max(starts, key=lambda event: event.get("ts", 0))
        spec = start.get("spec")
        if not isinstance(spec, str):
            continue
        m = BUG_SPEC_RE.fullmatch(spec)
        if not m:
            continue
        stem = m.group(1)
        candidate = (start.get("ts", 0), key, task_events)
        if stem not in bug_tasks or candidate[0] > bug_tasks[stem][0]:
            bug_tasks[stem] = candidate
    for stem, (_, key, task_events) in sorted(bug_tasks.items()):
        version, slug = key
        lines.append(f'k3dm_dispatch_bug_state{{bug="{stem}",version="{version}",slug="{slug}",dispatch_state="{_dispatch_state(task_events)}"}} 1')
    if claude_context is not None or repo_root is not None:
        if claude_context is not None:
            claude_context["rates"] = claude_prices or {}
        _render_claude_context(lines, now, claude_context, repo_root)
        if claude_context is not None:
            all_turns = (claude_context or {}).get("turns") or []
            all_boundaries = (claude_context or {}).get("boundaries") or []
            task_windows = defaultdict(list)
            for key, task_events in _task_states(events).items():
                starts = [row["ts"] for row in task_events if row.get("event") == "start"]
                lands = [row["ts"] for row in task_events if row.get("event") == "land"]
                release = _normalize_version(key[0])
                if starts and lands and release:
                    task_windows[release].append((min(starts), max(lands)))
            for release, intervals in task_windows.items():
                selected_turns = [turn for turn in all_turns if any(start <= _timestamp(turn.get("ts")) <= end
                                  for start, end in intervals)]
                if not selected_turns:
                    continue
                selected_boundaries = [boundary for boundary in all_boundaries if any(
                    start <= _timestamp(boundary.get("ts")) <= end for start, end in intervals)]
                release_context = {"turns": selected_turns, "boundaries": selected_boundaries,
                                   "rates": claude_prices or {}}
                _render_claude_context(lines, now, release_context, repo_root,
                                       metric_windows={release: 10**12}, legacy=False)
    if coverage is not None:
        _activity_metrics(lines, events, coverage, now, prices)
        newest_quota = max((r.get("quota") for r in coverage if r.get("quota") and _timestamp(r["quota"][0])), key=lambda q: _timestamp(q[0]), default=None)
        _quota_efficiency(lines, events, newest_quota, now)
    else:
        _quota_efficiency(lines, events, None, now)
    _claude_quota(lines, claude_usage_cache)
    _agy_metrics(lines, os.environ.get("K3DM_AGENT_LEDGER_DIR", str(Path.home() / ".local/share/k3d-manager/agent-sessions")) + "/agy.jsonl", now, events=events)
    _render_dispatch_gates(lines, events)
    lines.append(f"k3dm_dispatch_ledger_timestamp_seconds {now}")
    return "\n".join(lines) + "\n"


def main(argv=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("--spec-stats", metavar="PATH")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--prices", default=str(_repo_root() / "scripts/etc/agent/codex-model-prices.json"))
    parser.add_argument("--codex-home", default=os.environ.get("CODEX_HOME", str(Path.home() / ".codex")))
    repo_key = str(_repo_root()).replace("/", "-")
    parser.add_argument("--claude-projects", default=str(Path.home() / ".claude" / "projects" / repo_key))
    parser.add_argument("--claude-cache", default=str(Path.home() / ".local/share/k3d-manager/claude-usage/rollup.json"))
    parser.add_argument("--claude-usage-cache", default=os.path.join(os.environ.get("STATUSLINE_CACHE_DIR") or "/tmp/claude", "statusline-usage-cache.json"))
    args = parser.parse_args(argv)
    if args.spec_stats is not None:
        print(json.dumps(_spec_stats(args.spec_stats), separators=(",", ":")))
        return 0
    events, bad_lines = read_ledger(_root() / "ledger.jsonl")
    model_prices, subscriptions, checked, claude_prices = _prices(args.prices)
    claude_context = {} if Path(args.claude_projects).is_dir() else None
    claude_records = _claude_rollup(args.claude_projects, args.claude_cache, claude_context) if claude_context is not None else None
    payload = render(events, bad_lines, prices=model_prices, subscriptions=subscriptions,
                     checked=checked, codex_home=args.codex_home, claude_records=claude_records,
                     claude_prices=claude_prices, claude_context=claude_context, repo_root=_repo_root(),
                     claude_usage_cache=args.claude_usage_cache)
    if args.dry_run:
        print(payload, end="")
        return 0
    base = os.environ.get("K3DM_DISPATCH_PUSHGATEWAY_URL", "http://localhost:19094").rstrip("/")
    request = urllib.request.Request(
        f"{base}/metrics/job/k3dm-dispatch", data=payload.encode(), method="PUT",
        headers={"Content-Type": "text/plain; version=0.0.4"},
    )
    try:
        with urllib.request.urlopen(request, timeout=5):
            pass
    except Exception as exc:  # one bounded request; callers should not retry forever
        print(f"dispatch metrics push failed: {exc}")
        return 1
    try:
        subprocess.run([str(Path(__file__).with_name("k3dm-dispatch-logs"))],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=300)
    except (OSError, subprocess.TimeoutExpired):
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
