#!/usr/bin/env bash
# shellcheck disable=SC2016

set -euo pipefail

_dispatch_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_dispatch_repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "${_dispatch_repo_root}" ]] || _dispatch_repo_root="$(cd "${_dispatch_script_dir}/.." && pwd)"
# shellcheck source=/dev/null
source "${_dispatch_script_dir}/../scripts/lib/system.sh"
_dispatch_worktree_root="${K3DM_WORKTREE_ROOT:-${HOME}/.local/share/k3d-manager/worktrees}"

_dispatch_ledger_event() {
  local event="$1" version="$2" slug="$3" json filter='.' arg_count
  shift 3
  if (($#)); then
    arg_count=$#; filter="${!arg_count}"; set -- "${@:1:arg_count-1}"
  fi
  json="$(jq -nc --arg event "$event" --arg version "$version" --arg slug "$slug" \
    --argjson ts "$(date +%s)" "$@" "{ts:\$ts,event:\$event,version:\$version,slug:\$slug} | ($filter)" 2>/dev/null)" || {
    echo "[codex-dispatch] WARNING: could not build ledger event ${event} for ${slug}" >&2
    return 0
  }
  if ! printf '%s\n' "$json" >>"$_dispatch_worktree_root/ledger.jsonl"; then
    echo "[codex-dispatch] WARNING: could not write $_dispatch_worktree_root/ledger.jsonl" >&2
  fi
}

_dispatch_schedule_metrics() {
  mkdir -p "$_dispatch_worktree_root" 2>/dev/null || true
  "$_dispatch_script_dir/k3dm-dispatch-metrics" >>"$_dispatch_worktree_root/metrics.log" 2>&1 &
}

_dispatch_codex_exit() {
  local worktree="$1" run="$2" version="$3" slug="$4" log="$5" exit_code="$6" tokens tree ts
  tokens="$(awk '/^tokens used$/{getline; gsub(/,/, ""); if ($0 ~ /^[0-9]+$/) value=$0} END{if (value != "") print value}' "$log" 2>/dev/null || true)"
  git -C "$worktree" add -A
  tree="$(git -C "$worktree" write-tree)"
  git -C "$worktree" reset -q
  printf '%s\n' "$tree" >"$run/codex-tree"
  ts="$(date +%s)"
  printf '%s\n' "$ts" >"$run/codex-exit-ts"
  if [[ -n "$tokens" ]]; then
    _dispatch_ledger_event codex_exit "$version" "$slug" \
      --argjson exit "$exit_code" --argjson tokens "$tokens" --arg tree "$tree" \
      '.["exit"]=$exit|.["tokens"]=$tokens|.["tree"]=$tree'
  else
    _dispatch_ledger_event codex_exit "$version" "$slug" \
      --argjson exit "$exit_code" --arg tree "$tree" \
      '.["exit"]=$exit|.["tokens"]=null|.["tree"]=$tree'
  fi
  _dispatch_schedule_metrics
}

_dispatch_error() { echo "[codex-dispatch] ERROR: $*" >&2; exit 2; }
_dispatch_usage() {
  cat <<'EOF'
Usage:
  bin/k3dm-codex-dispatch start --spec PATH [--slug SLUG] [--network]
  bin/k3dm-codex-dispatch status [SLUG]
  bin/k3dm-codex-dispatch land --slug SLUG (--test CMD|--no-test) [--allow-out-of-scope]
  bin/k3dm-codex-dispatch resume --slug SLUG --prompt-file PATH
  bin/k3dm-codex-dispatch abandon --slug SLUG --yes
EOF
}

_dispatch_release_branch() {
  local branch
  branch="$(git -C "${_dispatch_repo_root}" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  [[ "${branch}" =~ ^k3d-manager-v[0-9]+\.[0-9]+\.[0-9]+$ ]] || _dispatch_error "current branch '${branch:-detached}' is not a release branch"
  printf '%s\n' "${branch}"
}

_dispatch_spec_files() {
  awk '/^## Files[[:space:]]*$/ { in_files=1; next } in_files && /^## / { exit } in_files { print }' |
    grep -oE "\`[^\`]+\`" | sed "s/^\`//; s/\`$//" || true
}

_dispatch_scope_verdict() {
  local worktree="$1" spec="$2" rel="$3" allow="$4" path pattern in_scope=1 matched base from merge_base
  local -a patterns=()
  if [[ ! -f "$worktree.run/base" ]]; then
    echo "scope: unknown (no recorded base)"
    return 1
  fi
  base="$(<"$worktree.run/base")"
  from="$base"
  if merge_base="$(git -C "$worktree" merge-base "$rel" HEAD 2>/dev/null)" && git -C "$worktree" merge-base --is-ancestor "$base" "$merge_base"; then
    from="$merge_base"
  fi
  while IFS= read -r path; do [[ -n "$path" ]] && patterns+=("$path"); done < <(git -C "$worktree" show "$base:$spec" | _dispatch_spec_files)
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    matched=1
    [[ "$path" == "$spec" || "$path" == memory-bank/* ]] && { echo "out-of-scope: $path"; in_scope=0; continue; }
    for pattern in "${patterns[@]}"; do
      # shellcheck disable=SC2254
      case "$path" in
        $pattern) matched=0; break ;;
      esac
    done
    if (( matched )); then echo "out-of-scope: $path"; in_scope=0; fi
  done < <({
    git -C "$worktree" diff --name-only "$from" HEAD
    git -C "$worktree" diff --name-only
    git -C "$worktree" ls-files --others --exclude-standard
  } | sort -u)
  if (( in_scope )); then echo "scope: in-scope"; elif (( allow )); then echo "scope: out-of-scope (allowed)"; else return 1; fi
}

_dispatch_task_spec() {
  local task="$1" run="$2" spec
  [[ -f "$run/spec" ]] || return 1
  spec="$(<"$run/spec")"
  [[ -n "$spec" && -f "$task/$spec" ]] || return 1
  printf '%s\n' "$spec"
}

_dispatch_task_paths() {
  _dispatch_task_dir="${_dispatch_worktree_root}/$1/$2"
  _dispatch_run_dir="${_dispatch_worktree_root}/$1/$2.run"
}

_dispatch_network_task_running() {
  local version="$1" candidate_run candidate_slug candidate_pid
  for candidate_run in "$_dispatch_worktree_root/$version"/*.run; do
    [[ -d "$candidate_run" && -f "$candidate_run/network" ]] || continue
    [[ -f "$candidate_run/exit" ]] && continue
    [[ -f "$candidate_run/pid" ]] || continue
    candidate_pid="$(<"$candidate_run/pid")"
    if kill -0 "$candidate_pid" 2>/dev/null; then
      candidate_slug="$(basename "$candidate_run" .run)"
      printf '%s\n' "$candidate_slug"
      return 0
    fi
  done
  return 1
}

_dispatch_start() {
  local spec="" slug="" network=0 rel version head remote spec_base worktree run state_dir arg network_slug
  while (($#)); do
    case "$1" in
      --spec) (($# >= 2)) || _dispatch_error "--spec requires a path"; spec="$2"; shift 2 ;;
      --slug) (($# >= 2)) || _dispatch_error "--slug requires a value"; slug="$2"; shift 2 ;;
      --network) network=1; shift ;;
      -h|--help) _dispatch_usage; return 0 ;;
      *) _dispatch_error "unknown start option: $1" ;;
    esac
  done
  [[ -n "$spec" ]] || _dispatch_error "start requires --spec PATH"
  rel="$(_dispatch_release_branch)"; version="${rel#k3d-manager-}"
  [[ -f "$_dispatch_repo_root/$spec" ]] || _dispatch_error "spec does not exist: $spec"
  git -C "$_dispatch_repo_root" ls-files --error-unmatch -- "$spec" >/dev/null 2>&1 || _dispatch_error "spec is not tracked: $spec"
  git -C "$_dispatch_repo_root" diff --quiet HEAD -- "$spec" || _dispatch_error "spec is changed: $spec"
  git -C "$_dispatch_repo_root" fetch origin "$rel:refs/remotes/origin/$rel" >/dev/null 2>&1 || _dispatch_error "could not fetch origin/$rel"
  head="$(git -C "$_dispatch_repo_root" rev-parse HEAD)"; remote="$(git -C "$_dispatch_repo_root" rev-parse "origin/$rel")"
  [[ "$head" == "$remote" ]] || _dispatch_error "HEAD is not pushed to origin/$rel"
  _dispatch_spec_files <"$_dispatch_repo_root/$spec" | grep -q . || _dispatch_error "spec has no backticked path in its ## Files section"
  spec_base="$(basename "$spec" .md)"
  [[ -n "$slug" ]] || slug="${spec_base#"${version}"-}"
  [[ "$slug" != "$spec_base" ]] || slug="$spec_base"
  [[ "$slug" =~ ^[A-Za-z0-9._-]+$ ]] || _dispatch_error "invalid slug: $slug"
  git -C "$_dispatch_repo_root" show-ref --verify --quiet "refs/heads/task/$version/$slug" && _dispatch_error "task branch already exists: task/$version/$slug"
  git -C "$_dispatch_repo_root" ls-remote --exit-code --heads origin "task/$version/$slug" >/dev/null 2>&1 && _dispatch_error "remote task branch already exists: task/$version/$slug"
  worktree="$_dispatch_worktree_root/$version/$slug"; run="$_dispatch_worktree_root/$version/$slug.run"
  [[ ! -e "$worktree" ]] || _dispatch_error "worktree path already exists: $worktree"
  [[ ! -e "$run" ]] || _dispatch_error "run path already exists: $run"
  if (( network )) && network_slug="$(_dispatch_network_task_running "$version")"; then
    _dispatch_error "network task $network_slug is still running; only one networked task at a time"
  fi
  mkdir -p "$_dispatch_worktree_root/$version"
  git -C "$_dispatch_repo_root" worktree add -b "task/$version/$slug" "$worktree" "origin/$rel" >/dev/null
  mkdir -m 700 "$run"; state_dir="$run/state"; mkdir -m 700 "$state_dir"
  for arg in jobs run state logs tmp port-cache; do mkdir -m 700 "$state_dir/$arg"; done
  if (( network )); then
    : >"$run/network"
  fi
  printf '%s\n' "$remote" >"$run/base"
  printf '%s\n' "$spec" >"$run/spec"
  _dispatch_ledger_event start "$version" "$slug" --argjson network "$network" '.["network"]=$network'
  cat >"$run/prompt.md" <<EOF
Read the spec at $spec in full, and implement it in this directory only.
Run the spec's Rules gates and paste their output.
Do not run git add, git commit or git push. .git is read-only to you. Leave the changes in the working tree.
Do not touch memory-bank/.
Do not unset or override the K3DM_* and TMPDIR variables you were given. They keep this task's state away from the live webhook and from other tasks.
Your last message must list every file you changed.
EOF
  local -a _dispatch_state_vars=(
    "K3DM_REPO_ROOT=$worktree" "K3DM_JOB_DIR=$state_dir/jobs" "K3DM_RUN_DIR=$state_dir/run"
    "K3DM_STATE_DIR=$state_dir/state" "K3DM_LOG_DIR=$state_dir/logs" "K3DM_TMP_ROOT=$state_dir/tmp"
    "K3DM_PORT_CACHE_DIR=$state_dir/port-cache" "TMPDIR=$state_dir/tmp"
  )
  (
    set +e
    if (( network )); then
      env "${_dispatch_state_vars[@]}" "${K3DM_CODEX_BIN:-codex}" exec --sandbox workspace-write -C "$worktree" --add-dir "$state_dir" -o "$run/last-message.md" -c sandbox_workspace_write.network_access=true - <"$run/prompt.md" >"$run/codex.log" 2>&1
    else
      env "${_dispatch_state_vars[@]}" "${K3DM_CODEX_BIN:-codex}" exec --sandbox workspace-write -C "$worktree" --add-dir "$state_dir" -o "$run/last-message.md" - <"$run/prompt.md" >"$run/codex.log" 2>&1
    fi
    exit_code="$?"
    _dispatch_codex_exit "$worktree" "$run" "$version" "$slug" "$run/codex.log" "$exit_code"
    printf '%s\n' "$exit_code" >"$run/exit"
  ) </dev/null >/dev/null 2>&1 &
  printf '%s\n' "$!" >"$run/pid"
  echo "worktree: $worktree"; echo "run: $run"; echo "status: bin/k3dm-codex-dispatch status $slug"
}

_dispatch_status() {
  local rel version task slug run state spec pid
  rel="$(_dispatch_release_branch)"; version="${rel#k3d-manager-}"
  [[ -d "$_dispatch_worktree_root/$version" ]] || return 0
  for task in "$_dispatch_worktree_root/$version"/*; do
    [[ -d "$task" && "$task" != *.run ]] || continue
    slug="$(basename "$task")"; run="$task.run"
    if [[ -f "$run/landed" ]]; then state=landed
    elif [[ -f "$run/pid" ]] && kill -0 "$(<"$run/pid")" 2>/dev/null; then state=running
    elif [[ -f "$run/exit" ]]; then state="exited $(<"$run/exit")"
    else state=unknown; fi
    [[ -z "${1:-}" || "$1" == "$slug" ]] || continue
    echo "task: $slug"; echo "state: $state"; [[ -f "$run/network" ]] && echo "network: yes" || true
    if compgen -G "$run/prompt-[0-9]*.md" >/dev/null; then
      echo "resumes: $(find "$run" -maxdepth 1 -name 'prompt-[0-9]*.md' | wc -l | tr -d ' ')"
    fi
    git -C "$task" status --porcelain || true; git -C "$task" log --oneline "origin/$rel..HEAD" || true
    if spec="$(_dispatch_task_spec "$task" "$run")"; then _dispatch_scope_verdict "$task" "$spec" "$rel" 1 || true; else echo "scope: unknown (no recorded spec)"; fi
  done
}

_dispatch_land() {
  local slug="" allow=0 test_set=0 no_test=0 test_cmd="" rel version task run pid spec current land_lock verifier_lines wait_seconds land_ts codex_ts
  while (($#)); do
    case "$1" in
      --slug) (($# >= 2)) || _dispatch_error "--slug requires a value"; slug="$2"; shift 2 ;;
      --test) (($# >= 2)) || _dispatch_error "--test requires a command"; test_set=1; test_cmd="$2"; shift 2 ;;
      --no-test) no_test=1; shift ;;
      --allow-out-of-scope) allow=1; shift ;;
      *) _dispatch_error "unknown land option: $1" ;;
    esac
  done
  [[ -n "$slug" ]] || _dispatch_error "land requires --slug SLUG"
  (( test_set + no_test == 1 )) || _dispatch_error "land requires exactly one of --test CMD or --no-test"
  rel="$(_dispatch_release_branch)"; version="${rel#k3d-manager-}"; _dispatch_task_paths "$version" "$slug"; task="$_dispatch_task_dir"; run="$_dispatch_run_dir"
  [[ -d "$task" ]] || _dispatch_error "worktree does not exist: $task"
  [[ -f "$run/pid" ]] && pid="$(<"$run/pid")" || pid=""
  [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null || _dispatch_error "Codex is still running"
  [[ -f "$run/base" ]] || _dispatch_error "no recorded base for $slug (expected $run/base)"
  [[ -z "$(git -C "$task" status --porcelain)" ]] || _dispatch_error "worktree has uncommitted changes"
  [[ "$(git -C "$task" rev-list --count "origin/$rel..HEAD")" -gt 0 ]] || _dispatch_error "task branch has no commits ahead of origin/$rel"
  spec="$(_dispatch_task_spec "$task" "$run")" || _dispatch_error "no recorded spec for $slug (expected $run/spec)"
  if ! _dispatch_scope_verdict "$task" "$spec" "$rel" "$allow"; then
    _dispatch_ledger_event land_refused "$version" "$slug" --arg reason scope '.["reason"]=$reason'
    _dispatch_schedule_metrics
    _dispatch_error "task changes are out of scope"
  fi
  verifier_lines=0
  if [[ -s "$run/codex-tree" ]]; then
    verifier_lines="$(git -C "$task" diff --numstat "$(<"$run/codex-tree")" HEAD | awk '{if ($1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/) total += $1 + $2} END {print total + 0}')"
  fi
  land_lock="$_dispatch_worktree_root/$version/.land.lock"
  if ! mkdir "$land_lock" 2>/dev/null; then
    if [[ -f "$land_lock/pid" ]] && kill -0 "$(<"$land_lock/pid")" 2>/dev/null; then
      _dispatch_error "another land is in progress (pid $(<"$land_lock/pid"))"
    fi
    rm -f "$land_lock/pid"; rmdir "$land_lock" 2>/dev/null || _dispatch_error "could not remove stale landing lock"
    mkdir "$land_lock" 2>/dev/null || _dispatch_error "another land is in progress"
  fi
  printf '%s\n' "$$" >"$land_lock/pid"
  _dispatch_land_lock_path="$land_lock"
  trap '_dispatch_release_land_lock "${_dispatch_land_lock_path}"' EXIT
  current="$(git -C "$_dispatch_repo_root" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"; [[ "$current" == "$rel" ]] || _dispatch_error "operator checkout is not on $rel"
  [[ -z "$(git -C "$_dispatch_repo_root" status --porcelain)" ]] || _dispatch_error "operator checkout is dirty"
  if ! git -C "$task" rebase "$rel" >/dev/null; then
    _dispatch_ledger_event land_refused "$version" "$slug" --arg reason rebase '.["reason"]=$reason'
    _dispatch_schedule_metrics
    _dispatch_error "rebase of task/$version/$slug onto $rel failed; resolve it in $task"
  fi
  if (( no_test )); then
    echo "tests: skipped (--no-test)"
  elif ! (cd "$task" && env \
    "K3DM_REPO_ROOT=$task" "K3DM_JOB_DIR=$run/state/jobs" "K3DM_RUN_DIR=$run/state/run" \
    "K3DM_STATE_DIR=$run/state/state" "K3DM_LOG_DIR=$run/state/logs" "K3DM_TMP_ROOT=$run/state/tmp" \
    "K3DM_PORT_CACHE_DIR=$run/state/port-cache" "TMPDIR=$run/state/tmp" \
    bash -c "$test_cmd" >"$run/land-test.log" 2>&1); then
    tail -n 20 "$run/land-test.log"
    _dispatch_ledger_event land_refused "$version" "$slug" --arg reason tests '.["reason"]=$reason'
    _dispatch_schedule_metrics
    _dispatch_error "tests failed after rebase onto $rel; see $run/land-test.log"
  else
    echo "tests: passed"
  fi
  git -C "$_dispatch_repo_root" merge --ff-only "task/$version/$slug" >/dev/null || _dispatch_error "fast-forward merge of task/$version/$slug failed"
  land_ts="$(date +%s)"; wait_seconds=null
  if [[ -s "$run/codex-exit-ts" ]]; then
    codex_ts="$(<"$run/codex-exit-ts")"; wait_seconds=$((land_ts - codex_ts))
  fi
  _dispatch_ledger_event land "$version" "$slug" --argjson verifier_lines "$verifier_lines" \
    --argjson wait_seconds "$wait_seconds" '.["verifier_lines"]=$verifier_lines|.["wait_seconds"]=$wait_seconds'
  _dispatch_schedule_metrics
  git -C "$_dispatch_repo_root" worktree remove "$task"
  git -C "$_dispatch_repo_root" branch --unset-upstream "task/$version/$slug" 2>/dev/null || true
  git -C "$_dispatch_repo_root" branch -d "task/$version/$slug" >/dev/null; : >"$run/landed"
  echo "landed: $slug"; echo "push: git push origin $rel"
}

_dispatch_release_land_lock() {
  local lock="$1"
  rm -f "$lock/pid"
  rmdir "$lock" 2>/dev/null || true
}

_dispatch_resume() {
  local slug="" prompt_file="" rel version task run pid session_id n network_slug exit_code
  while (($#)); do
    case "$1" in
      --slug) (($# >= 2)) || _dispatch_error "--slug requires a value"; slug="$2"; shift 2 ;;
      --prompt-file) (($# >= 2)) || _dispatch_error "--prompt-file requires a path"; prompt_file="$2"; shift 2 ;;
      *) _dispatch_error "unknown resume option: $1" ;;
    esac
  done
  [[ -n "$slug" ]] || _dispatch_error "resume requires --slug SLUG"
  [[ -n "$prompt_file" ]] || _dispatch_error "resume requires --prompt-file PATH"
  [[ -s "$prompt_file" ]] || _dispatch_error "prompt file is missing or empty: $prompt_file"
  rel="$(_dispatch_release_branch)"; version="${rel#k3d-manager-}"; _dispatch_task_paths "$version" "$slug"; task="$_dispatch_task_dir"; run="$_dispatch_run_dir"
  [[ -d "$task" ]] || _dispatch_error "worktree does not exist: $task"
  [[ ! -f "$run/landed" ]] || _dispatch_error "task has landed: $slug"
  [[ -f "$run/pid" ]] && pid="$(<"$run/pid")" || pid=""
  if [[ -n "$pid" && ! -f "$run/exit" ]] && kill -0 "$pid" 2>/dev/null; then
    _dispatch_error "Codex is still running"
  fi
  session_id="$(sed -n 's/^session id: //p' "$run/codex.log" 2>/dev/null | head -n 1)"
  [[ "$session_id" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] || _dispatch_error "no valid session id in $run/codex.log"
  n=2
  while [[ -e "$run/prompt-$n.md" ]]; do ((n++)); done
  if [[ -f "$run/network" ]] && network_slug="$(_dispatch_network_task_running "$version")" && [[ "$network_slug" != "$slug" ]]; then
    _dispatch_error "network task $network_slug is still running; only one networked task at a time"
  fi
  cp "$prompt_file" "$run/prompt-$n.md"
  rm -f "$run/exit"
  local -a _dispatch_state_vars=(
    "K3DM_REPO_ROOT=$task" "K3DM_JOB_DIR=$run/state/jobs" "K3DM_RUN_DIR=$run/state/run"
    "K3DM_STATE_DIR=$run/state/state" "K3DM_LOG_DIR=$run/state/logs" "K3DM_TMP_ROOT=$run/state/tmp"
    "K3DM_PORT_CACHE_DIR=$run/state/port-cache" "TMPDIR=$run/state/tmp"
  )
  (
    cd "$task"
    set +e
    if [[ -f "$run/network" ]]; then
      env "${_dispatch_state_vars[@]}" "${K3DM_CODEX_BIN:-codex}" exec resume -c 'sandbox_mode="workspace-write"' -c "sandbox_workspace_write.writable_roots=[\"$run/state\"]" -c sandbox_workspace_write.network_access=true -o "$run/last-message-$n.md" "$session_id" - <"$run/prompt-$n.md" >"$run/codex-$n.log" 2>&1
    else
      env "${_dispatch_state_vars[@]}" "${K3DM_CODEX_BIN:-codex}" exec resume -c 'sandbox_mode="workspace-write"' -c "sandbox_workspace_write.writable_roots=[\"$run/state\"]" -o "$run/last-message-$n.md" "$session_id" - <"$run/prompt-$n.md" >"$run/codex-$n.log" 2>&1
    fi
    exit_code="$?"
    _dispatch_codex_exit "$task" "$run" "$version" "$slug" "$run/codex-$n.log" "$exit_code"
    printf '%s\n' "$exit_code" >"$run/exit"
  ) </dev/null >/dev/null 2>&1 &
  printf '%s\n' "$!" >"$run/pid"
  _dispatch_ledger_event resume "$version" "$slug" --argjson n "$n" '.["n"]=$n'
  _dispatch_schedule_metrics
  echo "resumed: $slug"; echo "resume: $n"
}

_dispatch_abandon() {
  local slug="" yes=0 rel version
  while (($#)); do
    case "$1" in
      --slug) (($# >= 2)) || _dispatch_error "--slug requires a value"; slug="$2"; shift 2 ;;
      --yes) yes=1; shift ;;
      *) _dispatch_error "unknown abandon option: $1" ;;
    esac
  done
  [[ -n "$slug" ]] || _dispatch_error "abandon requires --slug SLUG"
  rel="$(_dispatch_release_branch)"; version="${rel#k3d-manager-}"; _dispatch_task_paths "$version" "$slug"
  if (( ! yes )); then echo "would remove: $_dispatch_task_dir"; echo "would delete branch: task/$version/$slug"; exit 2; fi
  git -C "$_dispatch_repo_root" worktree remove --force "$_dispatch_task_dir"; git -C "$_dispatch_repo_root" branch -D "task/$version/$slug" >/dev/null
  _dispatch_ledger_event abandon "$version" "$slug"
  _dispatch_schedule_metrics
  echo "abandoned: $slug"
}

main() {
  (($#)) || { _dispatch_usage; exit 2; }
  case "$1" in
    start) shift; _dispatch_start "$@" ;;
    status) shift; (($# <= 1)) || _dispatch_error "status accepts at most one slug"; _dispatch_status "${1:-}" ;;
    land) shift; _dispatch_land "$@" ;;
    resume) shift; _dispatch_resume "$@" ;;
    abandon) shift; _dispatch_abandon "$@" ;;
    -h|--help) _dispatch_usage ;;
    *) _dispatch_error "unknown command: $1" ;;
  esac
}
main "$@"
