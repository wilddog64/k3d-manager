#!/usr/bin/env bash
# shellcheck disable=SC2016

set -euo pipefail

_dispatch_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_dispatch_repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "${_dispatch_repo_root}" ]] || _dispatch_repo_root="$(cd "${_dispatch_script_dir}/.." && pwd)"
# shellcheck source=/dev/null
source "${_dispatch_script_dir}/../scripts/lib/system.sh"
_dispatch_worktree_root="${K3DM_WORKTREE_ROOT:-${HOME}/.local/share/k3d-manager/worktrees}"
_dispatch_event_repo="k3d-manager"

_dispatch_ledger_event() {
  local event="$1" version="$2" slug="$3" json filter='.' arg_count event_repo="$_dispatch_event_repo"
  shift 3
  if [[ -s "$_dispatch_worktree_root/$version/$slug.run/repo-name" ]]; then
    event_repo="$(<"$_dispatch_worktree_root/$version/$slug.run/repo-name")"
  fi
  if (($#)); then
    arg_count=$#; filter="${!arg_count}"; set -- "${@:1:arg_count-1}"
  fi
  json="$(jq -nc --arg event "$event" --arg version "$version" --arg slug "$slug" \
    --argjson ts "$(date +%s)" --arg repo "$event_repo" "$@" "{ts:\$ts,event:\$event,version:\$version,slug:\$slug,repo:\$repo} | ($filter)" 2>/dev/null)" || {
    echo "[codex-dispatch] WARNING: could not build ledger event ${event} for ${slug}" >&2
    return 1
  }
  if ! printf '%s\n' "$json" >>"$_dispatch_worktree_root/ledger.jsonl"; then
    echo "[codex-dispatch] WARNING: could not write $_dispatch_worktree_root/ledger.jsonl" >&2
    return 1
  fi
}

_dispatch_ledger_event_best_effort() {
  _dispatch_ledger_event "$@" || true
}

_dispatch_schedule_metrics() {
  mkdir -p "$_dispatch_worktree_root" 2>/dev/null || true
  local lock="$_dispatch_worktree_root/metrics.lock" pending="$_dispatch_worktree_root/metrics.pending"
  if ! mkdir "$lock" 2>/dev/null; then
    if [[ -d "$lock" ]] && [[ -n "$(find "$lock" -maxdepth 0 -mmin +10 -print -quit 2>/dev/null)" ]]; then
      rm -rf "$lock"
      mkdir "$lock" 2>/dev/null || { touch "$pending"; return 0; }
    else
      touch "$pending"
      # Close the release race: if the lock disappeared after our failed mkdir,
      # become the next lock holder instead of leaving a pending request behind.
      [[ -d "$lock" ]] || { _dispatch_schedule_metrics; return 0; }
      return 0
    fi
  fi
  (
    # shellcheck disable=SC2329 # invoked indirectly by the EXIT trap
    _dispatch_metrics_cleanup() {
      if (( owns_lock )); then rmdir "$lock" 2>/dev/null || true; fi
    }
    owns_lock=1
    trap _dispatch_metrics_cleanup EXIT
    trap 'exit 1' HUP INT TERM
    while :; do
      rm -f "$pending"
      "${K3DM_DISPATCH_METRICS_BIN:-$_dispatch_script_dir/k3dm-dispatch-metrics}" >>"$_dispatch_worktree_root/metrics.log" 2>&1 || true
      [[ -e "$pending" ]] && continue
      rmdir "$lock" 2>/dev/null || break
      owns_lock=0
      if [[ -e "$pending" ]] && mkdir "$lock" 2>/dev/null; then owns_lock=1; continue; fi
      break
    done
  ) &
}

_dispatch_log() {
  local run="$1" message="$2"
  printf '[%s] %s\n' "$(date +%s)" "$message" >>"$run/supervisor.log"
}

_dispatch_atomic_write() {
  local path="$1" content="$2" tmp
  tmp="${path}.tmp.$$"
  printf '%b' "$content" >"$tmp" && mv -f "$tmp" "$path"
}

_dispatch_process_start() {
  ps -p "$1" -o lstart= 2>/dev/null | sed 's/^ *//; s/ *$//'
}

_dispatch_write_start_marker() {
  local run="$1" started process_start
  started="$(date +%s)"
  process_start="$(_dispatch_process_start $$)"
  [[ -n "$process_start" ]] || process_start=unavailable
  _dispatch_atomic_write "$run/start" "pid=$$\nstarted=$started\nprocess_start=$process_start\n"
  _dispatch_atomic_write "$run/pid" "$$\n"
}

_dispatch_write_exit_marker() {
  local run="$1" exit_code="$2" ts
  ts="$(date +%s)"
  _dispatch_atomic_write "$run/exit" "${exit_code}\n"
  _dispatch_atomic_write "$run/codex-exit-ts" "${ts}\n"
}

_dispatch_start_marker_value() {
  local run="$1" key="$2"
  awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); print; exit}' "$run/start" 2>/dev/null
}

_dispatch_worker_matches_start() {
  local run="$1" pid marker_start current_start
  [[ -s "$run/start" ]] || return 1
  pid="$(_dispatch_start_marker_value "$run" pid)"
  marker_start="$(_dispatch_start_marker_value "$run" process_start)"
  [[ "$pid" =~ ^[0-9]+$ && -n "$marker_start" ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  current_start="$(_dispatch_process_start "$pid")"
  [[ "$marker_start" == unavailable ]] || [[ -n "$current_start" && "$current_start" == "$marker_start" ]]
}

_dispatch_identity_parts() {
  local identity="$1"
  [[ "$identity" =~ ^([A-Za-z0-9._:-]{1,64})/([A-Za-z0-9._:-]{1,64})$ ]] || return 1
  printf '%s\n%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
}

_dispatch_primary_identity_json() {
  local identity="$1" source="$2" vendor=unknown model=unknown status=unknown parts=""
  case "$identity" in
    "") case "$source" in ""|unknown) source=unknown ;; *) return 1 ;; esac ;;
    *)
      case "$source" in "") source=declared ;; declared|runtime-reported) ;; *) return 1 ;; esac
      parts="$(_dispatch_identity_parts "$identity")" || return 1
      vendor="${parts%%$'\n'*}"; model="${parts#*$'\n'}"
      case "$source" in runtime-reported) status=runtime_reported ;; *) status=declared ;; esac
      ;;
  esac
  jq -nc --arg vendor "$vendor" --arg model "$model" --arg source "$source" --arg status "$status" \
    '{vendor:$vendor,model:$model,source:$source,status:$status}'
}

_dispatch_codex_exit() {
  local worktree="$1" run="$2" version="$3" slug="$4" log="$5" exit_code="$6" run_number="$7" tokens tree session_id
  tokens="$(awk '/^tokens used$/{getline; gsub(/,/, ""); if ($0 ~ /^[0-9]+$/) value=$0} END{if (value != "") print value}' "$log" 2>/dev/null || true)"
  session_id="$(sed -n 's/^session id: //p' "$log" 2>/dev/null | head -n 1)"
  git -C "$worktree" add -A || return 1
  tree="$(git -C "$worktree" write-tree)" || return 1
  git -C "$worktree" reset -q || return 1
  printf '%s\n' "$tree" >"$run/codex-tree"
  if [[ -n "$tokens" ]]; then
    _dispatch_ledger_event codex_exit "$version" "$slug" \
      --argjson exit "$exit_code" --argjson tokens "$tokens" --arg tree "$tree" \
      --argjson run "$run_number" --arg session "$session_id" \
      '.["exit"]=$exit|.["tokens"]=$tokens|.["tree"]=$tree|.["run"]=$run|.["session"]=$session' || return 1
  else
    _dispatch_ledger_event codex_exit "$version" "$slug" \
      --argjson exit "$exit_code" --arg tree "$tree" \
      --argjson run "$run_number" --arg session "$session_id" \
      '.["exit"]=$exit|.["tokens"]=null|.["tree"]=$tree|.["run"]=$run|.["session"]=$session' || return 1
  fi
  _dispatch_schedule_metrics
}

_dispatch_agy_exit() {
  local worktree="$1" run="$2" version="$3" slug="$4" log="$5" exit_code="$6" run_number="$7" tree json usage conversation
  tree="$(git -C "$worktree" write-tree 2>/dev/null || true)"
  [[ -n "$tree" ]] && printf '%s\n' "$tree" >"$run/codex-tree"
  json="$(tail -n 1 "$log" 2>/dev/null || true)"
  conversation="$(jq -r '.conversation_id // .conversationId // .session_id // empty' <<<"$json" 2>/dev/null || true)"
  [[ -n "$conversation" || ! -s "$run/session" ]] || conversation="$(<"$run/session")"
  [[ -z "$conversation" ]] || printf '%s\n' "$conversation" >"$run/session"
  usage="$(jq -c '.usage // .result.usage // empty' <<<"$json" 2>/dev/null || true)"
  _dispatch_ledger_event_best_effort agent_exit "$version" "$slug" --argjson exit "$exit_code" \
    --argjson usage "${usage:-null}" --arg tree "${tree:-}" --argjson run "$run_number" --arg session "$conversation" \
    '.exit=$exit|.usage=$usage|.tree=$tree|.run=$run|.session=$session'
  [[ -z "$usage" ]] || _dispatch_ledger_event_best_effort agent_usage "$version" "$slug" \
    --argjson usage "$usage" --argjson run "$run_number" '.usage=$usage|.run=$run'
  _dispatch_schedule_metrics
}

_dispatch_codex_usage() {
  local log="$1" version="$2" slug="$3" session_id codex_home file usage model input cached output
  local -a matches=()
  session_id="$(sed -n 's/^session id: //p' "$log" 2>/dev/null | head -n 1)"
  codex_home="${CODEX_HOME:-${HOME}/.codex}"
  if [[ -z "$session_id" ]]; then
    echo "[codex-dispatch] WARNING: no session id in $log" >&2; return 1
  fi
  while IFS= read -r file; do [[ -n "$file" ]] && matches+=("$file"); done \
    < <(find "$codex_home/sessions" -type f -name "rollout-*-${session_id}.jsonl" -print 2>/dev/null)
  if ((${#matches[@]} != 1)); then
    echo "[codex-dispatch] WARNING: expected one session file for ${session_id}, found ${#matches[@]}" >&2; return 1
  fi
  file="${matches[0]}"
  usage="$(jq -sc '[.[] | .payload.info.total_token_usage? // empty] | last // empty' "$file" 2>/dev/null)"
  model="$(jq -sr '[.[] | (.payload.model? // .payload.info.model? // empty) | select(type == "string")] | last // empty' "$file" 2>/dev/null)"
  if [[ -z "$usage" ]] || ! jq -e 'type == "object" and (.input_tokens|type=="number") and (.cached_input_tokens|type=="number") and (.output_tokens|type=="number")' <<<"$usage" >/dev/null 2>&1; then
    echo "[codex-dispatch] WARNING: could not parse token usage for ${session_id}" >&2; return 1
  fi
  input="$(jq -r '.input_tokens' <<<"$usage")"
  cached="$(jq -r '.cached_input_tokens' <<<"$usage")"
  output="$(jq -r '.output_tokens' <<<"$usage")"
  if [[ -n "$model" ]]; then
    _dispatch_ledger_event codex_usage "$version" "$slug" --arg session "$session_id" --arg model "$model" \
      --argjson input "$input" --argjson cached_input "$cached" --argjson output "$output" \
      '.session=$session|.model=$model|.input=$input|.cached_input=$cached_input|.output=$output'
  else
    _dispatch_ledger_event codex_usage "$version" "$slug" --arg session "$session_id" --argjson input "$input" \
      --argjson cached_input "$cached" --argjson output "$output" \
      '.session=$session|.model=null|.input=$input|.cached_input=$cached_input|.output=$output'
  fi
  [[ "${_DISPATCH_SKIP_METRICS:-0}" == 1 ]] || _dispatch_schedule_metrics
}

_dispatch_worker() {
  local operation="$1" worktree="$2" run="$3" version="$4" slug="$5" network="$6" n="${7:-}" session_id="${8:-}" agent="${9:-codex}" model="${10:-}" model_source="${11:-inherited}"
  local -a state_vars
  local run_number="${n:-1}"
  _dispatch_write_start_marker "$run" || { _dispatch_log "$run" "could not write worker start marker"; return 125; }
  state_vars=(
    "K3DM_REPO_ROOT=$worktree" "K3DM_JOB_DIR=$run/state/jobs" "K3DM_RUN_DIR=$run/state/run"
    "K3DM_STATE_DIR=$run/state/state" "K3DM_LOG_DIR=$run/state/logs" "K3DM_TMP_ROOT=$run/state/tmp"
    "K3DM_PORT_CACHE_DIR=$run/state/port-cache" "TMPDIR=$run/state/tmp"
  )
  _dispatch_event_repo="$(cat "$run/repo-name" 2>/dev/null || echo k3d-manager)"
  [[ "$agent" != agy ]] || state_vars+=("K3DM_DISPATCH_SLUG=$slug")
  cd "$worktree" || { _dispatch_log "$run" "could not enter worker worktree"; return 125; }
  set +e
  if [[ "$agent" == agy ]]; then
    if [[ "$operation" == resume ]]; then
      env "${state_vars[@]}" "${K3DM_AGY_BIN:-agy}" --print "$(<"$run/prompt-$n.md")" --output-format json --model "$model" --sandbox --add-dir "$worktree" --add-dir "$run/state" --dangerously-skip-permissions --conversation "$session_id" >"$run/agy-$n.log" 2>&1
    else
      env "${state_vars[@]}" "${K3DM_AGY_BIN:-agy}" --print "$(<"$run/prompt.md")" --output-format json --model "$model" --sandbox --add-dir "$worktree" --add-dir "$run/state" --dangerously-skip-permissions >"$run/agy.log" 2>&1
    fi
  elif [[ "$operation" == start ]]; then
    if (( network )); then
      if [[ -n "$model" ]]; then env "${state_vars[@]}" "${K3DM_CODEX_BIN:-codex}" exec -m "$model" --sandbox workspace-write -C "$worktree" --add-dir "$run/state" -o "$run/last-message.md" -c sandbox_workspace_write.network_access=true - <"$run/prompt.md" >"$run/codex.log" 2>&1
      else env "${state_vars[@]}" "${K3DM_CODEX_BIN:-codex}" exec --sandbox workspace-write -C "$worktree" --add-dir "$run/state" -o "$run/last-message.md" -c sandbox_workspace_write.network_access=true - <"$run/prompt.md" >"$run/codex.log" 2>&1; fi
    else
      if [[ -n "$model" ]]; then env "${state_vars[@]}" "${K3DM_CODEX_BIN:-codex}" exec -m "$model" --sandbox workspace-write -C "$worktree" --add-dir "$run/state" -o "$run/last-message.md" - <"$run/prompt.md" >"$run/codex.log" 2>&1
      else env "${state_vars[@]}" "${K3DM_CODEX_BIN:-codex}" exec --sandbox workspace-write -C "$worktree" --add-dir "$run/state" -o "$run/last-message.md" - <"$run/prompt.md" >"$run/codex.log" 2>&1; fi
    fi
  elif (( network )); then
    if [[ -n "$model" ]]; then env "${state_vars[@]}" "${K3DM_CODEX_BIN:-codex}" exec resume -m "$model" -c 'sandbox_mode="workspace-write"' -c "sandbox_workspace_write.writable_roots=[\"$run/state\"]" -c sandbox_workspace_write.network_access=true -o "$run/last-message-$n.md" "$session_id" - <"$run/prompt-$n.md" >"$run/codex-$n.log" 2>&1
    else env "${state_vars[@]}" "${K3DM_CODEX_BIN:-codex}" exec resume -c 'sandbox_mode="workspace-write"' -c "sandbox_workspace_write.writable_roots=[\"$run/state\"]" -c sandbox_workspace_write.network_access=true -o "$run/last-message-$n.md" "$session_id" - <"$run/prompt-$n.md" >"$run/codex-$n.log" 2>&1; fi
  else
    if [[ -n "$model" ]]; then env "${state_vars[@]}" "${K3DM_CODEX_BIN:-codex}" exec resume -m "$model" -c 'sandbox_mode="workspace-write"' -c "sandbox_workspace_write.writable_roots=[\"$run/state\"]" -o "$run/last-message-$n.md" "$session_id" - <"$run/prompt-$n.md" >"$run/codex-$n.log" 2>&1
    else env "${state_vars[@]}" "${K3DM_CODEX_BIN:-codex}" exec resume -c 'sandbox_mode="workspace-write"' -c "sandbox_workspace_write.writable_roots=[\"$run/state\"]" -o "$run/last-message-$n.md" "$session_id" - <"$run/prompt-$n.md" >"$run/codex-$n.log" 2>&1; fi
  fi
  local exit_code="$?" log="$run/codex.log"
  [[ "$agent" == agy ]] && log="$run/agy.log"
  [[ "$operation" == start ]] || log="$run/codex-$n.log"
  if [[ "$agent" == agy ]]; then
    [[ "$operation" == start ]] || log="$run/agy-$n.log"
    _dispatch_write_exit_marker "$run" "$exit_code" || _dispatch_log "$run" "could not write agent exit marker"
    if [[ "$(git -C "$worktree" rev-parse HEAD)" != "$(<"$run/base")" ]]; then
      : >"$run/violation"
      _dispatch_ledger_event_best_effort scope_violation "$version" "$slug" --arg reason 'agent committed' '.reason=$reason'
    fi
    _dispatch_agy_exit "$worktree" "$run" "$version" "$slug" "$log" "$exit_code" "$run_number"
  else
    _dispatch_write_exit_marker "$run" "$exit_code" || _dispatch_log "$run" "could not write Codex exit marker"
    local runtime_model
    runtime_model="$(awk 'NR <= 40 && /^model: [^[:space:]]+$/ {sub(/^model: /, ""); print; exit}' "$log" 2>/dev/null || true)"
    if [[ "$runtime_model" =~ ^[A-Za-z0-9._:-]{1,64}$ ]]; then
      _dispatch_ledger_event_best_effort identity "$version" "$slug" --argjson run "$run_number" \
        --arg vendor openai --arg model "$runtime_model" \
        '.run=$run|.worker_identity={vendor:$vendor,model:$model,source:"runtime",status:"reported"}'
    fi
    if ! _dispatch_codex_exit "$worktree" "$run" "$version" "$slug" "$log" "$exit_code" "$run_number"; then
      _dispatch_log "$run" "Codex bookkeeping failed after exit code ${exit_code} was recorded"
    fi
    _dispatch_codex_usage "$log" "$version" "$slug" || true
  fi
  return "$exit_code"
}

_dispatch_detach_worker() {
  local run="$1"; shift
  perl -MPOSIX -e 'defined(my $first = fork) or die "fork failed\n"; exit 0 if $first; POSIX::setsid() >= 0 or die "setsid failed\n"; defined(my $second = fork) or die "second fork failed\n"; exit 0 if $second; exec @ARGV or die "exec failed\n"' \
    "$_dispatch_script_dir/k3dm-codex-dispatch" _worker "$@" >>"$run/supervisor.log" 2>&1 &
}

_dispatch_wait_for_start() {
  local run="$1" attempt
  for ((attempt = 1; attempt <= 40; attempt++)); do
    [[ -s "$run/start" ]] && return 0
    sleep 0.05
  done
  return 1
}

_dispatch_error() { echo "[codex-dispatch] ERROR: $*" >&2; exit 2; }
_dispatch_usage() {
  cat <<'EOF'
Usage:
  bin/k3dm-codex-dispatch start --spec PATH [--slug SLUG] [--agent codex|agy] [--model ID] [--coordinator VENDOR/MODEL] [--primary-coordinator VENDOR/MODEL] [--network] [--repo PATH --branch NAME]
  bin/k3dm-codex-dispatch status [SLUG]
  bin/k3dm-codex-dispatch open [--version vX.Y.Z]
  bin/k3dm-codex-dispatch land --slug SLUG (--test CMD|--no-test) [--landing-actor ACTOR] [--landing-model VENDOR/MODEL] [--review-pending] [--allow-out-of-scope]
  bin/k3dm-codex-dispatch resume --slug SLUG --prompt-file PATH --reason continue_prompt|clarification|correction|other [--model ID] [--coordinator VENDOR/MODEL]
  bin/k3dm-codex-dispatch handoff --slug SLUG --acting-coordinator VENDOR/MODEL [--reason ENUM] [--provenance declared|runtime-reported]
  bin/k3dm-codex-dispatch verify --slug SLUG --result pass|fail [--evidence FILE] [--tokens N] [--verifier NAME]
  bin/k3dm-codex-dispatch intervention --slug SLUG --reason continue_prompt|clarification|correction|other
  bin/k3dm-codex-dispatch abandon --slug SLUG --yes
  bin/k3dm-codex-dispatch prune [--yes]
  bin/k3dm-codex-dispatch usage-backfill
  bin/k3dm-codex-dispatch release-merged --version vX.Y.Z --pr N --merged-at YYYY-MM-DDTHH:MM:SSZ
  bin/k3dm-codex-dispatch gate-status --slug SLUG [--version V] [--json] [--as-of TS]
  bin/k3dm-codex-dispatch mark --slug S [--version V] --state offline_tested|deployed|live_verified --sha SHA --evidence FILE --by NAME
  bin/k3dm-codex-dispatch gate-record --slug S [--version V] --event EVENT [event-specific flags]
  bin/k3dm-codex-dispatch gate-coverage-start
  bin/k3dm-codex-dispatch link --slug S [--version V] --parent P --role build|review|verify
  bin/k3dm-codex-dispatch combine [--version V] --parent P --parts a,b --conflicts N --result pass|fail --evidence FILE --by NAME
EOF
}

# S1 gate commands share one deterministic, line-order ledger reader. Keeping
# this in the dispatcher avoids creating a second state file or dependency.
_dispatch_s1() {
  python3 - "$_dispatch_worktree_root" "$_dispatch_repo_root" "$@" <<'PY'
import hashlib, json, os, re, subprocess, sys, time
from pathlib import Path

root, manager, command, *args = sys.argv[1:]
ledger = Path(root) / 'ledger.jsonl'
PARENT = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$')
def die(msg): print('[codex-dispatch] ERROR: '+msg, file=sys.stderr); raise SystemExit(2)
def parse(argv, boolean=()):
    d={}; i=0
    while i<len(argv):
        k=argv[i]
        if not k.startswith('--'): die('unexpected argument '+k)
        if k in d: die('duplicate flag '+k)
        if k in boolean: d[k]=True; i+=1; continue
        if i+1>=len(argv) or argv[i+1].startswith('--'): die(k+' requires a value')
        d[k]=argv[i+1]; i+=2
    return d
def read_lines():
    rows=[]; bad=0
    if not ledger.exists(): return rows,bad
    try: raw=ledger.read_bytes().splitlines()
    except OSError as e: die(str(e))
    for line in raw:
        try:
            x=json.loads(line.decode('utf-8'))
            if not isinstance(x,dict) or isinstance(x.get('ts'),bool) or not isinstance(x.get('ts'),(int,float)): raise ValueError()
            rows.append(x)
        except Exception: bad+=1
    return rows,bad
def task_rows(rows, slug, version=None, cutoff=None):
    selected=[x for x in rows if x.get('slug')==slug and x.get('event')=='start' and (cutoff is None or x['ts']<=cutoff)]
    versions=list(dict.fromkeys(x.get('version') for x in selected))
    if version is None:
        if len(versions)!=1: die('slug does not resolve to exactly one task version')
        version=versions[0]
    alltask=[x for x in rows if x.get('slug')==slug and x.get('version')==version]
    starts=[i for i,x in enumerate(alltask) if x.get('event')=='start' and (cutoff is None or x['ts']<=cutoff)]
    if not starts: die('task has no start at or before --as-of')
    # Full history for parent/interventions; current attempt begins at last start.
    attempt=alltask[starts[-1]:]
    return version, alltask, attempt
def assess_status(rows, slug, version=None, cutoff=None, bad=0):
    version, hist, a = task_rows(rows,slug,version,cutoff)
    coverage=next((i for i,x in enumerate(rows) if x.get('event')=='gate_coverage_start'),None)
    first=next((i for i,x in enumerate(rows) if x.get('event')=='start' and x.get('slug')==slug and x.get('version')==version),None)
    covered=coverage is not None and first is not None and first>=coverage
    run=1; runs=set(); exits={}; charged={}; assessments={}; interventions=0
    for i,x in enumerate(a):
        ev=x.get('event')
        if ev=='start': run=x.get('run',1); runs.add(run)
        elif ev=='resume':
            outgoing=run
            if x.get('reason')=='correction': charged.setdefault(outgoing,i)
            run=x.get('run',x.get('n',run+1)); runs.add(run)
        elif ev in ('codex_exit','agent_exit'):
            rn=x.get('run',run); exits[rn]=x.get('exit');
            if x.get('exit') not in (0,None): charged.setdefault(rn,i)
        elif ev in ('verify','land_refused'):
            rn=run
            if ev=='verify' and x.get('result')=='fail': charged.setdefault(rn,i)
            if ev=='land_refused' and x.get('reason') in ('tests','fast-gate'): charged.setdefault(rn,i)
        if ev=='attempt_assessed' and isinstance(x.get('run'),int): assessments[x['run']]=(i,x)
    for rn,(idx,x) in assessments.items():
        if rn not in runs: continue
        if x.get('outcome') in ('failed','rework'): charged[rn]=idx
        elif x.get('outcome') in ('progress','quota'): charged.pop(rn,None)
    progress=[rn for rn,(_,x) in assessments.items() if rn in runs and x.get('outcome')=='progress' and x.get('new_evidence_sha256')]
    p=max(progress,default=0)
    clears=[i for i,x in enumerate(a) if x.get('event')=='gate_cleared' and x.get('gate')=='stall']
    lastclear=max(clears,default=-1)
    unsuccessful=sorted(charged)
    streak=sum(1 for r,i in charged.items() if r>p and i>lastclear)
    interventions=sum(1 for x in hist if x.get('event')=='intervention')
    terminal=any(x.get('event') in ('land','abandon') for x in a)
    stall='closed' if terminal else 'open' if streak>=2 else 'clear'
    states={x.get('state') for x in a if x.get('event')=='state_mark'}
    lastverify=next((x for x in reversed(a) if x.get('event')=='verify'),None)
    ladder={
      'implemented':'done' if exits.get(run)==0 else 'pending',
      'offline_tested':'done' if 'offline_tested' in states else ('pending' if covered else 'unknown'),
      'independently_verified':'done' if lastverify and lastverify.get('result')=='pass' and lastverify.get('evidence_sha256') else 'unknown' if lastverify and lastverify.get('result')=='pass' else 'pending',
      'landed':'done' if any(x.get('event')=='land' for x in a) else 'pending',
      'deployed':'done' if 'deployed' in states else ('pending' if covered else 'unknown'),
      'live_verified':'done' if 'live_verified' in states else ('pending' if covered else 'unknown')}
    gateclears={g:max((i for i,x in enumerate(a) if x.get('event')=='gate_cleared' and x.get('gate')==g),default=-1) for g in ('scope','arch')}
    scopes=[{'ts':x.get('ts'),'paths':x.get('paths',[]),'risk':x.get('risk')} for i,x in enumerate(a) if x.get('event')=='scope_gate' and i>gateclears['scope']]
    arch=[{'ts':x.get('ts'),'decision':x.get('decision'),'reviewer':x.get('reviewer')} for i,x in enumerate(a) if x.get('event')=='architecture_review' and i>gateclears['arch']]
    parent=role=None
    for x in hist:
        if x.get('event') in ('start','link') and 'parent' in x: parent=x['parent']; role=x.get('role')
    landed=ladder['landed']=='done'
    action='none' if any(x.get('event')=='abandon' for x in a) else 'stall_review' if stall=='open' else 'clear_gate' if scopes or arch else 'wait_for_run' if not landed and run not in exits else 'resume_or_abandon' if not landed and exits.get(run) not in (None,0) else 'land' if not landed else 'verify' if ladder['independently_verified']=='pending' else 'deploy' if ladder['deployed']=='pending' else 'live_verify' if ladder['live_verified']=='pending' else 'none'
    return {'version':version,'slug':slug,'as_of':cutoff,'advisory':True,'ladder':ladder,'stall':stall,'streak':streak,'unsuccessful':unsuccessful,'runs':len(runs),'human_interventions':interventions,'open_scope':scopes,'open_architecture':arch,'parent':parent,'role':role,'bad_lines':bad,'next_action':action}
def append(event, version=None, slug=None, **fields):
    obj={'ts':int(time.time()),'event':event,'version':version,'repo':'k3d-manager',**fields}
    if slug is not None: obj['slug']=slug
    if slug and version:
        rp=Path(root)/version/(slug+'.run')/'repo-name'
        if rp.is_file(): obj['repo']=rp.read_text().strip()
    ledger.parent.mkdir(parents=True,exist_ok=True)
    with ledger.open('a') as f: f.write(json.dumps(obj,separators=(',',':'))+'\n')
    if command!='gate-status':
        subprocess.Popen([os.environ.get('K3DM_DISPATCH_METRICS_BIN',str(Path(manager)/'bin/k3dm-dispatch-metrics'))],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
def current_version(rows):
    branch=subprocess.run(['git','-C',manager,'symbolic-ref','--quiet','--short','HEAD'],text=True,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL).stdout.strip()
    m=re.fullmatch(r'k3d-manager-(v?\d+\.\d+\.\d+)',branch)
    if m: return m.group(1)
    starts=[x.get('version') for x in rows if x.get('event')=='start']
    return starts[-1] if starts else None
def resolve(d, rows):
    if not d.get('--slug'): die('missing --slug')
    version=d.get('--version')
    return task_rows(rows,d['--slug'],version)[0]
def known_runs(rows, slug, version):
    known=set(); latest=1
    for row in task_rows(rows,slug,version)[2]:
        if row.get('event')=='start':
            latest=row.get('run',1); known.add(latest)
        elif row.get('event')=='resume':
            latest=row.get('run',row.get('n',latest+1)); known.add(latest)
    return known
rows,bad=read_lines()
if command=='gate-status':
    d=parse(args,('--json',))
    cutoff=None
    if '--as-of' in d:
        try: cutoff=int(d['--as-of'])
        except (TypeError,ValueError): die('invalid --as-of')
    rows=[x for x in rows if cutoff is None or x['ts']<=cutoff]
    if set(d)-{'--slug','--version','--json','--as-of'}: die('unlisted gate-status flag')
    if '--slug' not in d: die('missing --slug')
    out=assess_status(rows,d['--slug'],d.get('--version'),cutoff,bad)
    if '--json' in d: print(json.dumps(out,separators=(',',':')))
    else: print(json.dumps(out,indent=2)); print('Result is advisory and self-reported.')
else:
    d=parse(args)
if command=='gate-status':
    pass
elif command=='gate-coverage-start':
    if d: die('gate-coverage-start takes no flags')
    if not any(x.get('event')=='gate_coverage_start' for x in rows): append('gate_coverage_start',current_version(rows))
elif command in ('link','mark','gate-record','combine'):
    slug=d.get('--slug'); version=d.get('--version')
    if command=='combine':
        allowed={'--version','--parent','--parts','--conflicts','--result','--evidence','--by'}
        if set(d)-allowed or not {'--parent','--parts','--conflicts','--result','--evidence','--by'}.issubset(d): die('missing or unlisted combine flag')
        p=d.get('--parent',''); parts=d.get('--parts','').split(',') if d.get('--parts') else []
        if not PARENT.fullmatch(p): die('invalid parent')
        if d.get('--result') not in ('pass','fail') or not d.get('--conflicts','').isdigit(): die('invalid combine values')
        ev=Path(d.get('--evidence',''))
        if not ev.is_file() or not os.access(ev,os.R_OK) or ev.stat().st_size==0: die('invalid evidence file')
        if version:
            resolved_version=version
        else:
            part_versions=[task_rows(rows,part,None)[0] for part in parts]
            if not part_versions: die('combine requires at least one part')
            if len(set(part_versions))!=1: die('combine parts do not resolve to one task version')
            resolved_version=part_versions[0]
        for part in parts:
            v,h,a=task_rows(rows,part,resolved_version)
            cur=None
            for x in h:
                if x.get('event') in ('start','link') and 'parent' in x: cur=x.get('parent')
            if cur!=p: die('part is not linked to parent')
        append('combine',resolved_version,None,parent=p,parts=parts,conflicts=int(d['--conflicts']),result=d['--result'],evidence_path=d['--evidence'],evidence_sha256=hashlib.sha256(ev.read_bytes()).hexdigest(),recorded_by=d['--by'])
    else:
        if not slug: die('missing --slug')
        version=resolve(d,rows)
        if command=='link':
            if set(d)-{'--slug','--version','--parent','--role'} or not {'--slug','--parent','--role'}.issubset(d): die('missing or unlisted link flag')
            p=d.get('--parent',''); role=d.get('--role')
            if not PARENT.fullmatch(p) or role not in ('build','review','verify'): die('invalid parent or role')
            append('link',version,slug,parent=p,role=role)
        elif command=='mark':
            if set(d)-{'--slug','--version','--state','--sha','--evidence','--by'} or not {'--slug','--state','--sha','--evidence','--by'}.issubset(d): die('missing or unlisted mark flag')
            state=d.get('--state'); sha=d.get('--sha',''); ev=Path(d.get('--evidence',''))
            if state not in ('offline_tested','deployed','live_verified') or not re.fullmatch('[0-9a-fA-F]{40}',sha): die('invalid state or sha')
            repo=Path(root)/version/(slug+'.run')/'repo'; repo=Path(repo.read_text().strip()) if repo.is_file() else Path(os.environ.get('K3DM_REPO_ROOT',manager))
            if subprocess.run(['git','-C',str(repo),'cat-file','-e',sha+'^{commit}'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode: die('sha is not a task repo commit')
            if not ev.is_file() or ev.stat().st_size==0 or not os.access(ev,os.R_OK): die('invalid evidence')
            if state!='offline_tested':
                txt=ev.read_text(); pieces=txt.splitlines(); sep=next((i for i,line in enumerate(pieces) if line.strip()=='---'),None); head='\n'.join(pieces[:sep]) if sep is not None else ''; output=pieces[sep+1:] if sep is not None else []
                if any(not re.search(r'^'+k+r':\s*\S',head,re.M) for k in ('artifact','environment','command')) or not re.search(r'^rc:\s*0\s*$',head,re.M) or not any(line.strip() for line in output): die('live evidence header is incomplete')
            append('state_mark',version,slug,state=state,sha=sha,evidence_path=d['--evidence'],evidence_sha256=hashlib.sha256(ev.read_bytes()).hexdigest(),recorded_by=d['--by'])
        else:
            event=d.get('--event'); fields={
             'attempt_assessed':({'--run','--outcome','--assessor','--baseline-sha'},{'--new-evidence'}),
             'stall_gate':({'--runs','--reason','--assessor','--baseline-sha'},set()),
             'replan_reviewed':({'--decision','--reviewer','--plan','--baseline-sha'},set()),
             'scope_gate':({'--paths','--risk','--assessor','--baseline-sha'},set()),
             'architecture_review':({'--decision','--reviewer','--evidence','--baseline-sha'},set()),
             'gate_cleared':({'--gate','--by','--evidence'},set())}
            if event not in fields: die('unknown gate event')
            required,optional=fields[event]
            if set(d)-{'--slug','--version','--event'}-required-optional or not required.issubset(d): die('missing or unlisted gate-record flag')
            enums={'--outcome':{'failed','rework','progress','quota','unknown'},'--decision':{'approved','rejected','narrow_fix','diagnose_first','separate_security_spec','change_architecture','operator_decision_required'},'--risk':{'normal','high'},'--gate':{'stall','scope','arch'}}
            if '--outcome' in d and d['--outcome'] not in {'failed','rework','progress','quota','unknown'}: die('invalid --outcome')
            if '--decision' in d:
                choices={'approved','rejected'} if event=='replan_reviewed' else {'narrow_fix','diagnose_first','separate_security_spec','change_architecture','operator_decision_required'}
                if d['--decision'] not in choices: die('invalid --decision')
            if '--risk' in d and d['--risk'] not in {'normal','high'}: die('invalid --risk')
            if '--gate' in d and d['--gate'] not in {'stall','scope','arch'}: die('invalid --gate')
            commits=[x for x in rows if x.get('slug')==slug and x.get('version')==version and x.get('event') in ('start','resume')]
            for k in ('--reviewer',):
                if k in d and any(d[k] in (x.get('agent'),(x.get('worker_identity') or {}).get('model')) for x in commits): die('reviewer is the worker')
            if '--baseline-sha' in d:
                repo=Path(root)/version/(slug+'.run')/'repo'; repo=repo.read_text().strip() if repo.is_file() else os.environ.get('K3DM_REPO_ROOT',manager)
                if not re.fullmatch('[0-9a-fA-F]{40}',d['--baseline-sha']) or subprocess.run(['git','-C',repo,'cat-file','-e',d['--baseline-sha']+'^{commit}'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode: die('invalid baseline commit')
            data={}
            mapping={'--run':'run','--runs':'runs','--outcome':'outcome','--assessor':'assessor','--baseline-sha':'baseline_sha','--reason':'reason','--decision':'decision','--reviewer':'reviewer','--risk':'risk','--paths':'paths','--gate':'gate','--by':'by'}
            for k,v in d.items():
                if k in mapping: data[mapping[k]]=(v.split(',') if k=='--paths' else v)
            evidence_key={'--new-evidence':'new_evidence','--plan':'plan','--evidence':'evidence'}.get(next((k for k in ('--new-evidence','--plan','--evidence') if k in d),''))
            for k in ('--new-evidence','--plan','--evidence'):
                if k in d:
                    ev=Path(d[k]);
                    if not ev.is_file() or not os.access(ev,os.R_OK) or ev.stat().st_size==0: die('invalid evidence file')
                    data[evidence_key+'_path' if evidence_key!='new_evidence' else 'new_evidence_path']=d[k]; data[evidence_key+'_sha256' if evidence_key!='new_evidence' else 'new_evidence_sha256']=hashlib.sha256(ev.read_bytes()).hexdigest()
            if event=='attempt_assessed' and not evidence_key: data.update(new_evidence_path=None,new_evidence_sha256=None)
            if event=='attempt_assessed':
                try: data['run']=int(data['run'])
                except (TypeError,ValueError): die('invalid --run')
                if data['run'] not in known_runs(rows,slug,version): die('unknown run')
            if event=='stall_gate':
                try: data['runs']=[int(n) for n in data['runs'].split(',')]
                except (TypeError,ValueError): die('invalid --runs')
                if not data['runs'] or any(n not in known_runs(rows,slug,version) for n in data['runs']): die('unknown run')
            if event in ('stall_gate','scope_gate'): data['gate_state']='opened'
            if event=='gate_cleared':
                status=assess_status(rows,slug,version,None,bad)
                if (d['--gate']=='stall' and status['stall']!='open') or (d['--gate']=='scope' and not status['open_scope']) or (d['--gate']=='arch' and not status['open_architecture']): die('gate is not open')
            append(event,version,slug,**data)
else: die('unknown S1 command')
PY
}

_dispatch_release_merged() {
  local version="" pr="" merged_at="" merged_ts ledger
  while (($#)); do
    case "$1" in
      --version) (($# >= 2)) || _dispatch_error "--version requires a value"; version="$2"; shift 2 ;;
      --pr) (($# >= 2)) || _dispatch_error "--pr requires a value"; pr="$2"; shift 2 ;;
      --merged-at) (($# >= 2)) || _dispatch_error "--merged-at requires a value"; merged_at="$2"; shift 2 ;;
      *) _dispatch_error "unknown release-merged option: $1" ;;
    esac
  done
  [[ "$version" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+$ ]] || _dispatch_error "invalid or missing --version"
  [[ "$pr" =~ ^[1-9][0-9]*$ ]] || _dispatch_error "invalid or missing --pr"
  [[ "$merged_at" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || _dispatch_error "invalid or missing --merged-at"
  merged_ts="$(python3 -c 'from datetime import datetime, timezone; import sys; print(int(datetime.strptime(sys.argv[1], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()))' "$merged_at" 2>/dev/null)" || _dispatch_error "invalid --merged-at date"
  ledger="$_dispatch_worktree_root/ledger.jsonl"
  if [[ -f "$ledger" ]] && jq -se --arg version "$version" --argjson merged_at "$merged_ts" \
    'any(.[]; .event == "release_merged" and .version == $version and .merged_at == $merged_at)' \
    "$ledger" >/dev/null 2>&1; then
    echo "already recorded: $version"
    return 0
  fi
  _dispatch_ledger_event release_merged "$version" release --argjson pr "$pr" --argjson merged_at "$merged_ts" \
    '.pr=$pr|.merged_at=$merged_at' || _dispatch_error "could not record release merge"
  echo "recorded release merge: $version PR #$pr"
}

_dispatch_validate_evidence() {
  python3 -I - "$1" "$2" "${3:-$_dispatch_repo_root}" <<'PYVALIDATE'
import re, subprocess, sys
from pathlib import Path
try:
    text = Path(sys.argv[1]).read_text(encoding="utf-8")
    headers, output = text.split("\n---\n", 1)
    assert output and output.splitlines()
    fields = {}
    triples = []
    for line in headers.splitlines():
        match = re.fullmatch(r"([a-z_]+): (.+)", line)
        assert match
        key, value = match.groups()
        assert value.strip()
        if key.startswith("pre_fix_"):
            triples.append((key, value))
        else:
            assert key not in fields
            fields[key] = value
    assert re.fullmatch(r"[A-Za-z0-9._-]{1,80}", fields["verifier"])
    assert not sys.argv[2] or fields["verifier"] == sys.argv[2]
    assert fields["tests_from"] == "acceptance" and fields["rc"] == "0"
    assert fields["command"].strip()
    assert triples and len(triples) % 3 == 0
    shas = [fields["fix_sha"]]
    for i in range(0, len(triples), 3):
        sha, command, rc = triples[i:i+3]
        assert [sha[0], command[0], rc[0]] == ["pre_fix_sha", "pre_fix_command", "pre_fix_rc"]
        assert command[1].strip() and re.fullmatch(r"-?[0-9]+", rc[1]) and int(rc[1]) != 0
        shas.append(sha[1])
    for sha in shas:
        assert re.fullmatch(r"[0-9a-fA-F]{7,40}", sha)
        assert subprocess.run(["git", "-C", sys.argv[3], "cat-file", "-e", sha + "^{commit}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    print(fields["verifier"])
except (OSError, UnicodeError, ValueError, KeyError, AssertionError):
    sys.exit(1)
PYVALIDATE
}

_dispatch_verify() {
  local slug="" result="" tokens="" verifier="" evidence="" evidence_path="" evidence_sha256="" rel version tokens_set=0 run_dir count
  while (($#)); do
    case "$1" in
      --slug) (($# >= 2)) || _dispatch_error "--slug requires a value"; slug="$2"; shift 2 ;;
      --result) (($# >= 2)) || _dispatch_error "--result requires a value"; result="$2"; shift 2 ;;
      --tokens) (($# >= 2)) || _dispatch_error "--tokens requires a value"; tokens="$2"; tokens_set=1; shift 2 ;;
      --evidence) (($# >= 2)) || _dispatch_error "--evidence requires a value"; evidence="$2"; shift 2 ;;
      --verifier) (($# >= 2)) || _dispatch_error "--verifier requires a value"; verifier="$2"; shift 2 ;;
      *) _dispatch_error "unknown verify option: $1" ;;
    esac
  done
  [[ "$slug" =~ ^[A-Za-z0-9._-]{1,120}$ ]] || _dispatch_error "verify requires a valid --slug SLUG"
  [[ "$result" == pass || "$result" == fail ]] || _dispatch_error "--result must be pass or fail"
  (( ! tokens_set )) || [[ "$tokens" =~ ^[0-9]+$ ]] || _dispatch_error "--tokens must be a non-negative integer"
  [[ -z "$verifier" || "$verifier" =~ ^[A-Za-z0-9._-]{1,80}$ ]] || _dispatch_error "invalid verifier name"
  rel="$(_dispatch_release_branch)"; version="${rel#k3d-manager-}"
  jq -se --arg version "$version" --arg slug "$slug" \
    'any(.[]; .event == "land" and .version == $version and .slug == $slug)' \
    "$_dispatch_worktree_root/ledger.jsonl" >/dev/null 2>&1 || _dispatch_error "no landed task for $slug in $version"
  [[ "$result" != pass || -n "$evidence" ]] || _dispatch_error "pass requires --evidence"
  if [[ -n "$evidence" ]]; then
    run_dir="$_dispatch_worktree_root/$version/$slug.run"
    verifier="$(_dispatch_validate_evidence "$evidence" "$verifier" "$(cat "$run_dir/repo" 2>/dev/null)")" || _dispatch_error "invalid verification evidence"
    mkdir -p "$run_dir" || _dispatch_error "could not create run directory"
    count="$(find "$run_dir" -maxdepth 1 -name 'verify-evidence.*.log' -type f | wc -l | tr -d ' ')"
    evidence_path="$version/$slug.run/verify-evidence.$((count + 1)).log"
    [[ ! -e "$_dispatch_worktree_root/$evidence_path" ]] || _dispatch_error "evidence destination already exists"
    cp "$evidence" "$_dispatch_worktree_root/$evidence_path" || _dispatch_error "could not copy evidence"
    evidence_sha256="$(python3 -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1], "rb").read()).hexdigest())' "$_dispatch_worktree_root/$evidence_path")" || _dispatch_error "could not hash evidence"
  fi
  _dispatch_event_repo="$(cat "$_dispatch_worktree_root/$version/$slug.run/repo-name" 2>/dev/null || echo k3d-manager)"
  if (( tokens_set )); then
    _dispatch_ledger_event verify "$version" "$slug" --arg evidence_path "$evidence_path" --arg evidence_sha256 "$evidence_sha256" --arg result "$result" --arg verifier "$verifier" --argjson tokens "$tokens" \
      '.result=$result|if $evidence_path != "" then .evidence_path=$evidence_path|.evidence_sha256=$evidence_sha256 else . end|.tokens=$tokens|if $verifier != "" then .verifier=$verifier else . end' || _dispatch_error "could not record verification"
  else
    _dispatch_ledger_event verify "$version" "$slug" --arg evidence_path "$evidence_path" --arg evidence_sha256 "$evidence_sha256" --arg result "$result" --arg verifier "$verifier" \
      '.result=$result|if $evidence_path != "" then .evidence_path=$evidence_path|.evidence_sha256=$evidence_sha256 else . end|if $verifier != "" then .verifier=$verifier else . end' || _dispatch_error "could not record verification"
  fi
  _dispatch_schedule_metrics
  echo "verification recorded: $slug ($result)"
}

_dispatch_intervention() {
  local slug="" reason="" version ledger event_repo ts current_root
  while (($#)); do
    case "$1" in
      --slug) (($# >= 2)) || _dispatch_error "--slug requires a value"; slug="$2"; shift 2 ;;
      --reason) (($# >= 2)) || _dispatch_error "--reason requires a value"; reason="$2"; shift 2 ;;
      *) _dispatch_error "unknown intervention option: $1" ;;
    esac
  done
  if [[ "${K3DM_JOB_DIR:-}" == "$_dispatch_worktree_root/"*/*.run/state/jobs ]]; then
    _dispatch_error "interventions must be recorded by the operator, not a dispatched worker"
  fi
  if [[ "${K3DM_REPO_ROOT:-}" == "$_dispatch_worktree_root/"*/* ]]; then
    _dispatch_error "interventions must be recorded by the operator, not a dispatched worker"
  fi
  current_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ "$current_root" == "$_dispatch_worktree_root/"*/* ]]; then
    _dispatch_error "interventions must be recorded by the operator, not a dispatched worker"
  fi
  [[ "$slug" =~ ^[A-Za-z0-9._-]+$ ]] || _dispatch_error "invalid or missing slug"
  case "$reason" in continue_prompt|clarification|correction|other) ;; *) _dispatch_error "invalid intervention reason" ;; esac
  ledger="$_dispatch_worktree_root/ledger.jsonl"
  [[ -f "$ledger" ]] || _dispatch_error "unknown task: $slug"
  version="$(jq -sr --arg slug "$slug" '[.[] | select(.slug == $slug and (.event == "start" or .event == "resume"))] | last | .version // empty' "$ledger" 2>/dev/null)"
  [[ -n "$version" && -d "$_dispatch_worktree_root/$version/$slug.run" ]] || _dispatch_error "unknown task: $slug"
  event_repo="$(cat "$_dispatch_worktree_root/$version/$slug.run/repo-name" 2>/dev/null || echo k3d-manager)"
  ts="$(date +%s)"
  if ! jq -e 'select(.event == "intervention_coverage_start")' "$ledger" >/dev/null 2>&1; then
    jq -nc --arg version "$version" --arg slug "$slug" --arg repo "$event_repo" --argjson ts "$ts" \
      '{ts:$ts,event:"intervention_coverage_start",version:$version,slug:$slug,repo:$repo}' >>"$ledger" \
      || _dispatch_error "could not record intervention coverage"
  fi
  jq -nc --arg version "$version" --arg slug "$slug" --arg repo "$event_repo" --arg reason "$reason" --argjson ts "$ts" \
    '{ts:$ts,event:"intervention",version:$version,slug:$slug,repo:$repo,reason:$reason}' >>"$ledger" \
    || _dispatch_error "could not record intervention"
  _dispatch_schedule_metrics
  echo "recorded $reason for $slug ($version)"
}

_dispatch_usage_backfill() {
  local path version slug log session backfilled=0 missing=0
  local ledger="$_dispatch_worktree_root/ledger.jsonl"
  while IFS= read -r -d '' path; do
    version="${path%/*}"; version="${version##*/}"
    slug="${path##*/}"; slug="${slug%.run}"
    while IFS= read -r -d '' log; do
      session="$(sed -n 's/^session id: //p' "$log" 2>/dev/null | head -n 1)"
      [[ -n "$session" ]] || { ((missing += 1)); continue; }
      if jq -se --arg v "$version" --arg s "$slug" --arg id "$session" \
        'any(.[]; .event == "codex_usage" and .version == $v and .slug == $s and .session == $id)' \
        "$ledger" >/dev/null 2>&1; then continue; fi
      if _DISPATCH_SKIP_METRICS=1 _dispatch_codex_usage "$log" "$version" "$slug"; then ((backfilled += 1)); else
        if [[ -z "$(find "${CODEX_HOME:-${HOME}/.codex}/sessions" -type f \
          -name "rollout-*-${session}.jsonl" -print -quit 2>/dev/null)" ]]; then
          ((missing += 1))
        fi
      fi
    done < <(find "$path" -maxdepth 1 -type f -name 'codex*.log' -print0)
  done < <(find "$_dispatch_worktree_root" -mindepth 2 -maxdepth 2 -type d -name '*.run' -print0 2>/dev/null)
  echo "backfilled: $backfilled"
  echo "missing: $missing"
  ((backfilled == 0)) || _dispatch_schedule_metrics
}

_dispatch_release_branch() {
  local branch
  branch="$(git -C "${_dispatch_repo_root}" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  [[ "${branch}" =~ ^k3d-manager-v[0-9]+\.[0-9]+\.[0-9]+$ ]] || _dispatch_error "current branch '${branch:-detached}' is not a release branch"
  printf '%s\n' "${branch}"
}

_dispatch_spec_files() {
  awk '/^## Files[[:space:]]*$/ { in_files=1; next } in_files && /^## / { exit } in_files { print }' |
    grep -oE "\`[^\`]+\`" | sed "s/^\`//; s/\`$//" || true
}

_dispatch_change_stats() {
  local input="$1" added deleted path kind filename result='{"files":0,"code":0,"tests":0,"docs":0}'
  while IFS=$'\t' read -r added deleted path; do
    [[ -n "$path" ]] || continue
    filename="${path##*/}"
    if [[ "$path" == scripts/tests/* || "$filename" == test_*.py || "$filename" == *.bats ]]; then kind=tests
    elif [[ "$path" == docs/* || "$path" == memory-bank/* || "$path" == *.md ]]; then kind=docs
    else kind=code; fi
    if [[ "$added" =~ ^[0-9]+$ && "$deleted" =~ ^[0-9]+$ ]]; then
      result="$(jq -c --arg kind "$kind" --argjson lines "$((added + deleted))" '.files+=1|.[$kind]+=$lines' <<<"$result")"
    else
      result="$(jq -c '.files+=1' <<<"$result")"
    fi
  done <<<"$input"
  printf '%s\n' "$result"
}

_dispatch_scope_verdict() {
  local worktree="$1" spec="$2" rel="$3" allow="$4" path pattern in_scope=1 matched base from merge_base
  local -a patterns=()
  if [[ ! -f "$worktree.run/base" ]]; then
    echo "scope: unknown (no recorded base)"
    return 1
  fi
  base="$(<"$worktree.run/base")"
  from="$base"
  if merge_base="$(git -C "$worktree" merge-base "$rel" HEAD 2>/dev/null)" && git -C "$worktree" merge-base --is-ancestor "$base" "$merge_base"; then
    from="$merge_base"
  fi
  if [[ -f "$worktree.run/spec.md" ]]; then
    local expected_spec_hash actual_spec_hash
    expected_spec_hash="$(cat "$worktree.run/spec-sha256" 2>/dev/null || true)"
    actual_spec_hash="$(shasum -a 256 "$worktree.run/spec.md" 2>/dev/null | awk '{print $1}')"
    [[ -n "$expected_spec_hash" && "$expected_spec_hash" == "$actual_spec_hash" ]] || {
      echo "scope: unknown (spec snapshot changed)"
      return 1
    }
    while IFS= read -r path; do [[ -n "$path" ]] && patterns+=("$path"); done < <(_dispatch_spec_files <"$worktree.run/spec.md")
  else
    while IFS= read -r path; do [[ -n "$path" ]] && patterns+=("$path"); done < <(git -C "$worktree" show "$base:$spec" | _dispatch_spec_files)
  fi
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    matched=1
    [[ "$path" == "$spec" || "$path" == memory-bank/* ]] && { echo "out-of-scope: $path"; in_scope=0; continue; }
    for pattern in "${patterns[@]}"; do
      # shellcheck disable=SC2254
      case "$path" in
        $pattern) matched=0; break ;;
      esac
    done
    if (( matched )); then echo "out-of-scope: $path"; in_scope=0; fi
  done < <({
    git -C "$worktree" diff --name-only "$from" HEAD
    git -C "$worktree" diff --name-only
    git -C "$worktree" ls-files --others --exclude-standard
  } | sort -u)
  if (( in_scope )); then echo "scope: in-scope"; elif (( allow )); then echo "scope: out-of-scope (allowed)"; else return 1; fi
}

_dispatch_task_spec() {
  local task="$1" run="$2" spec
  [[ -f "$run/spec" ]] || return 1
  spec="$(<"$run/spec")"
  [[ -n "$spec" && ( -f "$task/$spec" || -f "$run/spec.md" ) ]] || return 1
  printf '%s\n' "$spec"
}

_dispatch_task_paths() {
  _dispatch_task_dir="${_dispatch_worktree_root}/$1/$2"
  _dispatch_run_dir="${_dispatch_worktree_root}/$1/$2.run"
}

_dispatch_network_task_running() {
  local version="$1" candidate_run candidate_slug candidate_pid
  for candidate_run in "$_dispatch_worktree_root/$version"/*.run; do
    [[ -d "$candidate_run" && -f "$candidate_run/network" ]] || continue
    [[ -f "$candidate_run/exit" ]] && continue
    [[ -f "$candidate_run/pid" ]] || continue
    candidate_pid="$(<"$candidate_run/pid")"
    if kill -0 "$candidate_pid" 2>/dev/null; then
      candidate_slug="$(basename "$candidate_run" .run)"
      printf '%s\n' "$candidate_slug"
      return 0
    fi
  done
  return 1
}

_dispatch_start() {
  local spec="" slug="" parent="" role="" network=0 rel version head remote spec_base worktree run state_dir arg network_slug agent=codex model="" model_source=inherited available_models repo="" target="" repo_name="" task_repo manager_git task_git coordinator="" coordinator_vendor="" coordinator_model="" primary_coordinator="" primary_vendor=unknown primary_model=unknown primary_source="" primary_identity_json
  while (($#)); do
    case "$1" in
      --spec) (($# >= 2)) || _dispatch_error "--spec requires a path"; spec="$2"; shift 2 ;;
      --slug) (($# >= 2)) || _dispatch_error "--slug requires a value"; slug="$2"; shift 2 ;;
      --parent) (($# >= 2)) || _dispatch_error "--parent requires a value"; parent="$2"; shift 2 ;;
      --role) (($# >= 2)) || _dispatch_error "--role requires a value"; role="$2"; shift 2 ;;
      --agent) (($# >= 2)) || _dispatch_error "--agent requires a value"; agent="$2"; shift 2 ;;
      --model) (($# >= 2)) || _dispatch_error "--model requires a value"; model="$2"; model_source=explicit; shift 2 ;;
      --coordinator) (($# >= 2)) || _dispatch_error "invalid coordinator"; coordinator="$2"; shift 2 ;;
      --primary-coordinator) (($# >= 2)) || _dispatch_error "--primary-coordinator requires VENDOR/MODEL"; primary_coordinator="$2"; shift 2 ;;
      --primary-coordinator-source) (($# >= 2)) || _dispatch_error "--primary-coordinator-source requires declared or runtime-reported"; primary_source="$2"; shift 2 ;;
      --repo) (($# >= 2)) || _dispatch_error "--repo requires a path"; repo="$2"; shift 2 ;;
      --branch) (($# >= 2)) || _dispatch_error "--branch requires a name"; target="$2"; shift 2 ;;
      --network) network=1; shift ;;
      -h|--help) _dispatch_usage; return 0 ;;
      *) _dispatch_error "unknown start option: $1" ;;
    esac
  done
  [[ -n "$spec" ]] || _dispatch_error "start requires --spec PATH"
  if [[ -n "$coordinator" ]]; then
    [[ "$coordinator" =~ ^([A-Za-z0-9._:-]{1,64})/([A-Za-z0-9._:-]{1,64})$ ]] || _dispatch_error "invalid coordinator"
    coordinator_vendor="${BASH_REMATCH[1]}"; coordinator_model="${BASH_REMATCH[2]}"
  fi
  if [[ -n "$parent" || -n "$role" ]]; then
    [[ "$parent" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ && "$role" =~ ^(build|review|verify)$ ]] || _dispatch_error "--parent and --role must be valid and used together"
  fi
  [[ -z "$parent" || -n "$role" ]] || _dispatch_error "--parent requires --role"
  [[ -z "$role" || -n "$parent" ]] || _dispatch_error "--role requires --parent"
  primary_identity_json="$(_dispatch_primary_identity_json "$primary_coordinator" "$primary_source")" \
    || _dispatch_error "invalid primary coordinator identity or provenance"
  primary_vendor="$(jq -r '.vendor' <<<"$primary_identity_json")"
  primary_model="$(jq -r '.model' <<<"$primary_identity_json")"
  primary_source="$(jq -r '.source' <<<"$primary_identity_json")"
  [[ -z "$repo" && -z "$target" || -n "$repo" && -n "$target" ]] || _dispatch_error "--repo and --branch must be used together"
  case "$repo" in
    \~|\~/*) repo="${HOME}${repo#\~}" ;;
  esac
  task_repo="$_dispatch_repo_root"
  if [[ -n "$repo" ]]; then
    [[ "$target" != main && "$target" != master ]] || _dispatch_error "--branch must not be main or master"
    task_repo="$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null)" || _dispatch_error "--repo must be a git checkout"
    manager_git="$(git -C "$_dispatch_repo_root" rev-parse --path-format=absolute --git-common-dir)"
    task_git="$(git -C "$task_repo" rev-parse --path-format=absolute --git-common-dir)"
    [[ "$task_git" != "$manager_git" ]] || _dispatch_error "--repo must not point at k3d-manager"
    git -C "$task_repo" remote get-url origin >/dev/null 2>&1 || _dispatch_error "--repo requires an origin remote"
    repo_name="$(git -C "$task_repo" remote get-url origin | sed -E 's#/*\.git$##; s#^.*/##; s#^([^:]+):##')"
    [[ "$repo_name" =~ ^[A-Za-z0-9._-]{1,64}$ ]] || _dispatch_error "origin repository name is invalid"
    git -C "$task_repo" fetch origin "+$target:refs/remotes/origin/$target" >/dev/null 2>&1 || _dispatch_error "branch does not exist on origin: $target"
  else
    repo_name=k3d-manager; target=""
  fi
  [[ "$agent" == codex || "$agent" == agy ]] || _dispatch_error "unknown agent: $agent"
  if [[ "$agent" == agy ]]; then
    (( network == 0 )) || _dispatch_error "--network is not supported with --agent agy"
    [[ -n "$model" ]] || { model=gemini-4-argon-medium; model_source=default; }
    available_models="$("${K3DM_AGY_BIN:-agy}" models 2>&1)" || _dispatch_error "agy models failed: $available_models"
    if ! awk -F '\t' -v wanted="$model" 'NF && $1 == wanted {found=1} END {exit !found}' <<<"$available_models"; then
      echo "[codex-dispatch] ERROR: unknown agy model: $model" >&2
      printf '%s\n' "$available_models" >&2
      exit 2
    fi
  fi
  rel="$(_dispatch_release_branch)"; version="${rel#k3d-manager-}"
  [[ -f "$_dispatch_repo_root/$spec" ]] || _dispatch_error "spec does not exist: $spec"
  git -C "$_dispatch_repo_root" ls-files --error-unmatch -- "$spec" >/dev/null 2>&1 || _dispatch_error "spec is not tracked: $spec"
  git -C "$_dispatch_repo_root" diff --quiet HEAD -- "$spec" || _dispatch_error "spec is changed: $spec"
  git -C "$_dispatch_repo_root" fetch origin "+$rel:refs/remotes/origin/$rel" >/dev/null 2>&1 || _dispatch_error "could not fetch origin/$rel"
  head="$(git -C "$_dispatch_repo_root" rev-parse HEAD)"; remote="$(git -C "$_dispatch_repo_root" rev-parse "origin/$rel")"
  [[ "$head" == "$remote" ]] || _dispatch_error "HEAD is not pushed to origin/$rel"
  _dispatch_spec_files <"$_dispatch_repo_root/$spec" | grep . >/dev/null || _dispatch_error "spec has no backticked path in its ## Files section"
  spec_base="$(basename "$spec" .md)"
  [[ -n "$slug" ]] || slug="${spec_base#"${version}"-}"
  [[ "$slug" != "$spec_base" ]] || slug="$spec_base"
  [[ "$slug" =~ ^[A-Za-z0-9._-]+$ ]] || _dispatch_error "invalid slug: $slug"
  git -C "$task_repo" show-ref --verify --quiet "refs/heads/task/$version/$slug" && _dispatch_error "task branch already exists: task/$version/$slug"
  git -C "$task_repo" ls-remote --exit-code --heads origin "task/$version/$slug" >/dev/null 2>&1 && _dispatch_error "remote task branch already exists: task/$version/$slug"
  worktree="$_dispatch_worktree_root/$version/$slug"; run="$_dispatch_worktree_root/$version/$slug.run"
  [[ ! -e "$worktree" ]] || _dispatch_error "worktree path already exists: $worktree"
  [[ ! -e "$run" ]] || _dispatch_error "run path already exists: $run"
  if (( network )) && network_slug="$(_dispatch_network_task_running "$version")"; then
    _dispatch_error "network task $network_slug is still running; only one networked task at a time"
  fi
  mkdir -p "$_dispatch_worktree_root/$version"
  if [[ -n "$repo" ]]; then
    remote="$(git -C "$task_repo" rev-parse "origin/$target")"
    git -C "$task_repo" worktree add -b "task/$version/$slug" "$worktree" "origin/$target" >/dev/null
  else
    git -C "$task_repo" worktree add -b "task/$version/$slug" "$worktree" "origin/$rel" >/dev/null
  fi
  mkdir -m 700 "$run"; state_dir="$run/state"; mkdir -m 700 "$state_dir"
  for arg in jobs run state logs tmp port-cache; do mkdir -m 700 "$state_dir/$arg"; done
  if (( network )); then
    : >"$run/network"
  fi
  printf '%s\n' "$remote" >"$run/base"
  printf '%s\n' "$spec" >"$run/spec"
  if [[ -n "$repo" ]]; then
    printf '%s\n' "$task_repo" >"$run/repo"
    printf '%s\n' "$target" >"$run/target"
    printf '%s\n' "$head" >"$run/spec-base"
    cp "$_dispatch_repo_root/$spec" "$run/spec.md"
    shasum -a 256 "$run/spec.md" | awk '{print $1}' >"$run/spec-sha256"
    printf '%s\n' "$repo_name" >"$run/repo-name"
  else
    printf '%s\n' "$_dispatch_repo_root" >"$run/repo"
    printf '%s\n' "$rel" >"$run/target"
    printf '%s\n' "$repo_name" >"$run/repo-name"
  fi
  _dispatch_event_repo="$repo_name"
  local spec_stats_json stats_args=()
  spec_stats_json="$(python3 "${K3DM_DISPATCH_SPEC_STATS_BIN:-$_dispatch_script_dir/k3dm-dispatch-metrics}" --spec-stats "$_dispatch_repo_root/$spec" 2>/dev/null || true)"
  if ! jq -e 'type == "object"' <<<"$spec_stats_json" >/dev/null 2>&1; then spec_stats_json=null; fi
  stats_args=(--argjson spec_stats "$spec_stats_json")
  printf '%s\n' "$agent" >"$run/agent"
  printf '%s\n' "$model" >"$run/model"
  if [[ "$agent" == codex && -n "$model" ]]; then
    _dispatch_ledger_event_best_effort start "$version" "$slug" --argjson network "$network" --argjson run 1 --arg spec "$spec" "${stats_args[@]}" --arg agent "$agent" --arg model "$model" --arg model_source "$model_source" --arg coordinator_vendor "$coordinator_vendor" --arg coordinator_model "$coordinator_model" --arg worker_vendor openai --arg worker_status "$([[ "$model_source" == inherited ]] && echo unverified || echo selected)" --arg parent "$parent" --arg role "$role" 'if $parent=="" then . else .parent=$parent|.role=$role end|.network=$network|.run=$run|.spec=$spec|if ($spec_stats|type)=="object" then .spec_stats=$spec_stats else . end|.agent=$agent|.model=$model|.model_source=$model_source|.worker_identity={vendor:$worker_vendor,model:$model,source:$model_source,status:$worker_status}|.coordinator_identity=(if $coordinator_vendor=="" then {vendor:"unknown",model:"unknown",source:"unreported",status:"unknown"} else {vendor:$coordinator_vendor,model:$coordinator_model,source:"declared",status:"declared"} end)'
  else
    _dispatch_ledger_event_best_effort start "$version" "$slug" --argjson network "$network" --argjson run 1 --arg spec "$spec" "${stats_args[@]}" --arg agent "$agent" --argjson model "$( [[ -n "$model" ]] && jq -nc --arg m "$model" '$m' || echo null )" --arg model_source "$model_source" --arg coordinator_vendor "$coordinator_vendor" --arg coordinator_model "$coordinator_model" --arg worker_vendor "$([[ "$agent" == agy ]] && echo google || echo openai)" --arg worker_status "$([[ "$model_source" == inherited ]] && echo unverified || echo selected)" --arg parent "$parent" --arg role "$role" 'if $parent=="" then . else .parent=$parent|.role=$role end|.network=$network|.run=$run|.spec=$spec|if ($spec_stats|type)=="object" then .spec_stats=$spec_stats else . end|.agent=$agent|.model=$model|.model_source=$model_source|.worker_identity={vendor:$worker_vendor,model:(.model // "unknown"),source:$model_source,status:(if .model == null then "unknown" else $worker_status end)}|.coordinator_identity=(if $coordinator_vendor=="" then {vendor:"unknown",model:"unknown",source:"unreported",status:"unknown"} else {vendor:$coordinator_vendor,model:$coordinator_model,source:"declared",status:"declared"} end)'
  fi
  _dispatch_ledger_event_best_effort primary_coordinator "$version" "$slug" --arg vendor "$primary_vendor" --arg model "$primary_model" --arg source "$primary_source" \
    '.primary_coordinator_identity={vendor:$vendor,model:$model,source:$source,status:(if $source=="unknown" then "unknown" elif $source=="runtime-reported" then "runtime_reported" else "declared" end)}'
  local prompt_spec="$spec"
  [[ ! -f "$run/spec.md" ]] || prompt_spec="$(cd "$run" && pwd)/spec.md"
  cat >"$run/prompt.md" <<EOF
Read the spec at $prompt_spec in full, and implement it in this directory only.
Run the spec's Rules gates and paste their output.
Do not run git add, git commit or git push. .git is read-only to you. Leave the changes in the working tree.
Do not touch memory-bank/.
Do not unset or override the K3DM_* and TMPDIR variables you were given. They keep this task's state away from the live webhook and from other tasks.
Your last message must list every file you changed.
EOF
  _dispatch_detach_worker "$run" start "$worktree" "$run" "$version" "$slug" "$network" "" "" "$agent" "$model" "$model_source" </dev/null
  _dispatch_wait_for_start "$run" || _dispatch_log "$run" "worker did not acknowledge startup"
  echo "worktree: $worktree"; echo "run: $run"; echo "status: bin/k3dm-codex-dispatch status $slug"
}

_dispatch_status() {
  local rel version task slug run state spec pid exit_code
  rel="$(_dispatch_release_branch)"; version="${rel#k3d-manager-}"
  [[ -d "$_dispatch_worktree_root/$version" ]] || return 0
  for task in "$_dispatch_worktree_root/$version"/*; do
    [[ -d "$task" && "$task" != *.run ]] || continue
    slug="$(basename "$task")"; run="$task.run"
    if [[ -f "$run/landed" ]]; then
      state=landed
    elif [[ -f "$run/exit" ]]; then
      exit_code="$(head -n 1 "$run/exit")"
      if [[ -f "$run/violation" ]]; then state="VIOLATION: agent committed"
      elif [[ "$exit_code" == 0 ]]; then state="exited successfully"; else state="exited nonzero ($exit_code)"; fi
    elif _dispatch_worker_matches_start "$run"; then
      state=running
    elif [[ -s "$run/start" ]]; then
      state="terminated unexpectedly (see $run/supervisor.log)"
    elif [[ -f "$run/pid" ]] && kill -0 "$(<"$run/pid")" 2>/dev/null; then
      state=starting
    else
      state=unknown
    fi
    [[ -z "${1:-}" || "$1" == "$slug" ]] || continue
    echo "task: $slug"; echo "state: $state"; [[ -f "$run/network" ]] && echo "network: yes" || true
    if compgen -G "$run/prompt-[0-9]*.md" >/dev/null; then
      echo "resumes: $(find "$run" -maxdepth 1 -name 'prompt-[0-9]*.md' | wc -l | tr -d ' ')"
    fi
    local task_target task_repo
    task_target="$(cat "$run/target" 2>/dev/null || printf '%s' "$rel")"
    task_repo="$(cat "$run/repo-name" 2>/dev/null || echo k3d-manager)"
    echo "repo: $task_repo"
    git -C "$task" status --porcelain || true; git -C "$task" log --oneline "origin/$task_target..HEAD" || true
    if spec="$(_dispatch_task_spec "$task" "$run")"; then _dispatch_scope_verdict "$task" "$spec" "$task_target" 1 || true; else echo "scope: unknown (no recorded spec)"; fi
  done
}

_dispatch_land() {
  local slug="" superseding="" allow=0 test_set=0 no_test=0 review_pending=0 test_cmd="" landing_actor=unknown landing_model="" landing_vendor=unknown rel version task run pid spec current land_lock verifier_lines wait_seconds land_ts codex_ts target repo_path base target_sha task_before target_count=0
  local _landing_parts=""
  while (($#)); do
    case "$1" in
      --slug) (($# >= 2)) || _dispatch_error "--slug requires a value"; slug="$2"; shift 2 ;;
      --superseding) (($# >= 2)) || _dispatch_error "--superseding requires a slug"; superseding="$2"; shift 2 ;;
      --test) (($# >= 2)) || _dispatch_error "--test requires a command"; test_set=1; test_cmd="$2"; shift 2 ;;
      --no-test) no_test=1; shift ;;
      --landing-actor) (($# >= 2)) || _dispatch_error "--landing-actor requires a value"; landing_actor="$2"; shift 2 ;;
      --landing-model) (($# >= 2)) || _dispatch_error "--landing-model requires VENDOR/MODEL"; landing_model="$2"; shift 2 ;;
      --review-pending) review_pending=1; shift ;;
      --allow-out-of-scope) allow=1; shift ;;
      *) _dispatch_error "unknown land option: $1" ;;
    esac
  done
  [[ -n "$slug" ]] || _dispatch_error "land requires --slug SLUG"
  case "$landing_actor" in human|claude|codex|other_agent|unknown) ;; *) _dispatch_error "invalid landing actor" ;; esac
  case "$landing_model" in
    "") ;;
    *)
    case "$landing_actor" in codex|claude|other_agent) ;; *) _dispatch_error "landing model requires an identified agent actor" ;; esac
    _landing_parts="$(_dispatch_identity_parts "$landing_model")" || _dispatch_error "invalid landing model"
    landing_vendor="${_landing_parts%%$'\n'*}"
    landing_model="${_landing_parts#*$'\n'}"
    ;;
  esac
  (( test_set + no_test == 1 )) || _dispatch_error "land requires exactly one of --test CMD or --no-test"
  rel="$(_dispatch_release_branch)"; version="${rel#k3d-manager-}"; _dispatch_task_paths "$version" "$slug"; task="$_dispatch_task_dir"; run="$_dispatch_run_dir"
  [[ -d "$task" ]] || _dispatch_error "worktree does not exist: $task"
  repo_path="$(cat "$run/repo" 2>/dev/null || printf '%s' "$_dispatch_repo_root")"
  target="$(cat "$run/target" 2>/dev/null || printf '%s' "$rel")"
  [[ -n "$target" ]] || target="$rel"
  _dispatch_event_repo="$(cat "$run/repo-name" 2>/dev/null || echo k3d-manager)"
  [[ ! -f "$run/violation" ]] || _dispatch_error "VIOLATION: agent committed"
  [[ -f "$run/pid" ]] && pid="$(<"$run/pid")" || pid=""
  [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null || _dispatch_error "Codex is still running"
  [[ -f "$run/base" ]] || _dispatch_error "no recorded base for $slug (expected $run/base)"
  [[ -z "$(git -C "$task" status --porcelain)" ]] || _dispatch_error "worktree has uncommitted changes"
  [[ "$(git -C "$task" rev-list --count "origin/$target..HEAD")" -gt 0 ]] || _dispatch_error "task branch has no commits ahead of origin/$target"
  spec="$(_dispatch_task_spec "$task" "$run")" || _dispatch_error "no recorded spec for $slug (expected $run/spec)"
  local prior_slug prior_run
  for prior_run in "$_dispatch_worktree_root/$version"/*.run; do
    [[ -f "$prior_run/landed" ]] || continue
    prior_slug="$(basename "$prior_run" .run)"
    [[ "$prior_slug" == "$slug" ]] && continue
    if [[ -f "$prior_run/spec" && "$(<"$prior_run/spec")" == "$spec" ]]; then
      [[ "$superseding" == "$prior_slug" ]] || _dispatch_error "spec already landed by $prior_slug; use --superseding $prior_slug"
    fi
  done
  if ! _dispatch_scope_verdict "$task" "$spec" "$target" "$allow"; then
    _dispatch_ledger_event_best_effort land_refused "$version" "$slug" --arg reason scope '.["reason"]=$reason'
    _dispatch_schedule_metrics
    _dispatch_error "task changes are out of scope"
  fi
  task_before="$(git -C "$task" rev-parse HEAD)"
  verifier_lines=0
  if [[ -s "$run/codex-tree" ]]; then
    verifier_lines="$(git -C "$task" diff --numstat "$(<"$run/codex-tree")" HEAD | awk '{if ($1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/) total += $1 + $2} END {print total + 0}')"
  fi
  land_lock="$_dispatch_worktree_root/$version/.land.lock"
  if ! mkdir "$land_lock" 2>/dev/null; then
    if [[ -f "$land_lock/pid" ]] && kill -0 "$(<"$land_lock/pid")" 2>/dev/null; then
      _dispatch_error "another land is in progress (pid $(<"$land_lock/pid"))"
    fi
    rm -f "$land_lock/pid"; rmdir "$land_lock" 2>/dev/null || _dispatch_error "could not remove stale landing lock"
    mkdir "$land_lock" 2>/dev/null || _dispatch_error "another land is in progress"
  fi
  printf '%s\n' "$$" >"$land_lock/pid"
  _dispatch_land_lock_path="$land_lock"
  trap '_dispatch_release_land_lock "${_dispatch_land_lock_path}"' EXIT
  current="$(git -C "$repo_path" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [[ "$current" != "$target" ]]; then
    _dispatch_ledger_event_best_effort land_refused "$version" "$slug" --arg reason target_diverged '.reason=$reason'
    _dispatch_error "target checkout is not on $target"
  fi
  if [[ -n "$(git -C "$repo_path" status --porcelain)" ]]; then
    _dispatch_ledger_event_best_effort land_refused "$version" "$slug" --arg reason target_diverged '.reason=$reason'
    _dispatch_error "target checkout is dirty"
  fi
  if ! git -C "$repo_path" fetch origin "+$target:refs/remotes/origin/$target" >/dev/null 2>&1; then
    _dispatch_ledger_event_best_effort land_refused "$version" "$slug" --arg reason target_diverged '.reason=$reason'
    _dispatch_error "could not fetch origin/$target"
  fi
  base="$(<"$run/base")"; target_sha="$(git -C "$repo_path" rev-parse "origin/$target")"
  if [[ "$(git -C "$repo_path" rev-parse "$target")" != "$target_sha" ]]; then
    _dispatch_ledger_event_best_effort land_refused "$version" "$slug" --arg reason target_diverged '.reason=$reason'
    _dispatch_error "local $target differs from origin/$target"
  fi
  if [[ "$target_sha" != "$base" ]]; then
    if ! git -C "$repo_path" merge-base --is-ancestor "$base" "$target_sha"; then
      _dispatch_ledger_event_best_effort land_refused "$version" "$slug" --arg reason target_rewritten '.reason=$reason'
      _dispatch_error "origin/$target was rewritten since dispatch"
    fi
    target_count="$(git -C "$repo_path" rev-list --count "$base..$target_sha")"
    echo "target moved: +$target_count commits since dispatch ($base..$target_sha)"
  fi
  if ! git -C "$task" rebase "$target_sha" >/dev/null; then
    _dispatch_ledger_event_best_effort land_refused "$version" "$slug" --arg reason rebase '.["reason"]=$reason'
    _dispatch_schedule_metrics
    _dispatch_error "rebase of task/$version/$slug onto $target failed; resolve it in $task"
  fi
  local -a land_env=(
    "K3DM_REPO_ROOT=$task" "K3DM_JOB_DIR=$run/state/jobs" "K3DM_RUN_DIR=$run/state/run"
    "K3DM_STATE_DIR=$run/state/state" "K3DM_LOG_DIR=$run/state/logs" "K3DM_TMP_ROOT=$run/state/tmp"
    "K3DM_PORT_CACHE_DIR=$run/state/port-cache" "TMPDIR=$run/state/tmp"
  )
  local validation="$run/land-test.log" attempt=0 existing
  if (( no_test )); then
    echo "tests: skipped (--no-test)"
  else
    for existing in "$run"/land-test.*.log; do
      [[ -f "$existing" ]] && ((attempt+=1))
    done
    ((attempt+=1))
    validation="$run/land-test.$attempt.log"
    # Avoid overwriting an existing attempt even if the sequence has gaps.
    while [[ -e "$validation" ]]; do
      ((attempt+=1))
      validation="$run/land-test.$attempt.log"
    done
    ln -sfn "${validation##*/}" "$run/land-test.log"
  fi
  if (( no_test )); then
    :
  elif ! (cd "$task" && env "${land_env[@]}" bash -c "$test_cmd" >"$validation" 2>&1); then
    tail -n 20 "$validation"
    _dispatch_ledger_event_best_effort land_refused "$version" "$slug" --arg reason tests --arg validation "$validation" '.["reason"]=$reason|.validation=$validation'
    _dispatch_schedule_metrics
    _dispatch_error "tests failed after rebase onto $target; see $validation"
  else
    echo "tests: passed"
  fi
  if [[ "${K3DM_SKIP_FAST_GATE:-0}" == 1 ]]; then
    echo "land: fast gate skipped (K3DM_SKIP_FAST_GATE=1)"
  elif [[ ! -x "$task/scripts/ci/fast_gate.sh" ]]; then
    echo "land: fast gate not available in $_dispatch_event_repo; --test is the gate"
  elif ! (cd "$task" && env "${land_env[@]}" scripts/ci/fast_gate.sh "origin/$target" 2>&1 | tee "$run/land-fast-gate.log"); then
    _dispatch_ledger_event_best_effort land_refused "$version" "$slug" --arg reason fast-gate '.reason=$reason'
    _dispatch_schedule_metrics
    _dispatch_error "fast gate failed after rebase onto $target; see $run/land-fast-gate.log"
  fi
  if [[ "$(git -C "$repo_path" rev-parse "$target")" != "$target_sha" ]]; then
    git -C "$task" reset --hard "$task_before" >/dev/null 2>&1 || true
    _dispatch_ledger_event_best_effort land_refused "$version" "$slug" --arg reason target_moved_during_land '.reason=$reason'
    _dispatch_error "$target moved during land"
  fi
  local land_commit="" change_json="null" numstat=""
  land_commit="$(git -C "$task" rev-parse HEAD 2>/dev/null || true)"
  if numstat="$(git -C "$task" diff --numstat "$rel" HEAD 2>/dev/null)"; then
    change_json="$(_dispatch_change_stats "$numstat" 2>/dev/null || echo null)"
    [[ "$change_json" =~ ^\{.*\}$ ]] || change_json=null
  fi
  git -C "$repo_path" merge --ff-only "task/$version/$slug" >/dev/null || _dispatch_error "fast-forward merge of task/$version/$slug failed"
  land_ts="$(date +%s)"; wait_seconds=null
  if [[ -s "$run/codex-exit-ts" ]]; then
    codex_ts="$(<"$run/codex-exit-ts")"; wait_seconds=$((land_ts - codex_ts))
  fi
  local test_result=passed
  (( no_test )) && test_result=skipped
  _dispatch_ledger_event_best_effort land "$version" "$slug" --argjson verifier_lines "$verifier_lines" \
    --argjson wait_seconds "$wait_seconds" --arg tree "$(cat "$run/codex-tree" 2>/dev/null || true)" \
    --arg validation "$validation" --arg test_result "$test_result" \
    --argjson target_moved_commits "$target_count" --arg commit "$land_commit" --argjson change "$change_json" \
    --arg actor "$landing_actor" --arg vendor "$landing_vendor" --arg model "$landing_model" --argjson review_pending "$review_pending" \
    '.verifier_lines=$verifier_lines|.wait_seconds=$wait_seconds|.tree=$tree|.validation=$validation|.test_result=$test_result|.target_moved_commits=$target_moved_commits|.landing_actor={actor:$actor,vendor:$vendor,model:(if $model=="" then "unknown" else $model end),source:(if $actor=="unknown" then "unknown" else "declared" end)}|.review_status=(if $review_pending then "pending" else "unknown" end)|if $commit!="" then .commit=$commit else . end|if ($change|type)=="object" then .change=$change else . end|.chosen=true'
  case "$review_pending" in
    1) _dispatch_ledger_event_best_effort review_pending "$version" "$slug" --arg actor "$landing_actor" '.landing_actor=$actor|.review_status="pending"' ;;
  esac
  _dispatch_schedule_metrics
  git -C "$repo_path" worktree remove "$task"
  git -C "$repo_path" branch --unset-upstream "task/$version/$slug" 2>/dev/null || true
  git -C "$repo_path" branch -d "task/$version/$slug" >/dev/null; : >"$run/landed"
  echo "landed: $slug"; echo "push: git -C $repo_path push origin $target"
}

_dispatch_handoff() {
  local slug="" acting="" reason=unknown provenance=declared version vendor model
  local _acting_parts=""
  while (($#)); do
    case "$1" in
      --slug) (($# >= 2)) || _dispatch_error "--slug requires SLUG"; slug="$2"; shift 2 ;;
      --acting-coordinator) (($# >= 2)) || _dispatch_error "--acting-coordinator requires VENDOR/MODEL"; acting="$2"; shift 2 ;;
      --reason) (($# >= 2)) || _dispatch_error "--reason requires a value"; reason="$2"; shift 2 ;;
      --provenance) (($# >= 2)) || _dispatch_error "--provenance requires a value"; provenance="$2"; shift 2 ;;
      *) _dispatch_error "unknown handoff option: $1" ;;
    esac
  done
  [[ -n "$slug" && -n "$acting" ]] || _dispatch_error "handoff requires --slug and --acting-coordinator"
  case "$reason" in quota_exhausted|manual|unavailable|scheduled|other|unknown) ;; *) _dispatch_error "invalid handoff reason" ;; esac
  case "$provenance" in declared|runtime-reported) ;; *) _dispatch_error "invalid handoff provenance" ;; esac
  _acting_parts="$(_dispatch_identity_parts "$acting")" || _dispatch_error "invalid acting coordinator"
  vendor="${_acting_parts%%$'\n'*}"; model="${_acting_parts#*$'\n'}"
  version="$(_dispatch_release_branch)"; version="${version#k3d-manager-}"; _dispatch_task_paths "$version" "$slug"
  [[ -f "$_dispatch_run_dir/spec" ]] || _dispatch_error "no dispatched task '$slug' for $version"
  _dispatch_event_repo="$(cat "$_dispatch_run_dir/repo-name" 2>/dev/null || echo k3d-manager)"
  _dispatch_ledger_event handoff "$version" "$slug" --arg vendor "$vendor" --arg model "$model" --arg source "$provenance" --arg reason "$reason" \
    '.acting_coordinator_identity={vendor:$vendor,model:$model,source:$source,status:(if $source=="declared" then "declared" else "runtime_reported" end)}|.handoff_reason=$reason|.handoff_reason_source=$source'
  _dispatch_schedule_metrics
  printf 'handoff recorded: %s (%s)\n' "$slug" "$reason"
}

_dispatch_release_land_lock() {
  local lock="$1"
  rm -f "$lock/pid"
  rmdir "$lock" 2>/dev/null || true
}

_dispatch_open() {
  local version="" ledger="$_dispatch_worktree_root/ledger.jsonl"
  while (($#)); do
    case "$1" in
      --version) (($# >= 2)) || _dispatch_error "--version requires a value"; version="$2"; shift 2 ;;
      *) _dispatch_error "unknown open option: $1" ;;
    esac
  done
  [[ -z "$version" || "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || _dispatch_error "invalid version"
  [[ -f "$ledger" ]] || return 0
  python3 - "$ledger" "$version" <<'PYOPEN'
import json, sys, time
from collections import defaultdict

tasks = defaultdict(list)
with open(sys.argv[1]) as ledger:
    for line in ledger:
        try:
            event = json.loads(line)
        except (ValueError, TypeError):
            continue
        if isinstance(event, dict) and event.get("version") and event.get("slug"):
            tasks[(event["version"], event["slug"])].append(event)
found = False
for (version, slug), events in sorted(tasks.items()):
    if sys.argv[2] and version != sys.argv[2]:
        continue
    starts = [e for e in events if e.get("event") == "start"]
    if not starts or any(e.get("event") in ("land", "abandon") for e in events):
        continue
    age = max(0, int((time.time() - starts[0].get("ts", 0)) // 86400))
    print(f"{version} {slug} {age}d {events[-1].get('event', 'unknown')}")
    found = True
sys.exit(1 if found else 0)
PYOPEN
}

_dispatch_resume() {
  local slug="" prompt_file="" reason="" rel version task run session_id n network_slug agent model="" coordinator="" coordinator_vendor="" coordinator_model="" model_source recorded_model recorded_source
  while (($#)); do
    case "$1" in
      --slug) (($# >= 2)) || _dispatch_error "--slug requires a value"; slug="$2"; shift 2 ;;
      --prompt-file) (($# >= 2)) || _dispatch_error "--prompt-file requires a path"; prompt_file="$2"; shift 2 ;;
      --reason) (($# >= 2)) || _dispatch_error "--reason requires a value"; reason="$2"; shift 2 ;;
      --model) (($# >= 2)) || _dispatch_error "--model requires a value"; model="$2"; shift 2 ;;
      --coordinator) (($# >= 2)) || _dispatch_error "invalid coordinator"; coordinator="$2"; shift 2 ;;
      *) _dispatch_error "unknown resume option: $1" ;;
    esac
  done
  case "$reason" in continue_prompt|clarification|correction|other) ;; *) _dispatch_error "invalid or missing resume reason" ;; esac
  [[ -n "$slug" ]] || _dispatch_error "resume requires --slug SLUG"
  if [[ -n "$coordinator" ]]; then
    [[ "$coordinator" =~ ^([A-Za-z0-9._:-]{1,64})/([A-Za-z0-9._:-]{1,64})$ ]] || _dispatch_error "invalid coordinator"
    coordinator_vendor="${BASH_REMATCH[1]}"; coordinator_model="${BASH_REMATCH[2]}"
  fi
  [[ -n "$prompt_file" ]] || _dispatch_error "resume requires --prompt-file PATH"
  [[ -s "$prompt_file" ]] || _dispatch_error "prompt file is missing or empty: $prompt_file"
  rel="$(_dispatch_release_branch)"; version="${rel#k3d-manager-}"; _dispatch_task_paths "$version" "$slug"; task="$_dispatch_task_dir"; run="$_dispatch_run_dir"
  _dispatch_event_repo="$(cat "$run/repo-name" 2>/dev/null || echo k3d-manager)"
  [[ -d "$task" ]] || _dispatch_error "worktree does not exist: $task"
  [[ ! -f "$run/landed" ]] || _dispatch_error "task has landed: $slug"
  if [[ ! -f "$run/exit" ]] && _dispatch_worker_matches_start "$run"; then
    _dispatch_error "Codex is still running"
  fi
  agent="$(cat "$run/agent" 2>/dev/null || echo codex)"
  if [[ -z "$model" ]]; then model="$(cat "$run/model" 2>/dev/null || true)"; model_source=inherited
  else
    [[ "$agent" != agy ]] || _dispatch_error "--model is not supported for agy resume"
    [[ "$model" =~ ^[A-Za-z0-9._:-]{1,64}$ ]] || _dispatch_error "invalid model"
    model_source=explicit
  fi
  if [[ "$agent" == agy ]]; then
    [[ -s "$run/session" ]] || _dispatch_error "agy run returned no conversation id; start a new task"
    session_id="$(<"$run/session")"
  else
    session_id="$(sed -n 's/^session id: //p' "$run/codex.log" 2>/dev/null | head -n 1)"
  fi
  if [[ "$agent" != agy ]]; then
    [[ "$session_id" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] || _dispatch_error "no valid session id in $run/codex.log"
  fi
  n=2
  while [[ -e "$run/prompt-$n.md" ]]; do ((n++)); done
  if [[ -f "$run/network" ]] && network_slug="$(_dispatch_network_task_running "$version")" && [[ "$network_slug" != "$slug" ]]; then
    _dispatch_error "network task $network_slug is still running; only one networked task at a time"
  fi
  [[ "$model_source" != explicit ]] || printf '%s\n' "$model" >"$run/model"
  cp "$prompt_file" "$run/prompt-$n.md"
  rm -f "$run/exit" "$run/start"
  _dispatch_intervention --slug "$slug" --reason "$reason" >/dev/null
  recorded_model="$model"; recorded_source="$model_source"
  if [[ -z "$model" ]]; then recorded_model=unknown; recorded_source=unreported; fi
  _dispatch_ledger_event_best_effort resume "$version" "$slug" --arg reason "$reason" --argjson n "$n" --argjson run "$n" --arg agent "$agent" --arg model "$recorded_model" --arg vendor "$([[ "$agent" == agy ]] && echo google || echo openai)" --arg model_source "$recorded_source" --arg coordinator_vendor "$coordinator_vendor" --arg coordinator_model "$coordinator_model" '.reason=$reason|.["n"]=$n|.run=$run|.agent=$agent|.worker_identity={vendor:$vendor,model:$model,source:$model_source,status:(if $model=="unknown" then "unknown" else "unverified" end)}|.coordinator_identity=(if $coordinator_vendor=="" then {vendor:"unknown",model:"unknown",source:"unreported",status:"unknown"} else {vendor:$coordinator_vendor,model:$coordinator_model,source:"declared",status:"declared"} end)'
  _dispatch_detach_worker "$run" resume "$task" "$run" "$version" "$slug" "$([[ -f "$run/network" ]] && echo 1 || echo 0)" "$n" "$session_id" "$agent" "$model" "$model_source" </dev/null
  _dispatch_wait_for_start "$run" || _dispatch_log "$run" "resume worker did not acknowledge startup"
  _dispatch_schedule_metrics
  echo "resumed: $slug"; echo "resume: $n"
}

_dispatch_abandon() {
  local slug="" yes=0 rel version
  while (($#)); do
    case "$1" in
      --slug) (($# >= 2)) || _dispatch_error "--slug requires a value"; slug="$2"; shift 2 ;;
      --yes) yes=1; shift ;;
      *) _dispatch_error "unknown abandon option: $1" ;;
    esac
  done
  [[ -n "$slug" ]] || _dispatch_error "abandon requires --slug SLUG"
  rel="$(_dispatch_release_branch)"; version="${rel#k3d-manager-}"; _dispatch_task_paths "$version" "$slug"
  _dispatch_event_repo="$(cat "$_dispatch_run_dir/repo-name" 2>/dev/null || echo k3d-manager)"
  local repo_path target
  repo_path="$(cat "$_dispatch_run_dir/repo" 2>/dev/null || printf '%s' "$_dispatch_repo_root")"
  target="$(cat "$_dispatch_run_dir/target" 2>/dev/null || printf '%s' "$rel")"
  if (( ! yes )); then echo "would remove: $_dispatch_task_dir"; echo "would delete branch: task/$version/$slug"; exit 2; fi
  git -C "$repo_path" worktree remove --force "$_dispatch_task_dir"; git -C "$repo_path" branch -D "task/$version/$slug" >/dev/null
  _dispatch_ledger_event_best_effort abandon "$version" "$slug"
  _dispatch_schedule_metrics
  echo "abandoned: $slug"
}

_dispatch_prune() {
  local yes=0 arg version_dir version slug path branch release run_dir reason pruned=0 kept=0
  local -a candidates=()
  while (($#)); do
    case "$1" in
      --yes) (( yes == 0 )) || _dispatch_error "duplicate prune option: $1"; yes=1; shift ;;
      *) _dispatch_error "unknown prune option: $1" ;;
    esac
  done
  [[ -n "$_dispatch_repo_root" ]] || _dispatch_error "prune must run inside a git repository"
  for version_dir in "$_dispatch_worktree_root"/*/; do
    [[ -d "$version_dir" ]] || continue
    version="${version_dir%/}"; version="${version##*/}"
    for path in "$version_dir"*; do
      [[ -d "$path" && "$path" != *.run ]] || continue
      slug="${path##*/}"
      candidates+=("$version/$slug")
    done
    for branch in $(git -C "$_dispatch_repo_root" for-each-ref --format='%(refname:short)' "refs/heads/task/$version/"); do
      slug="${branch##*/}"
      [[ -d "$version_dir$slug" ]] || candidates+=("$version/$slug")
    done
  done
  # Deduplicate candidates that may have been found by both directory and branch scans.
  local -A seen=()
  for arg in "${candidates[@]}"; do
    [[ -z "${seen[$arg]:-}" ]] || continue
    seen[$arg]=1
    version="${arg%%/*}"; slug="${arg#*/}"; path="$_dispatch_worktree_root/$version/$slug"
    branch="task/$version/$slug"; release="origin/k3d-manager-$version"; run_dir="$_dispatch_worktree_root/$version/$slug.run"
    reason=""
    if ! git -C "$_dispatch_repo_root" show-ref --verify --quiet "refs/remotes/$release"; then
      reason="no release branch"
    elif git -C "$_dispatch_repo_root" show-ref --verify --quiet "refs/heads/$branch" &&
         git -C "$_dispatch_repo_root" cherry "$release" "$branch" | grep '^+' >/dev/null; then
      reason="unapplied commits"
    elif [[ -d "$path" ]] && [[ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]]; then
      reason="uncommitted changes"
    elif [[ ! -e "$run_dir/exit" && -f "$run_dir/pid" ]] &&
         kill -0 "$(<"$run_dir/pid")" 2>/dev/null; then
      reason="worker running"
    fi
    if [[ -n "$reason" ]]; then
      echo "keep: $version/$slug ($reason)"
      ((kept += 1))
    elif (( yes )); then
      if [[ -d "$path" ]]; then git -C "$_dispatch_repo_root" worktree remove "$path" || { echo "keep: $version/$slug (uncommitted changes)"; ((kept += 1)); continue; }; fi
      if git -C "$_dispatch_repo_root" show-ref --verify --quiet "refs/heads/$branch"; then git -C "$_dispatch_repo_root" branch -D "$branch" >/dev/null; fi
      echo "pruned: $version/$slug"
      ((pruned += 1))
    else
      echo "would prune: $version/$slug"
      ((pruned += 1))
    fi
  done
  if (( yes )); then git -C "$_dispatch_repo_root" worktree prune; fi
  echo "pruned: $pruned kept: $kept"
}

main() {
  (($#)) || { _dispatch_usage; exit 2; }
  case "$1" in
    _worker) shift; _dispatch_worker "$@" ;;
    start) shift; _dispatch_start "$@" ;;
    open) shift; _dispatch_open "$@" ;;
    status) shift; (($# <= 1)) || _dispatch_error "status accepts at most one slug"; _dispatch_status "${1:-}" ;;
    land) shift; _dispatch_land "$@" ;;
    resume) shift; _dispatch_resume "$@" ;;
    handoff) shift; _dispatch_handoff "$@" ;;
    verify) shift; _dispatch_verify "$@" ;;
    intervention) shift; _dispatch_intervention "$@" ;;
    abandon) shift; _dispatch_abandon "$@" ;;
    prune) shift; _dispatch_prune "$@" ;;
    usage-backfill) shift; (($# == 0)) || _dispatch_error "usage-backfill accepts no options"; _dispatch_usage_backfill ;;
    release-merged) shift; _dispatch_release_merged "$@" ;;
    gate-status|mark|gate-record|gate-coverage-start|link|combine) cmd="$1"; shift; _dispatch_s1 "$cmd" "$@" ;;
    -h|--help) _dispatch_usage ;;
    *) _dispatch_error "unknown command: $1" ;;
  esac
}
main "$@"
