#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -f "$REPO_ROOT/scripts/lib/foundation/scripts/lib/system.sh" ]]; then
  # shellcheck source=/dev/null
  source "$REPO_ROOT/scripts/lib/foundation/scripts/lib/system.sh"
else
  # shellcheck source=/dev/null
  source "$REPO_ROOT/scripts/lib/system.sh"
fi

readonly REMOTE=origin
readonly BRANCH=deploy/hub
readonly TAG_PREFIX=hub-promote/
GH_REPO="${GH_REPO:-wilddog64/k3d-manager}"

die() { printf '[hub-promote] ERROR: %s\n' "$*" >&2; exit 1; }
git_cmd() { _run_command --soft -- git -C "$REPO_ROOT" "$@"; }
git_push() { _run_command --soft -- env -u REF -u BREAK_GLASS -u SKIP_CHECK_RUNS -u SKIP_CHECK_RUNS_REASON -u MAKEFLAGS -u MFLAGS -u MAKELEVEL git -C "$REPO_ROOT" push "$@"; }

merged_pr_contains() {
  local target="$1" old="$2" rows number head merge remote_head
  rows="$(_run_command --soft -- gh api --paginate "repos/$GH_REPO/commits/$old/pulls" --jq '.[] | select(.merged_at != null) | [.number,.head.sha,.merge_commit_sha] | @tsv')" || return 1
  while IFS=$'\t' read -r number head merge; do
    [[ "$number" =~ ^[0-9]+$ && "$head" =~ ^[0-9a-f]{40,64}$ && "$merge" =~ ^[0-9a-f]{40,64}$ ]] || continue
    remote_head="$(git_cmd ls-remote "$REMOTE" "refs/pull/$number/head")" || continue
    [[ "${remote_head%%$'\t'*}" == "$head" ]] || continue
    git_cmd cat-file -e "$head^{commit}" 2>/dev/null || git_cmd fetch --no-tags "$REMOTE" "refs/pull/$number/head" >/dev/null 2>&1 || continue
    git_cmd cat-file -e "$merge^{commit}" 2>/dev/null || continue
    git_cmd merge-base --is-ancestor "$old" "$head" || continue
    git_cmd merge-base --is-ancestor "$merge" "$target" || continue
    printf '%s\n' "$number"
    return 0
  done <<< "$rows"
  return 1
}

uncontained_commits() {
  local target="$1" old="$2" list pr
  if [[ "$old" =~ ^0+$ || -z "$target" || -z "$old" ]]; then
    return 0
  fi
  list="$(git_cmd cherry "$target" "$old" | awk '$1 == "+" {print $2}')" || return 1
  if [[ -n "$list" ]] && pr="$(merged_pr_contains "$target" "$old")"; then
    printf '[hub-promote] note: deploy/hub %s is contained in merged PR #%s whose merge commit is in %s (squash merge); not treating its commits as uncontained\n' "$old" "$pr" "$target" >&2
    return 0
  fi
  [[ -z "$list" ]] || printf '%s\n' "$list"
}

print_uncontained_list() {
  local c short subj
  for c in "$@"; do
    short="$(git_cmd rev-parse --short "$c" 2>/dev/null || printf '%s' "$c")"
    subj="$(git_cmd log -1 --format='%s' "$c" 2>/dev/null || printf '(no subject)')"
    printf '  %s %s\n' "$short" "$subj"
  done
  local cp_cmd="git cherry-pick -x"
  for c in "$@"; do
    short="$(git_cmd rev-parse --short "$c" 2>/dev/null || printf '%s' "$c")"
    cp_cmd+=" $short"
  done
  printf '[hub-promote] carry them over: %s\n' "$cp_cmd"
}

remote_sha() {
  local allow_missing="${1:-0}"
  local rows sha
  rows="$(git_cmd ls-remote "$REMOTE" "refs/heads/$BRANCH")" || die "cannot read $REMOTE $BRANCH"
  sha="${rows%%$'\t'*}"
  if [[ -z "$sha" && "$allow_missing" == 1 ]]; then
    printf '%040d' 0
    return
  fi
  [[ "$sha" =~ ^[0-9a-f]{40,64}$ ]] || die "$REMOTE/$BRANCH does not exist; bootstrap it before promoting"
  printf '%s' "$sha"
}

resolve_on_origin() {
  local ref="$1" sha branches local_sha origin_sha
  if git_cmd show-ref --verify --quiet "refs/heads/$ref" && git_cmd show-ref --verify --quiet "refs/remotes/$REMOTE/$ref"; then
    local_sha="$(git_cmd rev-parse --verify "refs/heads/$ref^{commit}")" || die "cannot resolve local branch '$ref'"
    origin_sha="$(git_cmd rev-parse --verify "refs/remotes/$REMOTE/$ref^{commit}")" || die "cannot resolve origin branch '$ref'"
    [[ "$local_sha" == "$origin_sha" ]] || die "branch '$ref' differs: local $local_sha; origin/$ref $origin_sha"
  fi
  sha="$(git_cmd rev-parse --verify "${ref}^{commit}" 2>/dev/null)" || die "cannot resolve REF '$ref' to a commit"
  branches="$(git_cmd branch -r --contains "$sha" --format='%(refname:short)' | sed '/^origin\/HEAD -> /d')"
  [[ "$branches" == *"origin/"* ]] || die "commit $sha is not reachable from an origin branch"
  printf '%s' "$sha"
}

approval_resolve() {
  local ref="$1" name="" local_sha="" origin_sha="" sha="" refs="" rc
  for name in "refs/heads/$ref" "refs/remotes/$REMOTE/$ref"; do
    if git_cmd show-ref --verify --quiet "$name"; then rc=0; else rc=$?; fi
    [[ "$rc" == 0 || "$rc" == 1 ]] || return 75
    if [[ "$rc" == 0 ]]; then
      if sha="$(git_cmd rev-parse --verify "${name}^{commit}" 2>/dev/null)"; then :; else return 75; fi
      if [[ "$name" == "refs/heads/$ref" ]]; then local_sha="$sha"; else origin_sha="$sha"; fi
    fi
  done
  if [[ -n "$local_sha" && -n "$origin_sha" && "$local_sha" != "$origin_sha" ]]; then
    printf "[hub-promote] branch '%s' differs: local %s; origin/%s %s\n" "$ref" "$local_sha" "$ref" "$origin_sha" >&2; return 2
  fi
  if sha="$(git_cmd rev-parse --verify --quiet "${ref}^{commit}" 2>/dev/null)"; then rc=0; else rc=$?; fi
  [[ "$rc" == 0 ]] || { [[ "$rc" == 1 ]] && { printf "[hub-promote] cannot resolve REF '%s' to a commit\n" "$ref" >&2; return 2; }; return 75; }
  if refs="$(git_cmd for-each-ref --contains "$sha" --format='%(refname)' "refs/remotes/$REMOTE/")"; then :; else return 75; fi
  local reachable=0 line
  while IFS= read -r line; do [[ "$line" == "refs/remotes/$REMOTE/HEAD" || -z "$line" ]] || reachable=1; done <<< "$refs"
  [[ "$reachable" == 1 ]] || { printf '[hub-promote] commit %s is not reachable from an origin branch\n' "$sha" >&2; return 2; }
  [[ "$sha" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] || return 75
  printf '%s' "$sha"
}

classify_check_runs() {
  local sha="$1" data count pending failed
  data="$(_run_command --soft -- gh api --paginate "repos/$GH_REPO/commits/$sha/check-runs" --jq '.check_runs[]')" || return 2
  count="$(jq -s 'length' <<< "$data")" || return 2
  (( count > 0 )) || return 3
  pending="$(jq -s '[.[] | select(.status != "completed")] | length' <<< "$data")" || return 2
  failed="$(jq -s '[.[] | select(.conclusion != "success" and .conclusion != "neutral" and .conclusion != "skipped")] | length' <<< "$data")" || return 2
  (( pending == 0 && failed == 0 ))
}

check_runs() {
  local sha="$1" rc
  if classify_check_runs "$sha"; then return 0; else rc=$?; fi
  case "$rc" in
    2) die "GitHub check-runs lookup failed" ;;
    3) die "no GitHub check runs exist for $sha" ;;
    *) die "GitHub check runs are pending or failed for $sha" ;;
  esac
}

show_and_confirm() {
  local old="$1" new="$2" action="$3" ref="${4:-}" subjects
  printf '[hub-promote] action: %s\n[hub-promote] old deploy/hub: %s\n[hub-promote] new deploy/hub: %s\n' "$action" "$old" "$new"
  if [[ "$old" =~ ^0+$ ]]; then
    printf '[hub-promote] bootstrap: deploy/hub does not exist yet\n'
  else
    if [[ "$action" == rollback ]]; then
      if ! subjects="$(git_cmd log --format='%h %s' "$new..$old" 2>/dev/null)"; then
        die "cannot list rollback commits in range $new..$old"
      fi
      printf '[hub-promote] will be removed from deploy/hub:\n'
      if [[ -n "$subjects" ]]; then printf '%s\n' "$subjects"; else printf '  (none)\n'; fi
      if ! subjects="$(git_cmd log --format='%h %s' "$old..$new" 2>/dev/null)"; then
        die "cannot list rollback commits in range $old..$new"
      fi
      if [[ -n "$subjects" ]]; then printf '[hub-promote] will be added to deploy/hub:\n%s\n' "$subjects"; fi
    else
      subjects="$(git_cmd log --format='%h %s' -30 "$old..$new" 2>/dev/null || true)"
      if [[ -n "$subjects" ]]; then printf '%s\n' "$subjects"; else printf '[hub-promote] no commits between refs\n'; fi
    fi
  fi
  [[ -z "$ref" ]] || printf '[hub-promote] REF: %s\n' "$ref"
  [[ -t 0 ]] || die 'confirmation requires a TTY'
  printf "Type 'promote' to continue: " >&2
  local answer
  IFS= read -r answer || die 'could not read confirmation'
  [[ "$answer" == promote ]] || die 'confirmation did not match promote'
}

record_move() {
  local old="$1" new="$2" action="$3" ref="${4:-}" break_glass="${5:-0}" skip_checks="${6:-0}" stamp tag message existing push_output push_log
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  tag="$TAG_PREFIX$stamp"
  existing="$(git_cmd ls-remote --tags "$REMOTE" "refs/tags/$tag")"
  [[ -z "$existing" ]] || die "promotion tag $tag already exists; retry after the next UTC second"
  existing="$(git_cmd show-ref --verify "refs/tags/$tag" 2>/dev/null || true)"
  [[ -z "$existing" ]] || die "local promotion tag $tag already exists; retry after the next UTC second"
  printf -v message 'action: %s\nold: %s\nnew: %s\nREF: %s' "$action" "$old" "$new" "${ref:-$new}"
  [[ "$break_glass" != 1 ]] || message+=$'\nmode: break-glass'
  if [[ "$skip_checks" == 1 ]]; then
    message+=$'\nmode: skip-check-runs'
    message+=$'\nreason: '"$SKIP_CHECK_RUNS_REASON"
  fi
  if [[ "$action" == rollback ]]; then message+=$'\nrollback: yes'; fi
  local lease="refs/heads/$BRANCH:$old"
  [[ ! "$old" =~ ^0+$ ]] || lease="refs/heads/$BRANCH:"
  push_log="$(mktemp)"
  if ! git_push "$REMOTE" "--force-with-lease=$lease" "$new:refs/heads/$BRANCH" 2>&1 | tee "$push_log" >&2; then
    push_output="$(<"$push_log")"
    rm -f "$push_log"
    if [[ "$push_output" == *"stale info"* ]]; then
      die 'deploy/hub changed after it was read; lease rejected the push'
    fi
    die "push to deploy/hub failed; see git's output above (a pre-push hook, the network or permissions)"
  fi
  rm -f "$push_log"
  git_cmd tag -a "$tag" "$new" -m "$message" || die "could not create annotated tag $tag"
  git_push "$REMOTE" "refs/tags/$tag" || die "deploy/hub moved, but tag push failed ($tag)"
  printf '[hub-promote] moved deploy/hub to %s and recorded %s\n' "$new" "$tag"
}

status() {
  local sha tags release ahead local_sha origin_sha counts local_ahead local_behind
  sha="$(remote_sha)"
  printf '[hub-promote] deploy/hub: %s\n' "$sha"
  tags="$(git_cmd ls-remote --tags "$REMOTE" "refs/tags/${TAG_PREFIX}*" | awk '$2 !~ /\^\{\}$/ {print}' | sort -k2 -r | head -3 || true)"
  printf '[hub-promote] last three hub-promote tags:\n%s\n' "${tags:-  (none)}"
  release="${RELEASE_BRANCH:-$(git_cmd branch --show-current)}"
  if [[ ! "$release" =~ ^k3d-manager-v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    release="$(git_cmd for-each-ref --sort=-committerdate --format='%(refname:lstrip=3)' 'refs/remotes/origin/k3d-manager-v*' | head -1)"
  fi
  if [[ -z "$release" ]]; then release=main; fi
  if ! git_cmd fetch --quiet --no-tags "$REMOTE" "+refs/heads/$release:refs/remotes/$REMOTE/$release" "+refs/heads/$BRANCH:refs/remotes/$REMOTE/$BRANCH"; then
    printf '[hub-promote] WARNING: fetch failed; counts may be stale\n' >&2
  fi
  ahead="$(git_cmd rev-list --count "$sha..refs/remotes/$REMOTE/$release" 2>/dev/null || printf '?')"
  printf '[hub-promote] %s ahead of deploy/hub: %s\n' "$release" "$ahead"
  local_sha="$(git_cmd rev-parse --verify "refs/heads/$release^{commit}" 2>/dev/null || true)"
  origin_sha="$(git_cmd rev-parse --verify "refs/remotes/$REMOTE/$release^{commit}" 2>/dev/null || true)"
  if [[ -n "$local_sha" && -n "$origin_sha" && "$local_sha" != "$origin_sha" ]]; then
    counts="$(git_cmd rev-list --left-right --count "refs/heads/$release...refs/remotes/$REMOTE/$release")" || counts='? ?'
    if [[ "$counts" == *$'\t'* ]]; then
      read -r local_ahead local_behind <<< "$counts"
      printf '[hub-promote] local %s is %s behind / %s ahead of origin\n' "$release" "$local_behind" "$local_ahead"
    else
      printf '[hub-promote] local %s is ? behind / ? ahead of origin\n' "$release"
    fi
  fi
  local rel_sha
  rel_sha="$origin_sha"
  if [[ -n "$rel_sha" ]]; then
    local -a uncontained=()
    local uncontained_text
    uncontained_text="$(uncontained_commits "$rel_sha" "$sha")" || printf '[hub-promote] WARNING: cannot check deploy/hub containment\n' >&2
    [[ -z "${uncontained_text:-}" ]] || mapfile -t uncontained <<< "$uncontained_text"
    if (( ${#uncontained[@]} > 0 )); then
      printf '[hub-promote] uncontained commits on deploy/hub:\n'
      print_uncontained_list "${uncontained[@]}"
    fi
  fi
}

rollback() {
  local break_glass="${1:-0}"
  local old target tag tag_data action sha tag_old top live_sha
  local -a tags=()
  local -a stack_old=()
  local -a stack_new=()
  live_sha=""
  git_cmd fetch "$REMOTE" --prune
  old="$(remote_sha)"
  mapfile -t tags < <(git_cmd ls-remote --tags "$REMOTE" "refs/tags/${TAG_PREFIX}*" | awk '$2 !~ /\^\{\}$/ {print $2}' | sort -k1,1)
  for tag in "${tags[@]}"; do
    tag_data="$(git_cmd fetch --no-tags "$REMOTE" "$tag" >/dev/null && git_cmd cat-file -p FETCH_HEAD)" || die "promotion tag $tag is not available"
    action="$(sed -n 's/^action: //p' <<< "$tag_data" | head -1)"
    tag_old="$(sed -n 's/^old: //p' <<< "$tag_data" | head -1)"
    sha="$(sed -n 's/^new: //p' <<< "$tag_data" | head -1)"
    [[ "$sha" =~ ^[0-9a-f]{40,64}$ && "$tag_old" =~ ^[0-9a-f]{40,64}$ ]] || die "promotion tag $tag has no valid old/new SHA"
    case "$action" in
      promote)
        live_sha="$sha"
        if [[ "$tag_old" != "$sha" ]]; then
          stack_old+=("$tag_old")
          stack_new+=("$sha")
        fi
        ;;
      rollback)
        (( ${#stack_new[@]} >= 1 )) || die "rollback tag $tag has no earlier promotion to pop"
        top="${stack_new[${#stack_new[@]}-1]}"
        if [[ "$tag_old" != "$top" ]]; then
          if ! git_cmd cat-file -e "$tag_old^{commit}" 2>/dev/null; then
            git_cmd fetch --no-tags "$REMOTE" "$tag_old" >/dev/null 2>&1 || true
          fi
          if ! git_cmd cat-file -e "$tag_old^{commit}" 2>/dev/null; then
            printf '[hub-promote] WARNING: rollback tag %s old SHA %s is unavailable locally; accepting its recorded target\n' "$tag" "$tag_old" >&2
          elif ! git_cmd merge-base --is-ancestor "$top" "$tag_old" 2>/dev/null; then
            die "rollback tag $tag does not match the promotion stack"
          fi
        fi
        [[ "$sha" == "${stack_old[${#stack_old[@]}-1]}" ]] || die "rollback tag $tag does not match the promotion stack"
        live_sha="$sha"
        unset 'stack_old[${#stack_old[@]}-1]'
        unset 'stack_new[${#stack_new[@]}-1]'
        ;;
      *) die "promotion tag $tag has an unknown action" ;;
    esac
  done
  (( ${#stack_new[@]} > 0 )) || die 'there is no earlier promotion to return to'
  top="${stack_new[${#stack_new[@]}-1]}"
  if [[ "${stack_old[${#stack_old[@]}-1]}" =~ ^0+$ ]]; then
    die 'the promotion stack only contains the bootstrap; there is no earlier state to return to'
  fi
  [[ -n "$live_sha" ]] || die 'promotion history has no live SHA'
  if [[ "$old" != "$live_sha" ]]; then
    if ! git_cmd merge-base --is-ancestor "$live_sha" "$old" 2>/dev/null; then
      die 'deploy/hub does not match the promotion stack top'
    fi
  fi
  local -a uncontained=()
  local uncontained_text
  uncontained_text="$(uncontained_commits "$live_sha" "$old")" || die "cannot check deploy/hub containment ($old against $live_sha)"
  [[ -z "$uncontained_text" ]] || mapfile -t uncontained <<< "$uncontained_text"
  if (( ${#uncontained[@]} > 0 )); then
    if [[ "$break_glass" != 1 ]]; then
      printf '[hub-promote] ERROR: deploy/hub has uncontained commits not in promotion stack top %s:\n' "$top" >&2
      print_uncontained_list "${uncontained[@]}" >&2
      die 'deploy/hub does not match the promotion stack top'
    fi
  fi
  target="${stack_old[${#stack_old[@]}-1]}"
  show_and_confirm "$old" "$target" rollback
  record_move "$old" "$target" rollback "" "$break_glass"
}

main() {
  [[ $# -ge 1 ]] || die 'usage: k3dm-hub-promote promote REF [BREAK_GLASS=1] [SKIP_CHECK_RUNS=1] | promote REF --approval ID | rollback [BREAK_GLASS=1] | status | is-contained TARGET OLD'
  case "$1" in
    is-green)
      [[ $# == 2 && -n "$2" ]] || die 'usage: k3dm-hub-promote is-green <sha>'
      if classify_check_runs "$2"; then exit 0; else rc=$?; fi
      case "$rc" in
        1|3) exit 3 ;;
        2) exit 2 ;;
        *) exit 2 ;;
      esac
      ;;
    is-contained)
      [[ $# == 3 && -n "$2" && -n "$3" ]] || exit 2
      local target old contained
      target="$(git_cmd rev-parse --verify "$2^{commit}" 2>/dev/null)" || exit 2
      old="$(git_cmd rev-parse --verify "$3^{commit}" 2>/dev/null)" || exit 2
      contained="$(uncontained_commits "$target" "$old")" || exit 2
      [[ -z "$contained" ]] || exit 1
      ;;
    status) [[ $# == 1 ]] || die 'status takes no arguments'; status ;;
    rollback)
      [[ $# -ge 1 && $# -le 2 ]] || die 'usage: k3dm-hub-promote rollback [BREAK_GLASS=1]'
      local break_glass="${2:-${BREAK_GLASS:-0}}"
      [[ "$break_glass" == 0 || "$break_glass" == 1 ]] || die 'BREAK_GLASS must be 0 or 1'
      rollback "$break_glass"
      ;;
    promote)
      if [[ $# == 4 && "$3" == --approval ]]; then
        local ref="$2" approval_id="$4" sha old_sha client_rc reply human
        [[ "$approval_id" =~ ^p[0-9]+-[0-9a-f]{8}$ ]] || { printf '[hub-promote] ERROR: usage: promote REF --approval ID\n' >&2; exit 2; }
        if [[ "${BREAK_GLASS:-}" != '' && "${BREAK_GLASS:-}" != 0 || "${SKIP_CHECK_RUNS:-}" != '' && "${SKIP_CHECK_RUNS:-}" != 0 ]]; then
          printf '[hub-promote] --approval cannot be combined with BREAK_GLASS or SKIP_CHECK_RUNS\n' >&2; exit 1
        fi
        if git_cmd fetch "$REMOTE" --prune; then :; else printf '[hub-promote] could not fetch origin for approval %s; rerun the same command\n' "$approval_id" >&2; exit 75; fi
        if sha="$(approval_resolve "$ref")"; then :; else rc=$?; printf '[hub-promote] cannot resolve approval %s (exit %s); rerun the same command\n' "$approval_id" "$rc" >&2; exit "$rc"; fi
        if reply="$(env -u BREAK_GLASS -u SKIP_CHECK_RUNS -u SKIP_CHECK_RUNS_REASON -u REF -u MAKEFLAGS -u MFLAGS -u MAKELEVEL "$REPO_ROOT/bin/k3dm-promote-client" promote --id "$approval_id" --sha "$sha")"; then client_rc=0; else client_rc=$?; fi
        human="$(/usr/bin/python3 -I - "$sha" "$client_rc" "$reply" <<'PYCODE'
import json
import re
import sys

requested, client_rc, raw_reply = sys.argv[1], int(sys.argv[2]), sys.argv[3]
try:
    value = json.loads(raw_reply)
except Exception:
    print("DENIED\tclient denied approval (malformed reply)" if client_rc == 2 else "INVALID")
    raise SystemExit
expected = {"v", "result", "code", "message", "data"}
valid = isinstance(value, dict) and set(value) == expected and type(value.get("v")) is int and value["v"] == 1
sha_pattern = r"^[0-9a-f]{40}([0-9a-f]{24})?$"
tag_pattern = r"^hub-promote/[0-9]{8}T[0-9]{6}Z$"
if client_rc == 0:
    data = value.get("data")
    valid = valid and value.get("result") == "ok" and value.get("code") == "ok" and isinstance(value.get("message"), str) and isinstance(data, dict) and set(data) == {"outcome", "old", "new", "tag"} and data.get("outcome") in ("moved", "already") and data.get("new") == requested and isinstance(data.get("old"), str) and re.fullmatch(sha_pattern, data["old"]) and isinstance(data.get("tag"), str) and re.fullmatch(tag_pattern, data["tag"])
    if valid:
        print("OK\t%s\t%s\t%s\t%s" % (data["outcome"], data["old"], data["new"], data["tag"]))
        raise SystemExit
elif client_rc == 1:
    data = value.get("data")
    valid = valid and value.get("result") == "refused" and isinstance(value.get("code"), str) and isinstance(value.get("message"), str) and isinstance(data, dict) and set(data) == {"approval"} and data.get("approval") in ("kept", "final")
    if valid:
        print("REFUSED\t%s\t%s" % (data["approval"], value["message"]))
        raise SystemExit
elif client_rc == 2:
    message = value.get("message") if isinstance(value, dict) and isinstance(value.get("message"), str) else "client denied approval (malformed reply)"
    print("DENIED\t%s" % message)
    raise SystemExit
elif client_rc not in (0, 1, 2):
    message = value.get("message") if isinstance(value.get("message"), str) else "no reply"
    print("UNKNOWN\t%s" % message)
    raise SystemExit
print("INVALID")
PYCODE
)"
        case "$human" in
          OK$'\t'*) IFS=$'\t' read -r _ outcome old_sha new_sha tag <<< "$human"; if [[ "$outcome" == moved ]]; then printf '[hub-promote] approval %s moved deploy/hub %s..%s (%s)\n' "$approval_id" "${old_sha:0:7}" "${new_sha:0:7}" "$tag" >&2; else printf '[hub-promote] approval %s had already moved deploy/hub %s..%s (%s)\n' "$approval_id" "${old_sha:0:7}" "${new_sha:0:7}" "$tag" >&2; fi; printf 'approved-sha %s\napproved-old %s\n' "$new_sha" "$old_sha"; exit 0 ;;
          REFUSED$'\t'*) IFS=$'\t' read -r _ state message <<< "$human"; if [[ "$state" == kept ]]; then printf '[hub-promote] refused: %s; approval %s is kept\n' "$message" "$approval_id" >&2; else printf '[hub-promote] refused: %s; approval %s is closed; request a new one\n' "$message" "$approval_id" >&2; fi; exit 1 ;;
          DENIED$'\t'*) printf '[hub-promote] refused: %s\n' "${human#*$'\t'}" >&2; exit 2 ;;
          UNKNOWN$'\t'*) printf '[hub-promote] could not decide for approval %s (%s); rerun the same command; bin/k3dm-promote-client show --id %s reports its state\n' "$approval_id" "${human#*$'\t'}" "$approval_id" >&2; exit 75 ;;
          *) printf '[hub-promote] the authority\x27s reply for approval %s did not match the request; rerun the same command\n' "$approval_id" >&2; exit 75 ;;
        esac
      fi
      for arg in "${@:2}"; do
        if [[ "$arg" == --approval ]]; then
          printf '[hub-promote] ERROR: usage: promote REF --approval ID\n' >&2
          exit 2
        fi
      done
      [[ $# -ge 2 && $# -le 4 ]] || die 'usage: k3dm-hub-promote promote REF [BREAK_GLASS=1] [SKIP_CHECK_RUNS=1]'
      local ref="$2" break_glass="${3:-${BREAK_GLASS:-0}}" skip_checks="${4:-${SKIP_CHECK_RUNS:-0}}" old new
      [[ "$break_glass" == 0 || "$break_glass" == 1 ]] || die 'BREAK_GLASS must be 0 or 1'
      [[ "$skip_checks" == 0 || "$skip_checks" == 1 ]] || die 'SKIP_CHECK_RUNS must be 0 or 1'
      if [[ "$skip_checks" == 1 ]]; then
        [[ -n "${SKIP_CHECK_RUNS_REASON:-}" && "$SKIP_CHECK_RUNS_REASON" != *$'\n'* && "$SKIP_CHECK_RUNS_REASON" =~ [^[:space:]] ]] || die 'SKIP_CHECK_RUNS=1 needs SKIP_CHECK_RUNS_REASON="<why>" (one line)'
      fi
      git_cmd fetch "$REMOTE" --prune
      new="$(resolve_on_origin "$ref")"
      old="$(remote_sha 1)"
      if [[ "$new" == "$old" ]]; then
        printf '[hub-promote] deploy/hub is already at %s; nothing to promote\n' "$new"
        exit 0
      fi
      if [[ ! "$old" =~ ^0+$ ]]; then
        git_cmd fetch --no-tags "$REMOTE" "+refs/heads/$BRANCH:refs/remotes/$REMOTE/$BRANCH" || die "cannot fetch $REMOTE $BRANCH"
        git_cmd cat-file -e "$old^{commit}" || die "deploy/hub commit $old is not available locally; refusing to promote"
      fi
      local -a uncontained=()
      local uncontained_text
      uncontained_text="$(uncontained_commits "$new" "$old")" || die "cannot check deploy/hub containment ($old against $new)"
      [[ -z "$uncontained_text" ]] || mapfile -t uncontained <<< "$uncontained_text"
      if (( ${#uncontained[@]} > 0 )); then
        if [[ "$break_glass" != 1 ]]; then
          printf '[hub-promote] ERROR: deploy/hub contains %d commit(s) not in %s:\n' "${#uncontained[@]}" "$ref" >&2
          print_uncontained_list "${uncontained[@]}" >&2
          exit 1
        fi
      fi
      if [[ "$skip_checks" == 1 ]]; then
        printf '[hub-promote] WARNING: check-run gate skipped for %s: %s\n' "$new" "$SKIP_CHECK_RUNS_REASON" >&2
      else
        check_runs "$new"
      fi
      show_and_confirm "$old" "$new" promote "$ref"
      record_move "$old" "$new" promote "$ref" "$break_glass" "$skip_checks"
      printf '[hub-promote] next: make appsets-check, then make platform-ops\n'
      ;;
    *) die "unknown action '$1'" ;;
  esac
}

main "$@"
