#!/usr/bin/env bash
# bin/smoke-test-cluster-health
# Baseline cluster health gate — run after every cluster task before reporting done.
#
# Checks:
#   1. ghcr-pull-secret exists in all 3 shopping-cart namespaces (resolved app context)
#   2. All 5 ArgoCD apps are Synced (infra cluster context)
#   3. All 5 app pods Running on the resolved app context
#
# Exit: 0 healthy, 1 health check failed, 2 target could not be determined
#
# Usage:
#   bin/smoke-test-cluster-health
#
# Environment:
#   INFRA_CONTEXT      kubectl context for infra cluster (default: k3d-k3d-cluster)
#   APP_CONTEXT        kubectl context for app cluster; when unset, the unique
#                      shopping-cart Application destination.name is used when it
#                      is a local context, or INFRA_CONTEXT for an in-cluster app
#   ARGOCD_NAMESPACE   namespace ArgoCD runs in          (default: cicd)
#   ARGOCD_APP_PREFIX  exact prefix of the selected shopping-cart Applications;
#                      when unset, it is inferred only when one candidate exists

set -euo pipefail

SMOKE_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SMOKE_SCRIPT_DIR}/.." && pwd)"
# shellcheck source=scripts/lib/system.sh
# shellcheck disable=SC1091
source "${REPO_ROOT}/scripts/lib/system.sh"

INFRA_CONTEXT="${INFRA_CONTEXT:-k3d-k3d-cluster}"
ARGOCD_NAMESPACE="${ARGOCD_NAMESPACE:-cicd}"

_target_error() {
  local message candidate_name candidate_dest

  message="$1"
  printf '[TARGET] %s\n' "${message}" >&2
  if [[ -z "${_candidate_lines}" ]]; then
    printf '  (none)\n' >&2
  else
    while IFS=$'\t' read -r candidate_name candidate_dest; do
      if [[ -n "${candidate_dest}" ]]; then
        printf '  %s -> %s\n' "${candidate_name}" "${candidate_dest}" >&2
      else
        printf '  %s -> (in-cluster)\n' "${candidate_name}" >&2
      fi
    done <<< "${_candidate_lines}"
  fi
  exit 2
}

if ! _application_listing="$(_kubectl --no-exit --quiet -- --context="${INFRA_CONTEXT}" \
    -n "${ARGOCD_NAMESPACE}" get applications \
    -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.spec.destination.name}{"\n"}{end}' 2>/dev/null)"; then
  _candidate_lines=""
  _target_error "could not list ArgoCD Applications in ${ARGOCD_NAMESPACE} using ${INFRA_CONTEXT}"
fi
_candidate_lines="$(printf '%s\n' "${_application_listing}" | awk -F'\t' '$1 ~ /shopping-cart-basket$/')"

if [[ -n "${ARGOCD_APP_PREFIX+x}" ]]; then
  _selected_candidate="$(printf '%s\n' "${_candidate_lines}" \
    | awk -F'\t' -v n="${ARGOCD_APP_PREFIX}shopping-cart-basket" '$1==n')"
  [[ -n "${_selected_candidate}" ]] || \
    _target_error "no shopping-cart target matches ARGOCD_APP_PREFIX=${ARGOCD_APP_PREFIX}"
else
  _candidate_count="$(printf '%s\n' "${_candidate_lines}" | awk 'NF { count++ } END { print count + 0 }')"
  (( _candidate_count == 1 )) || \
    _target_error "expected exactly one shopping-cart target, found ${_candidate_count}"
  _selected_candidate="${_candidate_lines}"
  ARGOCD_APP_PREFIX="${_selected_candidate%shopping-cart-basket*}"
fi

_selected_dest="${_selected_candidate#*$'\t'}"
if [[ -z "${APP_CONTEXT+x}" ]]; then
  if [[ -z "${_selected_dest}" ]]; then
    APP_CONTEXT="${INFRA_CONTEXT}"
  else
    if ! _local_contexts="$(kubectl config get-contexts -o name 2>/dev/null)"; then
      _target_error "destination ${_selected_dest} cannot be checked because local kubeconfig contexts are unavailable"
    fi
    if printf '%s\n' "${_local_contexts}" | grep -qxF -- "${_selected_dest}"; then
      APP_CONTEXT="${_selected_dest}"
    else
      _target_error "destination ${_selected_dest} is not a local kubeconfig context; add that context or set APP_CONTEXT"
    fi
  fi
elif [[ -n "${_selected_dest}" && "${APP_CONTEXT}" != "${_selected_dest}" ]]; then
  _target_error "APP_CONTEXT=${APP_CONTEXT} does not match Application destination ${_selected_dest}"
fi
SHOPPING_CART_APP_NS="shopping-cart-apps"
SHOPPING_CART_PAYMENT_NS="shopping-cart-payment"

PASS=0
FAIL=0

_pass() { echo "[PASS] $*"; (( PASS++ )) || true; }
_fail() { echo "[FAIL] $*" >&2; (( FAIL++ )) || true; }

echo "=== Cluster Health Smoke Test ==="
echo "  infra: ${INFRA_CONTEXT}"
echo "  app:   ${APP_CONTEXT}"
echo "Infra context: ${INFRA_CONTEXT}; app context: ${APP_CONTEXT} (apps: ${ARGOCD_APP_PREFIX}shopping-cart-*)"
echo ""

# --- 1. ghcr-pull-secret in all 3 namespaces (app cluster) ---
echo "-- ghcr-pull-secret --"
for ns in shopping-cart-apps shopping-cart-data shopping-cart-payment; do
  if _kubectl --no-exit --quiet -- --context="${APP_CONTEXT}" get secret ghcr-pull-secret -n "${ns}" >/dev/null 2>&1; then
    _pass "ghcr-pull-secret present in ${ns}"
  else
    _fail "ghcr-pull-secret MISSING in ${ns}"
  fi
done

echo ""

# --- 2. ArgoCD apps Synced (infra cluster) ---
echo "-- ArgoCD sync status --"
for app in shopping-cart-basket shopping-cart-order shopping-cart-payment \
           shopping-cart-product-catalog shopping-cart-frontend; do
  sync_status=$(_kubectl --no-exit --quiet -- --context="${INFRA_CONTEXT}" get application "${ARGOCD_APP_PREFIX}${app}" \
    -n "${ARGOCD_NAMESPACE}" \
    -o jsonpath='{.status.sync.status}' 2>/dev/null || echo "NotFound")
  if [[ "${sync_status}" == "Synced" ]]; then
    _pass "${app}: Synced"
  else
    _fail "${app}: ${sync_status} (expected Synced)"
  fi
done

echo ""

# --- 3. Pod status on app cluster ---
echo "-- Pod status (${APP_CONTEXT}) --"
running=$(
  { _kubectl --no-exit --quiet -- --context="${APP_CONTEXT}" get pods -n "${SHOPPING_CART_APP_NS}" --no-headers 2>/dev/null
    _kubectl --no-exit --quiet -- --context="${APP_CONTEXT}" get pods -n "${SHOPPING_CART_PAYMENT_NS}" --no-headers 2>/dev/null
  } | grep -c "Running" || true)
crashloop=$(
  { _kubectl --no-exit --quiet -- --context="${APP_CONTEXT}" get pods -n "${SHOPPING_CART_APP_NS}" --no-headers 2>/dev/null
    _kubectl --no-exit --quiet -- --context="${APP_CONTEXT}" get pods -n "${SHOPPING_CART_PAYMENT_NS}" --no-headers 2>/dev/null
  } | grep -c "CrashLoopBackOff" || true)

echo "  Running:            ${running}"
echo "  CrashLoopBackOff:   ${crashloop}"

if (( running >= 5 )); then
  _pass "${running}/5 pods Running"
else
  _fail "only ${running}/5 pods Running — expected 5"
fi

echo ""

# --- Summary ---
echo "=== Result: ${PASS} passed, ${FAIL} failed ==="
if (( FAIL > 0 )); then
  exit 1
fi
exit 0
