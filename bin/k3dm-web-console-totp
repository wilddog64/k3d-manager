#!/bin/bash
function _wct_main_env() {
  PATH=/usr/bin:/bin:/usr/sbin:/sbin
  unset -f sudo
}

_WCT_LABEL=com.k3d-manager.web-console-totp
_WCT_PLIST_TEMPLATE="scripts/etc/launchd/${_WCT_LABEL}.plist.tmpl"
_WCT_GATE_SOURCE=scripts/libexec/k3dm-console-gate.py
_WCT_TOTPD_SOURCE=scripts/libexec/k3dm-console-totpd.py
_WCT_TOTPCTL_SOURCE=scripts/libexec/k3dm-console-totpctl.py
_WCT_PY=/Library/Developer/CommandLineTools/usr/bin/python3
_WCT_PYAPP=/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/Resources/Python.app/Contents/MacOS/Python
_WCT_PYDYLIB=/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/Python3
_WCT_STATE_DIR=/var/db/k3dm-web-console
_WCT_RUN_DIR=/var/db/k3dm-web-console-run
_WCT_LOG=/var/log/k3dm-web-console-totp.log

function _wct_message() {
  printf 'web-console-totp: %s\n' "$*" >&2
}

function _wct_refusal_check() {
  local eff_uid
  case "${TMUX+set}:${TMUX_PANE+set}:${STY+set}" in *set*) _wct_message 'refusing to show a secret here: inside tmux or screen'; return 2 ;; esac
  case "${SSH_CONNECTION+set}:${SSH_TTY+set}" in *set*) _wct_message 'refusing to show a secret here: over SSH'; return 2 ;; esac
  if [[ ! -t 0 || ! -t 1 ]]; then _wct_message 'refusing to show a secret here: stdin or stdout is not a tty'; return 2; fi
  if ! { : <>/dev/tty; } 2>/dev/null; then _wct_message 'refusing to show a secret here: /dev/tty not accessible'; return 2; fi
  eff_uid=$(_wc_tool /usr/bin/id -u) || return 2
  if [[ "$eff_uid" = 0 ]]; then _wct_message 'refusing to show a secret here: running as root'; return 2; fi
  return 0
}

function _wct_find_tmux() {
  local candidate
  for candidate in /opt/homebrew/bin/tmux /usr/local/bin/tmux /opt/local/bin/tmux /usr/bin/tmux; do
    if [[ -f "$_WC_PREFIX$candidate" && -x "$_WC_PREFIX$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

function _wct_realpath() {
  local path="$1" actual="$_WC_PREFIX$1" target parent base hops=0
  [[ -e "$actual" || -L "$actual" ]] || return 1
  while [[ -L "$actual" ]]; do
    hops=$((hops + 1))
    (( hops <= 40 )) || return 1
    parent="${actual%/*}"
    parent=$(cd -P -- "$parent" 2>/dev/null && pwd -P) || return 1
    target=$(_wc_tool /usr/bin/stat -f %Y "$actual") || return 1
    if [[ "$target" = /* ]]; then
      if [[ -e "$target" || -L "$target" ]]; then
        actual="$target"
      elif [[ -e "$_WC_PREFIX$target" || -L "$_WC_PREFIX$target" ]]; then
        actual="$_WC_PREFIX$target"
      else
        return 1
      fi
    else
      actual="$parent/$target"
    fi
  done
  parent="${actual%/*}"
  base="${actual##*/}"
  parent=$(cd -P -- "$parent" 2>/dev/null && pwd -P) || return 1
  printf '%s/%s\n' "$parent" "$base"
}

function _wct_sources() {
  local paths=(bin/k3dm-web-console-totp
    "$_WCT_GATE_SOURCE"
    "$_WCT_TOTPD_SOURCE"
    "$_WCT_TOTPCTL_SOURCE"
    "$_WCT_PLIST_TEMPLATE"
    scripts/lib/web_console_common.sh
    scripts/lib/system.sh
    scripts/lib/foundation/scripts/lib/system.sh
    scripts/lib/agent_rigor.sh)
  local file blob
  { _wc_tool /usr/bin/git ls-files --error-unmatch -- "${paths[@]}" >/dev/null 2>&1 &&
    _wc_tool /usr/bin/git diff --quiet HEAD -- "${paths[@]}"; } || {
      _wct_message 'sources differ from HEAD; commit or discard first'; return 9
    }
  for file in "${paths[@]}"; do
    blob=$(_wc_tool /usr/bin/git rev-parse "HEAD:$file") || return 9
    printf '%s %s\n' "$blob" "$file"
  done
}

function _wct_ancestors() {
  local dir
  for dir in /Library \
    /Library/Developer \
    /Library/Developer/CommandLineTools \
    /Library/Developer/CommandLineTools/Library \
    /Library/Developer/CommandLineTools/Library/Frameworks \
    /Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework \
    /Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions \
    /Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9 \
    /Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/Resources \
    /Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/Resources/Python.app \
    /Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/Resources/Python.app/Contents \
    /Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/Resources/Python.app/Contents/MacOS; do
    _wc_trust_check "$dir" || return 8
  done
}

function _wct_trust_install() {
  local path
  for path in / /private /private/etc /private/var /Library /Library/PrivilegedHelperTools "$_WC_LAUNCHD_DIR" /private/var/db /private/var/log; do
    _wc_trust_check "$path" || return 8
  done
  for path in "$_WC_HELPER_DIR" "$_WC_CONF_DIR" "$_WC_HELPER_DIR/.prev" "$_WC_CONF_DIR/.prev" "$_WCT_STATE_DIR" "$_WCT_RUN_DIR"; do
    if [[ -e "$_WC_PREFIX$path" || -L "$_WC_PREFIX$path" ]]; then
      _wc_trust_check "$path" || return 8
    fi
  done
  _wc_trust_chain "$_WCT_PY" || return 8
  _wc_trust_check "$_WCT_PYAPP" "$_WCT_PYDYLIB" || return 8
  _wct_ancestors || return 8
  _wc_dest_check "$_WC_JOURNAL" "$_WC_CONF_DIR/manifest" "$_WC_HELPER_DIR/forced-command.stub" "$_WCT_LOG" "$_WC_LAUNCHD_DIR/${_WCT_LABEL}.plist" "$_WC_HELPER_DIR/totpd" "$_WC_HELPER_DIR/totpctl" "$_WC_HELPER_DIR/forced-command" "$_WC_CONF_DIR/totp.conf" || return 8
}

function _wct_part_a_ready() {
  local manifest="$_WC_PREFIX$_WC_CONF_DIR/manifest" hash member part src extra
  local config=0 plist=0 stub=0 ca=0 hostkey=0 entry=0 rows=0
  [[ -r "$manifest" && -f "$_WC_PREFIX$_WC_HELPER_DIR/forced-command.stub" ]] || {
    _wct_message 'part A is not installed'; return 2
  }
  while read -r hash member part src extra; do
    [[ -n "$hash" && -n "$src" && -z "$extra" ]] || return 2
    [[ "$part" != A ]] || rows=$((rows+1))
    case "$part:$member" in
      "A:$_WC_CONF_DIR/sshd_config") config=$((config+1)) ;;
      "A:$_WC_LAUNCHD_DIR/${_WC_LABEL}.plist") plist=$((plist+1)) ;;
      "A:$_WC_HELPER_DIR/forced-command.stub") stub=$((stub+1)) ;;
      "A:$_WC_CONF_DIR/access_ca.pub") ca=$((ca+1)) ;;
      "A:$_WC_CONF_DIR/ssh_host_ed25519_key.pub") hostkey=$((hostkey+1)) ;;
      [AC]:"$_WC_HELPER_DIR/forced-command") entry=$((entry+1)) ;;
    esac
  done < "$manifest"
  (( rows )) || { _wct_message 'part A is not installed'; return 2; }
  [[ "$config:$plist:$stub:$ca:$hostkey:$entry" = 1:1:1:1:1:1 &&
     ! -e "$_WC_PREFIX$_WC_CONF_DIR/launchd.plist.pending" ]] || {
    _wct_message 'part A incomplete (CA missing or daemon not loaded); finish make install-web-console-sshd first'
    return 2
  }
  console_port=$(_wct_port_lookup) || { _wct_message 'sshd_config port missing'; return 2; }
}

function _wct_blob() {
  _wc_tool /usr/bin/git cat-file blob "HEAD:$1" && printf '.'
}

function _wct_digest() {
  _wc_hash_stdin < "$_WC_PREFIX$1"
}

function _wct_port_lookup() {
  local line pattern='^ListenAddress 127\.0\.0\.1:([0-9]+)$'
  if line=$(_wc_tool /usr/bin/head -n 1 "$_WC_PREFIX$_WC_CONF_DIR/sshd_config" 2>/dev/null) && [[ "$line" =~ $pattern ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  else
    return 2
  fi
}

function _wct_recover() {
  local rc=0
  _wc_txn_recover || rc=$?
  [[ "$rc" != 5 ]] || _WCT_KEEP_JOURNAL=1
  return "$rc"
}

function _wct_commit() {
  local rc
  _wc_commit "$@" && return 0
  rc=$?
  # The shared transaction removes its journal only after a full restore.
  [[ ! -e "$_WC_PREFIX$_WC_JOURNAL" ]] || _WCT_KEEP_JOURNAL=1
  return "$rc"
}

function _wct_exit_cleanup() {
  local code="$1"
  trap - EXIT
  _wc_revoke_reconcile || (( code != 0 )) || code=1
  if [[ "$_WCT_KEEP_JOURNAL" != 1 ]]; then
    _wc_txn_end || (( code != 0 )) || code=1
  fi
  _wc_stage_clean "$_WC_CONF_DIR" || (( code != 0 )) || code=1
  _wc_stage_clean "$_WC_HELPER_DIR" || (( code != 0 )) || code=1
  _wc_lock_release || (( code != 0 )) || code=7
  exit "$code"
}

function _wct_validate_stage() {
  local file
  for file in "$helper_stage/totpd" "$helper_stage/totpctl" "$helper_stage/forced-command"; do
    _wc_priv "$_WCT_PY" -IS -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' "$file" 2>/dev/null || return 4
  done
  local first_line
  first_line=$(_wc_priv /usr/bin/head -n 1 "$helper_stage/forced-command" 2>/dev/null) || return 4
  [[ "$first_line" = '#!/Library/Developer/CommandLineTools/usr/bin/python3 -IS' ]] || return 4
  _wc_priv /usr/bin/plutil -lint "$conf_stage/${_WCT_LABEL}.plist" >/dev/null 2>/dev/null || return 4
  local k v count=0 uid_ok=0 tmux_ok=0 idle_ok=0 port_ok=0
  local staged_config
  staged_config=$(_wc_priv /usr/bin/head -n 6 "$conf_stage/totp.conf" 2>/dev/null) || return 4
  while IFS='=' read -r k v; do
    [[ -n "$k" ]] || continue
    count=$((count+1))
    case "$k" in
      uid) [[ "$v" =~ ^[0-9]+$ ]] && uid_ok=1 ;;
      tmux) [[ "$v" = /* ]] && tmux_ok=1 ;;
      idle_seconds) [[ "$v" =~ ^[0-9]+$ ]] && (( v >= 5 && v <= 600 )) && idle_ok=1 ;;
      console_port) [[ "$v" =~ ^[0-9]+$ ]] && (( v >= 1024 && v <= 49151 )) && port_ok=1 ;;
      *) return 4 ;;
    esac
  done <<< "$staged_config"
  (( count == 4 && uid_ok && tmux_ok && idle_ok && port_ok )) || return 4
}

function _wct_check_custody() {
  local target="$_WC_HELPER_DIR/forced-command"
  local actual manifest_hash
  actual=$(_wct_digest "$target") || return 8
  manifest_hash=
  local h p pt s
  while read -r h p pt s _; do
    if [[ "$p" = "$target" && "$pt" = [AC] ]]; then manifest_hash="$h"; break; fi
  done < "$_WC_PREFIX$_WC_CONF_DIR/manifest"
  if [[ -n "$manifest_hash" && "$actual" = "$manifest_hash" ]]; then
    return 0
  fi
  _wct_message 'unrecognised forced-command'
  return 8
}

function _wct_compare_hashes() {
  local staged_file="$1" installed_path="$2"
  local staged_h inst_h
  [[ -f "$_WC_PREFIX$installed_path" ]] || return 1
  staged_h=$(_wc_stage_hash "$staged_file") || return 1
  inst_h=$(_wct_digest "$installed_path") || return 1
  [[ "$staged_h" = "$inst_h" ]]
}

function _wct_repeat_check() {
  _wct_compare_hashes "$helper_stage/totpd" "$_WC_HELPER_DIR/totpd" || return 1
  _wct_compare_hashes "$helper_stage/totpctl" "$_WC_HELPER_DIR/totpctl" || return 1
  _wct_compare_hashes "$helper_stage/forced-command" "$_WC_HELPER_DIR/forced-command" || return 1
  _wct_compare_hashes "$conf_stage/totp.conf" "$_WC_CONF_DIR/totp.conf" || return 1
  _wct_compare_hashes "$conf_stage/${_WCT_LABEL}.plist" "$_WC_LAUNCHD_DIR/${_WCT_LABEL}.plist" || return 1
  _wct_compare_hashes "$conf_stage/manifest" "$_WC_CONF_DIR/manifest" || return 1
  local wire_resp
  wire_resp=$(_wc_priv "$_WCT_PY" -IS "$_WC_PREFIX$_WC_HELPER_DIR/totpctl" status --wire 2>/dev/null) || return 1
  case "$wire_resp" in ENROLLED|NOT_ENROLLED) return 0 ;; UNAVAILABLE) _wct_damaged; return 5 ;; *) return 1 ;; esac
}

function _wct_damaged() {
  _wct_message 'verifier state damaged; run make uninstall-web-console-totp PURGE_SECRET=1, then install and enrol'
}

function _wct_wait_daemon() {
  local i wire_resp
  for ((i=0; i<10; i++)); do
    if wire_resp=$(_wc_priv "$_WCT_PY" -IS "$_WC_PREFIX$_WC_HELPER_DIR/totpctl" status --wire 2>/dev/null); then
      case "$wire_resp" in ENROLLED|NOT_ENROLLED) wire_status="$wire_resp"; return 0 ;; UNAVAILABLE) _wct_damaged; return 5 ;; esac
    fi
    _wc_tool /bin/sleep 1 || return 5
  done
  return 5
}

function _wct_install_generation() {
  local conf_stage helper_stage wire_status
  conf_stage=$(_wc_stage_new "$_WC_CONF_DIR") && helper_stage=$(_wc_stage_new "$_WC_HELPER_DIR") || return 8
  local gate_src totpd_src totpctl_src plist_src
  gate_src=$(_wct_blob "$_WCT_GATE_SOURCE") && totpd_src=$(_wct_blob "$_WCT_TOTPD_SOURCE") && totpctl_src=$(_wct_blob "$_WCT_TOTPCTL_SOURCE") && plist_src=$(_wct_blob "$_WCT_PLIST_TEMPLATE") || return 9
  printf '%s' "${gate_src%.}" | _wc_stage_put "$helper_stage" forced-command 0755 || return 8
  printf '%s' "${totpd_src%.}" | _wc_stage_put "$helper_stage" totpd 0755 || return 8
  printf '%s' "${totpctl_src%.}" | _wc_stage_put "$helper_stage" totpctl 0755 || return 8
  printf '%s' "${plist_src%.}" | _wc_stage_put "$conf_stage" "${_WCT_LABEL}.plist" 0644 || return 8
  local conf_body
  printf -v conf_body 'uid=%s\ntmux=%s\nidle_seconds=120\nconsole_port=%s\n' "$op_uid" "$tmux_path" "$console_port"
  printf '%s' "$conf_body" | _wc_stage_put "$conf_stage" totp.conf 0644 || return 8
  printf '' | _wc_stage_put "$conf_stage" manifest 0644 || return 8
  local h p pt s
  while read -r h p pt s _; do
    [[ "$pt" = A && "$p" != "$_WC_HELPER_DIR/forced-command" ]] || continue
    _wc_manifest_put "$conf_stage" A "$p" "$h" "$s" || return 8
  done < "$_WC_PREFIX$_WC_CONF_DIR/manifest"
  local gate_hash totpd_hash totpctl_hash plist_hash conf_hash
  gate_hash=$(_wc_stage_hash "$helper_stage/forced-command") && totpd_hash=$(_wc_stage_hash "$helper_stage/totpd") && totpctl_hash=$(_wc_stage_hash "$helper_stage/totpctl") && plist_hash=$(_wc_stage_hash "$conf_stage/${_WCT_LABEL}.plist") && conf_hash=$(_wc_stage_hash "$conf_stage/totp.conf") || return 8
  _wc_manifest_put "$conf_stage" C "$_WC_HELPER_DIR/totpd" "$totpd_hash" "$totpd_blob" || return 8
  _wc_manifest_put "$conf_stage" C "$_WC_HELPER_DIR/totpctl" "$totpctl_hash" "$totpctl_blob" || return 8
  _wc_manifest_put "$conf_stage" C "$_WC_HELPER_DIR/forced-command" "$gate_hash" "$gate_blob" || return 8
  _wc_manifest_put "$conf_stage" C "$_WC_LAUNCHD_DIR/${_WCT_LABEL}.plist" "$plist_hash" "$plist_blob" || return 8
  _wc_manifest_put "$conf_stage" C "$_WC_CONF_DIR/totp.conf" "$conf_hash" - || return 8
  _wct_validate_stage || { _wct_message 'validation failed; nothing moved'; return 4; }
  if _wct_repeat_check; then
    _wct_message 'already installed'
    return 0
  else
    [[ "$?" != 5 ]] || return 5
  fi
  _wct_commit "$helper_stage" "$_WC_HELPER_DIR/totpd" "$_WC_HELPER_DIR/totpctl" || return 5
  _wct_commit "$conf_stage" "$_WC_CONF_DIR/totp.conf" "$_WC_CONF_DIR/manifest" "$_WC_LAUNCHD_DIR/${_WCT_LABEL}.plist" || return 5
  local job="system/$_WCT_LABEL" plist="$_WC_PREFIX$_WC_LAUNCHD_DIR/${_WCT_LABEL}.plist"
  _wc_priv /bin/launchctl bootout "$job" 2>/dev/null || _wct_job_absent || {
    _wct_recover || return "$?"
    return 5
  }
  if _wc_priv /bin/launchctl bootstrap system "$plist" 2>/dev/null && _wct_wait_daemon; then
    _wct_commit "$helper_stage" "$_WC_HELPER_DIR/forced-command" && {
      [[ "$wire_status" = ENROLLED ]] || _wct_message 'not enrolled: logins stay refused'
      return 0
    }
  fi
  _wc_priv /bin/launchctl bootout "$job" 2>/dev/null || _wct_job_absent || _wct_message 'verifier job still registered'
  [[ "$_WCT_KEEP_JOURNAL" = 0 ]] || return 5
  _wct_recover || return "$?"
  if [[ -f "$plist" ]]; then
    _wc_priv /bin/launchctl bootstrap system "$plist" 2>/dev/null || {
      _wct_message 'previous verifier plist restored but bootstrap failed'; return 5
    }
  fi
  _wct_message 'load failed; previous generation restored'
  return 5

}

function _wct_install() {
  local dry=0 explicit_tmux='' tmux_path='' console_port='' op_uid=''
  local gate_blob totpd_blob totpctl_blob plist_blob
  while (( $# )); do
    case "$1" in
      --dry-run) dry=1 ;;
      --tmux) [[ -n "${2-}" ]] || return 2; explicit_tmux="$2"; shift ;;
      *) return 2 ;;
    esac
    shift
  done
  if [[ ! -x "$_WC_PREFIX$_WCT_PY" ]]; then _wct_message 'python interpreter missing'; return 2; fi
  if (( dry )) || [[ ! -f "$_WC_PREFIX$_WC_JOURNAL" ]]; then
    _wct_part_a_ready || return 2
  fi
  op_uid=$(_wc_tool /usr/bin/id -u) || return 2
  if [[ -n "$explicit_tmux" ]]; then
    if [[ "$explicit_tmux" != /* || ! -f "$_WC_PREFIX$explicit_tmux" || ! -x "$_WC_PREFIX$explicit_tmux" ]]; then
      _wct_message "tmux not found; give --tmux PATH"; return 2
    fi
    local resolved_tmux resolved_home resolved_checkout home_path="$_WC_PREFIX$HOME"
    resolved_tmux=$(_wct_realpath "$explicit_tmux") || { _wct_message 'tmux not found; give --tmux PATH'; return 2; }
    [[ -d "$home_path" ]] || home_path="$HOME"
    resolved_home=$(cd -P -- "$home_path" 2>/dev/null && pwd -P) || return 2
    resolved_checkout=$(cd -P -- "$PWD" 2>/dev/null && pwd -P) || return 2
    case "$resolved_tmux" in
      "$resolved_home"/*|"$resolved_checkout"/*|*/../*|*/..) _wct_message 'tmux path outside HOME and checkout required'; return 2 ;;
    esac
    tmux_path="$explicit_tmux"
  else
    tmux_path=$(_wct_find_tmux) || { _wct_message 'tmux not found; give --tmux PATH'; return 2; }
  fi
  printf 'web-console-totp: using %s\n' "$tmux_path"
  _wct_sources || return 9
  gate_blob=$(_wc_tool /usr/bin/git rev-parse "HEAD:$_WCT_GATE_SOURCE") && totpd_blob=$(_wc_tool /usr/bin/git rev-parse "HEAD:$_WCT_TOTPD_SOURCE") && totpctl_blob=$(_wc_tool /usr/bin/git rev-parse "HEAD:$_WCT_TOTPCTL_SOURCE") && plist_blob=$(_wc_tool /usr/bin/git rev-parse "HEAD:$_WCT_PLIST_TEMPLATE") || return 9
  if (( dry )); then
    printf 'root:wheel 0700 %s\n' "$_WCT_STATE_DIR"
    printf 'root:wheel 0755 %s\n' "$_WCT_RUN_DIR"
    printf 'root:wheel 0755 %s\n' "$_WC_HELPER_DIR/totpd" "$_WC_HELPER_DIR/totpctl" "$_WC_HELPER_DIR/forced-command"
    printf 'root:wheel 0644 %s\n' "$_WC_CONF_DIR/totp.conf" "$_WC_LAUNCHD_DIR/${_WCT_LABEL}.plist" "$_WC_CONF_DIR/manifest"
    printf 'root:wheel 0600 %s\n' "$_WCT_LOG"
    return 0
  fi
  _wc_priv_open || return 10
  _wct_trust_install || return 8
  _wc_lock_take || return 7
  _WCT_KEEP_JOURNAL=0
  trap '_wct_exit_cleanup "$?"' EXIT
  _wct_recover || return "$?"
  _wct_part_a_ready || return 2
  _wct_check_custody || return 8
  _wc_txn_begin || return 5
  _wc_stage_clean "$_WC_CONF_DIR" && _wc_stage_clean "$_WC_HELPER_DIR" || return 5
  if [[ ! -d "$_WC_PREFIX$_WCT_STATE_DIR" ]]; then
    _wc_txn_record created "$_WCT_STATE_DIR" || return 5
    _wc_priv /usr/bin/install -d -o root -g wheel -m 0700 "$_WC_PREFIX$_WCT_STATE_DIR" 2>/dev/null || return 8
    _wc_trust_check "$_WCT_STATE_DIR" || return 8
  fi
  if [[ ! -d "$_WC_PREFIX$_WCT_RUN_DIR" ]]; then
    _wc_txn_record created "$_WCT_RUN_DIR" || return 5
    _wc_priv /usr/bin/install -d -o root -g wheel -m 0755 "$_WC_PREFIX$_WCT_RUN_DIR" 2>/dev/null || return 8
    _wc_trust_check "$_WCT_RUN_DIR" || return 8
  fi
  if [[ ! -e "$_WC_PREFIX$_WCT_LOG" ]]; then
    _wc_priv /usr/bin/install -o root -g wheel -m 0600 "$_WC_PREFIX/dev/null" "$_WC_PREFIX$_WCT_LOG" 2>/dev/null || return 8
  fi
  _wct_install_generation
}

function _wct_purge_state() {
  if [[ -d "$_WC_PREFIX$_WCT_STATE_DIR" ]]; then
    _wc_priv /bin/rm -rf -- "$_WC_PREFIX$_WCT_STATE_DIR" 2>/dev/null || return 1
  fi
}

function _wct_uninstall() {
  local purge=0
  if (( $# )); then
    [[ $# = 1 && "$1" = --purge-secret ]] || return 2
    purge=1
  fi
  _wc_priv_open || return 10
  _wc_lock_take || return 7
  _WCT_KEEP_JOURNAL=0
  trap '_wct_exit_cleanup "$?"' EXIT
  _wct_recover || return "$?"
  local has_c=0 h p pt s
  if [[ -f "$_WC_PREFIX$_WC_CONF_DIR/manifest" ]]; then
    while read -r h p pt s _; do
      [[ "$pt" != C ]] || { has_c=1; break; }
    done < "$_WC_PREFIX$_WC_CONF_DIR/manifest"
  fi
  local paths=("$_WC_LAUNCHD_DIR/${_WCT_LABEL}.plist" "$_WC_HELPER_DIR/totpd"
               "$_WC_HELPER_DIR/totpctl" "$_WC_CONF_DIR/totp.conf" "$_WCT_RUN_DIR" "$_WCT_LOG")
  if (( has_c )); then
    _wct_restore_stub || return "$?"
  elif _wct_paths_absent && _wct_job_absent; then
    (( ! purge )) || _wct_purge_state || return 1
    _wct_message 'not installed'
    return 0
  elif [[ -e "$_WC_PREFIX$_WC_CONF_DIR/manifest" || -e "$_WC_PREFIX$_WC_HELPER_DIR" ]]; then
    local digest
    digest=$(_wct_digest "$_WC_HELPER_DIR/forced-command") || return 8
    _wct_stub_listed "$digest" || return 8
  fi
  _wct_remove
}

function _wct_paths_absent() {
  local path
  for path in "${paths[@]}"; do
    [[ ! -e "$_WC_PREFIX$path" && ! -L "$_WC_PREFIX$path" ]] || return 1
  done
}

function _wct_job_absent() {
  local _WC_LABEL="$_WCT_LABEL"
  _wc_job_absent
}

function _wct_stub_listed() {
  local h p pt
  while read -r h p pt _; do
    [[ "$p" = "$_WC_HELPER_DIR/forced-command.stub" && "$pt" = A && "$h" = "$1" ]] && return 0
  done < "$_WC_PREFIX$_WC_CONF_DIR/manifest"
  return 1
}

function _wct_restore_stub() {
  local h p pt s
  local stub_path="$_WC_HELPER_DIR/forced-command.stub" stub_h manifest_stub_h=''
  stub_h=$(_wct_digest "$stub_path") || return 8
  while read -r h p pt s _; do
    if [[ "$p" = "$stub_path" && "$pt" = A ]]; then manifest_stub_h="$h"; break; fi
  done < "$_WC_PREFIX$_WC_CONF_DIR/manifest"
  [[ "$stub_h" = "$manifest_stub_h" ]] || { _wct_message 'stub hash mismatch'; return 8; }
  _wc_txn_begin || return 5
  local stage
  stage=$(_wc_stage_new "$_WC_HELPER_DIR") || return 5
  _wc_priv /bin/cp -p "$_WC_PREFIX$stub_path" "$stage/forced-command" 2>/dev/null || return 5
  printf '' | _wc_stage_put "$stage" manifest 0644 || return 5
  local stub_blob=''
  while read -r h p pt s _; do
    if [[ "$pt" = A && "$p" != "$_WC_HELPER_DIR/forced-command" ]]; then
      _wc_manifest_put "$stage" A "$p" "$h" "$s" || return 5
    fi
    [[ "$p" != "$stub_path" ]] || stub_blob="$s"
  done < "$_WC_PREFIX$_WC_CONF_DIR/manifest"
  _wc_manifest_put "$stage" A "$_WC_HELPER_DIR/forced-command" "$stub_h" "$stub_blob" || return 5
  _wct_commit "$stage" "$_WC_HELPER_DIR/forced-command" "$_WC_CONF_DIR/manifest" || return 5
}

function _wct_remove() {
  local path flags rc=0
  _wc_priv /bin/launchctl bootout "system/${_WCT_LABEL}" 2>/dev/null || _wct_job_absent || rc=1
  for path in "${paths[@]}"; do
    flags=-f
    [[ "$path" != "$_WCT_RUN_DIR" ]] || flags=-rf
    _wc_priv /bin/rm "$flags" -- "$_WC_PREFIX$path" 2>/dev/null || { _wct_message "could not remove $path"; rc=1; }
  done
  (( ! purge )) || _wct_purge_state || rc=1
  _wct_paths_absent || rc=1
  _wct_job_absent || { _wct_message 'verifier job still registered'; rc=1; }
  return "$rc"
}

function _wct_enroll() {
  _wct_refusal_check || return 2
  _wc_priv_open || return 10
  _wc_priv "$_WCT_PY" -IS "$_WC_PREFIX$_WC_HELPER_DIR/totpctl" enroll
}

function _wct_rotate() {
  _wct_refusal_check || return 2
  _wc_priv_open || return 10
  _wc_priv "$_WCT_PY" -IS "$_WC_PREFIX$_WC_HELPER_DIR/totpctl" rotate
}

function _wct_status() {
  _wc_priv_open || return 10
  _wc_priv "$_WCT_PY" -IS "$_WC_PREFIX$_WC_HELPER_DIR/totpctl" status "$@"
}

function main() {
  _wct_main_env
  local repo="${BASH_SOURCE[0]%/*}/.."
  cd -- "$repo" || return 2
  # shellcheck disable=SC1091
  source scripts/lib/web_console_common.sh
  _wc_fixture_gate || return 2
  if [[ -z "$_WC_PREFIX" ]]; then
    # shellcheck disable=SC2034
    local SCRIPT_DIR=scripts
    # shellcheck source=/dev/null
    source scripts/lib/system.sh
  fi
  local verb="${1-}" args=()
  (( $# )) && shift
  while (( $# )); do
    args+=("$1")
    shift
  done
  case "$verb" in
    install) _wct_install "${args[@]}" ;;
    uninstall) _wct_uninstall "${args[@]}" ;;
    enroll) _wct_enroll "${args[@]}" ;;
    rotate) _wct_rotate "${args[@]}" ;;
    status) _wct_status "${args[@]}" ;;
    *) _wct_message 'usage: k3dm-web-console-totp install|uninstall|enroll|rotate|status'; return 2 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" = "$0" ]]; then main "$@"; fi
