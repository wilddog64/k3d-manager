def _provider_supports_pushgateway(provider):
    """The Pushgateway is installed on app-cluster observability stacks only."""
    return provider != "hub"


def _normalize_provider(provider):
    provider = (provider or "").strip().lower()
    return {
        "aws": "k3s-aws",
        "k3s-aws": "k3s-aws",
        "gcp": "k3s-gcp",
        "k3s-gcp": "k3s-gcp",
        "az": "k3s-az",
        "azure": "k3s-az",
        "k3s-az": "k3s-az",
        "oci": "k3s-oci",
        "k3s-oci": "k3s-oci",
        "hostinger": "k3s-hostinger",
        "hostiger": "k3s-hostinger",
        "k3s-hostiger": "k3s-hostinger",
        "k3s-hostinger": "k3s-hostinger",
    }.get(provider, provider)


def _resolve_provider(preferred=None):
    provider = _normalize_provider(preferred)
    if provider:
        return provider
    provider = _normalize_provider(os.environ.get("CLUSTER_PROVIDER") or os.environ.get("K3D_MANAGER_CLUSTER_PROVIDER"))
    if provider:
        return provider
    try:
        if _ACTIVE_PROVIDER_FILE.exists():
            provider = _normalize_provider(_ACTIVE_PROVIDER_FILE.read_text())
            if provider:
                return provider
    except OSError:
        pass
    return "k3s-aws"


def _provider_context(provider=None):
    provider = _resolve_provider(provider)
    return {
        "k3s-aws": "ubuntu-k3s",
        "k3s-az": "ubuntu-azure",
        "k3s-gcp": "ubuntu-gcp",
        "k3s-hostinger": "ubuntu-hostinger",
    }.get(provider, "ubuntu-k3s")


def _acg_stack_probe(provider):
    provider = _resolve_provider(provider)
    if provider != "k3s-aws":
        return None

    region = os.environ.get("ACG_REGION", "us-west-2")
    stack_name = os.environ.get("_ACG_CF_STACK_NAME", "k3d-manager-acg")
    healthy = {"CREATE_COMPLETE", "UPDATE_COMPLETE", "UPDATE_ROLLBACK_COMPLETE"}
    transitioning = {
        "CREATE_IN_PROGRESS",
        "UPDATE_IN_PROGRESS",
        "UPDATE_COMPLETE_CLEANUP_IN_PROGRESS",
        "UPDATE_ROLLBACK_IN_PROGRESS",
        "UPDATE_ROLLBACK_COMPLETE_CLEANUP_IN_PROGRESS",
        "REVIEW_IN_PROGRESS",
    }
    unhealthy = {
        "ROLLBACK_COMPLETE",
        "CREATE_FAILED",
        "ROLLBACK_FAILED",
        "UPDATE_ROLLBACK_FAILED",
        "DELETE_FAILED",
        "DELETE_IN_PROGRESS",
    }

    aws_out, aws_timeout = _posix_spawn_capture(
        ["aws", "sts", "get-caller-identity", "--region", region, "--query", "Arn", "--output", "text"],
        timeout=10,
    )
    arn = aws_out.strip()
    if aws_timeout or not arn or "arn:" not in arn.lower():
        return {
            "class": "credentials-unavailable",
            "arn": arn,
            "stack_status": "",
            "status_line": "*ACG sandbox:* AWS credentials unavailable — stack state unknown until `/cluster-refresh` restores credentials",
            "unreachable_line": f"\n❌ *{provider} cluster unreachable* — AWS credentials are unavailable, so sandbox state could not be confirmed.",
            "refresh_line": "\n⚠️ *Refresh completed* — credentials/access layer refreshed as far as possible, but AWS identity still looks unavailable",
        }

    stack_out, stack_timeout = _posix_spawn_capture(
        [
            "aws",
            "cloudformation",
            "describe-stacks",
            "--region",
            region,
            "--stack-name",
            stack_name,
            "--query",
            "Stacks[0].StackStatus",
            "--output",
            "text",
        ],
        timeout=15,
    )
    stack_status = stack_out.strip()
    if not stack_timeout and stack_status in healthy:
        return {
            "class": "present-healthy",
            "arn": arn,
            "stack_status": stack_status,
            "status_line": f"*ACG sandbox:* present and healthy ({stack_status})",
            "unreachable_line": f"\n❌ *{provider} cluster unreachable* — ACG stack is still present ({stack_status}), so the cluster is likely rebuilding or the access layer is down.",
            "refresh_line": "\n✅ *Refresh complete* — credentials and access layer refreshed; rerun `/cluster-status` if the cluster is still converging",
        }
    if not stack_timeout and stack_status in transitioning:
        return {
            "class": "present-transitioning",
            "arn": arn,
            "stack_status": stack_status,
            "status_line": f"*ACG sandbox:* present and changing state ({stack_status})",
            "unreachable_line": f"\n❌ *{provider} cluster unreachable* — ACG stack is currently transitioning ({stack_status}).",
            "refresh_line": "\n✅ *Refresh complete* — credentials refreshed; the ACG stack is still transitioning",
        }
    if not stack_timeout and stack_status in unhealthy:
        return {
            "class": "present-unhealthy",
            "arn": arn,
            "stack_status": stack_status,
            "status_line": f"*ACG sandbox:* present but unhealthy ({stack_status})",
            "unreachable_line": f"\n❌ *{provider} cluster unreachable* — ACG stack is present but unhealthy ({stack_status}). `/cluster-refresh` will not repair CloudFormation state.",
            "refresh_line": f"\n⚠️ *Refresh completed* — credentials/access layer refreshed, but the ACG stack is still unhealthy ({stack_status})",
        }

    missing_markers = ("does not exist", "ValidationError", "Stack with id")
    if stack_timeout or any(marker in stack_status for marker in missing_markers):
        return {
            "class": "absent",
            "arn": arn,
            "stack_status": stack_status,
            "status_line": "*ACG sandbox:* absent — sandbox likely expired or was torn down",
            "unreachable_line": f"\n❌ *{provider} cluster unreachable* — ACG sandbox appears absent/expired. `/cluster-refresh` will not recreate it; reprovision the cluster instead.",
            "refresh_line": "\n⚠️ *Refresh completed* — credentials refreshed, but the ACG sandbox is still absent and must be reprovisioned",
        }

    return {
        "class": "unknown",
        "arn": arn,
        "stack_status": stack_status,
        "status_line": f"*ACG sandbox:* state unknown ({stack_status or 'probe failed'})",
        "unreachable_line": f"\n❌ *{provider} cluster unreachable* — AWS is reachable, but sandbox state could not be classified ({stack_status or 'probe failed'}).",
        "refresh_line": "\n⚠️ *Refresh completed* — credentials/access layer refreshed, but ACG sandbox state is still unclear",
    }

