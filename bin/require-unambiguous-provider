#!/usr/bin/env bash
# bin/require-unambiguous-provider
#
# Guard for provider-ambiguous `make down` / `make status`: refuse when MULTIPLE
# providers are live and CLUSTER_PROVIDER was not set explicitly, so a bare
# `make down` cannot silently tear down the wrong cluster while another is up.
#
# Purely additive — a no-op unless ALL of these hold:
#   - CLUSTER_PROVIDER was NOT set on the command line / environment (arg1 != 1)
#   - two or more providers are live in the active-providers set
# For MAKE_TARGET=down, k3s-hostinger is not counted: a bare `make down` always
# targets the Makefile default (k3s-aws) and can never reach Hostinger, which is
# long-lived. `make status` keeps counting it, because a bare status resolves to
# Hostinger first.
# With 0 or 1 live providers, or an explicit CLUSTER_PROVIDER, it exits 0 and
# changes nothing.
#
# Usage: require-unambiguous-provider <explicit:0|1>
#   arg1 = 1 when CLUSTER_PROVIDER was set on the command line / environment.
#
# Exit codes:
#   0  unambiguous (proceed)
#   3  ambiguous — multiple providers live, no explicit CLUSTER_PROVIDER

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# shellcheck source=/dev/null
source "${REPO_ROOT}/scripts/lib/system.sh"
# shellcheck source=/dev/null
source "${REPO_ROOT}/scripts/lib/provider.sh"

_explicit="${1:-0}"
[[ "${_explicit}" == "1" ]] && exit 0

_live=()
mapfile -t _live < <(_acg_list_active_providers 2>/dev/null || true)

if [[ "${MAKE_TARGET:-}" == "down" ]]; then
  _counted=()
  for _p in "${_live[@]}"; do
    [[ "${_p}" == "k3s-hostinger" ]] && continue
    _counted+=("${_p}")
  done
  _live=("${_counted[@]+"${_counted[@]}"}")
fi

if [[ "${#_live[@]}" -gt 1 ]]; then
  {
    echo "Refusing: ${#_live[@]} providers are live and CLUSTER_PROVIDER was not set."
    echo "Live providers:"
    printf '  - %s\n' "${_live[@]}"
    echo "Re-run with an explicit provider, e.g.:"
    echo "  make ${MAKE_TARGET:-down} CLUSTER_PROVIDER=${_live[0]}"
  } >&2
  exit 3
fi

exit 0
