#!/usr/bin/env python3
# shellcheck disable=SC1071
"""Parse offline test output and publish bounded metrics to Pushgateway."""

import argparse
import os
import re
import sys
import time
import urllib.request
from collections import defaultdict
from pathlib import Path


PUSH_RETRIES = 3
PUSH_SLEEP_SECONDS = 1
DEFAULT_PUSHGATEWAY_URL = "http://localhost:9091"
MAX_FAILURES = 100
MAX_LABEL_LENGTH = 120


def _suite_name(value):
    return Path(value.strip()).name


def _metric_label(value):
    """Escape and bound a value used in a Prometheus label."""
    value = re.sub(r"\s+", " ", str(value or "")).strip()
    value = value[:MAX_LABEL_LENGTH]
    return value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")


def run_classification(exit_code):
    """Classify the terminal run without claiming that a failure is a defect."""
    return "passed" if exit_code == 0 else "failed_untriaged"


def parse_log(text):
    """Return suite counts, totals, failures, durations, and last step."""
    suites = defaultdict(lambda: {"ok": 0, "not_ok": 0})
    durations = {}
    current_suite = None
    current_python = None
    last_step = "unknown"
    unittest_pending = None
    failures = []
    total = 0
    failed = 0

    for line in text.splitlines():
        step_match = re.search(r"\[make\]\s+(test(?:-all|-bin|-python(?:-unit|-pytest)?)?)\b", line)
        if step_match:
            last_step = step_match.group(1)
        if "scripts/k3d-manager test all" in line:
            last_step = "test"

        marker = re.search(r"^\s*#\s+(?:file:\s*)?([^\s#]+\.bats)\b", line)
        make_marker = re.search(r"\[make\]\s+bats\s+([^\s]+\.bats)\b", line)
        if marker or make_marker:
            current_suite = _suite_name((marker or make_marker).group(1))
            current_python = None
            suites.setdefault(current_suite, {"ok": 0, "not_ok": 0})

        python_marker = re.search(r"(?:python3|pytest)\s+([^\s]+\.py)\b", line)
        if python_marker:
            current_python = _suite_name(python_marker.group(1))
            current_suite = current_python
            suites.setdefault(current_suite, {"ok": 0, "not_ok": 0})
        if re.search(r"\bpytest(?:\s|$).*scripts/tests", line):
            last_step = "test-pytest"

        tap = re.match(r"^\s*(not )?ok\s+(\d+)\b\s*(.*)$", line)
        if tap:
            if current_suite is None:
                current_suite = "bats"
                suites.setdefault(current_suite, {"ok": 0, "not_ok": 0})
            result = "not_ok" if tap.group(1) else "ok"
            suites[current_suite][result] += 1
            total += 1
            failed += result == "not_ok"
            if result == "not_ok" and len(failures) < MAX_FAILURES:
                failures.append({
                    "suite": current_suite,
                    "case": tap.group(2),
                    "name": tap.group(3).strip() or "unnamed test",
                    "reason": "",
                })
            continue

        if failures and not failures[-1]["reason"] and line.lstrip().startswith("#"):
            detail = line.lstrip()[1:].strip()
            if detail and not detail.startswith("(in test file"):
                failures[-1]["reason"] = detail

        duration = re.search(r"#\s+(?:duration|time)\s*[:=]\s*([0-9.]+)\s*s?\b", line, re.I)
        if duration and current_suite:
            durations[current_suite] = float(duration.group(1))

        ran = re.search(r"Ran\s+(\d+)\s+tests?\s+in\s+([0-9.]+)s", line)
        if ran:
            unittest_pending = (int(ran.group(1)), float(ran.group(2)), current_python or "unittest")
            continue
        if unittest_pending and re.search(r"\bOK\b", line):
            count, duration_value, suite = unittest_pending
            suites[suite]["ok"] += count
            total += count
            durations[suite] = duration_value
            last_step = "test-python-unit"
            unittest_pending = None
            continue
        if unittest_pending and "FAILED" in line:
            count, duration_value, suite = unittest_pending
            failure_match = re.search(r"failures=(\d+)", line)
            error_match = re.search(r"errors=(\d+)", line)
            bad = int(failure_match.group(1)) if failure_match else 0
            bad += int(error_match.group(1)) if error_match else 0
            suites[suite]["ok"] += max(count - bad, 0)
            suites[suite]["not_ok"] += bad
            total += count
            failed += bad
            durations[suite] = duration_value
            last_step = "test-python-unit"
            unittest_pending = None
            continue

        pytest_passed = re.search(r"(\d+)\s+passed\b", line)
        pytest_failed = re.search(r"(\d+)\s+failed\b", line)
        if pytest_passed or pytest_failed:
            passed = int(pytest_passed.group(1)) if pytest_passed else 0
            bad = int(pytest_failed.group(1)) if pytest_failed else 0
            suites["pytest"]["ok"] += passed
            suites["pytest"]["not_ok"] += bad
            total += passed + bad
            failed += bad
            pytest_time = re.search(r"\bin\s+([0-9.]+)s\b", line)
            if pytest_time:
                durations["pytest"] = float(pytest_time.group(1))
            last_step = "test-pytest"

    return {
        "suites": dict(suites),
        "durations": durations,
        "total": total,
        "failed": failed,
        "failures": failures,
        "last_step": last_step,
    }


def build_payload(parsed, target, exit_code, now=None, run_duration=None):
    now = int(time.time()) if now is None else now
    lines = [
        "# HELP k3dm_test_suite_cases Test cases by suite and result",
        "# TYPE k3dm_test_suite_cases gauge",
    ]
    for suite in sorted(parsed["suites"]):
        values = parsed["suites"][suite]
        for result in ("ok", "not_ok"):
            lines.append(f'k3dm_test_suite_cases{{suite="{suite}",result="{result}"}} {values[result]}')
    if parsed.get("failures"):
        lines += [
            "# HELP k3dm_test_failure One bounded failed test case with its first diagnostic reason",
            "# TYPE k3dm_test_failure gauge",
        ]
        for failure in parsed["failures"]:
            labels = {
                "target": target,
                "suite": failure["suite"],
                "case": failure["case"],
                "name": failure["name"],
                "reason": failure["reason"] or "diagnostic unavailable",
            }
            rendered = ",".join(f'{key}="{_metric_label(value)}"' for key, value in labels.items())
            lines.append(f"k3dm_test_failure{{{rendered}}} 1")
    lines += [
        "# HELP k3dm_test_suite_duration_seconds Wall-clock duration of one suite",
        "# TYPE k3dm_test_suite_duration_seconds gauge",
    ]
    for suite in sorted(parsed["durations"]):
        lines.append(f'k3dm_test_suite_duration_seconds{{suite="{suite}"}} {parsed["durations"][suite]}')
    lines += [
        "# HELP k3dm_test_cases_total Total cases in the run",
        "# TYPE k3dm_test_cases_total gauge",
        f'k3dm_test_cases_total{{target="{target}"}} {parsed["total"]}',
        "# HELP k3dm_test_cases_failed Failed cases in the run — THE health signal",
        "# TYPE k3dm_test_cases_failed gauge",
        f'k3dm_test_cases_failed{{target="{target}"}} {parsed["failed"]}',
        "# HELP k3dm_test_last_timestamp_seconds Unix timestamp of the last completed run",
        "# TYPE k3dm_test_last_timestamp_seconds gauge",
        f"k3dm_test_last_timestamp_seconds {now}",
    ]
    if run_duration is not None:
        lines += [
            "# HELP k3dm_test_run_duration_seconds Wall-clock duration of the whole run",
            "# TYPE k3dm_test_run_duration_seconds gauge",
            f'k3dm_test_run_duration_seconds{{target="{target}"}} {run_duration}',
        ]
    if parsed["failed"] == 0 and exit_code == 0:
        lines += [
            "# HELP k3dm_test_last_success_timestamp_seconds Unix timestamp of the last run with zero failures and exit code 0",
            "# TYPE k3dm_test_last_success_timestamp_seconds gauge",
            f"k3dm_test_last_success_timestamp_seconds {now}",
        ]
    lines += [
        "# HELP k3dm_test_run_classification Current terminal test-run classification",
        "# TYPE k3dm_test_run_classification gauge",
        (
            f'k3dm_test_run_classification{{target="{_metric_label(target)}",'
            f'classification="{run_classification(exit_code)}"}} 1'
        ),
        "# HELP k3dm_test_exit_code Make exit code — INFORMATIONAL ONLY, see the staleness note",
        "# TYPE k3dm_test_exit_code gauge",
        f'k3dm_test_exit_code{{target="{_metric_label(target)}"}} {exit_code}',
        "# HELP k3dm_test_last_step_reached Last make sub-target that ran (1 per step name)",
        "# TYPE k3dm_test_last_step_reached gauge",
        f'k3dm_test_last_step_reached{{target="{target}",step="{parsed["last_step"]}"}} 1',
    ]
    return "\n".join(lines) + "\n"


def push_metrics(payload, target, origin, endpoint=None, opener=None):
    endpoint = (endpoint or os.environ.get("K3DM_PUSHGATEWAY_URL", DEFAULT_PUSHGATEWAY_URL)).rstrip("/")
    url = f"{endpoint}/metrics/job/k3dm-tests/instance/{target}-{origin}"
    opener = opener or urllib.request.urlopen
    for attempt in range(1, PUSH_RETRIES + 1):
        try:
            with opener(f"{endpoint}/-/healthy", timeout=2) as response:
                if response.status != 200:
                    raise RuntimeError(f"Pushgateway unhealthy (HTTP {response.status})")
            request = urllib.request.Request(
                url, data=payload.encode(), method="PUT",
                headers={"Content-Type": "text/plain; charset=utf-8"},
            )
            with opener(request, timeout=5):
                pass
            print(f"[k3dm-test-metrics] metrics pushed: {target}/{origin}")
            return url
        except Exception as exc:
            if attempt < PUSH_RETRIES:
                print(f"[k3dm-test-metrics] push attempt {attempt}/{PUSH_RETRIES} failed: {exc} — retrying")
                time.sleep(PUSH_SLEEP_SECONDS)
            else:
                print(f"[k3dm-test-metrics] metrics push skipped (non-fatal): {exc}")
    return url


def main(argv=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("log_path")
    parser.add_argument("--target", choices=("test", "test-all"), required=True)
    parser.add_argument("--origin", choices=("local", "ci"), default="local")
    parser.add_argument("--exit-code", type=int, default=0)
    parser.add_argument("--run-duration", type=int, default=None)
    args = parser.parse_args(argv)
    parsed = parse_log(Path(args.log_path).read_text())
    print(f"[k3dm-test-metrics] {parsed['total']} cases, {parsed['failed']} failed")
    push_metrics(
        build_payload(parsed, args.target, args.exit_code, run_duration=args.run_duration),
        args.target, args.origin,
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
