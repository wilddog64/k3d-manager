#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/.." && pwd)"
services_dir="${repo_root}/services"
netrc_file=""
headers_file=""
unknown=0
drift=0

cleanup() {
  [[ -z "${netrc_file}" ]] || rm -f "${netrc_file}"
  [[ -z "${headers_file}" ]] || rm -f "${headers_file}"
}
trap cleanup EXIT

while [[ $# -gt 0 ]]; do
  case "$1" in
    --services-dir)
      [[ $# -ge 2 ]] || { printf '%s\n' 'ERROR: --services-dir requires a value' >&2; exit 2; }
      services_dir="$2"
      shift 2
      ;;
    *)
      printf 'ERROR: unknown option: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

gh_token="$(gh auth token 2>/dev/null || true)"
if [[ -z "${gh_token}" ]]; then
  printf '%s\n' 'ERROR: no gh token; run: gh auth refresh -h github.com -s read:packages' >&2
  exit 2
fi

netrc_file="$(mktemp "${TMPDIR:-/tmp}/k3dm-image-pin-drift.XXXXXX")"
chmod 600 "${netrc_file}"
printf 'machine ghcr.io login wilddog64 password %s\n' "${gh_token}" > "${netrc_file}"

latest_digest() {
  local image_path token_url manifest_url registry_token digest
  image_path="$1"
  token_url="https://ghcr.io/token?service=ghcr.io&scope=repository:${image_path}:pull"
  manifest_url="https://ghcr.io/v2/${image_path}/manifests/latest"

  registry_token="$(curl -s --netrc-file "${netrc_file}" "${token_url}" | jq -r '.token // empty')"
  [[ -n "${registry_token}" ]] || return 0

  headers_file="$(mktemp "${TMPDIR:-/tmp}/k3dm-image-pin-drift.XXXXXX")"
  chmod 600 "${headers_file}"
  printf 'Authorization: Bearer %s\n' "${registry_token}" > "${headers_file}"
  digest="$(curl -sI -H "@${headers_file}" \
    -H 'Accept: application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json' \
    "${manifest_url}" | sed -n 's/^[[:space:]]*[Dd]ocker-[Cc]ontent-[Dd]igest:[[:space:]]*\(sha256:[0-9a-f]*\)\r\{0,1\}$/\1/p' | head -n 1)"
  rm -f "${headers_file}"
  headers_file=""
  printf '%s' "${digest}"
}

while IFS= read -r kustomization; do
  service="$(basename "$(dirname "${kustomization}")")"
  image_data="$(awk '
    /^images:[[:space:]]*$/ { in_images=1; next }
    in_images && /^  - name:[[:space:]]*/ && !seen_name {
      name=$0; sub(/^  - name:[[:space:]]*/, "", name); seen_name=1; next
    }
    in_images && seen_name && /^    digest:[[:space:]]*/ {
      digest=$0; sub(/^    digest:[[:space:]]*/, "", digest); print name "\t" digest; exit
    }
  ' "${kustomization}")"

  if [[ -z "${image_data}" ]]; then
    printf '%s unpinned\n' "${service}"
    continue
  fi

  image_name="${image_data%%$'\t'*}"
  pinned_digest="${image_data#*$'\t'}"
  if [[ "${image_name}" != ghcr.io/* ]]; then
    printf '%s unknown (not ghcr.io)\n' "${service}"
    unknown=1
    continue
  fi

  latest="$(latest_digest "${image_name#ghcr.io/}")"
  if [[ -z "${latest}" ]]; then
    printf '%s unknown (could not resolve latest)\n' "${service}"
    unknown=1
    continue
  fi

  pinned_short="${pinned_digest#sha256:}"
  pinned_short="${pinned_short:0:12}"
  latest_short="${latest#sha256:}"
  latest_short="${latest_short:0:12}"
  if [[ "${pinned_digest}" == "${latest}" ]]; then
    printf '%s current pinned=%s latest=%s\n' "${service}" "${pinned_short}" "${latest_short}"
  else
    printf '%s DRIFT pinned=%s latest=%s\n' "${service}" "${pinned_short}" "${latest_short}"
    drift=1
  fi
done < <(find "${services_dir}" -mindepth 2 -maxdepth 2 -type f -name kustomization.yaml -print | sort)

if [[ "${drift}" -eq 1 ]]; then
  exit 1
fi
if [[ "${unknown}" -eq 1 ]]; then
  exit 2
fi
exit 0
