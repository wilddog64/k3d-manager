#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if (( $# != 0 )); then
  echo "Usage: bin/k3dm-hub-sync" >&2
  exit 2
fi

bin/k3dm-require-role hub || exit 1

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Refusing hub-sync: working tree is not clean." >&2
  exit 1
fi

old_head="$(git rev-parse HEAD)"
old_branch="$(git branch --show-current)"
target="${BRANCH:-$old_branch}"
if [[ ! "$target" =~ ^k3d-manager-v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Refusing hub-sync: target must be a release branch (got '$target')." >&2
  exit 2
fi

job_dir="${K3DM_JOB_DIR:-$HOME/.local/share/k3d-manager/webhook-jobs}"
cutoff="$(($(date +%s) - 10800))"
if [[ -d "$job_dir" ]]; then
  while IFS= read -r -d '' status_file; do
    state="$(cat "$status_file" 2>/dev/null || true)"
    modified="$(stat -c %Y "$status_file" 2>/dev/null || stat -f %m "$status_file" 2>/dev/null || echo 0)"
    if [[ ( "$state" == queued || "$state" == running ) && "$modified" =~ ^[0-9]+$ && "$modified" -ge "$cutoff" ]]; then
      job_id="$(basename "$(dirname "$status_file")")"
      echo "Refusing hub-sync: active webhook job $job_id." >&2
      exit 1
    fi
  done < <(find "$job_dir" -mindepth 2 -maxdepth 2 -type f -name status -print0)
fi

if ! git fetch origin "+refs/heads/$target:refs/remotes/origin/$target"; then
  echo "hub-sync step failed: git fetch origin $target" >&2
  exit 1
fi
switched_branch=0
if [[ "$old_branch" != "$target" ]]; then
  if ! git switch "$target" 2>/dev/null; then
    if ! git switch --track -c "$target" "origin/$target"; then
      echo "hub-sync step failed: switch to $target" >&2
      exit 1
    fi
  fi
  switched_branch=1
fi
if ! git merge --ff-only "origin/$target"; then
  if (( switched_branch )) && ! git switch "$old_branch"; then
    echo "hub-sync could not restore original branch $old_branch after refusing the non-fast-forward." >&2
  fi
  echo "Refusing hub-sync: $target is not a fast-forward." >&2
  exit 1
fi

new_head="$(git rev-parse HEAD)"
pulled=0
changed=()
if [[ "$old_head" != "$new_head" ]]; then
  pulled="$(git rev-list --count "$old_head..$new_head")"
  mapfile -t changed < <(git diff --name-only "$old_head" "$new_head")
fi

ran_restart=skipped
ran_platform=skipped
machine_setup=skipped
newer_release=skipped
appsets=skipped
appsets_reapply=skipped
step_failure=0
if (( pulled > 0 )); then
  code_change=0
  platform_change=0
  machine_change=0
  for path in "${changed[@]}"; do
    [[ "$path" == docs/* || "$path" == memory-bank/* || "$path" == CHANGELOG.md ]] || code_change=1
    [[ "$path" == scripts/etc/argocd/platform-ops/* ]] && platform_change=1
    [[ "$path" == scripts/etc/launchd/* || "$path" == bin/k3dm-machine-setup ]] && machine_change=1
  done
  if (( code_change )); then
    if make restart-webhook; then
      if launchctl kickstart -k "gui/$(id -u)/com.k3d-manager.hermes"; then
        ran_restart=ran
      else
        echo "hub-sync step failed: launchctl kickstart Hermes" >&2
        ran_restart=failed
        step_failure=1
      fi
    else
      echo "hub-sync step failed: make restart-webhook" >&2
      ran_restart=failed
      step_failure=1
    fi
  else
    ran_restart="skipped (docs-only range)"
  fi
  if (( platform_change )); then
    if make platform-ops; then ran_platform=ran; else echo "hub-sync step failed: make platform-ops" >&2; ran_platform=failed; step_failure=1; fi
  else
    ran_platform="skipped (no platform-ops files changed)"
  fi
  if (( machine_change )); then
    machine_setup="needed: make machine-setup ROLE=hub"
  else
    machine_setup="skipped (no launchd or machine-setup files changed)"
  fi
fi

_release_version_gt() {
  local left="$1" right="$2" index a b
  local -a left_parts right_parts
  IFS=. read -r -a left_parts <<< "${left#k3d-manager-v}"
  IFS=. read -r -a right_parts <<< "${right#k3d-manager-v}"
  for index in 0 1 2; do
    a="${left_parts[$index]}"
    b="${right_parts[$index]}"
    while [[ "$a" == 0* && ${#a} -gt 1 ]]; do a="${a#0}"; done
    while [[ "$b" == 0* && ${#b} -gt 1 ]]; do b="${b#0}"; done
    (( ${#a} > ${#b} )) && return 0
    (( ${#a} < ${#b} )) && return 1
    [[ "$a" > "$b" ]] && return 0
    [[ "$a" < "$b" ]] && return 1
  done
  return 1
}
newest=""
if remote_heads="$(git ls-remote --heads origin 'k3d-manager-v*' 2>/dev/null)"; then
  while IFS= read -r remote_branch; do
    [[ "$remote_branch" =~ ^k3d-manager-v[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
    if [[ -z "$newest" ]] || _release_version_gt "$remote_branch" "$newest"; then
      newest="$remote_branch"
    fi
  done < <(awk '{sub("refs/heads/", "", $2); print $2}' <<< "$remote_heads")
fi
if [[ -n "$newest" ]] && _release_version_gt "$newest" "$target"; then
  newer_release="needed: make hub-sync BRANCH=$newest"
fi
if make appsets-check; then
  appsets=ran
else
  appsets="ran (failed; non-fatal)"
  appsets_reapply="needed: make appsets-reapply"
fi
if [[ "$old_head" == "$new_head" ]]; then
  ran_restart="skipped (no commits pulled)"
  ran_platform="skipped (no commits pulled)"
  machine_setup="skipped (no commits pulled)"
fi

printf 'hub-sync summary\nrepository: %s\nold SHA: %s\nnew SHA: %s\ncommits pulled: %s\nrestart-webhook and Hermes: %s\nplatform-ops: %s\nmachine-setup: %s\nnewer release: %s\nappsets-check: %s\nappsets-reapply: %s\nprevious HEAD %s\n' \
  "$ROOT" "${old_head:0:12}" "${new_head:0:12}" "$pulled" "$ran_restart" "$ran_platform" \
  "$machine_setup" "$newer_release" "$appsets" "$appsets_reapply" "$old_head"
exit "$step_failure"
