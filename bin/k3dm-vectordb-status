#!/usr/bin/env python3
"""Emit vectordb health facts as JSON. Read-only; never raises; always exits 0."""

import argparse
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "scripts" / "lib"))

from hermes.prior_art import (  # noqa: E402
    KUBE_CONTEXT, NAMESPACE, TABLE, RetrievalUnavailable, iter_corpus, run_sql,
)

EXTERNAL_SECRET = "vectordb-postgres"
POD = "vectordb-0"


def kubectl_json_argv(kind, name, context=None, namespace=None):
    """Pure function so a test can assert the real argv without a cluster."""
    return ["kubectl", "--context", context or KUBE_CONTEXT,
            "-n", namespace or NAMESPACE, "get", kind, name, "-o", "json"]


def _condition_status(payload, condition_type):
    conditions = payload.get("status", {}).get("conditions")
    if not isinstance(conditions, list):
        return None
    matching = [item for item in conditions
                if isinstance(item, dict) and item.get("type") == condition_type]
    if not matching:
        return False
    return matching[-1].get("status") == "True"


def _kubectl_json(kind, name):
    result = subprocess.run(kubectl_json_argv(kind, name), capture_output=True,
                            text=True, timeout=30, check=False)
    if result.returncode != 0:
        return None
    try:
        return json.loads(result.stdout)
    except (TypeError, ValueError, json.JSONDecodeError):
        return None


def _cluster_facts():
    external_secret = _kubectl_json("externalsecret", EXTERNAL_SECRET)
    pod = _kubectl_json("pod", POD)
    return (_condition_status(external_secret, "Ready") if external_secret is not None else None,
            _condition_status(pod, "Ready") if pod is not None else None)


def _store_facts():
    try:
        raw = run_sql(f"SELECT count(*), extract(epoch from max(indexed_at)) FROM {TABLE};").strip()
        rows, last_indexed = raw.split("|", 1) if "|" in raw else raw.split()
        return True, int(rows), float(last_indexed) if last_indexed and last_indexed != "" else None
    except (RetrievalUnavailable, OSError, TypeError, ValueError):
        return False, None, None


def _corpus_docs():
    try:
        return len(iter_corpus(ROOT))
    except (RetrievalUnavailable, OSError, subprocess.SubprocessError):
        return 0


def status(offline=False):
    corpus_docs = _corpus_docs()
    if offline:
        external_secret_synced, pod_ready = None, None
        available, rows, last_indexed_epoch = False, None, None
    else:
        external_secret_synced, pod_ready = _cluster_facts()
        available, rows, last_indexed_epoch = _store_facts()
    return {
        "available": available,
        "external_secret_synced": external_secret_synced,
        "pod_ready": pod_ready,
        "rows": rows,
        "corpus_docs": corpus_docs,
        "last_indexed_epoch": last_indexed_epoch,
    }


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--json", action="store_true", help="emit JSON (the default)")
    parser.add_argument("--offline", action="store_true", help="skip cluster and store calls")
    args = parser.parse_args(argv)
    try:
        print(json.dumps(status(offline=args.offline), sort_keys=True))
    except Exception:
        print(json.dumps({"available": False, "external_secret_synced": None,
                          "pod_ready": None, "rows": None, "corpus_docs": 0,
                          "last_indexed_epoch": None}, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
