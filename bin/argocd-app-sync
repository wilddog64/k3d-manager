#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
# shellcheck disable=SC1091
source "${REPO_ROOT}/scripts/lib/system.sh"

usage() {
  echo "Usage: bin/argocd-app-sync <app> [--force] [--timeout SECONDS]" >&2
}

_app=""
_force=0
_timeout=120
while [[ $# -gt 0 ]]; do
  case "$1" in
    --force) _force=1; shift ;;
    --timeout)
      [[ $# -ge 2 ]] || { usage; exit 1; }
      _timeout="$2"
      shift 2
      ;;
    -h|--help) usage; exit 0 ;;
    -*) usage; exit 1 ;;
    *)
      [[ -z "${_app}" ]] || { usage; exit 1; }
      _app="$1"
      shift
      ;;
  esac
done
[[ -n "${_app}" ]] || { usage; exit 1; }

: "${ARGOCD_SERVER:=localhost:8080}"
: "${ARGOCD_SCHEME:=http}"
: "${INFRA_CONTEXT:=k3d-k3d-cluster}"
: "${ARGOCD_NS:=cicd}"

_pf_pid=""
_keep_log=0
_pf_log="$(mktemp "${TMPDIR:-/tmp}/argocd-app-sync.XXXXXX.log")"
_vault_hdr="$(mktemp "${TMPDIR:-/tmp}/argocd-app-sync.XXXXXX.hdr")"
chmod 600 "${_vault_hdr}"

_cleanup() {
  if [[ -n "${_pf_pid}" ]]; then
    kill "${_pf_pid}" 2>/dev/null || true
    wait "${_pf_pid}" 2>/dev/null || true
  fi
  if [[ ${_keep_log} -eq 0 ]]; then
    rm -f "${_pf_log}"
  else
    echo "ArgoCD port-forward log: ${_pf_log}" >&2
  fi
  rm -f "${_vault_hdr}"
}
trap _cleanup EXIT

_healthz() {
  curl -sf --max-time 1 "${ARGOCD_SCHEME}://${ARGOCD_SERVER}/healthz" >/dev/null
}

if [[ "${ARGOCD_SERVER}" == "localhost:8080" ]] && ! _healthz; then
  kubectl --context "${INFRA_CONTEXT}" -n "${ARGOCD_NS}" port-forward \
    svc/argocd-server 8080:443 >"${_pf_log}" 2>&1 &
  _pf_pid=$!
  for _attempt in $(seq 1 30); do
    _healthz && break
    sleep 1
  done
  if ! _healthz; then
    _keep_log=1
    echo "ArgoCD did not become reachable at ${ARGOCD_SERVER}" >&2
    exit 1
  fi
fi

_session_valid=0
_probe_output=""
if _probe_output="$(argocd account get-user-info --server "${ARGOCD_SERVER}" \
    --grpc-web --plaintext --insecure -o json 2>/dev/null)" && \
    python3 -c 'import json,sys; raise SystemExit(0 if json.load(sys.stdin).get("loggedIn") is True else 1)' \
    <<<"${_probe_output}"; then
  _session_valid=1
fi

if [[ ${_session_valid} -eq 0 ]]; then
  _pw="${ARGOCD_ADMIN_PASSWORD:-}"
  if [[ -z "${_pw}" ]]; then
    _vault_token="$(_kubectl --no-exit --context "${INFRA_CONTEXT}" -n secrets get secret vault-root \
      -o jsonpath='{.data.root_token}' 2>/dev/null | base64 --decode 2>/dev/null || true)"
    if [[ -n "${_vault_token}" ]]; then
      printf 'X-Vault-Token: %s\n' "${_vault_token}" >"${_vault_hdr}"
      _pw="$(curl -sf -H "@${_vault_hdr}" "http://127.0.0.1:18200/v1/secret/data/argocd/admin" 2>/dev/null | \
        python3 -c 'import json,sys; print(json.load(sys.stdin)["data"]["data"].get("password", ""))' 2>/dev/null || true)"
    fi
  fi
  if [[ -z "${_pw}" ]]; then
    _pw="$(_kubectl --no-exit --context "${INFRA_CONTEXT}" -n "${ARGOCD_NS}" get secret \
      argocd-initial-admin-secret -o jsonpath='{.data.password}' 2>/dev/null | base64 --decode 2>/dev/null || true)"
  fi
  if [[ -z "${_pw}" ]]; then
    _keep_log=1
    echo "Could not resolve ArgoCD admin password from ARGOCD_ADMIN_PASSWORD, Vault, or ${INFRA_CONTEXT}/${ARGOCD_NS}" >&2
    exit 1
  fi
  _session_token="$(printf '%s\n' "${_pw}" | \
    python3 -c 'import json,sys; print(json.dumps({"username":"admin","password":sys.stdin.read().rstrip("\n")}))' | \
    curl -sf --max-time 30 -H 'Content-Type: application/json' --data-binary @- \
    "${ARGOCD_SCHEME}://${ARGOCD_SERVER}/api/v1/session" | \
    python3 -c 'import json,sys; print(json.load(sys.stdin)["token"])')" || {
      _keep_log=1
      echo "ArgoCD API login failed for ${ARGOCD_SERVER}" >&2
      exit 1
    }
  export ARGOCD_AUTH_TOKEN="${_session_token}"
fi

_sync_args=(app sync "${_app}")
if [[ ${_force} -eq 1 ]]; then
  _sync_args+=(--force)
fi
_sync_args+=(--timeout "${_timeout}" --server "${ARGOCD_SERVER}" --grpc-web --plaintext --insecure)
argocd "${_sync_args[@]}"
