#!/usr/bin/env python3
"""Read-only local diagnostic for the k3d-manager webhook LaunchAgent."""

import argparse
import datetime as dt
import json
import os
import re
import selectors
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

LABEL = "com.k3d-manager.webhook"
PORT = 7443
LOG_TAIL_BYTES = 65536
TIMEOUT = 4
COMMAND_OUTPUT_LIMIT = 16384
HEALTH_BODY_LIMIT = 65536


def _run(argv, timeout=TIMEOUT):
    output = bytearray()
    started = time.monotonic()
    output_limited = False
    try:
        process = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    except OSError:
        return None
    with selectors.DefaultSelector() as selector:
        selector.register(process.stdout, selectors.EVENT_READ)
        while selector.get_map() and time.monotonic() - started < timeout:
            remaining = timeout - (time.monotonic() - started)
            for key, _ in selector.select(max(0, remaining)):
                chunk = os.read(key.fd, min(4096, COMMAND_OUTPUT_LIMIT + 1 - len(output)))
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                output.extend(chunk)
                if len(output) > COMMAND_OUTPUT_LIMIT:
                    output_limited = True
                    process.terminate()
                    break
    timed_out = time.monotonic() - started >= timeout
    if process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=0.2)
        except subprocess.TimeoutExpired:
            process.kill()
    return {"returncode": process.wait(), "stdout": bytes(output[:COMMAND_OUTPUT_LIMIT]).decode("utf-8", "replace"),
            "timed_out": timed_out, "output_limited": output_limited}


def _command_status(result):
    if result is None:
        return "command_unavailable"
    if isinstance(result, dict) and result.get("timed_out"):
        return "command_timeout"
    if isinstance(result, dict) and result.get("output_limited"):
        return "command_output_limit"
    return "complete"


def _result_output(result):
    if isinstance(result, dict):
        return result.get("stdout", "")
    if result is None:
        return ""
    return f"{result.stdout or ''}{result.stderr or ''}"


def _loaded_port(output):
    match = re.search(r"^\s*K3DM_WEBHOOK_PORT\s*=>\s*(\S+)\s*$", output, re.MULTILINE)
    if not match:
        return PORT
    value = match.group(1)
    if not value.isascii() or not value.isdecimal() or len(value) > 5:
        return None
    port = int(value)
    return port if 1 <= port <= 65535 else None


def _launchd_facts(uid, runner=_run):
    result = runner(["launchctl", "print", f"gui/{uid}/{LABEL}"])
    command_status = _command_status(result)
    output = _result_output(result)
    pid_match = re.search(r"\bpid\s*=\s*(\d+)", output)
    exit_match = re.search(r"\blast exit code\s*=\s*(-?\d+)", output)
    rc = result.get("returncode") if isinstance(result, dict) else result.returncode if result else None
    status = command_status
    if command_status == "complete":
        status = ("loaded" if rc == 0 else "missing" if re.search(r"could not find service|service not found", output, re.I)
                  else "command_error")
    return {"status": status, "port": _loaded_port(output) if status == "loaded" else None,
            "pid": int(pid_match.group(1)) if pid_match else None,
            "last_exit_code": int(exit_match.group(1)) if exit_match else None}


def _listener_facts(runner=_run, port=PORT):
    if port is None:
        return {"status": "configuration_unavailable", "listening": None}
    result = runner(["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN"])
    command_status = _command_status(result)
    output = _result_output(result)
    rc = result.get("returncode") if isinstance(result, dict) else result.returncode if result else None
    status = command_status if command_status != "complete" else (
        "listening" if rc == 0 and output.strip() else "no_listener" if rc == 1 and not output.strip() else "command_error")
    return {"status": status, "listening": status == "listening" if status in ("listening", "no_listener") else None}


def _process_facts(runner=_run):
    result = runner(["pgrep", "-f", "[b]in/k3dm-webhook"])
    command_status = _command_status(result)
    pids = []
    output = _result_output(result)
    rc = result.get("returncode") if isinstance(result, dict) else result.returncode if result else None
    if command_status == "complete" and rc == 0:
        pids = [int(line.split()[0]) for line in output.splitlines()
                if line.split() and line.split()[0].isdigit()]
    status = command_status if command_status != "complete" else "available" if rc in (0, 1) else "command_error"
    return {"status": status, "pids": pids}


def _log_facts(path):
    try:
        stat = path.stat()
        with path.open("rb") as handle:
            handle.seek(max(0, stat.st_size - LOG_TAIL_BYTES))
            raw = handle.read(LOG_TAIL_BYTES).decode("utf-8", "replace")
    except OSError:
        return {"available": False, "modified_utc": None, "freshness": "missing", "error_categories": []}
    categories = []
    for line in raw.splitlines()[-80:]:
        lower = line.lower()
        category = ("authentication" if "unauthorized" in lower or "forbidden" in lower else
                    "bind" if "address already in use" in lower or "bind" in lower else
                    "exception" if "traceback" in lower or "exception" in lower else None)
        if category and category not in categories:
            categories.append(category)
    modified = dt.datetime.fromtimestamp(stat.st_mtime, dt.timezone.utc)
    age = max(0, (dt.datetime.now(dt.timezone.utc) - modified).total_seconds())
    freshness = "fresh" if age < 900 else "stale"
    return {"available": True, "modified_utc": modified.isoformat(), "freshness": freshness,
            "error_categories": categories}


class _NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, _request, _response, _code, _message, _headers, _url):
        return None


def _build_health_opener(extra_handlers=()):
    return urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRedirectHandler(), *extra_handlers)


def _read_health_body(response, timeout):
    deadline = time.monotonic() + timeout
    body = bytearray()
    while len(body) <= HEALTH_BODY_LIMIT:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError("health response deadline exceeded")
        raw = getattr(response, "fp", None)
        sock = getattr(getattr(raw, "raw", None), "_sock", None)
        if sock is not None:
            sock.settimeout(remaining)
        chunk = response.read(min(4096, HEALTH_BODY_LIMIT + 1 - len(body)))
        if not chunk:
            return bytes(body)
        body.extend(chunk)
    raise ValueError("health response too large")


def _health_probe(token, timeout=TIMEOUT, opener=None, port=PORT):
    if port is None:
        return {"status": "configuration_unavailable", "http_responsive": False, "all_ok": None}
    if not token:
        return {"status": "auth_unavailable", "http_responsive": False, "all_ok": None}
    request = urllib.request.Request(f"http://127.0.0.1:{port}/api/v1/health?quick=1",
                                    headers={"Authorization": f"Bearer {token}"})
    try:
        open_request = opener or _build_health_opener().open
        with open_request(request, timeout=timeout) as response:
            if response.status in (401, 403):
                return {"status": "auth_failed", "http_responsive": True, "all_ok": None}
            if response.status != 200:
                return {"status": "http_error", "http_responsive": True, "all_ok": None}
            payload = json.loads(_read_health_body(response, timeout))
    except urllib.error.HTTPError as exc:
        return {"status": "auth_failed" if exc.code in (401, 403) else "http_error",
                "http_responsive": True, "all_ok": None}
    except (TimeoutError, OSError, urllib.error.URLError):
        return {"status": "local_timeout", "http_responsive": False, "all_ok": None}
    except (ValueError, TypeError):
        return {"status": "invalid_response", "http_responsive": True, "all_ok": None}
    if not isinstance(payload, dict) or not isinstance(payload.get("services"), list) or not isinstance(payload.get("all_ok"), bool):
        return {"status": "invalid_response", "http_responsive": True, "all_ok": None}
    services = payload["services"]
    if any(not isinstance(row, dict) or "ok" not in row
           or not isinstance(row.get("name"), str) or not row["name"].strip()
           or (row.get("ok") is not None and not isinstance(row.get("ok"), bool)) for row in services):
        return {"status": "invalid_response", "http_responsive": True, "all_ok": None}
    expected_all_ok = all(row["ok"] is not False for row in services)
    if payload["all_ok"] != expected_all_ok:
        return {"status": "invalid_response", "http_responsive": True, "all_ok": None}
    status = ("healthy_http_dependencies_unknown" if not services or any(row["ok"] is None for row in services)
              else "healthy_http" if payload["all_ok"] else "healthy_http_services_degraded")
    return {"status": status,
            "http_responsive": True, "all_ok": payload["all_ok"]}


def diagnose(check=False):
    now = dt.datetime.now(dt.timezone.utc).isoformat()
    if not check:
        return {"timestamp_utc": now, "mode": "dry-run", "probes": [
            "launchd job state and last exit code", "webhook process PID", "configured webhook TCP listener (default 7443)",
            "bounded redacted log summary", "reader-authenticated loopback /api/v1/health?quick=1"],
            "recovery": "No recovery is performed. Operator may run make restart-webhook once only when local evidence warrants it; it also restarts cloud-bridge."}
    home = Path(os.environ.get("HOME", str(Path.home())))
    job = _launchd_facts(os.getuid())
    process = _process_facts()
    port = job.get("port", PORT)
    listener = _listener_facts(port=port)
    log = _log_facts(home / "Library/Logs/k3dm-webhook.log")
    token = os.environ.get("K3DM_WEBHOOK_TOKEN_READER")
    token = token or _keychain_reader_token()
    probe = _health_probe(token, port=port)
    classification = _classify(job, listener, probe)
    reliable_unhealthy = job["status"] == "missing" or probe["status"] == "local_timeout"
    return {"timestamp_utc": now, "mode": "check", "launchd": job, "process": process, "listener": listener,
            "log": log, "health": probe, "classification": classification,
            "recovery_recommended": reliable_unhealthy,
            "recovery_action": "make restart-webhook (operator-controlled; restarts cloud-bridge too; at most once initially)"}


def _classify(job, listener, probe):
    if job["status"] == "missing":
        return "launchd_job_missing"
    if job["status"] != "loaded":
        return f"launchd_{job['status']}"
    if probe["status"] in ("auth_failed", "auth_unavailable", "http_error", "invalid_response"):
        return probe["status"]
    if probe["status"] == "local_timeout":
        return "local_http_unresponsive"
    if probe["status"] == "healthy_http":
        return "local_http_healthy_external_delivery_unverified"
    if probe["status"] == "healthy_http_services_degraded":
        return "local_http_handler_responsive_dependencies_degraded"
    if probe["status"] == "healthy_http_dependencies_unknown":
        return "local_http_handler_responsive_dependencies_unknown"
    if listener["status"] == "no_listener":
        return "listener_missing"
    return probe["status"]


def _keychain_reader_token():
    result = _run(["security", "find-generic-password", "-s", "k3dm-webhook-token-reader", "-a", "k3dm", "-w"])
    if not isinstance(result, dict) or _command_status(result) != "complete" or result.get("returncode") != 0:
        return None
    token = result.get("stdout")
    return token.strip() if isinstance(token, str) and token.strip() else None


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true", help="collect bounded local evidence (read-only)")
    mode.add_argument("--dry-run", action="store_true", help="print the probe plan (default)")
    args = parser.parse_args(argv)
    print(json.dumps(diagnose(check=args.check), sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
