#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: bin/k3dm-machine-secrets export --role hub|worker|console [--out FILE] [--keychain PATH]\n'
  printf '       bin/k3dm-machine-secrets import --in FILE [--force] [--keychain PATH]\n'
}

error() { printf '%s\n' "$1" >&2; exit "${2:-1}"; }
command_name="${1:-}"
[[ -n "$command_name" ]] || { usage >&2; exit 2; }
shift
role='' file='' keychain='' force=0
while (($#)); do
  case "$1" in
    --role|--out|--in|--keychain)
      (($# >= 2)) || { usage >&2; exit 2; }
      case "$1" in --role) role="$2" ;; --out|--in) file="$2" ;; --keychain) keychain="$2" ;; esac
      shift 2 ;;
    --force) force=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
if [[ -n "$keychain" ]]; then keychain_args=("$keychain"); else keychain_args=(); fi

passphrase_fd() {
  if [[ -n "${K3DM_SECRETS_PASSPHRASE_FILE:-}" ]]; then
    pass_args=(-pass "file:${K3DM_SECRETS_PASSPHRASE_FILE}")
    return
  fi
  local first second
  [[ -r /dev/tty ]] || error 'a terminal is required for the passphrase'
  read -r -s -p 'Passphrase: ' first </dev/tty; printf '\n' >/dev/tty
  if [[ "$command_name" == export ]]; then
    read -r -s -p 'Repeat passphrase: ' second </dev/tty; printf '\n' >/dev/tty
    [[ "$first" == "$second" ]] || error 'passphrases do not match'
  fi
  [[ -n "$first" ]] || error 'passphrase cannot be empty'
  exec {pass_fd}< <(printf '%s' "$first")
  unset first second
  pass_args=(-pass "fd:${pass_fd}")
}

locked_keychain_hint() {
  case "$1" in *'User interaction is not allowed'*) printf '%s\n' 'the login keychain is locked; run this in a terminal on the Mac itself, not over SSH' >&2 ;; esac
}

parse_password_hex() {
  local output="$1" line quoted
  while IFS= read -r line; do
    case "$line" in
      *'password: 0x'*) line="${line#*password: 0x}"; printf '%s' "${line%%[![:xdigit:]]*}"; return 0 ;;
      *'password: "'* )
        quoted="${line#*password: \"}"; quoted="${quoted%\"}"
        printf '%s' "$quoted" | od -An -v -tx1 | tr -d ' \n'
        return 0 ;;
    esac
  done <<< "$output"
  return 1
}

case "$command_name" in
  export)
    case "$role" in hub|worker|console) ;; *) usage >&2; exit 2 ;; esac
    manifest="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/scripts/etc/machine/secrets.${role}.list"
    [[ -r "$manifest" ]] || error "missing manifest: $manifest" 2
    if [[ -z "$file" ]]; then file="${XDG_STATE_HOME:-$HOME/.local/state}/k3d-manager/machine-secrets-${role}.enc"; fi
    [[ ! -e "$file" && ! -L "$file" ]] || error "refusing to overwrite existing file: $file"
    mkdir -p "$(dirname "$file")"
    umask 077
    passphrase_fd
    dump="$(security dump-keychain "${keychain_args[@]}" 2>&1)" || { locked_keychain_hint "$dump"; error 'could not list the keychain'; }
    records() {
      local service account item_account output hex
      while IFS='|' read -r service account _ _; do
        [[ -n "$service" && "$service" != \#* ]] || continue
        while IFS= read -r item_account; do
          [[ "$item_account" == "$service"$'\t'* ]] || continue
          item_account="${item_account#*$'\t'}"
          output="$(security find-generic-password -s "$service" -a "$item_account" -g "${keychain_args[@]}" 2>&1)" || { locked_keychain_hint "$output"; printf 'skipped (empty) %s %s\n' "$service" "$item_account" >&2; continue; }
          if hex="$(parse_password_hex "$output")" && [[ -n "$hex" ]]; then
            printf '%s\t%s\t%s\n' "$service" "$item_account" "$hex"
            printf 'exported %s %s\n' "$service" "$item_account" >&2
          else
            printf 'skipped (empty) %s %s\n' "$service" "$item_account" >&2
          fi
        done < <(printf '%s\n' "$dump" | awk -v svc="$service" '
          function emit() { if (in_item && service==svc && account!="") print service "\t" account }
          /^keychain: / || /^class: / { emit(); in_item=($0 ~ /^class: "genp"/); account=""; service="" }
          in_item && /^ *"svce"<blob>="/ { line=$0; sub(/^ *"svce"<blob>="/, "", line); sub(/"$/, "", line); service=line }
          in_item && /^ *"acct"<blob>="/ { line=$0; sub(/^ *"acct"<blob>="/, "", line); sub(/"$/, "", line); account=line }
          END { emit() }
        ')
      done < "$manifest"
    }
    set +e
    plaintext="$(records)" || { set -e; error 'could not read the keychain'; }
    [[ -n "$plaintext" ]] || { set -e; error 'nothing exported: no listed item was found in the keychain'; }
    printf '%s\n' "$plaintext" | openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -salt -out "$file" "${pass_args[@]}"
    result=$?
    unset plaintext
    set -e
    ((result == 0)) || { rm -f "$file"; error 'could not encrypt' "$result"; }
    display_file="${file/#$HOME/\~}"
    printf 'Encrypted transfer file: %s\nNext: transfer it securely, then run make machine-secrets-import FILE=%q on the new Mac.\n' "$display_file" "$display_file"
    ;;
  import)
    [[ -n "$file" && -f "$file" ]] || error 'use --in FILE with an existing transfer file' 2
    passphrase_fd
    temp_status="${TMPDIR:-/tmp}/k3dm-machine-secrets-status.$$"
    : > "$temp_status"
    trap 'rm -f "$temp_status"' EXIT
    if ! plaintext="$(openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -in "$file" "${pass_args[@]}" 2>/dev/null)"; then
      printf 'could not decrypt\n' >&2
      error 'could not decrypt' 1
    fi
    while IFS=$'\t' read -r service account hex; do
        [[ -n "$service$account$hex" ]] || continue
        if [[ ! "$service" =~ ^[A-Za-z0-9._:/@+-]+$ || ! "$account" =~ ^[A-Za-z0-9._:/@+-]+$ ]]; then
          printf 'rejected (bad name)\n'; printf 'fail\n' >> "$temp_status"; continue
        fi
        if [[ -z "$hex" || ! "$hex" =~ ^([[:xdigit:]]{2})+$ ]]; then
          printf 'rejected (empty or bad value) %s %s\n' "$service" "$account"; printf 'fail\n' >> "$temp_status"; continue
        fi
        if (( ! force )) && security find-generic-password -s "$service" -a "$account" "${keychain_args[@]}" >/dev/null 2>&1; then
          printf 'skipped (present) %s %s\n' "$service" "$account"; printf 'ok\n' >> "$temp_status"; continue
        fi
        if add_err="$(printf 'add-generic-password -U -s %s -a %s -X %s %s\n' "$service" "$account" "$hex" "$keychain" | security -i 2>&1 >/dev/null)" \
          && security find-generic-password -s "$service" -a "$account" "${keychain_args[@]}" >/dev/null 2>&1; then
          printf 'copied %s %s\n' "$service" "$account"; printf 'ok\n' >> "$temp_status"
        else
          locked_keychain_hint "$add_err"; printf 'failed %s %s\n' "$service" "$account"; printf 'fail\n' >> "$temp_status"
        fi
    done <<< "$plaintext"
    unset plaintext
    grep -q . "$temp_status" || error 'the transfer file holds no records; it was kept'
    if grep -q '^fail$' "$temp_status"; then printf 'transfer file kept because one or more items failed: %s\n' "$file"; error 'one or more items failed' 1; fi
    rm -f "$file"
    printf 'Import complete; encrypted transfer file deleted.\n'
    ;;
  *) usage >&2; exit 2 ;;
esac
