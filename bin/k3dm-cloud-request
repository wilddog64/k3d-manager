#!/usr/bin/env python3
"""File and optionally wait for a read-only cloud-session request."""

import argparse
import json
import os
import re
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts" / "lib"))
from webhook import notify_routes
from webhook.proc import _spawn_capture_text
from webhook.cloud_actions import ACTION_ALLOWLIST


RESPONSE_REF = "refs/remotes/origin/cloud-requests"
FETCH_REFSPEC = f"+refs/heads/cloud-requests:{RESPONSE_REF}"
APPROVAL_ID_RE = re.compile(r"^c[0-9]+-[0-9a-f]{8}$")


def _git(args, cwd=ROOT, env=None, timeout=60):
    rc, output, timed_out = _spawn_capture_text(["git", *args], cwd=cwd, env=env, timeout=timeout)
    if timed_out or rc != 0:
        raise RuntimeError(output.strip() or "git command failed")
    return output


def _parse_args(argv):
    parser = argparse.ArgumentParser(usage="k3dm-cloud-request <action> [--arg key=value ...] [--notify-route ALIAS] [--wait] [--wait-final] [--timeout SECONDS] [--poll-interval SECONDS]")
    parser.add_argument("action", choices=sorted(ACTION_ALLOWLIST))
    parser.add_argument("--arg", action="append", default=[])
    parser.add_argument("--notify-route", metavar="ALIAS")
    parser.add_argument("--wait", action="store_true")
    parser.add_argument("--wait-final", action="store_true")
    parser.add_argument("--timeout", type=float, default=300)
    parser.add_argument("--poll-interval", type=float, default=5)
    parsed = parser.parse_args(argv)
    if parsed.notify_route is not None and not notify_routes.ALIAS_RE.fullmatch(parsed.notify_route):
        parser.error(notify_routes.INVALID_REASON)
    args = {}
    for item in parsed.arg:
        if "=" not in item:
            parser.error("--arg requires key=value")
        key, value = item.split("=", 1)
        allowed = ACTION_ALLOWLIST[parsed.action][2]
        if key not in allowed or key in args:
            parser.error("unknown or repeated argument")
        if not allowed[key].fullmatch(value):
            parser.error(f"invalid {key}")
        args[key] = value
    if set(args) != set(ACTION_ALLOWLIST[parsed.action][2]):
        parser.error("missing required argument")
    if parsed.timeout < 0:
        parser.error("timeout must be non-negative")
    if parsed.poll_interval <= 0:
        parser.error("poll-interval must be positive")
    return parsed, args


def _commit_request(request_id, payload):
    remote_ref = _git(["ls-remote", "origin", "refs/heads/cloud-requests"]).split()
    if remote_ref:
        _git(["fetch", "origin", FETCH_REFSPEC], timeout=120)
        parent = _git(["rev-parse", "--verify", "--quiet", RESPONSE_REF]).strip()
    else:
        parent = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"
    with tempfile.NamedTemporaryFile(dir=ROOT, prefix="cloud-index.", delete=False) as handle:
        index_path = handle.name
    request_file = Path(index_path + ".request")
    request_file.write_text(json.dumps(payload, sort_keys=True) + "\n")
    env = os.environ.copy()
    env["GIT_INDEX_FILE"] = index_path
    try:
        if remote_ref:
            _git(["read-tree", parent], env=env)
        else:
            _git(["read-tree", "--empty"], env=env)
        blob = _git(["hash-object", "-w", str(request_file)], env=env).strip()
        _git(["update-index", "--add", "--cacheinfo", f"100644,{blob},requests/{request_id}.json"], env=env)
        tree = _git(["write-tree"], env=env).strip()
        commit_args = ["commit-tree", tree]
        if remote_ref:
            commit_args += ["-p", parent]
        commit_args += ["-m", "cloud request"]
        commit = _git(commit_args, env=env, timeout=30).strip()
        lease = parent if remote_ref else ""
        push = ["push", "--force-with-lease=refs/heads/cloud-requests:" + lease,
                "origin", f"{commit}:refs/heads/cloud-requests"]
        _git(push, timeout=120)
    finally:
        for path in (Path(index_path), request_file):
            try:
                path.unlink()
            except OSError:
                pass


def _pending_approval(request_id, action):
    """Return a validated approval notice, or None for untrusted/missing data."""
    try:
        pending = json.loads(_git(["show", f"{RESPONSE_REF}:responses/{request_id}.pending.json"]))
        if not isinstance(pending, dict) or pending.get("id") != request_id or pending.get("action") != action:
            return None
        body = pending.get("body")
        if (not isinstance(body, dict) or body.get("status") != "approval-pending"
                or not isinstance(body.get("approval_id"), str)
                or not APPROVAL_ID_RE.fullmatch(body["approval_id"])
                or not isinstance(body.get("expires_at"), str)):
            return None
        expires_at = datetime.fromisoformat(body["expires_at"].replace("Z", "+00:00"))
        return body["approval_id"], body["expires_at"], expires_at
    except (RuntimeError, json.JSONDecodeError, TypeError, ValueError, OverflowError):
        return None


def main(argv=None):
    parsed, args = _parse_args(argv)
    now = datetime.now(timezone.utc)
    request_id = now.strftime("%Y%m%dT%H%M%SZ") + "-" + parsed.action
    payload = {"schema": 1, "action": parsed.action, "args": args,
               "requested_by": "claude-cloud", "requested_at": now.isoformat().replace("+00:00", "Z"),
               "expires_at": (now + timedelta(minutes=30)).isoformat().replace("+00:00", "Z")}
    if parsed.notify_route is not None:
        payload["notify_route"] = parsed.notify_route
    try:
        _commit_request(request_id, payload)
    except (OSError, RuntimeError, ValueError) as error:
        print(str(error), file=sys.stderr)
        return 4
    print(request_id)
    if not parsed.wait and not parsed.wait_final:
        return 0
    wait_started = time.monotonic()
    deadline = wait_started + parsed.timeout
    approval_started = None
    approval_notice = None
    while True:
        try:
            _git(["fetch", "origin", FETCH_REFSPEC], timeout=120)
        except RuntimeError:
            return 4
        try:
            raw = _git(["show", f"{RESPONSE_REF}:responses/{request_id}.json"])
            response = json.loads(raw)
        except (RuntimeError, json.JSONDecodeError):
            response = None
        if response is not None:
            if approval_started is not None:
                deadline += time.monotonic() - approval_started
            print(json.dumps(response, sort_keys=True))
            if not parsed.wait_final:
                return {"ok": 0, "rejected": 3, "error": 4}.get(response.get("status"), 4)
            body = response.get("body")
            if not isinstance(body, dict) or body.get("status") != "queued" or not body.get("job_id"):
                return {"ok": 0, "rejected": 3, "error": 4}.get(response.get("status"), 4)
            while True:
                try:
                    _git(["fetch", "origin", FETCH_REFSPEC], timeout=120)
                except RuntimeError:
                    return 4
                try:
                    raw = _git(["show", f"{RESPONSE_REF}:responses/{request_id}.final.json"])
                    final_response = json.loads(raw)
                except (RuntimeError, json.JSONDecodeError):
                    final_response = None
                if final_response is not None:
                    print(json.dumps(final_response, sort_keys=True))
                    return {"ok": 0, "rejected": 3, "error": 4}.get(final_response.get("status"), 4)
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return 5
                time.sleep(min(parsed.poll_interval, remaining))
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return 5
        if approval_notice is None and parsed.action != "cluster-status":
            approval_notice = _pending_approval(request_id, parsed.action)
            if approval_notice is not None:
                approval_id, expires_text, expires_at = approval_notice
                approval_started = time.monotonic()
                print(f"awaiting operator approval ({approval_id}) until {expires_text}", file=sys.stderr)
                expiry_deadline = time.monotonic() + (expires_at.timestamp() - time.time()) + 120
                deadline = max(deadline, min(expiry_deadline, wait_started + 2100))
        time.sleep(min(parsed.poll_interval, remaining))


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SystemExit:
        raise
    except (argparse.ArgumentError, ValueError):
        raise SystemExit(2)
