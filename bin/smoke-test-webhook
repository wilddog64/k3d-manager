#!/usr/bin/env bash
# bin/smoke-test-webhook
# Webhook-server smoke gate for the webhook modularization (scripts/lib/webhook/*).
#
# Boots an ISOLATED k3dm-webhook instance (own port + own job/run dirs so it never
# disturbs the running :7443 server) and verifies the running server serves
# GET /api/v1/health. This proves the module split did not break server boot, the
# sys.path shim, module imports, or the health handler — WITHOUT needing a cluster.
#
# Run this as a gate after every modularization slice, before accepting it.
#
# Usage:
#   bin/smoke-test-webhook                  # boot + assert HTTP 200 + valid services[] shape
#   bin/smoke-test-webhook --require-all-ok # also fail if any service is not ok (dev box w/ cluster)
#
# Environment:
#   SMOKE_WEBHOOK_PORT   port for the isolated instance (default: 27443)
#   CLUSTER_PROVIDER     forwarded to /api/v1/health?provider= (default: server default)

set -euo pipefail

SMOKE_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SMOKE_SCRIPT_DIR}/.." && pwd)"

REQUIRE_ALL_OK=0
for arg in "$@"; do
  case "${arg}" in
    --require-all-ok) REQUIRE_ALL_OK=1 ;;
    -h|--help) grep '^#' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown arg: ${arg}" >&2; exit 2 ;;
  esac
done

PORT="${SMOKE_WEBHOOK_PORT:-27443}"
TOKEN="$(python3 -c 'import secrets; print(secrets.token_hex(16))')"
URL="http://127.0.0.1:${PORT}"

TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/k3dm-smoke-webhook.XXXXXX")"
SERVER_LOG="${TMP_DIR}/server.log"
HEALTH_JSON="${TMP_DIR}/health.json"
WEBHOOK_PID=""

cleanup() {
  [[ -n "${WEBHOOK_PID}" ]] && kill "${WEBHOOK_PID}" 2>/dev/null || true
  rm -rf "${TMP_DIR}" 2>/dev/null || true
}
trap cleanup EXIT

echo "=== Webhook-server smoke test ==="
echo "  port: ${PORT}"
echo "  isolated job/run dirs: ${TMP_DIR}"
echo ""

# --- boot isolated instance (own port + own job/run dirs) ---
K3DM_WEBHOOK_TOKEN="${TOKEN}" \
K3DM_WEBHOOK_PORT="${PORT}" \
K3DM_JOB_DIR="${TMP_DIR}/jobs" \
K3DM_RUN_DIR="${TMP_DIR}/run" \
K3DM_GEMINI_BIN="/usr/bin/true" \
  python3 "${REPO_ROOT}/bin/k3dm-webhook" >"${SERVER_LOG}" 2>&1 &
WEBHOOK_PID=$!

# --- wait for readiness (bail early if the process dies) ---
ready=0
for _ in $(seq 1 20); do
  if curl -s -o /dev/null "${URL}/" 2>/dev/null; then ready=1; break; fi
  kill -0 "${WEBHOOK_PID}" 2>/dev/null || break
  sleep 0.3
done

if (( ready == 0 )); then
  echo "[FAIL] webhook server did not start on ${URL}" >&2
  echo "---- server log ----" >&2
  cat "${SERVER_LOG}" >&2 2>/dev/null || true
  exit 1
fi
echo "[PASS] server booted and is accepting connections"

# --- hit /api/v1/health on the running server ---
health_path="/api/v1/health"
if [[ -n "${CLUSTER_PROVIDER:-}" ]]; then
  health_path="/api/v1/health?provider=${CLUSTER_PROVIDER}"
fi

http_code="$(curl -s -o "${HEALTH_JSON}" -w '%{http_code}' \
  -H "Authorization: Bearer ${TOKEN}" \
  --max-time 90 "${URL}${health_path}" 2>/dev/null || echo "000")"

if [[ "${http_code}" != "200" ]]; then
  echo "[FAIL] GET ${health_path} returned HTTP ${http_code} (expected 200)" >&2
  cat "${HEALTH_JSON}" >&2 2>/dev/null || true
  exit 1
fi
echo "[PASS] GET ${health_path} → HTTP 200"

# --- validate JSON shape + report services ---
python3 - "${HEALTH_JSON}" "${REQUIRE_ALL_OK}" <<'PY'
import json, sys

path, require_all_ok = sys.argv[1], sys.argv[2] == "1"
try:
    with open(path) as fh:
        data = json.load(fh)
except Exception as exc:
    print(f"[FAIL] health response is not valid JSON: {exc}", file=sys.stderr)
    sys.exit(1)

services = data.get("services")
if not isinstance(services, list) or not services:
    print("[FAIL] health response has no services[] array", file=sys.stderr)
    sys.exit(1)

for svc in services:
    icon = "OK " if svc.get("ok") else "ERR"
    print(f"  [{icon}] {svc.get('name')}: {svc.get('detail')}")

not_ok = [svc.get("name") for svc in services if not svc.get("ok")]
print(f"[PASS] health response valid — {len(services)} services reported")

if require_all_ok and not_ok:
    print(f"[FAIL] --require-all-ok: {len(not_ok)} service(s) not ok: "
          f"{', '.join(not_ok)}", file=sys.stderr)
    sys.exit(1)
if not_ok:
    print(f"[WARN] {len(not_ok)} service(s) not ok "
          f"(cluster-dependent — not failing without --require-all-ok): "
          f"{', '.join(not_ok)}")
PY

echo ""
echo "=== Webhook-server smoke test PASSED ==="
