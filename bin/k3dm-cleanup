#!/usr/bin/env bash
set -euo pipefail

K3DM_STATE_DIR="${HOME}/.local/share/k3d-manager"
K3DM_TMP_ROOT="${K3DM_TMP_ROOT:-/tmp}"
K3DM_TMP_RETENTION_DAYS="${K3DM_TMP_RETENTION_DAYS:-1}"
K3DM_RUN_DIR="${K3DM_RUN_DIR:-${K3DM_STATE_DIR}/run}"
K3DM_PACKER_CACHE_DIR="${K3DM_PACKER_CACHE_DIR:-${HOME}/.cache/packer}"
K3DM_PACKER_RETENTION_DAYS="${K3DM_PACKER_RETENTION_DAYS:-30}"
K3DM_PORT_CACHE_DIR="${K3DM_PORT_CACHE_DIR:-${HOME}/.cache/port}"
K3DM_PORT_RETENTION_DAYS="${K3DM_PORT_RETENTION_DAYS:-7}"

# Failure screenshots — keep most recent 10 in root, 10 in logs/
_prune_pngs() {
  local dir="$1"
  local keep="${2:-10}"
  local count
  count=$(( $(ls -1t "${dir}"/acg-extend-failure-*.png 2>/dev/null | wc -l | tr -d ' ' || true) ))
  if [[ "${count}" -gt "${keep}" ]]; then
    ls -1t "${dir}"/acg-extend-failure-*.png | tail -n "+$((keep + 1))" | xargs rm -f
    echo "k3dm-cleanup: pruned $((count - keep)) failure PNGs from ${dir}"
  fi
}

# Chromium re-downloadable cache dirs — safe to delete; browser re-creates them
_prune_chromium_cache() {
  local profile_dir="$1"
  local -a cache_dirs=(
    component_crx_cache
    optimization_guide_model_store
    GraphiteDawnCache
    WasmTtsEngine
    "Safe Browsing"
  )
  local cache_dir target
  for cache_dir in "${cache_dirs[@]}"; do
    target="${profile_dir}/${cache_dir}"
    if [[ -d "${target}" ]]; then
      rm -rf "${target}"
      echo "k3dm-cleanup: removed Chromium cache ${target}"
    fi
  done
}

_prune_old_paths() {
  local pattern="$1"
  local path_type="$2"
  local label="$3"
  local -a matches=()
  local path

  while IFS= read -r path; do
    matches+=("${path}")
  done < <(find "${K3DM_TMP_ROOT}" -maxdepth 1 -name "${pattern}" -type "${path_type}" -mtime +"${K3DM_TMP_RETENTION_DAYS}" -print 2>/dev/null | sort)

  if [[ "${#matches[@]}" -eq 0 ]]; then
    return
  fi

  rm -rf "${matches[@]}"
  echo "k3dm-cleanup: pruned ${#matches[@]} ${label} from ${K3DM_TMP_ROOT}"
}

_prune_placeholder_tmpdirs() {
  local count=0
  local dir
  local -a entries=()
  local age_match

  shopt -s nullglob dotglob
  for dir in "${K3DM_TMP_ROOT}"/TemporaryDirectory.*; do
    [[ -d "${dir}" ]] || continue
    age_match="$(find "${dir}" -maxdepth 0 -mtime +"${K3DM_TMP_RETENTION_DAYS}" -print 2>/dev/null || true)"
    [[ -n "${age_match}" ]] || continue

    entries=("${dir}"/*)
    if [[ "${#entries[@]}" -eq 1 ]] && [[ "$(basename "${entries[0]}")" == ".keep-directory" ]]; then
      rm -rf "${dir}"
      count=$((count + 1))
    fi
  done
  shopt -u nullglob dotglob

  if [[ "${count}" -gt 0 ]]; then
    echo "k3dm-cleanup: pruned ${count} stale TemporaryDirectory placeholders from ${K3DM_TMP_ROOT}"
  fi
}

_prune_run_dir() {
  local dir="${K3DM_RUN_DIR}"
  [[ -d "${dir}" ]] || return 0

  _prune_old_paths_in_dir "${dir}" 'alertmanager-*.html' f 'alertmanager probe captures'
  _prune_old_paths_in_dir "${dir}" 'alertproxy-*.log' f 'alertproxy logs'
  _prune_old_paths_in_dir "${dir}" 'k3d-*.out' f 'status debug outputs'
  _prune_old_paths_in_dir "${dir}" 'k3dm-ask-*.out' f 'ask transcript files'
  _prune_old_paths_in_dir "${dir}" 'k3d-manager-acg-watch.out' f 'acg-watch stdout logs'
  _prune_old_paths_in_dir "${dir}" 'k3d-manager-acg-watch.err' f 'acg-watch stderr logs'
  _prune_old_paths_in_dir "${dir}" 'k3dm_smoke*.out' f 'smoke test outputs'
  _prune_old_paths_in_dir "${dir}" 'k3dm-worker-smoke.*' f 'worker smoke outputs'
  _prune_old_paths_in_dir "${dir}" 'k3dm-products.json' f 'product debug captures'
}

_prune_old_paths_in_dir() {
  local base_dir="$1"
  local pattern="$2"
  local path_type="$3"
  local label="$4"
  local -a matches=()
  local path

  while IFS= read -r path; do
    matches+=("${path}")
  done < <(find "${base_dir}" -maxdepth 1 -name "${pattern}" -type "${path_type}" -mtime +"${K3DM_TMP_RETENTION_DAYS}" -print 2>/dev/null | sort)

  if [[ "${#matches[@]}" -eq 0 ]]; then
    return
  fi

  rm -rf "${matches[@]}"
  echo "k3dm-cleanup: pruned ${#matches[@]} ${label} from ${base_dir}"
}

# Packer artifacts are large and reproducible; remove only old, unreferenced
# ISO/lock files from the exact Packer cache directory.
_prune_packer_cache() {
  local path
  [[ -d "${K3DM_PACKER_CACHE_DIR}" ]] || return 0
  while IFS= read -r path; do
    if ! lsof -- "${path}" >/dev/null 2>&1; then
      rm -f "${path}"
      echo "k3dm-cleanup: removed stale Packer artifact ${path}"
    fi
  done < <(find "${K3DM_PACKER_CACHE_DIR}" -maxdepth 1 -type f \
    \( -name '*.iso' -o -name '*.lock' \) -mtime "+${K3DM_PACKER_RETENTION_DAYS}" -print 2>/dev/null)
}

# The port helper leaves tiny marker files; prune only markers older than the
# short retention window and never remove the directory itself.
_prune_port_markers() {
  local path
  [[ -d "${K3DM_PORT_CACHE_DIR}" ]] || return 0
  while IFS= read -r path; do
    rm -f "${path}"
    echo "k3dm-cleanup: removed stale port marker ${path}"
  done < <(find "${K3DM_PORT_CACHE_DIR}" -maxdepth 1 -type f \
    -mtime "+${K3DM_PORT_RETENTION_DAYS}" -print 2>/dev/null)
}

_prune_pngs "${K3DM_STATE_DIR}"
_prune_pngs "${K3DM_STATE_DIR}/logs"
_prune_chromium_cache "${K3DM_STATE_DIR}/profile"
_prune_chromium_cache "${K3DM_STATE_DIR}/playwright-auth"
_prune_run_dir

# tmp screenshots — keep most recent 5; delete older ones
_tmp_ss_count=$(( $(ls -1t "${K3DM_TMP_ROOT}"/k3dm-acg-screenshot-*.png 2>/dev/null | wc -l | tr -d ' ' || true) ))
if [[ "${_tmp_ss_count}" -gt 5 ]]; then
  ls -1t "${K3DM_TMP_ROOT}"/k3dm-acg-screenshot-*.png | tail -n "+6" | xargs rm -f
  echo "k3dm-cleanup: pruned $(( _tmp_ss_count - 5 )) screenshot(s) from ${K3DM_TMP_ROOT}"
fi

# tmp paths — prune only repo-owned leftovers plus stale TemporaryDirectory placeholders
_prune_old_paths 'playwright-artifacts-*' d 'playwright artifact dirs'
_prune_old_paths 'bats-run-*' d 'BATS temp dirs'
_prune_old_paths 'k3dm-ask-*.out' f 'ask transcript files'
_prune_old_paths 'k3d-manager-*.out' f 'k3d-manager stdout logs'
_prune_old_paths 'k3d-manager-*.err' f 'k3d-manager stderr logs'
_prune_old_paths 'argocd-*.sock' f 'argocd socket files'
_prune_old_paths 'k3d-config-tmp-*.yaml' f 'k3d config temp files'
_prune_old_paths 'k3d-hostsfile-*' f 'k3d hostsfile temp files'
_prune_old_paths 'k3d-manager-sudoers.*' f 'sudoers temp files'
_prune_old_paths 'k3dm-gcp-creds.*' f 'GCP credential temp files'
_prune_old_paths 'k3s-etcd-*.db' f 'k3s etcd snapshots'
_prune_placeholder_tmpdirs
_prune_packer_cache
_prune_port_markers

echo "k3dm-cleanup: done"
