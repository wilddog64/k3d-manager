#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
source "$REPO_ROOT/scripts/lib/foundation/scripts/lib/system.sh"

die() { printf '[hub-deploy] ERROR: %s\n' "$*" >&2; exit 2; }
stop() {
  local step="$1" code="$2" suffix=''
  if [[ "$code" == 75 && "$step" != run-lock ]] && { [[ -z "${approval_id:-}" ]] || [[ "$step" != promote && "$step" != read-deploy-hub && "$step" != read-promoted-ref ]]; }; then code=1; suffix=' (child exit 75)'; fi
  if [[ -n "${approval_id:-}" ]]; then printf 'hub-deploy: stopped at %s%s: rerun bin/k3dm-hub-deploy %s --approval %s after fixing it\n' "$step" "$suffix" "${new:-$ref}" "$approval_id" >&2
  else printf 'hub-deploy: stopped at %s%s: rerun make hub-deploy REF=%s after fixing it\n' "$step" "$suffix" "$ref" >&2; fi
  exit "$code"
}
retry_hint() { if [[ -n "${approval_id:-}" ]]; then printf 'hub-deploy: launchd %s %s; pending; rerun bin/k3dm-hub-deploy %s --approval %s\n' "$1" "$2" "${new:-$ref}" "$approval_id" >&2; else printf 'hub-deploy: launchd %s %s; pending; rerun bin/k3dm-hub-deploy <ref>\n' "$1" "$2" >&2; fi; }
approval_id=''
if [[ $# == 3 && "$2" == --approval ]]; then ref="$1"; approval_id="$3"; [[ "$approval_id" =~ ^p[0-9]+-[0-9a-f]{8}$ ]] || die 'usage: k3dm-hub-deploy <ref> [--approval <id>]'
elif [[ $# == 1 && -n "$1" ]]; then ref="$1"
else die 'usage: k3dm-hub-deploy <ref> [--approval <id>]'; fi
ref="$1"
stage2=0
if [[ -n "${K3DM_HUB_DEPLOY_PREV+x}" ]]; then
  prev="$K3DM_HUB_DEPLOY_PREV"
  unset K3DM_HUB_DEPLOY_PREV
  [[ "$prev" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ && "$ref" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] || die 'K3DM_HUB_DEPLOY_PREV must be a commit sha'
  stage2=1
fi
if _run_command --soft -- "$REPO_ROOT/bin/k3dm-require-role" hub; then :; else code=$?; stop require-role "$code"; fi
if [[ "$stage2" == 1 ]]; then
  _run_command --soft -- git -C "$REPO_ROOT" cat-file -e "$prev^{commit}" 9>&- || die 'K3DM_HUB_DEPLOY_PREV must be a commit sha'
fi
STATE_DIR="$HOME/.local/share/k3d-manager/hub-deploy"
umask 077
if _run_command --soft -- mkdir -p "$STATE_DIR" && _run_command --soft -- chmod 0700 "$STATE_DIR"; then :; else stop state-dir 1; fi
exec 9>>"$STATE_DIR/run.lock" || stop run-lock 1
if [[ -x /usr/bin/lockf ]]; then
  if /usr/bin/lockf -s -t 0 9; then lock_rc=0; else lock_rc=$?; fi
elif [[ -x /usr/bin/flock ]]; then
  if /usr/bin/flock -n -E 75 9; then lock_rc=0; else lock_rc=$?; fi
else
  printf 'hub-deploy: no lockf or flock\n' >&2; stop run-lock 1
fi
if [[ "$lock_rc" == 75 ]]; then printf 'hub-deploy: another run is active\n' >&2; exit 75; fi
[[ "$lock_rc" == 0 ]] || stop run-lock 1

remote_sha() {
  local rows sha
  rows="$(_run_command --soft -- git -C "$REPO_ROOT" ls-remote origin refs/heads/deploy/hub 9>&-)" || return $?
  sha="${rows%%$'\t'*}"
  [[ "$sha" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] || { printf '[hub-deploy] ERROR: origin/deploy/hub is missing or invalid\n' >&2; return 1; }
  printf '%s' "$sha"
}
write_state() {
  local name
  {
    printf 'appsets %s\nlaunchd %s\n' "$appsets" "$launchd"
    for name in "${pending[@]}"; do printf 'pending %s\n' "$name"; done
  } > "$STATE_DIR/state.tmp.$$" && _run_command --soft -- mv -f "$STATE_DIR/state.tmp.$$" "$STATE_DIR/state" 9>&-
}
valid_state() {
  local kind value line name
  appsets='' launchd='' pending=()
  [[ -f "$STATE_DIR/state" && -r "$STATE_DIR/state" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^(appsets|launchd|pending)\ ([a-z0-9-]+)$ ]] || return 1
    kind="${BASH_REMATCH[1]}"; value="${BASH_REMATCH[2]}"
    case "$kind" in
      appsets|launchd)
        [[ "$value" == full || "$value" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] || return 1
        if [[ "$value" != full ]]; then _run_command --soft -- git -C "$REPO_ROOT" cat-file -e "$value^{commit}" 9>&- || return 1; fi
        if [[ "$kind" == appsets ]]; then [[ -z "$appsets" ]] || return 1; appsets="$value"
        else [[ -z "$launchd" ]] || return 1; launchd="$value"; fi ;;
      pending)
        [[ "$value" =~ ^[a-z0-9-]+$ ]] || return 1
        for name in "${pending[@]}"; do [[ "$name" != "$value" ]] || return 1; done
        pending+=("$value") ;;
      *) return 1 ;;
    esac
  done < "$STATE_DIR/state"
  [[ -n "$appsets" && -n "$launchd" ]]
}
if [[ "$stage2" == 1 ]]; then old="$prev"
elif [[ -n "$approval_id" ]]; then old=''
elif old="$(remote_sha)"; then :; else code=$?; stop read-deploy-hub "$code"; fi
pending=()
approval_first_run=0
if [[ -n "$approval_id" ]] && valid_state; then :
elif [[ -n "$approval_id" ]]; then
  approval_first_run=1; appsets=''; launchd=full; pending=()
elif valid_state; then :
elif [[ ! -e "$STATE_DIR/state" && "$(_run_command --soft -- ls -A "$STATE_DIR" 9>&-)" == run.lock ]]; then
  appsets="$old"; launchd=full; pending=()
  printf 'hub-deploy: no reconcile state yet; full launchd reconcile owed; appsets base %s\n' "${old:0:7}"
  write_state || stop state-write 1
else
  appsets=full; launchd=full; pending=()
  printf 'hub-deploy: state unreadable; full launchd reconcile and appsets reapply owed\n'
  write_state || stop state-write 1
fi
RS_DIR="${K3DM_REPO_SYNC_STATE_DIR:-$HOME/.local/share/k3d-manager/repo-sync}"
RS_STALE=$((2 * ${K3DM_REPO_SYNC_TIMEOUT:-60} + 60))
owned=0
superseded_file=''
release_lock() { if [[ "$owned" == 1 && -r "$RS_DIR/lock/pid" && "$(_run_command --soft -- cat "$RS_DIR/lock/pid" 9>&-)" == "$$" ]]; then _run_command --soft -- rm -rf "$RS_DIR/lock" 9>&-; fi; owned=0; }
cleanup() { [[ -z "$superseded_file" ]] || rm -f -- "$superseded_file"; release_lock; }
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM HUP
checkout_ok() {
  local head dirty
  head="$(_run_command --soft -- git -C "$REPO_ROOT" rev-parse HEAD 9>&-)" || return 1
  dirty="$(_run_command --soft -- git -C "$REPO_ROOT" status --porcelain --untracked-files=no 9>&-)" || return 1
  [[ "$head" == "$new" && -z "$dirty" ]]
}
lock_stamp() { if [[ "$(_run_command --soft -- uname -s 9>&-)" == Darwin ]]; then _run_command --soft -- /usr/bin/stat -f %m "$1" 9>&-; else _run_command --soft -- /usr/bin/stat -c %Y "$1" 9>&-; fi; }
take_lock() {
  local pid mtime now err
  _run_command --soft -- mkdir -p "$RS_DIR" 9>&- || return 1
  if ! _run_command --soft --quiet -- mkdir "$RS_DIR/lock" 9>&- 2>/dev/null; then
    mtime="$(lock_stamp "$RS_DIR/lock")" || return 1; now="$(_run_command --soft -- date +%s 9>&-)"
    pid=''; [[ ! -r "$RS_DIR/lock/pid" ]] || pid="$(_run_command --soft -- cat "$RS_DIR/lock/pid" 9>&-)"
    err=''; if [[ "$pid" =~ ^[1-9][0-9]*$ ]]; then err="$(kill -0 "$pid" 2>&1)" || :; fi
    if (( now - mtime > RS_STALE )) || [[ "$err" == *'No such process'* || "$err" == *'no such process'* ]]; then _run_command --soft -- rm -rf "$RS_DIR/lock" 9>&-; else return 1; fi
    _run_command --soft --quiet -- mkdir "$RS_DIR/lock" 9>&- 2>/dev/null || return 1
  fi
  owned=1
  printf '%s\n' "$$" > "$RS_DIR/lock/pid" || return 1
  [[ "$(_run_command --soft -- cat "$RS_DIR/lock/pid" 9>&-)" == "$$" ]]
}

if [[ "$stage2" == 0 ]]; then
  if [[ -n "$approval_id" ]]; then
    if machine="$(_run_command --soft -- "$REPO_ROOT/bin/k3dm-hub-promote" promote "$ref" --approval "$approval_id" 9>&-)"; then :; else code=$?; stop promote "$code"; fi
    new="${machine#approved-sha }"; new="${new%%$'\n'*}"; promoted_old="${machine##*$'\n'}"; promoted_old="${promoted_old#approved-old }"
    [[ "$new" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ && "$promoted_old" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ && "$machine" == $'approved-sha '*$'\napproved-old '* ]] || stop promote 75
    old="$promoted_old"
    if [[ "$approval_first_run" == 1 ]]; then
      if [[ ! -e "$STATE_DIR/state" && "$(_run_command --soft -- ls -A "$STATE_DIR" 9>&-)" == run.lock ]]; then appsets="$promoted_old"; printf 'hub-deploy: no reconcile state yet; full launchd reconcile owed; appsets base %s\n' "${promoted_old:0:7}";
      else appsets=full; printf 'hub-deploy: state unreadable; full launchd reconcile and appsets reapply owed\n'; fi
      launchd=full; pending=(); write_state || stop state-write 1
    fi
    if got="$(remote_sha)"; then :; else stop read-promoted-ref 75; fi
    if [[ "$got" != "$new" ]]; then printf 'hub-deploy: deploy/hub is now %s; approval %s moved it to %s and has been superseded; nothing more to deploy for it\n' "${got:0:7}" "$approval_id" "${new:0:7}" >&2; stop superseded 1; fi
  else
  if _run_command --soft -- "$REPO_ROOT/bin/k3dm-hub-promote" promote "$ref" 9>&-; then :; else code=$?; stop promote "$code"; fi
  if new="$(remote_sha)"; then :; else code=$?; stop read-promoted-ref "$code"; fi
  if want="$(_run_command --soft -- git -C "$REPO_ROOT" rev-parse --verify "$ref^{commit}" 9>&-)"; then :; else stop resolve-promoted-ref 1; fi
  if [[ "$new" != "$want" ]]; then
    printf 'hub-deploy: deploy/hub is %s, not the promoted %s; superseded\n' "${new:0:7}" "${want:0:7}" >&2
    stop superseded 1
  fi
  fi
  trap cleanup EXIT
  deadline=$(( $(_run_command --soft -- date +%s 9>&-) + ${K3DM_HUB_DEPLOY_CHECKOUT_WAIT:-330} ))
  caught_up=0
  while :; do
    if take_lock; then
      if checkout_ok; then caught_up=1; release_lock; break
      elif [[ -z "$(_run_command --soft -- git -C "$REPO_ROOT" status --porcelain --untracked-files=no 9>&-)" ]] &&
           _run_command --soft -- git -C "$REPO_ROOT" merge-base --is-ancestor HEAD "$new" 9>&-; then
        _run_command --soft -- git -C "$REPO_ROOT" merge --ff-only --quiet "$new" 9>&- || :
        if checkout_ok; then caught_up=1; fi
      fi
    fi
    release_lock
    [[ "$caught_up" == 0 ]] || break
    now="$(_run_command --soft -- date +%s 9>&-)"; (( now < deadline )) || break
    delay=$((deadline-now)); (( delay <= 10 )) || delay=10
    _run_command --soft -- sleep "$delay" 9>&-
  done
  if [[ "$caught_up" != 1 ]]; then
    printf 'hub-deploy: hub checkout not at %s with a clean tracked tree; nothing applied\n' "${new:0:7}" >&2
    stop checkout-catch-up 1
  fi
  if ! _run_command --soft -- git -C "$REPO_ROOT" grep -q K3DM_HUB_DEPLOY_PREV "$new" -- bin/k3dm-hub-deploy 9>&-; then
    printf 'hub-deploy: promoted copy has no handoff; continuing with the running copy\n'
  elif [[ -x "$REPO_ROOT/bin/k3dm-hub-deploy" ]]; then
    printf 'hub-deploy: continuing with the promoted copy at %s\n' "${new:0:7}"
    if [[ -n "$approval_id" ]]; then exec env K3DM_HUB_DEPLOY_PREV="$old" "$REPO_ROOT/bin/k3dm-hub-deploy" "$new" --approval "$approval_id"; fi
    exec env K3DM_HUB_DEPLOY_PREV="$old" "$REPO_ROOT/bin/k3dm-hub-deploy" "$new"
  else stop handoff 1
  fi
else
  if new="$(remote_sha)"; then :; else code=$?; stop read-deploy-hub "$code"; fi
  if [[ "$new" != "$ref" ]] || ! checkout_ok; then
    printf 'hub-deploy: deploy/hub or the checkout moved from %s before the promoted copy ran; superseded\n' "${ref:0:7}" >&2
    stop superseded 1
  fi
fi
reapply=skipped
if [[ "$appsets" == full ]]; then
  printf 'appsets reapply owed after lost state\n'; reapply=ran
elif _run_command --soft -- git -C "$REPO_ROOT" diff --quiet "$appsets" "$new" -- scripts/etc/argocd/applicationsets/ 9>&-; then
  printf 'appsets unchanged between %s and %s; skipping reapply\n' "$appsets" "$new"
else
  diff_status=$?; [[ "$diff_status" == 1 ]] || stop diff "$diff_status"; reapply=ran
fi
if [[ "$reapply" == ran ]]; then
  if [[ -n "$approval_id" ]]; then superseded_file="$(mktemp "${TMPDIR:-/tmp}/k3dm-superseded.XXXXXX")"; if _run_command --soft -- make --no-print-directory -C "$REPO_ROOT" appsets-reapply "APPSETS_SHA=$new" "K3DM_SUPERSEDED_OUT=$superseded_file" 9>&-; then :; else code=$?; if [[ "$(head -n 1 "$superseded_file" 2>/dev/null | cut -d' ' -f1)" == superseded ]]; then printf 'hub-deploy: deploy/hub is now %s; approval %s moved it to %s and has been superseded; nothing more to deploy for it\n' "$(cut -d' ' -f2 "$superseded_file" | cut -c1-7)" "$approval_id" "${new:0:7}" >&2; stop superseded 1; fi; stop appsets-reapply "$code"; fi; rm -f -- "$superseded_file"; superseded_file=''
  elif _run_command --soft -- make --no-print-directory -C "$REPO_ROOT" appsets-reapply 9>&-; then :; else code=$?; stop appsets-reapply "$code"; fi
fi
appsets="$new"; write_state || stop state-write 1
for step in appsets-check platform-ops; do
  if [[ "$step" == platform-ops && -n "$approval_id" ]]; then superseded_file="$(mktemp "${TMPDIR:-/tmp}/k3dm-superseded.XXXXXX")"; if _run_command --soft -- make --no-print-directory -C "$REPO_ROOT" "$step" "PLATFORM_OPS_SHA=$new" "K3DM_SUPERSEDED_OUT=$superseded_file" 9>&-; then :; else code=$?; if [[ "$(head -n 1 "$superseded_file" 2>/dev/null | cut -d' ' -f1)" == superseded ]]; then printf 'hub-deploy: deploy/hub is now %s; approval %s moved it to %s and has been superseded; nothing more to deploy for it\n' "$(cut -d' ' -f2 "$superseded_file" | cut -c1-7)" "$approval_id" "${new:0:7}" >&2; stop superseded 1; fi; stop "$step" "$code"; fi; rm -f -- "$superseded_file"; superseded_file=''
  elif _run_command --soft -- make --no-print-directory -C "$REPO_ROOT" "$step" 9>&-; then :; else code=$?; stop "$step" "$code"; fi
done
pin_file="$HOME/.local/share/k3d-manager/repo-sync/deployed-platform-ops"
if [[ -r "$pin_file" ]] && pin="$(_run_command --soft -- cat "$pin_file" 9>&-)"; then :; else stop platform-ops-pin 1; fi
if [[ "$pin" != "$new" ]]; then
  printf 'hub-deploy: platform-ops applied %s, expected %s; deploy/hub has moved on; superseded\n' "${pin:0:7}" "${new:0:7}" >&2
  stop superseded 1
fi
if _run_command --soft -- kubectl --context "${INFRA_CONTEXT:-k3d-k3d-cluster}" -n platform-ops rollout status deploy/vulnerability-inventory-exporter --timeout=180s 9>&-; then :; else code=$?; stop rollout "$code"; fi

full=0
if [[ "$launchd" == full ]]; then
  full=1
  if paths="$(_run_command --soft -- git -C "$REPO_ROOT" ls-tree --name-only "$new" scripts/etc/launchd/ 9>&-)"; then :; else code=$?; stop launchd-diff "$code"; fi
else
  if paths="$(_run_command --soft -- git -C "$REPO_ROOT" diff --no-renames --name-only --diff-filter=AM "$launchd" "$new" -- scripts/etc/launchd/ 9>&-)"; then :; else code=$?; stop launchd-diff "$code"; fi
fi
candidates=("${pending[@]}")
while IFS= read -r path; do
  [[ "$path" == scripts/etc/launchd/com.k3d-manager.*.plist.tmpl ]] || continue
  name="${path##*/com.k3d-manager.}"; name="${name%.plist.tmpl}"
  found=0; for item in "${candidates[@]}"; do [[ "$item" != "$name" ]] || found=1; done
  [[ "$found" == 1 ]] || candidates+=("$name")
done <<< "$paths"
target_for() {
  case "$1" in
    hub-data-export) printf hub-data-export-schedule ;;
    hub-snapshot) printf snapshot-schedule ;;
    password-bundle) printf password-bundle-install ;;
    repo-sync|prometheus-credential-rotator|test-metrics|cleanup|node-health-watch|sandbox-reaper|vault-port-forward|prometheus-port-forward|hub-pushgateway-port-forward|hub-loki-port-forward|alertmanager-port-forward|alertmanager-auth-proxy|cloud-bridge) printf 'install-%s' "$1" ;;
    *) return 1 ;;
  esac
}
ready=(); pending=(); unwired=0
for name in "${candidates[@]}"; do
  path="scripts/etc/launchd/com.k3d-manager.$name.plist.tmpl"
  if ! _run_command --soft -- git -C "$REPO_ROOT" cat-file -e "$new:$path" 9>&-; then printf 'hub-deploy: launchd %s template removed; dropped\n' "$name"; continue; fi
  case "$name" in webhook-token-rotate|dispatch-stall-watch|dispatch-metrics)
    printf 'hub-deploy: launchd %s is excluded from automatic reinstall (scripts/etc/machine/not-installed.list); skipping\n' "$name"; continue;; esac
  plist="$HOME/Library/LaunchAgents/com.k3d-manager.$name.plist"
  if ! target_for "$name" >/dev/null; then
    if [[ -e "$plist" ]]; then printf 'hub-deploy: launchd %s changed and is installed, but no installer is wired; reinstall it with its setup command\n' "$name"; unwired=$((unwired+1)); fi
    continue
  fi
  if [[ ! -e "$plist" ]]; then [[ "$full" == 1 ]] || printf 'hub-deploy: launchd %s is not installed on this host; skipping\n' "$name"; continue; fi
  ready+=("$name"); pending+=("$name")
done
launchd="$new"; write_state || stop state-write 1
trap cleanup EXIT
plist_stamp() { if [[ "$(_run_command --soft -- uname -s 9>&-)" == Darwin ]]; then _run_command --soft -- /usr/bin/stat -f '%Fm %i' "$1" 9>&-; else _run_command --soft -- /usr/bin/stat -c '%.9Y %i' "$1" 9>&-; fi; }
ran=0
if ((${#ready[@]})); then
  if [[ "${K3DM_AGENT_LOAD:-}" == 0 ]]; then
    for name in "${ready[@]}"; do retry_hint "$name" 'agent load disabled (K3DM_AGENT_LOAD=0)'; done
  else
    deadline=$(( $(_run_command --soft -- date +%s 9>&-) + ${K3DM_HUB_DEPLOY_CHECKOUT_WAIT:-330} ))
    acquired=0
    while :; do
      if take_lock && checkout_ok; then acquired=1; break; fi
      release_lock
      now="$(_run_command --soft -- date +%s 9>&-)"; (( now < deadline )) || break
      delay=$((deadline-now)); (( delay <= 10 )) || delay=10
      _run_command --soft -- sleep "$delay" 9>&-
    done
    for name in "${ready[@]}"; do
      if [[ "$acquired" == 0 ]]; then retry_hint "$name:" "hub checkout is not at ${new:0:7} with a clean tracked tree"; continue; fi
      plist="$HOME/Library/LaunchAgents/com.k3d-manager.$name.plist"
      path="scripts/etc/launchd/com.k3d-manager.$name.plist.tmpl"
      reason=''
      _run_command --soft -- touch "$RS_DIR/lock" 9>&- || reason='checkout lock lost'
      [[ -r "$RS_DIR/lock/pid" && "$(_run_command --soft -- cat "$RS_DIR/lock/pid" 9>&-)" == "$$" ]] || reason='checkout lock lost'
      if [[ -z "$reason" ]] && ! checkout_ok; then reason='checkout moved during install'; fi
      if [[ -z "$reason" ]]; then
        actual="$(_run_command --soft -- git -C "$REPO_ROOT" hash-object "$path" 9>&-)" || actual=''
        expected="$(_run_command --soft -- git -C "$REPO_ROOT" rev-parse "$new:$path" 9>&-)" || expected=''
        [[ -n "$actual" && "$actual" == "$expected" ]] || reason='checkout moved during install'
      fi
      if [[ -z "$reason" ]]; then
        pre="$(plist_stamp "$plist")" || pre=absent
        target="$(target_for "$name")"
        ran=1
        if _run_command --soft -- env -u K3DM_AGENT_LOAD make --no-print-directory -C "$REPO_ROOT" "$target"; then code=0; else code=$?; fi
        if [[ "$code" != 0 ]]; then reason="install failed (exit $code)"
        elif [[ ! -r "$RS_DIR/lock/pid" || "$(_run_command --soft -- cat "$RS_DIR/lock/pid" 9>&-)" != "$$" ]]; then reason='checkout lock lost'
        elif ! checkout_ok; then reason='checkout moved during install'
        elif [[ "$(plist_stamp "$plist" || :)" == "$pre" || ! -e "$plist" ]]; then reason='plist not rewritten'
        elif ! _run_command --soft -- launchctl print "gui/$(_run_command --soft -- id -u 9>&-)/com.k3d-manager.$name" 9>&-; then reason='plist written but not loaded'; fi
      fi
      if [[ -n "$reason" ]]; then retry_hint "$name" "$reason"; continue; fi
      remaining=(); for item in "${pending[@]}"; do [[ "$item" == "$name" ]] || remaining+=("$item"); done
      pending=("${remaining[@]}"); write_state || stop state-write 1
    done
    release_lock
  fi
fi
if ((${#pending[@]})); then result="pending ${#pending[@]}"; printf 'hub-deploy: launchd pending: %s\n' "${pending[*]}" >&2
elif [[ "$ran" == 1 ]]; then result='ran 0'; else result='skipped 0'; fi
printf 'hub-deploy: deploy/hub %s..%s; reapply %s; appsets-check ok; platform-ops ok; exporter rolled out; launchd %s' "${old:0:7}" "${new:0:7}" "$reapply" "$result"
if (( unwired )); then printf '; launchd unwired %s' "$unwired"; fi
printf '\n'
