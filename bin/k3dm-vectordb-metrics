#!/usr/bin/env python3
"""Publish vectordb health facts to Prometheus Pushgateway."""

import json
import os
import re
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "scripts" / "lib"))
from hermes.prior_art import doc_meta  # noqa: E402
PUSH_RETRIES = 3
PUSH_SLEEP_SECONDS = 2
RELEASE_HISTORY = 5
PRIORITIES = ("P0", "P1", "P2", "P3", "unset")
STATES = ("open", "closed", "unknown")
_VERSION_RE = re.compile(r"^v(\d+)\.(\d+)\.(\d+)$")
_BRANCH_RE = re.compile(r"k3d-manager-(v\d+\.\d+\.\d+)$")


def _pushgateway_url():
    return os.environ.get("K3DM_VECTORDB_PUSHGATEWAY_URL", "http://localhost:19094").rstrip("/")


def _status():
    result = subprocess.run([str(ROOT / "bin" / "k3dm-vectordb-status"), "--json"],
                            cwd=ROOT, capture_output=True, text=True, timeout=120, check=False)
    if result.returncode != 0:
        return {}
    try:
        return json.loads(result.stdout)
    except (TypeError, ValueError, json.JSONDecodeError):
        return {}


def _metrics(payload):
    lines = []
    values = {
        "k3dm_vectordb_rows": payload.get("rows"),
        "k3dm_vectordb_corpus_docs": payload.get("corpus_docs"),
        "k3dm_vectordb_last_index_timestamp_seconds": payload.get("last_indexed_epoch"),
    }
    if values["k3dm_vectordb_rows"] is not None and values["k3dm_vectordb_corpus_docs"] is not None:
        values["k3dm_vectordb_drift_docs"] = (values["k3dm_vectordb_corpus_docs"] -
                                               values["k3dm_vectordb_rows"])
    if payload.get("available") is not None:
        values["k3dm_vectordb_reachable"] = int(bool(payload["available"]))
    if payload.get("external_secret_synced") is not None:
        values["k3dm_vectordb_external_secret_synced"] = int(
            bool(payload["external_secret_synced"]))
    for name, value in values.items():
        if value is not None:
            lines.append(f"{name} {value}")
    return "\n".join(lines) + "\n"


def publish(payload):
    metric_bytes = _metrics(payload).encode()
    pushgateway_url = _pushgateway_url()
    url = f"{pushgateway_url}/metrics/job/k3dm-vectordb"
    healthy_url = f"{pushgateway_url}/-/healthy"
    for attempt in range(1, PUSH_RETRIES + 1):
        try:
            with urllib.request.urlopen(healthy_url, timeout=2) as response:
                if response.status != 200:
                    raise RuntimeError(f"Pushgateway unhealthy (HTTP {response.status})")
            request = urllib.request.Request(
                url, data=metric_bytes, method="POST",
                headers={"Content-Type": "text/plain; charset=utf-8"},
            )
            urllib.request.urlopen(request, timeout=5)
            return True
        except Exception as exc:
            if attempt < PUSH_RETRIES:
                print(f"vectordb metrics push attempt {attempt}/{PUSH_RETRIES} failed: {exc}",
                      file=sys.stderr)
                time.sleep(PUSH_SLEEP_SECONDS)
            else:
                print(f"vectordb metrics push skipped (non-fatal): {exc}", file=sys.stderr)
    return False


def _bug_metrics(root, ref=None):
    """Return a complete bug inventory snapshot, or raise on any read/parse failure."""
    root = Path(root)
    if ref:
        listing = subprocess.run(["git", "-C", str(root), "ls-tree", "-r", "--name-only", ref,
                                  "docs/bugs"], capture_output=True, text=True, check=True)
        paths = [p for p in listing.stdout.splitlines()
                 if p.startswith("docs/bugs/") and "/" not in p[len("docs/bugs/"):]]
        texts = {p: subprocess.run(["git", "-C", str(root), "show", f"{ref}:{p}"],
                                   capture_output=True, text=True, check=True).stdout for p in paths}
    else:
        paths = sorted(p.relative_to(root).as_posix() for p in (root / "docs/bugs").glob("*.md"))
        texts = {p: (root / p).read_text(encoding="utf-8") for p in paths}
    counts = {(priority, state): 0 for priority in ("P0", "P1", "P2", "P3", "unset")
              for state in ("open", "closed", "unknown")}
    for text in texts.values():
        priority, state = doc_meta(text)
        counts[(priority, state)] += 1
    lines = [f'k3dm_bug_docs{{priority="{priority}",state="{state}"}} {counts[(priority, state)]}'
             for priority, state in counts]
    lines.append(f"k3dm_bug_docs_scan_timestamp_seconds {time.time()}")
    return "\n".join(lines) + "\n"


def _version(name):
    match = _VERSION_RE.match(name or "")
    return tuple(int(part) for part in match.groups()) if match else None


def _git_out(root, *args):
    return subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True,
                          check=True, timeout=60).stdout


def _current_release(root, ref):
    name = ref.removeprefix("origin/") if ref != "HEAD" else _git_out(root, "branch", "--show-current").strip()
    match = _BRANCH_RE.search(name)
    return match.group(1) if match else None


def _release_metrics(root, ref=None):
    """Bug docs per release for the current release branch and the shipped releases before it."""
    root = Path(root)
    ref = ref or "HEAD"
    result = subprocess.run([sys.executable, str(root / "scripts" / "bug-tally.py"), "--json", "--ref", ref],
                            cwd=root, capture_output=True, text=True, check=True, timeout=90)
    tally = json.loads(result.stdout)["releases"]
    current = _current_release(root, ref)
    shipped = sorted((tag for tag in _git_out(root, "tag", "--list", "v*", "--merged", ref).split()
                      if _version(tag) and (current is None or _version(tag) < _version(current))),
                     key=_version)[-RELEASE_HISTORY:]
    releases = shipped + ([current] if current else [])
    lines = []
    for order, release in enumerate(releases):
        by_priority = (tally.get(release) or {}).get("by_priority", {})
        for priority in PRIORITIES:
            counts = by_priority.get(priority, {})
            for state in STATES:
                lines.append(f'k3dm_bug_release_docs{{release="{release}",order="{order}",priority="{priority}",'
                             f'state="{state}"}} {int(counts.get(state, 0))}')
    if current:
        lines.append(f'k3dm_bug_current_release_info{{release="{current}"}} 1')
        later = {priority: 0 for priority in PRIORITIES}
        for release, data in tally.items():
            if _version(release) and _version(release) > _version(current):
                for priority in PRIORITIES:
                    later[priority] += int(data.get("by_priority", {}).get(priority, {}).get("open", 0))
        lines.extend(f'k3dm_bug_later_release_open_docs{{priority="{priority}"}} {count}'
                     for priority, count in later.items())
    return "\n".join(lines) + "\n"


def publish_bug_metrics(root, ref=None):
    try:
        payload = _bug_metrics(root, ref)
    except Exception as exc:
        print(f"bug metrics scan skipped (non-fatal): {exc}", file=sys.stderr)
        return False
    pushed = _push_bug_group("k3dm-bug-docs", payload)
    try:
        releases = _release_metrics(root, ref)
    except Exception as exc:
        print(f"bug release metrics skipped (non-fatal): {exc}", file=sys.stderr)
        return pushed
    _push_bug_group("k3dm-bug-releases", releases)
    return pushed


def _push_bug_group(job, payload):
    base = _pushgateway_url()
    healthy_url = f"{base}/-/healthy"
    url = f"{base}/metrics/job/{job}"
    for attempt in range(1, PUSH_RETRIES + 1):
        try:
            with urllib.request.urlopen(healthy_url, timeout=2) as response:
                if response.status != 200:
                    raise RuntimeError(f"Pushgateway unhealthy (HTTP {response.status})")
            request = urllib.request.Request(url, data=payload.encode(), method="POST",
                                             headers={"Content-Type": "text/plain; charset=utf-8"})
            urllib.request.urlopen(request, timeout=5)
            return True
        except Exception as exc:
            if attempt < PUSH_RETRIES:
                print(f"bug metrics push attempt {attempt}/{PUSH_RETRIES} failed: {exc}", file=sys.stderr)
                time.sleep(PUSH_SLEEP_SECONDS)
            else:
                print(f"bug metrics push skipped (non-fatal): {exc}", file=sys.stderr)
    return False


def main():
    publish(_status())
    publish_bug_metrics(ROOT, os.environ.get("K3DM_INDEX_REF"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
