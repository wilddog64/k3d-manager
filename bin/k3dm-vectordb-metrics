#!/usr/bin/env python3
"""Publish vectordb health facts to Prometheus Pushgateway."""

import json
import os
import re
import subprocess
import sys
import time
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "scripts" / "lib"))
from hermes.prior_art import doc_meta, doc_status, doc_verification  # noqa: E402
PUSH_RETRIES = 3
PUSH_SLEEP_SECONDS = 2
RELEASE_HISTORY = 5
PRIORITIES = ("P0", "P1", "P2", "P3", "unset")
STATES = ("open", "closed", "unknown")
_VERSION_RE = re.compile(r"^v(\d+)\.(\d+)\.(\d+)$")
_BRANCH_RE = re.compile(r"k3d-manager-(v\d+\.\d+\.\d+)$")
_SCAN_BRANCH_RE = re.compile(r"^[A-Za-z0-9._/-]{1,100}$")
_BUG_STEM_RE = re.compile(r"^[A-Za-z0-9._-]{1,120}$")
_FILED_RE = re.compile(r"^\*\*Filed:\*\*\s*(\d{4}-\d{2}-\d{2})\s*$", re.MULTILINE)
_HEADING_RE = re.compile(r"^#\s+(.+?)\s*$", re.MULTILINE)
STATUS_RANK = {"open": 0, "unknown": 1, "deferred": 2, "fixed": 3}


def _pushgateway_url():
    return os.environ.get("K3DM_VECTORDB_PUSHGATEWAY_URL", "http://localhost:19094").rstrip("/")


def _status():
    result = subprocess.run([str(ROOT / "bin" / "k3dm-vectordb-status"), "--json"],
                            cwd=ROOT, capture_output=True, text=True, timeout=120, check=False)
    if result.returncode != 0:
        return {}
    try:
        return json.loads(result.stdout)
    except (TypeError, ValueError, json.JSONDecodeError):
        return {}


def _metrics(payload):
    lines = []
    values = {
        "k3dm_vectordb_rows": payload.get("rows"),
        "k3dm_vectordb_corpus_docs": payload.get("corpus_docs"),
        "k3dm_vectordb_last_index_timestamp_seconds": payload.get("last_indexed_epoch"),
    }
    if values["k3dm_vectordb_rows"] is not None and values["k3dm_vectordb_corpus_docs"] is not None:
        values["k3dm_vectordb_drift_docs"] = (values["k3dm_vectordb_corpus_docs"] -
                                               values["k3dm_vectordb_rows"])
    if payload.get("available") is not None:
        values["k3dm_vectordb_reachable"] = int(bool(payload["available"]))
    if payload.get("external_secret_synced") is not None:
        values["k3dm_vectordb_external_secret_synced"] = int(
            bool(payload["external_secret_synced"]))
    for name, value in values.items():
        if value is not None:
            lines.append(f"{name} {value}")
    return "\n".join(lines) + "\n"


def publish(payload):
    metric_bytes = _metrics(payload).encode()
    pushgateway_url = _pushgateway_url()
    url = f"{pushgateway_url}/metrics/job/k3dm-vectordb"
    healthy_url = f"{pushgateway_url}/-/healthy"
    for attempt in range(1, PUSH_RETRIES + 1):
        try:
            with urllib.request.urlopen(healthy_url, timeout=2) as response:
                if response.status != 200:
                    raise RuntimeError(f"Pushgateway unhealthy (HTTP {response.status})")
            request = urllib.request.Request(
                url, data=metric_bytes, method="POST",
                headers={"Content-Type": "text/plain; charset=utf-8"},
            )
            urllib.request.urlopen(request, timeout=5)
            return True
        except Exception as exc:
            if attempt < PUSH_RETRIES:
                print(f"vectordb metrics push attempt {attempt}/{PUSH_RETRIES} failed: {exc}",
                      file=sys.stderr)
                time.sleep(PUSH_SLEEP_SECONDS)
            else:
                print(f"vectordb metrics push skipped (non-fatal): {exc}", file=sys.stderr)
    return False


def _bug_texts(root, ref=None):
    root = Path(root)
    if ref:
        listing = subprocess.run(["git", "-C", str(root), "ls-tree", "-r", "--name-only", ref,
                                  "docs/bugs"], capture_output=True, text=True, check=True)
        paths = [p for p in listing.stdout.splitlines()
                 if p.startswith("docs/bugs/") and "/" not in p[len("docs/bugs/"):]]
        request = "".join(f"{ref}:{p}\n" for p in paths).encode()
        blob = subprocess.run(["git", "-C", str(root), "cat-file", "--batch"], input=request,
                              capture_output=True, check=True, timeout=60).stdout
        texts = {}
        offset = 0
        for p in paths:
            header_end = blob.index(b"\n", offset)
            header = blob[offset:header_end].split()
            if len(header) != 3 or header[1] != b"blob":
                raise RuntimeError(f"git cat-file: unexpected header for {p}: {blob[offset:header_end]!r}")
            start = header_end + 1
            size = int(header[2])
            texts[p] = blob[start:start + size].decode("utf-8")
            offset = start + size + 1
    else:
        paths = sorted(p.relative_to(root).as_posix() for p in (root / "docs/bugs").glob("*.md"))
        texts = {p: (root / p).read_text(encoding="utf-8") for p in paths}
    return texts


def _bug_metrics(root, ref=None, texts=None):
    """Return a complete bug inventory snapshot, or raise on any read/parse failure."""
    texts = _bug_texts(root, ref) if texts is None else texts
    counts = {(priority, state): 0 for priority in ("P0", "P1", "P2", "P3", "unset")
              for state in ("open", "closed", "unknown")}
    for text in texts.values():
        priority, state = doc_meta(text)
        counts[(priority, state)] += 1
    lines = [f'k3dm_bug_docs{{priority="{priority}",state="{state}"}} {counts[(priority, state)]}'
             for priority, state in counts]
    lines.append(f"k3dm_bug_docs_scan_timestamp_seconds {time.time()}")
    return "\n".join(lines) + "\n"


def _scan_branch(root, ref=None):
    name = ref.removeprefix("origin/") if ref and ref != "HEAD" else ""
    if not name:
        try:
            name = _git_out(root, "branch", "--show-current").strip()
        except Exception:
            name = ""
    return name if _SCAN_BRANCH_RE.fullmatch(name) else ""


def _release_order(release):
    match = re.fullmatch(r"v(\d+)\.(\d+)\.(\d+)", release)
    if not match:
        return "9999.9999.9999 unassigned"
    return ".".join(f"{9999 - int(part):04d}" for part in match.groups()) + f" {release}"


def _release_at_least(release, minimum):
    version = _version(release)
    return version is not None and version >= minimum


def _bug_status_metrics(root, ref=None, now=None, tally=None, texts=None):
    root = Path(root)
    branch = _scan_branch(root, ref)
    now = now or datetime.now(timezone.utc)
    if now.tzinfo is None:
        now = now.replace(tzinfo=timezone.utc)
    release_of = {item["path"]: release
                  for release, data in (tally or {}).items()
                  for path_key in ("open_paths", "unknown_paths", "closed_paths")
                  for item in data.get(path_key, [])}
    rows = []
    skipped = 0
    texts = _bug_texts(root, ref) if texts is None else texts
    for path, text in texts.items():
        priority, status, _live_verified = doc_status(text)
        verification = doc_verification(text)
        stem = Path(path).name.removesuffix(".md")
        if not _BUG_STEM_RE.fullmatch(stem):
            skipped += 1
            continue
        filed_match = _FILED_RE.search(text)
        filed = filed_match.group(1) if filed_match else ""
        if not filed:
            prefix = re.match(r"^(\d{4}-\d{2}-\d{2})", stem)
            filed = prefix.group(1) if prefix else ""
        release = release_of.get(path, "unassigned")
        if not isinstance(release, str) or not _VERSION_RE.fullmatch(release):
            release = "unassigned"
        heading = _HEADING_RE.search(text)
        if heading:
            title = re.sub(r"^Bug:\s*", "", heading.group(1).strip())
            title = re.sub(r"[`*]", "", title)
            title = re.sub(r'["\\\t\r\n]+', " ", title)
            title = re.sub(r"\s+", " ", title).strip()
        else:
            title = re.sub(r"^\d{4}-\d{2}-\d{2}-?", "", stem).replace("-", " ").strip()
        if len(title) > 120:
            title = title[:119] + "…"
        verified = None
        live_verified = None
        if status == "fixed":
            verified = "true" if verification in ("verified", "live") else "false"
            live_verified = "true" if verification == "live" else "false"
            if not _release_at_least(release, (1, 43, 2)):
                verified = "n/a"
                live_verified = "n/a"
            value = -2
        elif filed:
            value = (now.date() - datetime.strptime(filed, "%Y-%m-%d").date()).days
        else:
            value = -1
        sort_key = f"{_release_order(release)} {STATUS_RANK[status]} {priority} {filed or '9999-99-99'} {stem}"
        rows.append((sort_key, priority, title, filed, stem, value, branch, release, status, verified,
                     live_verified))
    rows.sort(key=lambda row: row[0])
    truncated = int(len(rows) > 1000)
    aggregates = {}
    for _sort_key, priority, _title, _filed, _stem, _value, _branch, release, status, verified, live_verified in rows:
        key = (release, priority, status, verified, live_verified)
        aggregates[key] = aggregates.get(key, 0) + 1
    lines = []
    for sort_key, priority, title, filed, stem, value, scan_branch, release, status, verified, live_verified in rows[:1000]:
        labels = (f'priority="{priority}",title="{title}",filed="{filed}",bug="{stem}",'
                  f'sort_key="{sort_key}",branch="{scan_branch}",release="{release}",'
                  f'status="{status}",release_order="{_release_order(release)}"')
        if verified is not None:
            labels += f',verified="{verified}"'
            labels += f',live_verified="{live_verified}"'
        lines.append(f"k3dm_bug_info{{{labels}}} {value}")
    def aggregate_key(item):
        release, priority, status, verified, live_verified = item[0]
        return (release, PRIORITIES.index(priority), STATUS_RANK[status], verified or "", live_verified or "")
    for (release, priority, status, verified, live_verified), count in sorted(aggregates.items(), key=aggregate_key):
        labels = f'release="{release}",priority="{priority}",status="{status}"'
        if verified is not None:
            labels += f',verified="{verified}"'
            labels += f',live_verified="{live_verified}"'
        lines.append(f"k3dm_bug_status_docs{{{labels}}} {count}")
    lines.append(f"k3dm_bug_info_skipped {skipped}")
    lines.append(f"k3dm_bug_info_truncated {truncated}")
    return "\n".join(lines) + "\n"


def _version(name):
    match = _VERSION_RE.match(name or "")
    return tuple(int(part) for part in match.groups()) if match else None


def _git_out(root, *args):
    return subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True,
                          check=True, timeout=60).stdout


def _current_release(root, ref):
    name = _scan_branch(root, ref)
    match = _BRANCH_RE.search(name)
    return match.group(1) if match else None


def _tally(root, ref=None):
    root = Path(root)
    result = subprocess.run([sys.executable, str(root / "scripts" / "bug-tally.py"), "--json", "--ref", ref or "HEAD"],
                            cwd=root, capture_output=True, text=True, check=True, timeout=90)
    return json.loads(result.stdout)["releases"]


def _release_metrics(root, ref=None, tally=None):
    """Bug docs per release for the current release branch and the shipped releases before it."""
    root = Path(root)
    ref = ref or "HEAD"
    tally = tally if tally is not None else _tally(root, ref)
    current = _current_release(root, ref)
    shipped = sorted((tag for tag in _git_out(root, "tag", "--list", "v*", "--merged", ref).split()
                      if _version(tag) and (current is None or _version(tag) < _version(current))),
                     key=_version)[-RELEASE_HISTORY:]
    releases = shipped + ([current] if current else [])
    lines = []
    for order, release in enumerate(releases):
        by_priority = (tally.get(release) or {}).get("by_priority", {})
        for priority in PRIORITIES:
            counts = by_priority.get(priority, {})
            for state in STATES:
                lines.append(f'k3dm_bug_release_docs{{release="{release}",order="{order}",priority="{priority}",'
                             f'state="{state}"}} {int(counts.get(state, 0))}')
    if current:
        lines.append(f'k3dm_bug_current_release_info{{release="{current}"}} 1')
        later = {priority: 0 for priority in PRIORITIES}
        for release, data in tally.items():
            if _version(release) and _version(release) > _version(current):
                for priority in PRIORITIES:
                    later[priority] += int(data.get("by_priority", {}).get(priority, {}).get("open", 0))
        lines.extend(f'k3dm_bug_later_release_open_docs{{priority="{priority}"}} {count}'
                     for priority, count in later.items())
    return "\n".join(lines) + "\n"


def publish_bug_metrics(root, ref=None):
    try:
        texts = _bug_texts(root, ref)
        payload = _bug_metrics(root, ref, texts=texts)
    except Exception as exc:
        print(f"bug metrics scan skipped (non-fatal): {exc}", file=sys.stderr)
        return False
    pushed = _push_bug_group("k3dm-bug-docs", payload)
    try:
        tally = _tally(root, ref)
    except Exception as exc:
        print(f"bug tally skipped (non-fatal): {exc}", file=sys.stderr)
        tally = None
    try:
        open_bugs = _bug_status_metrics(root, ref, tally=tally, texts=texts)
        _push_bug_group("k3dm-bug-open", open_bugs, method="PUT")
    except Exception as exc:
        print(f"open bug metrics skipped (non-fatal): {exc}", file=sys.stderr)
    if tally is None:
        print("bug release metrics skipped (non-fatal): no tally", file=sys.stderr)
        return pushed
    try:
        releases = _release_metrics(root, ref, tally=tally)
    except Exception as exc:
        print(f"bug release metrics skipped (non-fatal): {exc}", file=sys.stderr)
        return pushed
    _push_bug_group("k3dm-bug-releases", releases)
    return pushed


def _push_bug_group(job, payload, method="POST"):
    base = _pushgateway_url()
    healthy_url = f"{base}/-/healthy"
    url = f"{base}/metrics/job/{job}"
    for attempt in range(1, PUSH_RETRIES + 1):
        try:
            with urllib.request.urlopen(healthy_url, timeout=2) as response:
                if response.status != 200:
                    raise RuntimeError(f"Pushgateway unhealthy (HTTP {response.status})")
            request = urllib.request.Request(url, data=payload.encode(), method=method,
                                             headers={"Content-Type": "text/plain; charset=utf-8"})
            urllib.request.urlopen(request, timeout=5)
            return True
        except Exception as exc:
            if attempt < PUSH_RETRIES:
                print(f"bug metrics push attempt {attempt}/{PUSH_RETRIES} failed: {exc}", file=sys.stderr)
                time.sleep(PUSH_SLEEP_SECONDS)
            else:
                print(f"bug metrics push skipped (non-fatal): {exc}", file=sys.stderr)
    return False


def main():
    publish(_status())
    publish_bug_metrics(ROOT, os.environ.get("K3DM_INDEX_REF"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
