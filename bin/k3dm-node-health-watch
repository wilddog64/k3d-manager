#!/usr/bin/env bash
# Bounded k3d agent recovery watchdog. It only restarts the configured agent
# after the node stays NotReady (the node controller's authoritative verdict)
# across the failure threshold plus a cooldown; a Ready-but-slow /healthz is
# advisory only and never triggers a restart (a slow node under CPU pressure is
# alive, and bouncing it evicts pods and adds load). Keep it disabled when
# running manually unless K3DM_NODE_RECOVERY_ENABLED=1 is explicitly set.
set -u

export PATH="/opt/homebrew/bin:/usr/local/bin:${PATH}"

context="${K3DM_NODE_RECOVERY_CONTEXT:-k3d-k3d-cluster}"
node="${K3DM_NODE_RECOVERY_NODE:-k3d-k3d-cluster-agent-0}"
interval="${K3DM_NODE_RECOVERY_INTERVAL:-30}"
threshold="${K3DM_NODE_RECOVERY_FAILURE_THRESHOLD:-5}"
cooldown="${K3DM_NODE_RECOVERY_COOLDOWN:-300}"
healthz_timeout="${K3DM_NODE_RECOVERY_HEALTHZ_TIMEOUT:-15s}"
enabled="${K3DM_NODE_RECOVERY_ENABLED:-0}"
log_file="${K3DM_NODE_RECOVERY_LOG:-${HOME}/.local/share/k3d-manager/logs/node-health-watch.log}"
state_file="${K3DM_NODE_RECOVERY_STATE:-${HOME}/.local/share/k3d-manager/node-health-watch.state}"

mkdir -p "$(dirname "$log_file")" "$(dirname "$state_file")"

_log() { printf '[%s] %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >>"$log_file"; }

_healthy() {
  kubectl --context "$context" get --raw "/api/v1/nodes/${node}/proxy/healthz" \
    --request-timeout="$healthz_timeout" 2>/dev/null | grep -qx 'ok'
}

_ready() {
  kubectl --context "$context" get node "$node" \
    -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' \
    --request-timeout=5s 2>/dev/null | grep -qx 'True'
}

_recover() {
  local last=0 now container_status recovery_command
  [[ "$enabled" == 1 ]] || { _log "agent unhealthy (recovery disabled)"; return 0; }
  last="$(cat "$state_file" 2>/dev/null || echo 0)"
  now="$(date +%s)"
  (( now - last >= cooldown )) || { _log "agent unhealthy (recovery cooldown active)"; return 0; }
  container_status="$(docker inspect -f '{{.State.Status}}' "$node" 2>/dev/null || true)"
  case "$container_status" in
    running) recovery_command="restart" ;;
    created|exited|paused) recovery_command="start" ;;
    "") _log "agent container ${node} not found; no restart attempted"; return 0 ;;
    *) _log "agent container ${node} has unexpected state ${container_status}; no restart attempted"; return 0 ;;
  esac
  printf '%s\n' "$now" >"$state_file"
  _log "${recovery_command}ing ${node} after ${threshold} consecutive kubelet-proxy failures"
  "${DOCKER_BIN:-docker}" "$recovery_command" "$node" >>"$log_file" 2>&1 || { _log "${recovery_command} failed"; return 1; }
  for _ in {1..20}; do
    _ready && _healthy && { _log "${node} recovered"; return 0; }
    sleep 5
  done
  _log "${node} did not recover within 100s"
  return 1
}

failures=0
while :; do
  if _ready; then
    failures=0
    _healthy || _log "${node} Ready but /healthz slow/unreachable (advisory, no restart)"
  else
    failures=$((failures + 1))
    _log "${node} NotReady (${failures}/${threshold})"
    if (( failures >= threshold )); then
      _recover || true
      failures=0
    fi
  fi
  sleep "$interval"
done
