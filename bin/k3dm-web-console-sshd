#!/bin/bash
function _wc_main_env() {
  PATH=/usr/bin:/bin:/usr/sbin:/sbin
  unset -f sudo
}

function _wc_sources() {
  _WC_CONFIG_TEMPLATE=scripts/etc/ssh/k3dm-web-console_sshd_config.tmpl
  _WC_PLIST_TEMPLATE="scripts/etc/launchd/${_WC_LABEL}.plist.tmpl"
  _WC_STUB_SOURCE=scripts/libexec/k3dm-console-forced-command
  local paths=(bin/k3dm-web-console-sshd scripts/lib/web_console_common.sh scripts/lib/system.sh
    scripts/lib/foundation/scripts/lib/system.sh scripts/lib/agent_rigor.sh
    "$_WC_CONFIG_TEMPLATE" "$_WC_PLIST_TEMPLATE" "$_WC_STUB_SOURCE")
  local file blob
  { _wc_tool /Library/Developer/CommandLineTools/usr/bin/git ls-files --error-unmatch -- "${paths[@]}" >/dev/null 2>&1 &&
    _wc_tool /Library/Developer/CommandLineTools/usr/bin/git diff --quiet HEAD -- "${paths[@]}"; } || {
      _wc_message 'sources differ from HEAD; commit or discard first'; return 9
    }
  for file in "${paths[@]}"; do
    blob=$(_wc_tool /Library/Developer/CommandLineTools/usr/bin/git rev-parse "HEAD:$file") || return 9
    printf '%s %s\n' "$blob" "$file"
  done
}

function _wc_render() {
  local rendered="$1" port="$2" login="$3" expected
  local -a lines=(
    "ListenAddress 127.0.0.1:$port"
    "AddressFamily inet"
    "HostKey /etc/k3dm-web-console/ssh_host_ed25519_key"
    "PidFile none"
    "UsePAM no"
    "PasswordAuthentication no"
    "KbdInteractiveAuthentication no"
    "PermitEmptyPasswords no"
    "HostbasedAuthentication no"
    "GSSAPIAuthentication no"
    "PermitRootLogin no"
    "PubkeyAuthentication yes"
    "AuthenticationMethods publickey"
    "TrustedUserCAKeys /etc/k3dm-web-console/access_ca.pub"
    "RevokedKeys /etc/k3dm-web-console/revoked_keys"
    "AuthorizedKeysFile none"
    "AllowUsers $login"
    "DisableForwarding yes"
    "AllowTcpForwarding no"
    "AllowAgentForwarding no"
    "AllowStreamLocalForwarding no"
    "GatewayPorts no"
    "PermitTunnel no"
    "X11Forwarding no"
    "PermitUserRC no"
    "PermitUserEnvironment no"
    "PermitListen none"
    "PermitOpen none"
    "PermitTTY yes"
    "ForceCommand /Library/PrivilegedHelperTools/k3dm-web-console/forced-command"
    "SetEnv ZDOTDIR=/etc/k3dm-web-console/zdotdir"
    "MaxAuthTries 3"
    "MaxSessions 1"
    "MaxStartups 3:50:10"
    "LoginGraceTime 30"
    "LogLevel VERBOSE"
    "ClientAliveInterval 300"
    "ClientAliveCountMax 3"
    "StrictModes yes"
    "UseDNS no"
  )
  [[ "$port" =~ ^[0-9]+$ && "$login" =~ ^[a-z_][a-z0-9_-]*$ && "$login" != root ]] || return 2
  rendered="${rendered//\{\{CONSOLE_PORT\}\}/$port}"
  rendered="${rendered//\{\{CONSOLE_USER\}\}/$login}"
  printf -v expected '%s\n' "${lines[@]}"
  [[ "$rendered" = "$expected" ]] || return 4
  printf '%s' "$rendered"
}

function _wc_port_valid() {
  local port="$1" decimal reason
  if [[ -z "$port" ]]; then reason='empty value'
  elif [[ ! "$port" =~ ^[0-9]+$ ]]; then reason='not a decimal port'
  else
    decimal="${port#"${port%%[!0]*}"}"
    if [[ -z "$decimal" || ${#decimal} -gt 5 ]] || (( 10#$decimal < 1024 || 10#$decimal > 49151 )); then
      reason='outside 1024-49151'
    else
      case "$decimal" in 22[0-9][0-9]|2022|8022|10222|22222|32222) reason='reserved SSH alternate' ;; *) return 0 ;; esac
    fi
  fi
  _wc_message "refusing port $port: $reason"
  return 2
}

function _wc_identity() {
  local record path
  [[ "$(_wc_tool /usr/bin/uname -s)" = Darwin ]] || { _wc_message 'macOS is required'; return 2; }
  (( EUID != 0 )) || { _wc_message 'run as the operator user, not root'; return 2; }
  _WC_LOGIN=$(_wc_tool /usr/bin/id -un) || return 2
  [[ "$_WC_LOGIN" =~ ^[a-z_][a-z0-9_-]*$ && "$_WC_LOGIN" != root ]] || return 2
  record=$(_wc_tool /usr/bin/id -P) || return 2
  [[ "${record##*:}" = /bin/zsh ]] || { _wc_message 'login shell must be /bin/zsh'; return 2; }
  for path in /etc/zshenv /etc/zshenv.zwc /etc/ssh/sshrc; do
    [[ ! -e "$_WC_PREFIX$path" && ! -L "$_WC_PREFIX$path" ]] ||
      { _wc_message "$path exists; the trusted entry needs it absent"; return 2; }
  done
}

function _wc_ca_read() {
  local line type bits digest details count=0 fingerprint
  _WC_CA=
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
    read -r type _ <<< "$line"
    case "$type" in ssh-ed25519|ecdsa-sha2-nistp256|ecdsa-sha2-nistp384|ecdsa-sha2-nistp521|ssh-rsa) ;; *) return 2 ;; esac
    count=$((count+1))
    _WC_CA="$line"$'\n'
  done
  (( count == 1 )) || return 2
  fingerprint=$(printf '%s' "$_WC_CA" | _wc_tool /usr/bin/ssh-keygen -l -f - 2>/dev/null) || return 2
  [[ "$fingerprint" != *$'\n'* ]] || return 2
  read -r bits digest details <<< "$fingerprint"
  type="${details##* }"
  [[ "$bits" =~ ^[0-9]+$ && "$digest" =~ ^SHA256:[A-Za-z0-9+/=]+$ && "$type" =~ ^\([A-Z0-9_-]+\)$ ]] || return 2
  printf '%s %s %s\n' "$bits" "$digest" "$type"
}

function _wc_emit() {
  local level="$1" id="$2" text="$3"
  [[ "$level" != WARN || "$strict" != 1 ]] || level=FAIL
  [[ "$level" != FAIL ]] || failures=1
  printf '%s %s %s\n' "$level" "$id" "$text"
}

function _wc_file_mode() {
  local dest="$1" expected="$2" actual
  _wc_trust_check "$dest" >/dev/null 2>&1 || return 1
  actual=$(_wc_tool /usr/bin/stat -f '%u:%g:%Lp' "$_WC_PREFIX$dest") || return 1
  [[ "$actual" = "0:0:$expected" ]]
}

function _wc_trust_install() {
  local path
  for path in / /etc /var /private /private/etc /Library /Library/LaunchDaemons /Library/PrivilegedHelperTools /private/var /private/var/db /private/var/log; do
    _wc_trust_check "$path" || return 8
  done
  for path in "$_WC_CONF_DIR" "$_WC_CONF_DIR/zdotdir" "$_WC_HELPER_DIR" "$_WC_CONF_DIR/.prev" "$_WC_HELPER_DIR/.prev"; do
    if [[ -e "$_WC_PREFIX$path" || -L "$_WC_PREFIX$path" ]]; then
      [[ -d "$_WC_PREFIX$path" ]] && _wc_trust_check "$path" || return 8
    fi
  done
  # shellcheck disable=SC2153 # _WC_LOG is assigned by web_console_common.sh.
  _wc_dest_check "$_WC_LOG" "$_WC_LAUNCHD_DIR/${_WC_LABEL}.plist" "$_WC_JOURNAL" \
    "$_WC_CONF_DIR"/{manifest,access_ca.pub,ssh_host_ed25519_key,ssh_host_ed25519_key.pub,sshd_config,revoked,revoked_keys,launchd.plist.pending,launchd.plist.revoked} \
    "$_WC_HELPER_DIR"/{forced-command,forced-command.stub}
}

function _wc_blob() {
  _wc_tool /Library/Developer/CommandLineTools/usr/bin/git cat-file blob "HEAD:$1" && printf '.'
}

function _wc_check_config() {
  local template rendered actual effective line listens=0 setenvs=0
  template=$(_wc_blob scripts/etc/ssh/k3dm-web-console_sshd_config.tmpl) || return 1
  rendered=$(_wc_render "${template%.}" "$port" "$_WC_LOGIN" && printf '.') || return 1
  IFS= read -r -d '' actual < "$_WC_PREFIX$_WC_CONF_DIR/sshd_config" && return 1
  [[ "$actual." = "$rendered" ]] || return 1
  effective=$(_wc_tool /usr/sbin/sshd -G -f "$_WC_PREFIX$_WC_CONF_DIR/sshd_config" 2>/dev/null) || return 1
  while IFS= read -r line; do
    case "$line" in
      'listenaddress '*) [[ "$line" = "listenaddress 127.0.0.1:$port" ]] || return 1; listens=$((listens+1));;
      'setenv '*) [[ "$line" = "setenv ZDOTDIR=/etc/k3dm-web-console/zdotdir" ]] || return 1; setenvs=$((setenvs+1));;
    esac
  done <<< "$effective"
  (( listens == 1 && setenvs == 1 ))
}

function _wc_job_running() {
  local output line inargs=0 state=0 args=()
  output=$(_wc_tool /bin/launchctl print "system/${_WC_LABEL}" 2>/dev/null) || return 1
  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"
    case "$line" in
      'state = running') state=1 ;;
      'arguments = {') inargs=1 ;;
      '}') inargs=0 ;;
      *) (( ! inargs )) || args+=("$line") ;;
    esac
  done <<< "$output"
  (( state && ${#args[@]} == 5 )) && [[ "${args[*]}" = '/usr/sbin/sshd -D -e -f /etc/k3dm-web-console/sshd_config' ]]
}

function _wc_digest() {
  _wc_hash_stdin < "$_WC_PREFIX$1"
}

function _wc_manifest_row() {
  local findpath="$1" digest path part source extra found=0 actual
  [[ -r "$_WC_PREFIX$_WC_CONF_DIR/manifest" ]] || return 1
  actual=$(_wc_digest "$findpath") || return 1
  while read -r digest path part source extra; do
    [[ "$path" = "$findpath" ]] || continue
    [[ -z "$extra" && "$digest" = "$actual" ]] || return 1
    case "$part" in A|C) ;; *) return 1 ;; esac
    found=$((found+1)); row_part="$part"; row_source="$source"
  done < "$_WC_PREFIX$_WC_CONF_DIR/manifest"
  (( found == 1 ))
}

function _wc_gate_healthy() {
  local dest="$_WC_HELPER_DIR/forced-command" stub="$_WC_HELPER_DIR/forced-command.stub"
  local row_part row_source gate_source gate_hash stub_hash
  _wc_file_mode "$dest" 755 && _wc_manifest_row "$dest" || return 1
  [[ "$row_part" != C ]] || return 0
  gate_source="$row_source"
  _wc_manifest_row "$stub" || return 1
  gate_hash=$(_wc_digest "$dest") && stub_hash=$(_wc_digest "$stub") || return 1
  [[ "$row_part" = A && "$gate_source" = "$row_source" && "$gate_hash" = "$stub_hash" ]]
}

function _wc_files_healthy() {
  local path hash part source extra mode row_part row_source
  _wc_trust_install || return 1
  for path in "$_WC_CONF_DIR"/{revoked,launchd.plist.pending,launchd.plist.revoked}; do
    [[ ! -e "$_WC_PREFIX$path" ]] || return 1
  done
  for path in "$_WC_CONF_DIR" "$_WC_HELPER_DIR" "$_WC_CONF_DIR/zdotdir" "$_WC_CONF_DIR/.prev" "$_WC_HELPER_DIR/.prev"; do
    mode=755; [[ "${path##*/}" != .prev ]] || mode=700
    [[ -d "$_WC_PREFIX$path" ]] && _wc_file_mode "$path" "$mode" || return 1
  done
  _wc_file_mode "$_WC_CONF_DIR/manifest" 644 && _wc_file_mode "$_WC_LOG" 600 && _wc_file_mode "$_WC_CONF_DIR/ssh_host_ed25519_key" 600 || return 1
  _wc_file_mode "$_WC_CONF_DIR/revoked_keys" 644 || return 1
  for path in "$_WC_CONF_DIR"/{sshd_config,access_ca.pub,ssh_host_ed25519_key.pub} "$_WC_LAUNCHD_DIR/${_WC_LABEL}.plist" "$_WC_HELPER_DIR"/{forced-command,forced-command.stub}; do
    mode=644; [[ "${path%/*}" != "$_WC_HELPER_DIR" ]] || mode=755
    _wc_file_mode "$path" "$mode" && _wc_manifest_row "$path" || return 1
    [[ "$row_part" = A || "$path" = "$_WC_HELPER_DIR/forced-command" ]] || return 1
  done
  while read -r hash path part source extra; do
    case "$path" in "$_WC_CONF_DIR"/*|"$_WC_HELPER_DIR"/*|"$_WC_LAUNCHD_DIR"/*.plist) ;; *) return 1 ;; esac
    [[ "$path" != */../* && -z "$extra" && -n "$source" ]] && _wc_manifest_row "$path" || return 1
    if [[ "$part" = A ]]; then
      case "$path" in "$_WC_CONF_DIR"/sshd_config|"$_WC_CONF_DIR"/access_ca.pub|"$_WC_CONF_DIR"/ssh_host_ed25519_key.pub|"$_WC_LAUNCHD_DIR/${_WC_LABEL}.plist"|"$_WC_HELPER_DIR"/forced-command|"$_WC_HELPER_DIR"/forced-command.stub) ;; *) return 1 ;; esac
    fi
  done < "$_WC_PREFIX$_WC_CONF_DIR/manifest"
}

function _wc_system_graph() {
  local file="$1" depth="$2" line keyword arg glob match found
  (( depth <= 16 )) && [[ -r "$file" ]] || return 1
  local args=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"; IFS=$' \t' read -r -a args <<< "$line"; keyword="${args[0]-}"
    keyword="${keyword//\"/}"; keyword="${keyword//\'/}"
    case "$keyword" in
      [Mm][Aa][Tt][Cc][Hh]|[Mm][Aa][Tt][Cc][Hh]=*) return 1 ;;
      [Ii][Nn][Cc][Ll][Uu][Dd][Ee]) ;;
      [Ii][Nn][Cc][Ll][Uu][Dd][Ee]=*) args=("${keyword%%=*}" "${keyword#*=}" "${args[@]:1}") ;;
      *) continue ;;
    esac
    for arg in "${args[@]:1}"; do
      arg="${arg//\"/}"; arg="${arg//\'/}"; [[ -n "$arg" ]] || return 1
      case "$arg" in /*) glob="$_WC_PREFIX$arg" ;; *) glob="$_WC_PREFIX/etc/ssh/$arg" ;; esac
      found=0
      local IFS=
      # shellcheck disable=SC2086
      for match in $glob; do
        found=1; _wc_system_graph "$match" "$((depth+1))" || return 1
      done
      (( found )) || return 1
    done
  done < "$file"
}

function _wc_route_file() {
  local path="$1" required="$2" service query result
  if [[ ! -e "$path" && "$required" = 0 ]]; then return 0; fi
  [[ -f "$path" && -r "$path" ]] || return 1
  [[ -x "$route_yq" ]] || return 2
  query='[.["warp-routing"].enabled, .originRequest.bastionMode, (.ingress[] | .originRequest.bastionMode)] | any_c(. == true)'
  result=$(_wc_tool /opt/homebrew/bin/yq -r "$query" - < "$path" 2>/dev/null) || return 1
  [[ "$result" = false ]] || return 1
  result=$(_wc_tool /opt/homebrew/bin/yq -r '.ingress[] | .service' - < "$path" 2>/dev/null) || return 1
  while IFS= read -r service; do
    case "$service" in
      *:22) return 1 ;;
      http://*|https://*|http_status:*|unix:*|"ssh://127.0.0.1:$port"|'') ;;
      *) return 1 ;;
    esac
  done <<< "$result"
}

function _wc_check_routes() {
  local path rc warning=0 failed=0 processes line arg next i
  local fields=() defaults=("${_WC_PREFIX:+$_WC_PREFIX/}scripts/etc/cloudflared/config.yml" "$HOME/.cloudflared/config.yml") explicit=("$@")
  local route_yq=/opt/homebrew/bin/yq
  [[ -z "$_WC_PREFIX" ]] || route_yq="$_WC_PREFIX/bin/yq"
  [[ -x "$route_yq" ]] || warning=1
  processes=$(_wc_tool /bin/ps -axo command=) || warning=1
  while IFS= read -r line; do
    read -r -a fields <<< "$line"; [[ "${fields[0]##*/}" = cloudflared ]] || continue
    local configs=0
    for ((i=1; i<${#fields[@]}; i++)); do
      arg="${fields[i]}"
      case "$arg" in
        --token|--token=*) warning=1 ;;
        --config|--config=*)
          configs=$((configs+1))
          if [[ "$arg" = --config ]]; then i=$((i+1)); path="${fields[i]-}"; else path="${arg#*=}"; fi
          next="${fields[i+1]-}"
          if [[ -z "$path" || "$path" = *[\"\']* || ( -n "$next" && "$next" != -* && "$next" != run && "$next" != tunnel ) ]]; then
            warning=1
          else
            explicit+=("$_WC_PREFIX$path")
          fi ;;
      esac
    done
    (( configs )) || warning=1
  done <<< "$processes"
  local required
  for required in 0 1; do
    local files=("${defaults[@]}")
    (( ! required )) || files=("${explicit[@]}")
    for path in "${files[@]}"; do
      rc=0; _wc_route_file "$path" "$required" || rc=$?
      case "$rc" in 1) failed=1 ;; 2) warning=1 ;; esac
    done
  done
  (( ! failed )) || return 1
  (( ! warning )) || return 2
}

function _wc_check_files() {
  local reason='files or manifest'
  if _wc_files_healthy >/dev/null 2>&1; then _wc_emit PASS C1 files; return; fi
  if [[ -f "$_WC_PREFIX$_WC_CONF_DIR/revoked" ]]; then reason='revoke marker present'
  elif [[ -e "$_WC_PREFIX$_WC_CONF_DIR/launchd.plist.revoked" ]]; then reason='daemon plist parked after revoke'
  elif [[ -e "$_WC_PREFIX$_WC_CONF_DIR/launchd.plist.pending" ]]; then reason='daemon plist pending CA installation'; fi
  _wc_emit FAIL C1 "$reason"
}

function _wc_check() {
  local strict=0 failures=0 port=42722 line result rc=0
  local inputs=()
  while (( $# )); do
    case "$1" in --strict) strict=1 ;; --cloudflared-config) (( $# > 1 )) || return 2; inputs+=("$2"); shift ;; *) return 2 ;; esac
    shift
  done
  IFS= read -r line 2>/dev/null < "$_WC_PREFIX$_WC_CONF_DIR/sshd_config" || line=
  [[ ! "$line" =~ ^ListenAddress\ 127\.0\.0\.1:([0-9]+)$ ]] || port="${BASH_REMATCH[1]}"
  _WC_LOGIN=$(_wc_tool /usr/bin/id -un) || _WC_LOGIN=
  _wc_check_files
  if _wc_check_config 2>/dev/null; then _wc_emit PASS C2 config; else _wc_emit FAIL C2 config; fi
  if _wc_listener "$port" >/dev/null; then _wc_emit PASS C3 "listener on $port"; else _wc_emit FAIL C3 "port $port is absent or held by another process"; fi
  if _wc_job_running; then _wc_emit PASS C4 launchd; else _wc_emit FAIL C4 launchd; fi
  if result=$(_wc_ca_read 2>/dev/null < "$_WC_PREFIX$_WC_CONF_DIR/access_ca.pub"); then _wc_emit PASS C5 "$result"; else _wc_emit FAIL C5 ca; fi
  if _wc_gate_healthy; then
    _wc_emit PASS C6 forced-command
  else _wc_emit FAIL C6 forced-command; fi
  _wc_check_routes "${inputs[@]}" || rc=$?
  case "$rc" in 0) _wc_emit PASS C7 system-sshd-not-tunnelled ;; 1) _wc_emit FAIL C7 'tunnel configuration' ;; *) _wc_emit WARN C7 indeterminate ;; esac
  if ! (shopt -s nullglob; _wc_system_graph "$_WC_PREFIX/etc/ssh/sshd_config" 0) || ! result=$(_wc_tool /usr/sbin/sshd -G 2>/dev/null); then
    _wc_emit WARN C8 indeterminate
  elif [[ $'\n'"$result"$'\n' = *$'\npasswordauthentication no\n'* && $'\n'"$result"$'\n' = *$'\nkbdinteractiveauthentication no\n'* ]]; then
    _wc_emit PASS C8 system-sshd-password-off
  else _wc_emit WARN C8 'drop-in settings: PasswordAuthentication no, KbdInteractiveAuthentication no'; fi
  result=$(_wc_tool /usr/sbin/netstat -anv -p tcp) || result=
  _wc_socket_note "$result"
  if _wc_identity >/dev/null 2>&1; then _wc_emit PASS C10 login-entry; else _wc_emit FAIL C10 login-entry; fi
  return "$failures"
}

function _wc_socket_note() {
  if [[ "$1" =~ \*\.22[[:space:]]+[^[:space:]]+[[:space:]]+LISTEN ]]; then _wc_emit INFO C9 'socket on *.22: yes'; else _wc_emit INFO C9 'socket on *.22: no'; fi
}

function _wc_revoke() {
  local port source plist="$_WC_PREFIX$_WC_LAUNCHD_DIR/${_WC_LABEL}.plist" rc=0
  (( $# == 0 )) || return 2
  if [[ -t 0 && -t 1 ]]; then _wc_priv_open || return 10
  elif ! _wc_priv_ticket; then
    _wc_message 'revoke needs an open sudo ticket or a terminal'; return 10
  fi
  read -r port source < <(_wc_port_lookup)
  printf 'web-console-sshd: port %s (%s)\n' "$port" "$source"
  _wc_revoke_mark || return 1
  if [[ -e "$plist" ]]; then _wc_priv /bin/mv -f "$plist" "$_WC_PREFIX$_WC_CONF_DIR/launchd.plist.revoked" 2>/dev/null || rc=1; fi
  _wc_stop "$port" || rc=1
  [[ ! -e "$plist" ]] || rc=1
  return "$rc"
}

function _wc_port_decide() {
  local field value sockets proto addr state
  _wc_port_valid "$port" || return 2
  sockets=$(_wc_tool /usr/sbin/netstat -anv -p tcp) || return 2
  while read -r proto _ _ addr _ state _; do
    [[ "$proto" = tcp* && "$state" = LISTEN && "${addr##*.}" = "$port" ]] || continue
    _wc_listener "$port" >/dev/null || { _wc_message "refusing port $port: held by another process"; return 2; }
    break
  done <<< "$sockets"
  if [[ -f "$_WC_PREFIX$_WC_CONF_DIR/totp.conf" ]]; then
    while IFS='=' read -r field value; do
      [[ "$field" != console_port || "$value" = "$port" ]] || {
        _wc_message "part C is installed on port $value; uninstall part C first"; return 2
      }
    done < "$_WC_PREFIX$_WC_CONF_DIR/totp.conf"
  fi
}

function _wc_mark_decide() {
  local phase="$1" file="$_WC_PREFIX$_WC_CONF_DIR/revoked" id
  [[ -e "$file" ]] || return 0
  IFS= read -r id < "$file" || return 8
  [[ "$id" =~ ^[0-9]{8}T[0-9]{6}Z\.[1-9][0-9]*$ ]] || return 8
  if [[ "$after" = 1 && "$phase" = advisory ]]; then
    marker_id="$id"; _wc_message "restoring revoked event $id"; return 0
  fi
  if [[ "$after" = 1 && "$marker_id" = "$id" ]]; then return 0; fi
  if [[ "$after" = 1 && "$phase" = locked ]]; then _wc_message 'a newer revoke arrived; not loaded'; return 11; fi
  if [[ "$phase" = advisory && -f "$_WC_PREFIX$_WC_JOURNAL" ]]; then
    _wc_message 'revoked, and an interrupted install is pending; recovering first'; return 0
  fi
  _wc_message 'revoked; rerun with --after-revoke to restore the daemon'; return 2
}

function _wc_chosen_ca() {
  local file="$ca_file"
  if [[ -z "$file" ]]; then
    file="$_WC_PREFIX$_WC_CONF_DIR/access_ca.pub"
    [[ -e "$file" ]] || { _WC_CA=; return 0; }
  fi
  [[ -f "$file" && -r "$file" ]] || return 2
  _wc_ca_read < "$file" || return 2
}

function _wc_dirs_new() {
  local dir mode
  for dir in "$_WC_CONF_DIR" "$_WC_CONF_DIR/zdotdir" "$_WC_HELPER_DIR" "$_WC_CONF_DIR/.prev" "$_WC_HELPER_DIR/.prev"; do
    [[ -d "$_WC_PREFIX$dir" ]] && continue
    mode=0755; [[ "${dir##*/}" != .prev ]] || mode=0700
    _wc_txn_record created "$dir" || return 5
    _wc_priv /usr/bin/install -d -o root -g wheel -m "$mode" "$_WC_PREFIX$dir" 2>/dev/null || return 8
    _wc_trust_check "$dir" || return 8
  done
}

function _wc_stage_member() {
  local stage="$1" dest="$2" mode="$3" bytes="$4" source="$5" digest old=
  printf '%s' "$bytes" | _wc_stage_put "$stage" "${dest##*/}" "$mode" || return 8
  digest=$(_wc_stage_hash "$stage/${dest##*/}") || return 8
  _wc_manifest_put "$conf_stage" A "$dest" "$digest" "$source" || return 8
  if [[ -e "$_WC_PREFIX$dest" ]]; then old=$(_wc_digest "$dest") || return 8; fi
  [[ "$old" = "$digest" ]] || changes+=("$dest")
}

function _wc_stage_gate() {
  local dest="$_WC_HELPER_DIR/forced-command" row_part row_source
  if [[ -e "$_WC_PREFIX$dest" ]]; then
    _wc_manifest_row "$dest" || { _wc_message 'unrecognised forced-command'; return 8; }
    [[ -n "$row_source" ]] || return 8
    if [[ "$row_part" = C ]]; then return 0; fi
    local gate_digest stub_digest
    gate_digest=$(_wc_digest "$dest") && stub_digest=$(_wc_digest "$_WC_HELPER_DIR/forced-command.stub") || return 8
    [[ "$gate_digest" = "$stub_digest" ]] || { _wc_message 'unrecognised forced-command'; return 8; }
  fi
  _wc_stage_member "$helper_stage" "$dest" 0755 "$stub" "$stub_blob"
}

function _wc_stage_keys() {
  local name=ssh_host_ed25519_key digest
  if [[ ! -e "$_WC_PREFIX$_WC_CONF_DIR/revoked_keys" && ! -L "$_WC_PREFIX$_WC_CONF_DIR/revoked_keys" ]]; then
    _wc_priv /usr/bin/ssh-keygen -k -f "$conf_stage/revoked_keys" 2>/dev/null || return 8
    _wc_priv /bin/chmod 0644 "$conf_stage/revoked_keys" 2>/dev/null || return 8
    changes+=("$_WC_CONF_DIR/revoked_keys")
  fi
  hostkey="$_WC_PREFIX$_WC_CONF_DIR/$name"
  if [[ ! -f "$hostkey" ]]; then
    hostkey="$conf_stage/$name"
    _wc_priv /usr/bin/ssh-keygen -q -t ed25519 -N '' -f "$hostkey" 2>/dev/null || return 8
    changes+=("$_WC_CONF_DIR/$name" "$_WC_CONF_DIR/$name.pub")
  fi
  digest=$(_wc_stage_hash "$hostkey.pub") || return 8
  _wc_manifest_put "$conf_stage" A "$_WC_CONF_DIR/$name.pub" "$digest" -
}

function _wc_stage_payloads() {
  local digest old='' hash path part src extra
  printf '' | _wc_stage_put "$conf_stage" manifest 0644 || return 8
  if [[ -n "$_WC_CA" ]]; then _wc_stage_member "$conf_stage" "$_WC_CONF_DIR/access_ca.pub" 0644 "$_WC_CA" - || return 8; fi
  _wc_stage_member "$helper_stage" "$_WC_HELPER_DIR/forced-command.stub" 0755 "$stub" "$stub_blob" || return 8
  _wc_stage_gate && _wc_stage_keys || return 8
  _wc_stage_member "$conf_stage" "$_WC_CONF_DIR/sshd_config" 0644 "$config" "template:$config_blob" || return 8
  local boundary=${#changes[@]} plist_changed=0
  if [[ -n "$_WC_CA" ]]; then
    _wc_stage_member "$conf_stage" "$plist_path" 0644 "$plist" "$plist_blob" || return 8
    if (( ${#changes[@]} != boundary )); then unset 'changes[boundary]'; plist_changed=1; fi
  else
    printf '%s' "$plist" | _wc_stage_put "$conf_stage" launchd.plist.pending 0644 || return 8
  fi
  if [[ -r "$_WC_PREFIX$_WC_CONF_DIR/manifest" ]]; then
    while read -r hash path part src extra; do
      [[ "$part" != C ]] || _wc_manifest_put "$conf_stage" C "$path" "$hash" "$src" || return 8
    done < "$_WC_PREFIX$_WC_CONF_DIR/manifest"
    old=$(_wc_digest "$_WC_CONF_DIR/manifest") || return 8
  fi
  digest=$(_wc_stage_hash "$conf_stage/manifest") || return 8
  [[ "$digest" = "$old" ]] || changes+=("$_WC_CONF_DIR/manifest")
  if (( plist_changed )); then changes+=("$plist_path"); fi
  if [[ -z "$_WC_CA" ]]; then changes+=("$_WC_CONF_DIR/launchd.plist.pending"); fi
  if [[ ! -e "$_WC_PREFIX$_WC_LOG" ]]; then
    _wc_priv /usr/bin/install -o root -g wheel -m 0600 "$_WC_PREFIX/dev/null" "$_WC_PREFIX$_WC_LOG" 2>/dev/null || return 8
    new_log=1
  fi
}

function _wc_sshd_diagnostics() {
  local line home_label='~'
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line//"$HOME"/$home_label}"
    _wc_message "${line//"$_WC_LOGIN"/<login>}"
  done
}

function _wc_validate() {
  local flag result keyword value normalized
  local staged_plist="$conf_stage/${plist_path##*/}"
  [[ -n "$_WC_CA" ]] || staged_plist="$conf_stage/launchd.plist.pending"
  for flag in -t -T; do
    local args=("$flag")
    [[ "$flag" != -T ]] || args+=(-C "user=nobody,host=localhost,addr=127.0.0.1,laddr=127.0.0.1,lport=$port")
    result=$({
      { _wc_priv /usr/sbin/sshd "${args[@]}" -f "$conf_stage/sshd_config" -h "$hostkey" 2>&1 >&3 || exit "$?"; } |
        _wc_sshd_diagnostics >&2
      exit "${PIPESTATUS[0]}"
    } 3>&1) || return 4
    [[ "$flag" = -T ]] || continue
    while IFS=' ' read -r keyword value; do
      [[ -n "$keyword" ]] || continue
      normalized=
      local i letter lower upper=ABCDEFGHIJKLMNOPQRSTUVWXYZ alphabet=abcdefghijklmnopqrstuvwxyz
      for ((i=0; i<${#keyword}; i++)); do
        letter="${keyword:i:1}"; lower="${upper%%"$letter"*}"
        if [[ "$lower" != "$upper" ]]; then letter="${alphabet:${#lower}:1}"; fi
        normalized+="$letter"
      done
      [[ $'\n'"$result"$'\n' = *$'\n'"$normalized $value"$'\n'* ]] || return 4
    done <<< "$config"
  done
  _wc_priv /usr/bin/plutil -lint "$staged_plist" >/dev/null 2>/dev/null || return 4
}

function _wc_parked_clear() {
  local file
  for file in launchd.plist.revoked launchd.plist.pending; do
    _wc_priv /bin/rm -f "$_WC_PREFIX$_WC_CONF_DIR/$file" 2>/dev/null || {
      _wc_message "loaded; stale $file not removed; check C1 fails until it is"; return 1
    }
  done
}

function _wc_restore() {
  local result=0
  _wc_txn_recover || result=$?
  (( result != 5 )) || _WC_KEEP_JOURNAL=1
  if (( new_log )); then _wc_priv /bin/rm -f "$_WC_PREFIX$_WC_LOG" 2>/dev/null || return 5; fi
  return "$result"
}

function _wc_install_exit() {
  local code="$1"
  trap - EXIT
  if ! _wc_revoke_reconcile; then
    _wc_message 'revoked marker present but the daemon is not parked; run revoke again'
    (( code != 0 )) || code=1
  fi
  { _wc_stage_clean "$_WC_CONF_DIR" && _wc_stage_clean "$_WC_HELPER_DIR"; } || { (( code != 0 )) || code=1; }
  if [[ "$_WC_KEEP_JOURNAL" != 1 ]]; then _wc_txn_end || { (( code != 0 )) || code=1; }; fi
  _wc_lock_release || { (( code != 0 )) || code=7; }
  exit "$code"
}

function _wc_move_generation() {
  local path stage
  for path in "${changes[@]}"; do
    stage="$conf_stage"
    [[ "${path%/*}" != "$_WC_HELPER_DIR" ]] || stage="$helper_stage"
    if ! _wc_commit_one "$stage" "$path"; then
      _wc_restore || return "$?"
      _wc_message 'commit failed; previous generation restored'; return 5
    fi
  done
}

function _wc_load_guard() {
  if [[ -f "$_WC_PREFIX$_WC_CONF_DIR/revoked" ]]; then
    _wc_revoke_reconcile || return 1
    _wc_message 'revoked during install; not loaded'; return 11
  fi
}

function _wc_consume_marker() {
  local dir="$_WC_PREFIX$_WC_CONF_DIR" readback
  [[ -n "$marker_id" ]] || return 0
  consumed="$dir/revoked.consumed.$marker_id"
  _wc_priv /bin/mv "$dir/revoked" "$consumed" 2>/dev/null || return 11
  if ! IFS= read -r readback < "$consumed" || [[ "$readback" != "$marker_id" ]]; then
    _wc_priv /bin/mv "$consumed" "$dir/revoked" 2>/dev/null || return 1
    _wc_message 'a newer revoke arrived; not loaded'; return 11
  fi
}

function _wc_load_previous() {
  local ignored=0 restore_rc=0
  _wc_restore || restore_rc=$?
  _wc_priv /bin/launchctl bootout "system/${_WC_LABEL}" 2>/dev/null || ignored=$?
  : "$ignored"
  if [[ -n "$consumed" && -f "$consumed" && ! -f "$_WC_PREFIX$_WC_CONF_DIR/revoked" ]]; then
    _wc_priv /bin/mv "$consumed" "$_WC_PREFIX$_WC_CONF_DIR/revoked" 2>/dev/null || return 1
  fi
  (( restore_rc == 0 )) || return "$restore_rc"
  if [[ -e "$_WC_PREFIX$plist_path" && ! -e "$_WC_PREFIX$_WC_CONF_DIR/revoked" ]]; then
    _wc_priv /bin/launchctl bootstrap system "$_WC_PREFIX$plist_path" 2>/dev/null || ignored=$?
    : "$ignored"
  fi
  _wc_revoke_reconcile || return 1
  _wc_message 'load failed; previous generation restored'; return 5
}

function _wc_load() {
  local consumed='' ignored=0 i
  _wc_consume_marker || return "$?"
  _wc_load_guard || return "$?"
  if ! _wc_trust_check "$_WC_CONF_DIR/zdotdir"; then
    _wc_priv /bin/rm -f "$_WC_PREFIX$plist_path" 2>/dev/null || return 1
    if [[ -n "$consumed" && ! -e "$_WC_PREFIX$_WC_CONF_DIR/revoked" ]]; then
      _wc_priv /bin/mv "$consumed" "$_WC_PREFIX$_WC_CONF_DIR/revoked" 2>/dev/null || return 1
    fi
    return 8
  fi
  _wc_priv /bin/launchctl bootout "system/${_WC_LABEL}" 2>/dev/null || ignored=$?
  : "$ignored"
  _wc_load_guard || return "$?"
  _wc_priv /bin/launchctl bootstrap system "$_WC_PREFIX$plist_path" 2>/dev/null || { _wc_load_previous; return "$?"; }
  _wc_load_guard || return "$?"
  for ((i=0; i<=10; i++)); do
    if _wc_listener "$port" >/dev/null && _wc_job_running; then _wc_parked_clear; return "$?"; fi
    (( i == 10 )) || _wc_tool /bin/sleep 1 || return 5
  done
  _wc_load_previous
}

function _wc_generation() {
  local conf_stage helper_stage hostkey changes=() rc=0 new_log=0
  _wc_txn_begin || return 5
  _wc_dirs_new || rc=$?
  if (( ! rc )); then conf_stage=$(_wc_stage_new "$_WC_CONF_DIR") && helper_stage=$(_wc_stage_new "$_WC_HELPER_DIR") || rc=8; fi
  (( rc )) || _wc_stage_payloads || rc=$?
  (( rc )) || _wc_validate || rc=4
  if (( rc )); then
    _wc_restore || return "$?"
    [[ "$rc" != 4 ]] || _wc_message 'validation failed; nothing loaded'
    return "$rc"
  fi
  _wc_move_generation || return "$?"
  if [[ -z "$_WC_CA" ]]; then _wc_message 'files installed; CA public key missing, daemon not loaded'; return 3; fi
  if [[ -z "$marker_id" ]] && _wc_listener "$port" >/dev/null && _wc_job_running; then
    case "${changes[*]}" in
      '') _wc_message 'already installed'; _wc_parked_clear; return "$?" ;;
      "$_WC_CONF_DIR/access_ca.pub $_WC_CONF_DIR/manifest") _wc_parked_clear; return "$?" ;;
    esac
  fi
  _wc_load
}

function _wc_install() {
  local dry=0 after=0 ca_file='' marker_id='' port="${WEB_CONSOLE_SSH_PORT-42722}" rc=0
  local template config stub plist config_blob stub_blob plist_blob plist_path="$_WC_LAUNCHD_DIR/${_WC_LABEL}.plist"
  while (( $# )); do
    case "$1" in
      --dry-run) dry=1 ;; --after-revoke) after=1 ;;
      --ca-file) (( $# > 1 )) && [[ -n "$2" ]] || return 2; ca_file="$2"; shift ;;
      *) return 2 ;;
    esac
    shift
  done
  _wc_identity || return "$?"
  _wc_port_decide || { [[ -f "$_WC_PREFIX$_WC_JOURNAL" && "$dry" = 0 ]] || return 2; }
  _wc_mark_decide advisory || return "$?"
  _wc_sources || return 9
  template=$(_wc_blob "$_WC_CONFIG_TEMPLATE") && config=$(_wc_render "${template%.}" "$port" "$_WC_LOGIN" && printf '.') || return 4
  config="${config%.}"
  plist=$(_wc_blob "$_WC_PLIST_TEMPLATE") && stub=$(_wc_blob "$_WC_STUB_SOURCE") || return 9
  plist="${plist%.}"; stub="${stub%.}"
  config_blob=$(_wc_tool /Library/Developer/CommandLineTools/usr/bin/git rev-parse "HEAD:$_WC_CONFIG_TEMPLATE") &&
    stub_blob=$(_wc_tool /Library/Developer/CommandLineTools/usr/bin/git rev-parse "HEAD:$_WC_STUB_SOURCE") &&
    plist_blob=$(_wc_tool /Library/Developer/CommandLineTools/usr/bin/git rev-parse "HEAD:$_WC_PLIST_TEMPLATE") || return 9
  if (( dry )); then
    _wc_chosen_ca || return 2
    printf '%s' "${config//"AllowUsers $_WC_LOGIN"/AllowUsers <login>}"
    local name
    printf 'root:wheel 0755 %s\n' "$_WC_CONF_DIR" "$_WC_CONF_DIR/zdotdir" "$_WC_HELPER_DIR" "$_WC_HELPER_DIR/forced-command" "$_WC_HELPER_DIR/forced-command.stub"
    printf 'root:wheel 0700 %s\n' "$_WC_CONF_DIR/.prev" "$_WC_HELPER_DIR/.prev"
    for name in sshd_config ssh_host_ed25519_key.pub manifest revoked_keys; do printf 'root:wheel 0644 %s/%s\n' "$_WC_CONF_DIR" "$name"; done
    printf 'root:wheel 0600 %s\n' "$_WC_CONF_DIR/ssh_host_ed25519_key" "$_WC_LOG" "$_WC_JOURNAL"
    printf '%s\n' 'mkdir lock; install -d directories; mktemp -d stages; tee payloads; shasum -a 256 staged files' \
      'ssh-keygen -q -t ed25519 if the host key is missing; install log if absent' \
      'sshd -t -f <staged config> -h <host key>; sshd -T -C <connection> -f <staged config> -h <host key>' \
      'plutil -lint <staged plist>; cp -p previous generation; tee -a journal before each mv'
    if [[ -n "$_WC_CA" ]]; then
      printf 'root:wheel 0644 %s\n' "$plist_path" "$_WC_CONF_DIR/access_ca.pub"
      printf '%s\n' 'launchctl bootout and bootstrap for a changed daemon; check listener and job; remove parked files'
    else
      printf 'root:wheel 0644 %s/launchd.plist.pending\n' "$_WC_CONF_DIR"
    fi
    return 0
  fi
  _wc_priv_open || return 10
  _wc_trust_install || return 8
  _wc_lock_take || return 7
  _WC_KEEP_JOURNAL=0
  trap '_wc_install_exit "$?"' EXIT
  _wc_txn_recover || { rc=$?; [[ "$rc" != 5 ]] || _WC_KEEP_JOURNAL=1; return "$rc"; }
  _wc_stage_clean "$_WC_CONF_DIR" && _wc_stage_clean "$_WC_HELPER_DIR" || return 5
  _wc_port_decide && _wc_mark_decide locked || return "$?"
  _wc_chosen_ca || return 2
  _wc_generation
}

function _wc_uninstall() {
  local purge=0 port source path part rc=0
  if (( $# )); then [[ $# = 1 && "$1" = --purge ]] || return 2; purge=1; fi
  _wc_priv_open || return 10
  _wc_trust_install || return 8
  _wc_lock_take || return 7
  _WC_KEEP_JOURNAL=0
  trap '_wc_install_exit "$?"' EXIT
  _wc_txn_recover || { rc=$?; [[ "$rc" != 5 ]] || _WC_KEEP_JOURNAL=1; return "$rc"; }
  if [[ -f "$_WC_PREFIX$_WC_CONF_DIR/manifest" ]]; then
    while read -r _ _ part _; do
      [[ "$part" != C ]] || { _wc_message 'part C is installed; run uninstall-web-console-totp first'; return 6; }
    done < "$_WC_PREFIX$_WC_CONF_DIR/manifest"
  fi
  if [[ -e "$_WC_PREFIX$_WC_LAUNCHD_DIR/com.k3d-manager.web-console-totp.plist" ]]; then
    _wc_message 'part C is installed; run uninstall-web-console-totp first'; return 6
  fi
  read -r port source < <(_wc_port_lookup); printf 'web-console-sshd: port %s (%s)\n' "$port" "$source"
  _wc_priv /bin/rm -f "$_WC_PREFIX$_WC_LAUNCHD_DIR/${_WC_LABEL}.plist" 2>/dev/null || return 1
  _wc_stop "$port" || return 1
  _wc_priv /bin/rm -rf -- "$_WC_PREFIX$_WC_HELPER_DIR" "$_WC_PREFIX$_WC_LOG" "$_WC_PREFIX$_WC_CONF_DIR"/{launchd.plist.pending,launchd.plist.revoked,revoked,sshd_config,manifest,.prev,zdotdir} "$_WC_PREFIX$_WC_CONF_DIR"/revoked.consumed.* 2>/dev/null || return 1
  if (( purge )); then _wc_priv /bin/rm -rf -- "$_WC_PREFIX$_WC_CONF_DIR" 2>/dev/null || return 1; fi
}

function main() {
  _wc_main_env
  local repo="${BASH_SOURCE[0]%/*}/.." caller_dir="$PWD"
  cd -- "$repo" || return 2
  # shellcheck source=scripts/lib/web_console_common.sh
  # shellcheck disable=SC1091 # Loaded from the repository root after cd above.
  source scripts/lib/web_console_common.sh
  _wc_fixture_gate || return 2
  if [[ -z "$_WC_PREFIX" ]]; then
    # shellcheck disable=SC2034 # Used by the sourced foundation library.
    local SCRIPT_DIR=scripts
    # shellcheck source=/dev/null
    source scripts/lib/system.sh
  fi
  local verb="${1-}" args=()
  (( $# )) && shift
  while (( $# )); do
    args+=("$1")
    case "$1" in
      --ca-file|--cloudflared-config)
        (( $# >= 2 )) && [[ -n "$2" ]] || return 2
        shift; case "$1" in /*) args+=("$1") ;; *) args+=("$caller_dir/$1") ;; esac ;;
    esac
    shift
  done
  case "$verb" in
    install) _wc_install "${args[@]}" ;;
    revoke) _wc_revoke "${args[@]}" ;;
    uninstall) _wc_uninstall "${args[@]}" ;;
    check) _wc_check "${args[@]}" ;;
    *) _wc_message 'usage: k3dm-web-console-sshd install|revoke|uninstall|check'; return 2 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" = "$0" ]]; then main "$@"; fi
