#!/bin/bash -p
unset POSIXLY_CORRECT CDPATH
[ "${POSIXLY_CORRECT+x}" ] && { printf '%s\n' 'POSIXLY_CORRECT must be unset' >&2; exit 2; }
set +o posix
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
export LC_ALL=C
umask 022

_VS_BASE=/private/var/db/k3dm-verified
_VS_URL=https://github.com/wilddog64/k3d-manager.git
_VS_GIT=/Library/Developer/CommandLineTools/usr/bin/git
_VS_GIT_CORE=/Library/Developer/CommandLineTools/usr/libexec/git-core
_VS_FIND=/usr/bin/find
_VS_LS=/bin/ls
_VS_SELF=/usr/local/libexec/k3dm/k3dm-verified-stage
_VS_TRUST_TOP=/
_VS_OWNER=0
_VS_GROUP=wheel
_VS_SUDO=/usr/bin/sudo

_vs_die() { local code="$1"; shift; printf '%s\n' "$*" >&2; exit "$code"; }
_vs_euid() { /usr/bin/id -u; }
_vs_require_root() { [ "$(_vs_euid)" = 0 ]; }
_vs_valid_commit() { [[ "${1:-}" =~ ^[0-9a-f]{40}$ ]]; }
_vs_valid_ref() { [[ "${1:-}" =~ ^[A-Za-z0-9._/-]+$ && "$1" != *..* ]]; }

_vs_git() {
  local -a fixed=(PATH=/usr/bin:/bin HOME=/var/empty GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_TERMINAL_PROMPT=0 GIT_OPTIONAL_LOCKS=0)
  if [ "${1:-}" = --safe-directory ]; then
    [ "$#" -ge 2 ] || return 2
    fixed+=(GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory "GIT_CONFIG_VALUE_0=$2")
    shift 2
  fi
  /usr/bin/env -i "${fixed[@]}" "$_VS_GIT" -c transfer.fsckObjects=true -c fetch.fsckObjects=true -c core.hooksPath=/dev/null -c credential.helper= "$@"
}

_vs_mode() { /usr/bin/stat -f '%u %Lp' "$1" 2>/dev/null; }
_vs_root_owned() {
  local item="$1" info owner mode acl_listing
  info=$(_vs_mode "$item") || return 1
  read -r owner mode <<< "$info"
  [ "$owner" = "$_VS_OWNER" ] || return 1
  (( (8#$mode & 0022) == 0 )) || return 1
  acl_listing=$("$_VS_LS" -lde "$item" 2>/dev/null) || return 1
  ! /usr/bin/grep -qE '^ [0-9]+: ' <<< "$acl_listing"
}
_vs_walk_trusted() {
  local path="$1" stop="$2" parent
  while :; do
    _vs_root_owned "$path" || return 1
    [ "$path" = "$stop" ] && return 0
    parent=$(/usr/bin/dirname "$path")
    [ "$parent" != "$path" ] || return 1
    path="$parent"
  done
}
_vs_self_check() {
  local actual
  if [ ! -f "$_VS_SELF" ] || ! _vs_walk_trusted "$_VS_SELF" "$_VS_TRUST_TOP"; then _vs_die 3 'bootstrap not root-owned'; fi
  _vs_walk_trusted "$_VS_GIT" "$_VS_TRUST_TOP" || _vs_die 3 'bootstrap not root-owned'
  _vs_walk_trusted "$_VS_GIT_CORE" "$_VS_TRUST_TOP" || _vs_die 3 'bootstrap not root-owned'
  if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    actual=$(cd -P "$(/usr/bin/dirname "$0")" && /bin/pwd)/$(/usr/bin/basename "$0")
    [ "$actual" = "$_VS_SELF" ] || _vs_die 3 'run the installed bootstrap /usr/local/libexec/k3dm/k3dm-verified-stage'
  fi
}

_vs_git_safe() {
  local repo="$1"; shift
  _vs_git --safe-directory "$repo" -C "$repo" "$@"
}
_vs_prepare_repo() {
  /usr/bin/install -d -o "$_VS_OWNER" -g "$_VS_GROUP" -m 0755 "$_VS_BASE" "$_VS_BASE/stage" || return 1
  /usr/sbin/chown "$_VS_OWNER:$_VS_GROUP" "$_VS_BASE" "$_VS_BASE/stage" || return 1
  /bin/chmod 0755 "$_VS_BASE" "$_VS_BASE/stage" || return 1
  _vs_root_owned "$_VS_BASE" && _vs_root_owned "$_VS_BASE/stage" || return 1
  # Recreate the bare repo so no planted local URL rewrite or remote can steer fetch.
  /bin/rm -rf -- "$_VS_BASE/repo.git" || return 1
  _vs_git -C "$_VS_BASE" init --bare "$_VS_BASE/repo.git" || return 1
  /usr/sbin/chown -R "$_VS_OWNER:$_VS_GROUP" "$_VS_BASE/repo.git" || return 1
  /bin/chmod -RN "$_VS_BASE/repo.git" && /bin/chmod -R go-w "$_VS_BASE/repo.git" && /bin/chmod 0700 "$_VS_BASE/repo.git" || return 1
  _vs_root_owned "$_VS_BASE/repo.git" || return 1
}
_vs_fetch_verify() {
  local commit="$1" ref="$2" repo="$_VS_BASE/repo.git"
  local -a refspecs=( '+refs/heads/main:refs/remotes/origin/main' '+refs/heads/deploy/hub:refs/remotes/origin/deploy/hub' )
  [ "$ref" = main ] || [ "$ref" = deploy/hub ] || refspecs+=("+refs/heads/$ref:refs/remotes/origin/$ref")
  _vs_prepare_repo || _vs_die 4 'fetch failed'
  _vs_git -C "$repo" fetch --force "$_VS_URL" "${refspecs[@]}" || _vs_die 4 'fetch failed'
  if ! _vs_git -C "$repo" cat-file -e "$commit^{commit}" || ! _vs_git -C "$repo" merge-base --is-ancestor "$commit" "refs/remotes/origin/$ref"; then
    _vs_print_tips "$repo" "$ref" "$commit"
    _vs_die 5 "commit not reachable from $ref"
  fi
}
_vs_print_tips() {
  local repo="$1" ref="$2" commit="$3" branch tip
  for branch in main deploy/hub "$ref"; do
    tip=$(_vs_git -C "$repo" rev-parse "refs/remotes/origin/$branch" 2>/dev/null || true)
    if [ -n "$tip" ]; then printf 'origin/%s: %s%s\n' "$branch" "$tip" "$([ "$tip" = "$commit" ] && printf ' (commit tip)' || true)"; else printf 'origin/%s: unavailable\n' "$branch"; fi
  done
}
_vs_stage() {
  local commit="$1" ref="$2" repo="$_VS_BASE/repo.git" target="$_VS_BASE/stage/$1" tmp="$_VS_BASE/stage/.tmp.$1.$$" path
  /bin/rm -rf -- "$target"
  _vs_fetch_verify "$commit" "$ref"
  for path in "$_VS_BASE"/stage/.tmp.*; do [ -e "$path" ] && /bin/rm -rf -- "$path"; done
  /bin/rm -rf -- "$tmp"
  if ! _vs_git -C "$_VS_BASE" clone --no-hardlinks --no-checkout "$repo" "$tmp" || ! _vs_git -C "$tmp" checkout --detach "$commit"; then
    /bin/rm -rf -- "$tmp" "$target"; _vs_die 6 'stage failed'
  fi
  printf '%s\n' "$commit" > "$tmp/.git/k3dm-verified" || { /bin/rm -rf -- "$tmp"; _vs_die 6 'stage failed'; }
  if ! /usr/sbin/chown -R "$_VS_OWNER:$_VS_GROUP" "$tmp" || ! /bin/chmod -RN "$tmp" || ! /bin/chmod -R go-w "$tmp" || ! /bin/mv "$tmp" "$target"; then /bin/rm -rf -- "$tmp" "$target"; _vs_die 6 'stage failed'; fi
  printf 'commit: %s\n' "$commit"
  _vs_print_tips "$repo" "$ref" "$commit"
  _vs_git -C "$repo" ls-tree -r "$commit" -- bin/k3dm-web-console-sshd bin/k3dm-web-console-totp bin/k3dm-promote-authority scripts/lib/system.sh scripts/lib/foundation/scripts/lib/system.sh scripts/lib/web_console_common.sh scripts/lib/agent_rigor.sh scripts/libexec/k3dm-promote-daemon.py scripts/lib/hub_approval.py scripts/lib/promote_mover.py scripts/etc/launchd-daemons/com.k3d-manager.promote-authority.plist.tmpl scripts/etc/promote/promote.conf.tmpl
  printf '/usr/local/libexec/k3dm/k3dm-verified-stage run %s k3dm-web-console-sshd <verb> [args...]\n' "$commit"
  printf '/usr/local/libexec/k3dm/k3dm-verified-stage run %s k3dm-web-console-totp <verb> [args...]\n' "$commit"
  printf '/usr/local/libexec/k3dm/k3dm-verified-stage run %s k3dm-promote-authority <verb> [args...]\n' "$commit"
}
_vs_install_self() {
  local commit="$1" old new stage="$_VS_BASE/stage/$1" tmp="${_VS_SELF}.tmp.$$" staged="$_VS_BASE/stage/$1/bin/k3dm-verified-stage"
  cd / || _vs_die 6 'cannot change to /'
  old=$(_vs_git -C "$_VS_BASE" hash-object --no-filters "$_VS_SELF" 2>/dev/null || printf 'absent')
  _vs_stage "$commit" main
  _vs_stage_ok "$stage" "$commit" || _vs_die 6 'staged bootstrap not verified'
  [ ! -L "$staged" ] && [ -f "$staged" ] || _vs_die 6 'staged bootstrap missing or symlink'
  if ! /usr/bin/install -o "$_VS_OWNER" -g "$_VS_GROUP" -m 0755 "$staged" "$tmp" || ! /bin/mv -f "$tmp" "$_VS_SELF"; then /bin/rm -f "$tmp"; _vs_die 6 'self install failed'; fi
  new=$(_vs_git -C "$_VS_BASE" hash-object --no-filters "$_VS_SELF")
  printf 'old blob: %s\nnew blob: %s\n' "$old" "$new"
}

_vs_stage_ok() {
  local stage="$1" commit="$2" entry resolved symlinks listing status_output checked
  resolved=$(cd -P "$stage" 2>/dev/null && /bin/pwd) || return 1
  [ "$resolved" = "$_VS_BASE/stage/$commit" ] || return 1
  _vs_walk_trusted "$_VS_BASE/stage" "$_VS_TRUST_TOP" || return 1
  [ ! -L "$stage/.git" ] || return 1
  symlinks=$("$_VS_FIND" "$stage" -path "$stage/.git" -prune -o -type l -print) || return 1
  [ -z "$symlinks" ] || return 1
  listing=$("$_VS_LS" -lReA "$stage" 2>/dev/null) || return 1
  ! /usr/bin/grep -qE '^ [0-9]+: ' <<< "$listing" || return 1
  checked=$("$_VS_FIND" "$stage" -print0 | {
    count=0
    while IFS= read -r -d '' entry; do
      _vs_root_owned "$entry" || exit 1
      count=$((count + 1))
    done
    printf '%s' "$count"
  }) || return 1
  [ "$checked" -gt 0 ] || return 1
  [ "$(/bin/cat "$stage/.git/k3dm-verified" 2>/dev/null)" = "$commit" ] || return 1
  [ "$(_vs_git_safe "$stage" rev-parse HEAD 2>/dev/null)" = "$commit" ] || return 1
  status_output=$(_vs_git_safe "$stage" status --porcelain --untracked-files=all --ignored 2>/dev/null) || return 1
  [ -z "$status_output" ]
}
_vs_run_validate() {
  local arg need=0
  for arg in "$@"; do
    if [ "$need" = 1 ]; then [[ "$arg" = /* ]] || return 1; need=0; continue; fi
    case "$arg" in --ca-file|--cloudflared-config|--tmux) need=1;; PROBE_FILE=*) [[ "${arg#PROBE_FILE=}" = /* ]] || return 1;; esac
  done
  [ "$need" = 0 ] || return 1
  if [ "${WEB_CONSOLE_SSH_PORT+x}" ]; then [[ "$WEB_CONSOLE_SSH_PORT" =~ ^[0-9]{1,5}$ ]] || return 1; fi
}
_vs_run() {
  local commit="$1" tool="$2" status=0 arg home term
  local -a child_env=()
  shift 2
  [ "$(_vs_euid)" != 0 ] || _vs_die 3 'run as the operator'
  case "$tool" in k3dm-web-console-sshd|k3dm-web-console-totp|k3dm-promote-authority);; *) _vs_die 2 'unknown tool';; esac
  _vs_valid_commit "$commit" || _vs_die 2 'invalid commit'
  _vs_run_validate "$@" || _vs_die 2 'pass an absolute path; invalid argument'
  _vs_stage_ok "$_VS_BASE/stage/$commit" "$commit" || _vs_die 7 "stage $commit not verified; run /usr/local/libexec/k3dm/k3dm-verified-stage stage $commit"
  "$_VS_SUDO" -k || _vs_die 3 'cannot invalidate sudo ticket'
  trap '' TSTP QUIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap '"$_VS_SUDO" -k >/dev/null 2>&1 || printf "%s\n" "warning: could not invalidate sudo ticket" >&2' EXIT
  cd /
  home=$(/usr/bin/id -P "$(_vs_euid)" | /usr/bin/awk -F: '{print $9}') || _vs_die 2 'cannot read passwd entry'
  [[ "$home" = /* && "$home" != *[$'\001'-$'\037']* ]] || _vs_die 2 'invalid passwd home'
  term=${TERM:-dumb}; [[ "$term" =~ ^[A-Za-z0-9._+-]{1,64}$ ]] || term=dumb
  child_env=("PATH=/usr/bin:/bin:/usr/sbin:/sbin" "HOME=$home" LC_ALL=C "TERM=$term" GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory "GIT_CONFIG_VALUE_0=$_VS_BASE/stage/$commit")
  for arg in TMUX TMUX_PANE STY SSH_CONNECTION SSH_TTY; do [ "${!arg+x}" ] && child_env+=("$arg=1"); done
  [ "${WEB_CONSOLE_SSH_PORT+x}" ] && child_env+=("WEB_CONSOLE_SSH_PORT=$WEB_CONSOLE_SSH_PORT")
  set +e
  /usr/bin/env -i "${child_env[@]}" /bin/bash -p "$_VS_BASE/stage/$commit/bin/$tool" "$@"
  status=$?
  if ! "$_VS_SUDO" -k; then printf '%s\n' 'warning: could not invalidate sudo ticket' >&2; fi
  trap - EXIT HUP INT TERM
  set -e
  return "$status"
}

main() {
  local mode=${1:-} commit ref=main
  [ -n "$mode" ] || _vs_die 2 'usage'
  case "$mode" in
    run) shift; [ "$#" -ge 2 ] || _vs_die 2 'usage'; _vs_run "$@";;
    --install-self) shift; [ "$#" = 1 ] || _vs_die 2 'usage'; _vs_valid_commit "$1" || _vs_die 2 'invalid commit'; _vs_require_root || _vs_die 3 'must run as root'; cd / || _vs_die 6 'cannot change to /'; _vs_install_self "$1";;
    *) _vs_valid_commit "$mode" || _vs_die 2 'usage'; commit=$mode; shift
      [ "$#" = 0 ] || [ "$#" = 2 ] || _vs_die 2 'usage'; if [ "$#" = 2 ]; then [ "$1" = --ref ] || _vs_die 2 'usage'; ref=$2; fi
      _vs_valid_commit "$commit" || _vs_die 2 'invalid commit'; _vs_valid_ref "$ref" || _vs_die 2 'invalid --ref'; _vs_require_root || _vs_die 3 'must run as root'; cd / || _vs_die 6 'cannot change to /'; [ "$ref" = main ] || printf 'UNPROTECTED REF %s\n' "$ref"; _vs_stage "$commit" "$ref";;
  esac
}

_vs_wrapper() {
  local -a args=("$@")
  [ "$(_vs_euid)" != 0 ] || _vs_die 3 'run as the operator'
  # Validate the exact stage wrapper grammar before touching sudo.
  if [ "${args[0]:-}" = stage ]; then
    if [ "${args[1]:-}" = --install-self ]; then
      [ "${#args[@]}" = 3 ] || _vs_die 2 'usage'
      _vs_valid_commit "${args[2]}" || _vs_die 2 'usage'
    else
      [ "${#args[@]}" = 2 ] || [ "${#args[@]}" = 4 ] || _vs_die 2 'usage'
      _vs_valid_commit "${args[1]:-}" || _vs_die 2 'invalid commit'
      if [ "${#args[@]}" = 4 ]; then
        [ "${args[2]}" = --ref ] || _vs_die 2 'invalid --ref'
        _vs_valid_ref "${args[3]}" || _vs_die 2 'invalid --ref'
      fi
    fi
  else _vs_die 2 'usage'; fi
  local status=0
  "$_VS_SUDO" -k || _vs_die 3 'cannot invalidate sudo ticket'
  trap '"$_VS_SUDO" -k >/dev/null 2>&1 || printf "%s\n" "warning: could not invalidate sudo ticket" >&2' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap '' QUIT
  "$_VS_SUDO" "$_VS_SELF" "${args[@]:1}" || status=$?
  if ! "$_VS_SUDO" -k; then printf '%s\n' 'warning: could not invalidate sudo ticket' >&2; fi
  trap - EXIT HUP INT TERM
  return "$status"
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  _vs_self_check
  if [ "${1:-}" = stage ]; then _vs_wrapper "$@"; else main "$@"; fi
fi
