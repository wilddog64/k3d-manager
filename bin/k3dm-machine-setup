#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
source "${REPO_ROOT}/scripts/lib/system.sh"
# shellcheck source=/dev/null
source "${REPO_ROOT}/scripts/lib/core.sh"

usage() { printf 'Usage: bin/k3dm-machine-setup --role hub|worker|console|control [--from HOST] [--secrets ask|skip] [--agents install|skip] [--check|--dry-run]\n       bin/k3dm-machine-setup --check-shell HOST\n'; }
role='' shell_host='' from_host='' secrets_mode=ask agents_mode=install mode=setup failed=0 brew_available=0
platform=unknown
while (($#)); do
  case "$1" in
    --role) (($# >= 2)) || { usage >&2; exit 2; }; role="$2"; shift 2 ;;
    --from) (($# >= 2)) || { usage >&2; exit 2; }; from_host="$2"; shift 2 ;;
    --secrets) (($# >= 2)) || { usage >&2; exit 2; }; secrets_mode="$2"; shift 2 ;;
    --agents) (($# >= 2)) || { usage >&2; exit 2; }; agents_mode="$2"; shift 2 ;;
    --check-shell) (($# >= 2)) || { usage >&2; exit 2; }; shell_host="$2"; shift 2 ;;
    --check) mode=check; shift ;;
    --dry-run) mode=dry-run; shift ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done
if [[ -n "$shell_host" ]]; then
  python3 - "$shell_host" <<'PYTHON'
import os, re, subprocess, sys
timeout_text = os.environ.get("K3DM_CHECK_SHELL_TIMEOUT", "60")
if not re.fullmatch(r"[0-9]+", timeout_text) or int(timeout_text) <= 0:
    print("K3DM_CHECK_SHELL_TIMEOUT must be a positive integer", file=sys.stderr)
    sys.exit(2)
try:
    result = subprocess.run(["ssh", "-tt", "-o", "BatchMode=yes", sys.argv[1], "$SHELL -lic exit"],
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=int(timeout_text))
    output = result.stdout.decode(errors="replace")
    status = result.returncode
except subprocess.TimeoutExpired as exc:
    output = (exc.stdout or b"").decode(errors="replace") + "\nlogin shell timed out\n"
    status = 1
pattern = re.compile(r"Username for|Password for|command not found|insecure directories|_lastcomp|Permission denied|timed out", re.I)
lines = [line for line in output.splitlines() if pattern.search(line)]
for line in lines:
    home = os.path.expanduser("~")
    if home and home != "/":
        line = line.replace(home, "~")
    line = re.sub(r"(?i)(https?://)[^/\s@]+@", r"\1[REDACTED]@", line)
    line = re.sub(r"(?:/Users|/home)/[^/\s:'\"]+(?:/[^\s:'\"]*)?", "[HOME]", line)
    line = re.sub(r"(?i)(?:gh[pousr]_[A-Za-z0-9_]+|github_pat_[A-Za-z0-9_]+|[A-Za-z0-9_-]{20,})", "[REDACTED]", line)
    print(line)
sys.exit(1 if status or lines else 0)
PYTHON
  exit $?
fi
case "$(uname -s)" in Darwin) platform=darwin ;; Linux) platform=linux ;; esac
if [[ "$platform" == linux ]]; then
  [[ "$role" == control ]] || { printf 'role %s is macOS-only; use --role control on Linux\n' "$role" >&2; exit 2; }
  case "$(uname -m)" in x86_64|aarch64) ;; *) printf 'unsupported Linux architecture: %s\n' "$(uname -m)" >&2; exit 2 ;; esac
  [[ "$(id -u)" != 0 ]] || { printf 'machine setup must not run as root on Linux\n' >&2; exit 2; }
else
  case "$role" in hub|worker|console|control) ;; *) usage >&2; exit 2 ;; esac
fi
case "$secrets_mode" in ask|skip) ;; *) printf 'Invalid --secrets value: %s (expected ask or skip)\n' "$secrets_mode" >&2; usage >&2; exit 2 ;; esac
case "$agents_mode" in install|skip) ;; *) printf 'Invalid --agents value: %s (expected install or skip)\n' "$agents_mode" >&2; usage >&2; exit 2 ;; esac
if [[ -n "$from_host" && ! "$from_host" =~ ^[A-Za-z0-9.-]+$ ]]; then printf 'Invalid --from host: %s\n' "$from_host" >&2; exit 2; fi
manifest_dir="${REPO_ROOT}/scripts/etc/machine"
sudoers_file="${K3DM_SUDOERS_FILE:-/etc/sudoers.d/k3d-manager}"
[[ -r "${manifest_dir}/brew.${role}.list" && -r "${manifest_dir}/secrets.${role}.list" && -r "${manifest_dir}/agents.${role}.list" ]] || { printf 'Missing role manifest\n' >&2; exit 2; }
report() { printf '%-32s %s\n' "$1" "$2"; }
install_promtool() {
  [[ "$role" == control || "$role" == console || "$role" == hub ]] || return 0
  if [[ "$mode" != setup ]]; then
    local candidate version
    candidate="$HOME/.local/bin/promtool"
    if [[ ! -x "$candidate" ]]; then candidate="$(command -v promtool 2>/dev/null || true)"; fi
    if [[ -n "$candidate" && -x "$candidate" ]] && version="$("$candidate" --version 2>/dev/null)" && [[ "$version" == *'promtool, version 3.1.0'* ]]; then
      report promtool ok
    else
      record_failure promtool missing
    fi
    return 0
  fi
  if _install_promtool; then report promtool installed
  else record_failure promtool 'missing (see installer output)'; fi
}

if [[ "$platform" == linux ]]; then
  linux_control() {
    local prefix=/home/linuxbrew/.linuxbrew pin commit expected actual installer raw kind name path target item candidate version
    if [[ ! -d "$prefix" || ! -w "$prefix" ]] || ! command -v curl >/dev/null 2>&1 || ! command -v git >/dev/null 2>&1 || ! command -v make >/dev/null 2>&1 || ! command -v gcc >/dev/null 2>&1 || ! command -v file >/dev/null 2>&1 || ! command -v pgrep >/dev/null 2>&1; then
      printf '%s\n' 'Homebrew Linux prerequisites are missing. Run these commands as an administrator:' 'sudo apt-get update' 'sudo apt-get install -y build-essential procps curl file git' 'sudo install -d -o "'"$(id -un)"'" -g "'"$(id -gn)"'" -m 0755 /home/linuxbrew/.linuxbrew'
      return 1
    fi
    pin="${manifest_dir}/homebrew-install.linux.pin"
    commit="$(sed -n 's/^commit=//p' "$pin")"; expected="$(sed -n 's/^sha256=//p' "$pin")"
    [[ "$commit" =~ ^[0-9a-f]{40}$ && "$expected" =~ ^[0-9a-f]{64}$ ]] || { report homebrew 'invalid installer pin'; return 1; }
    path="$prefix/bin/brew"
    if [[ ! -x "$path" ]]; then
      if [[ "$mode" != setup ]]; then report homebrew missing; return 1; fi
      installer="$(mktemp "${TMPDIR:-/tmp}/homebrew-install.XXXXXX")" || return 1
      if ! _run_command -- curl -fL "https://raw.githubusercontent.com/Homebrew/install/${commit}/install.sh" -o "$installer"; then rm -f "$installer"; report homebrew 'installer download failed'; return 1; fi
      if command -v sha256sum >/dev/null 2>&1; then actual="$(_run_command -- sha256sum "$installer" | awk '{print $1}')"
      elif command -v shasum >/dev/null 2>&1; then actual="$(_run_command -- shasum -a 256 "$installer" | awk '{print $1}')"
      else rm -f "$installer"; report homebrew 'no sha256 utility'; return 1; fi
      if [[ "$actual" != "$expected" ]]; then rm -f "$installer"; report homebrew 'installer checksum mismatch'; return 1; fi
      if ! _run_command -- env NONINTERACTIVE=1 HOMEBREW_NO_SUDO=1 bash "$installer"; then rm -f "$installer"; report homebrew 'installer failed'; return 1; fi
      rm -f "$installer"
    fi
    PATH="$prefix/bin:$prefix/sbin:$PATH"; export PATH
    if ! command -v brew >/dev/null 2>&1; then report homebrew missing; return 1; fi
    _run_command -- brew shellenv >/dev/null || { report homebrew 'shellenv failed'; return 1; }
    report homebrew ok
    while IFS= read -r raw <&3 || [[ -n "$raw" ]]; do
      raw="${raw%%#*}"; raw="${raw//[$'\t\r ']/}"; [[ -n "$raw" ]] || continue
      kind=formula; name="$raw"; case "$raw" in cask:*) kind=cask; name="${raw#cask:}" ;; formula:*) name="${raw#formula:}" ;; esac
      if [[ "$kind" == cask ]]; then report "cask:${name}" 'skipped (linux)'; continue; fi
      grep -Fqx "formula:${name}" "${manifest_dir}/brew.control.linux-skip.list" && { report "brew:${name}" 'skipped (linux; no formula build)'; continue; }
      if _run_command --soft --quiet -- brew list --formula "$name" >/dev/null 2>&1; then report "brew:${name}" ok
      elif [[ "$mode" == setup ]] && _run_command --soft --quiet -- brew install "$name"; then report "brew:${name}" installed
      else report "brew:${name}" missing; failed=1; fi
    done 3< "${manifest_dir}/brew.control.list"
    local venv="${XDG_DATA_HOME:-$HOME/.local/share}/k3d-manager/venv"
    if [[ "$mode" == setup ]]; then
      if [[ ! -x "$venv/bin/python" ]]; then _run_command -- python3 -m venv "$venv" || return 1; fi
      _run_command -- "$venv/bin/python" -m pip install 'pytest==9.1.1' 'ruff==0.15.8' 'PyYAML==6.0.3' >/dev/null || return 1
    fi
    report python-tools "$([[ -x "$venv/bin/python" ]] && printf ok || printf missing)"
    while IFS='|' read -r repo remote branch roles <&3; do
      [[ -n "$repo" && "$repo" != \#* ]] || continue
      case ",$roles," in *,control,*) ;; *) continue ;; esac
      case "$remote" in https://*) ;; *) report "repo:${repo}" 'skipped (non-HTTPS remote)'; failed=1; continue ;; esac
      target="$HOME/src/$repo"
      if [[ -e "$target/.git" ]]; then report "repo:${repo}" ok
      elif [[ "$mode" != setup ]]; then report "repo:${repo}" missing; failed=1
      elif mkdir -p "$(dirname "$target")" && _run_command -- git clone --branch "$branch" --single-branch "$remote" "$target"; then report "repo:${repo}" installed
      else report "repo:${repo}" missing; failed=1
      fi
    done 3< "${manifest_dir}/repos.list"
    for item in 'macOS Homebrew package' 'Keychain and secrets' 'LaunchAgents' 'FROM= file copy' 'operator include' 'shell links and agent-settings repos' 'smartcd'; do report "$item" 'skipped (linux)'; done
    if [[ "$mode" == setup ]]; then
      if _install_promtool; then report promtool installed
      else failed=1; report promtool 'missing (installer failed)'; fi
    else
      candidate="$HOME/.local/bin/promtool"
      if [[ ! -x "$candidate" ]]; then candidate="$(command -v promtool 2>/dev/null || true)"; fi
      if [[ -n "$candidate" && -x "$candidate" ]] && version="$("$candidate" --version 2>/dev/null)" && [[ "$version" == *'promtool, version 3.1.0'* ]]; then
        report promtool ok
      else
        failed=1; report promtool missing
      fi
    fi
    return "$failed"
  }
  linux_control
  exit $?
fi

setup_log="${XDG_STATE_HOME:-$HOME/.local/state}/k3d-manager/machine-setup.log"
display_path() {
  case "$1" in
    "$HOME") printf '~' ;;
    "$HOME"/*) printf '%s/%s' '~' "${1#"$HOME"/}" ;;
    *) printf '%s' "$1" ;;
  esac
}
log_install() {
  if [[ ! -e "$setup_log" ]]; then mkdir -p "$(dirname "$setup_log")" && (umask 077 && : > "$setup_log"); fi
  printf '== %s\n' "$*" >> "$setup_log"
  "$@" >> "$setup_log" 2>&1
}
record_failure() { failed=1; report "$1" "$2"; }
verify_homebrew_package() {
  local signature
  signature="$(pkgutil --check-signature "$1" 2>&1)" || return 1
  if ! printf '%s\n' "$signature" | grep -E 'Developer ID Installer:.*\(927JGANW46\)' >/dev/null; then return 1; fi
  printf '%s\n' "$signature" | grep -E '^[[:space:]]*Notarization: trusted by the Apple notary service[[:space:]]*$' >/dev/null
}

ensure_homebrew() {
  if command -v brew >/dev/null 2>&1; then report homebrew ok; return 0; fi
  if [[ "$mode" != setup ]]; then record_failure homebrew missing; return 1; fi
  local package
  package="$(mktemp "${TMPDIR:-/tmp}/Homebrew.XXXXXX.pkg")"
  if ! curl -fL 'https://github.com/Homebrew/brew/releases/latest/download/Homebrew.pkg' -o "$package" >/dev/null 2>&1; then
    rm -f "$package"; record_failure homebrew missing; return 1
  fi
  if ! verify_homebrew_package "$package"; then
    rm -f "$package"; record_failure homebrew 'skipped (package signer not verified)'; return 1
  fi
  if ! _run_command --interactive-sudo --require-sudo -- installer -pkg "$package" -target /; then
    rm -f "$package"; record_failure homebrew missing; return 1
  fi
  rm -f "$package"
  PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"; export PATH
  command -v brew >/dev/null 2>&1 || { record_failure homebrew missing; return 1; }
  report homebrew installed
}

check_clt() {
  local label
  if xcode-select -p >/dev/null 2>&1; then report command-line-tools ok; return; fi
  if [[ "$mode" != setup ]]; then record_failure command-line-tools missing; return; fi
  label="$(softwareupdate --list 2>/dev/null | sed -n 's/^[[:space:]]*\* Label: \(Command Line Tools for Xcode[^[:cntrl:]]*\)$/\1/p' | head -1)"
  if [[ -z "$label" ]]; then record_failure command-line-tools 'missing (no current label)'; return; fi
  if _run_command --interactive-sudo --require-sudo -- softwareupdate --install "$label"; then report command-line-tools installed
  else record_failure command-line-tools missing; fi
}

check_github_auth() {
  local auth_status
  if ! auth_status="$(gh auth status 2>&1)"; then
    if [[ "$mode" != setup || ! -t 0 ]]; then record_failure github-auth missing; return; fi
    if ! gh auth login; then record_failure github-auth missing; return; fi
    if ! auth_status="$(gh auth status 2>&1)"; then record_failure github-auth missing; return; fi
  fi
  if [[ "$auth_status" == *hosts.yml* ]]; then
    report github-auth-storage 'skipped (hosts.yml storage; run gh auth logout then gh auth login to use Keychain)'
  fi
  if [[ "$mode" == setup ]] && ! gh auth setup-git >/dev/null 2>&1; then record_failure github-setup-git missing; fi
  report github-auth ok
}

preflight() {
  if [[ "$(uname -s)" == Darwin ]]; then report preflight-macos ok; else record_failure preflight-macos missing; fi
  if [[ "$(uname -m)" == arm64 ]]; then report preflight-arm64 ok; else record_failure preflight-arm64 missing; fi
  check_clt
  if ensure_homebrew; then brew_available=1; fi
  check_github_auth
}

normalize_github_remote() {
  local remote
  remote="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  case "$remote" in
    https://github.com/*) remote="${remote#https://github.com/}" ;;
    git@github.com:*) remote="${remote#git@github.com:}" ;;
    ssh://git@github.com/*) remote="${remote#ssh://git@github.com/}" ;;
    *) return 1 ;;
  esac
  while [[ "$remote" == */ ]]; do remote="${remote%/}"; done
  remote="${remote%.git}"
  case "$remote" in */*) ;; *) return 1 ;; esac
  [[ -n "${remote%%/*}" && -n "${remote#*/}" && "${remote#*/}" != */* ]] || return 1
  printf '%s\n' "$remote"
}

same_remote() {
  local actual="$1" expected="$2" actual_normalized expected_normalized
  [[ -n "$actual" && "$actual" == "$expected" ]] && return 0
  actual_normalized="$(normalize_github_remote "$actual")" || return 1
  expected_normalized="$(normalize_github_remote "$expected")" || return 1
  [[ "$actual_normalized" == "$expected_normalized" ]]
}

install_smartcd() {
  [[ "$role" == hub || "$role" == worker || "$role" == control ]] || return 0
  local clone="$HOME/src/gitrepo/personal/smartcd" actual
  if [[ -r "$HOME/.smartcd/lib/core/smartcd" ]]; then report smartcd ok; return; fi
  if [[ "$mode" != setup ]]; then record_failure smartcd missing; return; fi
  if [[ ! -e "$clone/.git" ]]; then record_failure smartcd 'missing (source clone unavailable)'; return; fi
  actual="$(git -C "$clone" remote get-url origin 2>/dev/null || true)"
  if ! same_remote "$actual" 'https://github.com/cxreg/smartcd.git'; then record_failure smartcd 'skipped (source clone has another remote)'; return; fi
  if make -C "$clone" install >/dev/null 2>&1 && [[ -r "$HOME/.smartcd/lib/core/smartcd" ]]; then report smartcd installed
  else record_failure smartcd missing; fi
}

install_tools() {
  local raw kind name
  while IFS= read -r raw <&3 || [[ -n "$raw" ]]; do
    raw="${raw%%#*}"; raw="${raw//[$'\t\r']/}"
    [[ -n "${raw// /}" ]] || continue
    kind=formula; name="$raw"
    case "$raw" in cask:*) kind=cask; name="${raw#cask:}" ;; formula:*) name="${raw#formula:}" ;; esac
    if brew list "--${kind}" "$name" >/dev/null 2>&1 || { [[ "$raw" != *:* ]] && brew list --cask "$name" >/dev/null 2>&1; }; then report "brew:${name}" ok
    elif [[ "$mode" == setup ]]; then
      if if [[ "$kind" == cask ]]; then log_install brew install --cask "$name"; else log_install brew install "$name"; fi; then report "brew:${name}" installed
      else record_failure "brew:${name}" 'missing (see machine-setup.log)'; fi
    else record_failure "brew:${name}" missing
    fi
  done 3< "${manifest_dir}/brew.${role}.list"
}

ensure_python_tools() {
  local venv_dir="${XDG_DATA_HOME:-$HOME/.local/share}/k3d-manager/venv" python_bin
  if [[ -x "$venv_dir/bin/python" ]] && "$venv_dir/bin/python" -c 'import pytest, ruff, yaml' >/dev/null 2>&1; then report python-tools ok; return; fi
  if [[ "$mode" != setup ]]; then record_failure python-tools missing; return; fi
  python_bin="$(command -v python3 || true)"
  if [[ -z "$python_bin" ]]; then record_failure python-tools missing; return; fi
  if [[ ! -x "$venv_dir/bin/python" ]] && ! "$python_bin" -m venv "$venv_dir"; then
    record_failure python-tools missing; return
  fi
  if ! "$venv_dir/bin/python" -m pip install 'pytest==9.1.1' 'ruff==0.15.8' 'PyYAML==6.0.3' >/dev/null || ! "$venv_dir/bin/python" -c 'import pytest, ruff, yaml' >/dev/null 2>&1; then
    record_failure python-tools missing; return
  fi
  report python-tools 'installed (add ~/.local/share/k3d-manager/venv/bin to PATH)'

}

clone_if_absent() {
  local path="$1" remote="$2" branch="$3" target="$HOME/src/$1"
  if [[ -e "$target/.git" ]]; then
    local actual
    actual="$(git -C "$target" remote get-url origin 2>/dev/null || true)"
    if same_remote "$actual" "$remote"; then report "repo:${path}" ok; else record_failure "repo:${path}" 'skipped (existing clone has another remote)'; fi
    return
  fi
  if [[ ! -e "$target/.git" && -e "$target" && -n "$(ls -A "$target" 2>/dev/null || true)" ]]; then record_failure "repo:${path}" 'skipped (target is not empty)'; return; fi
  if [[ "$mode" != setup ]]; then record_failure "repo:${path}" missing; return; fi
  if ! mkdir -p "$(dirname "$target")"; then record_failure "repo:${path}" missing; return; fi
  if [[ "$branch" != - ]] && ! git ls-remote --exit-code --heads "$remote" "$branch" >/dev/null 2>&1; then record_failure "repo:${path}" 'skipped (branch unavailable upstream)'; return; fi
  if [[ "$branch" == - ]]; then
    if log_install git clone "$remote" "$target"; then report "repo:${path}" installed
    else record_failure "repo:${path}" 'missing (see machine-setup.log)'; fi
  elif log_install git clone --branch "$branch" --single-branch "$remote" "$target"; then report "repo:${path}" installed
  else record_failure "repo:${path}" 'missing (see machine-setup.log)'; fi
}

install_repos() {
  local path remote branch roles
  while IFS='|' read -r path remote branch roles <&3; do
    [[ -n "$path" && "$path" != \#* ]] || continue
    case ",$roles," in *",$role,"*) ;; *) continue ;; esac
    case "$remote" in SKIP:*) report "repo:${path}" "skipped (${remote#SKIP: })"; continue ;; esac
    clone_if_absent "$path" "$remote" "$branch"
  done 3< "${manifest_dir}/repos.list"
  clone_configs
  setup_shell_links
}

remote_one() {
  local target="$1" actual normalized ssh_url label
  case "$target" in "$HOME"/*) label="$(display_path "$target")" ;; *) label='[path redacted]' ;; esac
  [[ -e "$target/.git" ]] || return 0
  actual="$(git -C "$target" remote get-url origin 2>/dev/null || true)"
  normalized="$(normalize_github_remote "$actual")" || return 0
  [[ "$normalized" == wilddog64/* ]] || return 0
  if [[ "$actual" != https://github.com/* ]]; then report "remote:$label" ok; return; fi
  if (( ! github_ssh )); then report "remote:$label" 'https (no GitHub SSH key yet)'; return; fi
  if [[ "$mode" == check ]]; then record_failure "remote:$label" 'https (SSH available)'; return; fi
  if [[ "$mode" != setup ]]; then report "remote:$label" 'would switch to ssh'; return; fi
  ssh_url="git@github.com:${normalized}.git"
  if git -C "$target" remote set-url origin "$ssh_url" && git -C "$target" ls-remote origin HEAD >/dev/null 2>&1; then
    report "remote:$label" 'switched to ssh'
  else
    git -C "$target" remote set-url origin "$actual"
    record_failure "remote:$label" 'https (SSH remote unavailable)'
  fi
}

switch_ssh_remotes() {
  local path remote branch roles github_ssh=0 target ssh_output
  ssh_output="$(ssh -o BatchMode=yes -o ConnectTimeout=10 -T git@github.com 2>&1 || true)"
  if [[ "$ssh_output" == *"successfully authenticated"* ]]; then github_ssh=1; fi
  while IFS='|' read -r path remote branch roles <&3; do
    [[ -n "$path" && "$path" != \#* ]] || continue
    case ",$roles," in *",$role,"*) remote_one "$HOME/src/$path" ;; esac
  done 3< "${manifest_dir}/repos.list"
  if [[ "$role" == hub || "$role" == worker ]]; then
    for target in "$HOME/.claude" "$HOME/.codex" "$HOME/.gemini" "$HOME/.copilot"; do remote_one "$target"; done
  fi
}

check_completion_dirs() {
  local prefix='' dir entry resolved home_real brew_real count=0 first=''
  home_real="$(cd -P "$HOME" && pwd)"
  if (( brew_available )); then prefix="$(brew --prefix 2>/dev/null || true)"; fi
  brew_real="$(cd -P "${prefix:-/nonexistent}" 2>/dev/null && pwd || true)"
  for dir in "$HOME/.zplug" "$HOME/.zsh" "${prefix:+$prefix/share/zsh}"; do
    [[ -d "$dir" ]] || continue
    resolved="$(cd -P "$dir" && pwd)"
    if [[ "$mode" == setup && ( "$dir" == "$HOME/.zplug" || "$dir" == "$HOME/.zsh" ) && "$resolved" == "$home_real/"* && ( -z "$brew_real" || ( "$resolved" != "$brew_real" && "$resolved" != "$brew_real/"* && "$brew_real" != "$resolved/"* ) ) ]]; then chmod -R go-w "$resolved"; fi
    while IFS= read -r entry; do
      [[ -n "$entry" ]] || continue
      ((count+=1)); [[ -n "$first" ]] || first="$(display_path "$entry")"
    done < <(find "$dir/" ! -type l \( -perm -g+w -o -perm -o+w \) -print)
  done
  if (( count )); then record_failure zsh:completion-dirs "$count insecure ($first)"; else report zsh:completion-dirs ok; fi
}

clone_config() {
  local repo="$1" target="$2" remote="https://github.com/wilddog64/${1}.git"
  if [[ -e "$target/.git" ]]; then
    if same_remote "$(git -C "$target" remote get-url origin 2>/dev/null || true)" "$remote"; then report "config:${repo}" ok
    else record_failure "config:${repo}" 'skipped (unexpected existing directory)'; fi
    return
  fi
  if [[ -e "$target" && -n "$(ls -A "$target" 2>/dev/null || true)" ]]; then record_failure "config:${repo}" 'skipped (target is not empty)'; return; fi
  if [[ "$mode" != setup ]]; then record_failure "config:${repo}" missing; return; fi
  if git clone "$remote" "$target" >/dev/null 2>&1; then report "config:${repo}" installed
  else record_failure "config:${repo}" missing; fi
}
clone_configs() {
  [[ "$role" == hub || "$role" == worker ]] || return 0
  clone_config claude-settings "$HOME/.claude"
  clone_config codex-settings "$HOME/.codex"
  clone_config gemini-config "$HOME/.gemini"
  clone_config copilot-config "$HOME/.copilot"
}

setup_shell_links() {
  [[ "$role" == hub || "$role" == worker ]] || return 0
  local src="$HOME/src/gitrepo/personal/zshdotfiles" name dest backup
  [[ -d "$src" ]] || return 0
  for name in .zsh .zshrc .zshenv; do
    case "$name" in .zsh) dest="$src" ;; .zshrc) dest="$HOME/.zsh/zshrc" ;; .zshenv) dest="$HOME/.zsh/zshenv" ;; esac
    if [[ -L "$HOME/$name" && "$HOME/$name" -ef "$dest" ]]; then report "shell:${name}" ok; continue; fi
    if [[ -L "$HOME/$name" ]]; then record_failure "shell:${name}" "skipped (linked elsewhere: $(display_path "$(readlink "$HOME/$name")"))"; continue; fi
    if [[ "$mode" != setup ]]; then record_failure "shell:${name}" missing; continue; fi
    if [[ -e "$HOME/$name" && ! -L "$HOME/$name" ]]; then
      backup="$HOME/${name}.pre-machine-setup"
      if [[ -e "$backup" ]]; then record_failure "shell:${name}" 'skipped (backup already exists)'; continue; fi
      if ! mv "$HOME/$name" "$backup" 2>/dev/null; then record_failure "shell:${name}" missing; continue; fi
    fi
    if ln -sfn "$dest" "$HOME/$name" 2>/dev/null; then report "shell:${name}" installed
    else record_failure "shell:${name}" missing; fi
  done
}

link_optional() {
  local source="$1" target="$2" label="$3" allow_dir="${4:-}"
  if [[ ! -e "$source" ]]; then report "$label" 'skipped (tracked source not present yet)'; return 0; fi
  if [[ -L "$target" && "$target" -ef "$source" ]]; then report "$label" ok; return 0; fi
  if [[ -e "$target" || -L "$target" ]]; then record_failure "$label" 'skipped (target already exists)'; return 0; fi
  if [[ "$mode" != setup ]]; then record_failure "$label" missing; return 0; fi
  if ! mkdir -p "$(dirname "$target")" 2>/dev/null || ! ln -s "$source" "$target" 2>/dev/null; then record_failure "$label" missing; return 0; fi
  if [[ -n "$allow_dir" ]] && ! direnv allow "$allow_dir" >/dev/null 2>&1; then record_failure "$label" 'missing (direnv allow failed)'; return 0; fi
  report "$label" installed
}

install_state_chain() {
  [[ "$role" == hub || "$role" == worker ]] || return 0
  local base="$HOME/src/gitrepo/personal/zshdotfiles" name source
  link_optional "$base/smartcd_config" "$HOME/.smartcd_config" state-smartcd-config
  link_optional "$base/direnvrc" "$HOME/.config/direnv/direnvrc" state-direnvrc
  for name in sync-claude sync-gemini sync-codex sync-copilot; do
    case "$name" in
      sync-claude|sync-gemini) source="$base/scripts/$name" ;;
      *) source="$base/scripts/sync-agent-state.sh" ;;
    esac
    link_optional "$source" "$HOME/.local/bin/$name" "state:$name"
  done
  link_optional "$base/envrc/personal.envrc" "$HOME/src/gitrepo/personal/.envrc" state-personal-envrc "$HOME/src/gitrepo/personal"
  link_optional "$base/envrc/k3d-manager.envrc" "$HOME/src/gitrepo/personal/k3d-manager/.envrc" state-k3d-manager-envrc "$HOME/src/gitrepo/personal/k3d-manager"
  link_optional "$base/envrc/ansible.envrc" "$HOME/src/gitrepo/personal/ansible/.envrc" state-ansible-envrc "$HOME/src/gitrepo/personal/ansible"
  link_optional "$base/smartcd/src/bash_enter" "$HOME/.smartcd/scripts$HOME/src/bash_enter" state-smartcd-src
  link_optional "$base/smartcd/personal/bash_enter" "$HOME/.smartcd/scripts$HOME/src/gitrepo/personal/bash_enter" state-smartcd-personal
  link_optional "$base/smartcd/k3d-manager/bash_enter" "$HOME/.smartcd/scripts$HOME/src/gitrepo/personal/k3d-manager/bash_enter" state-smartcd-k3d-manager
  link_optional "$base/smartcd/provision-win-tomcat/bash_enter" "$HOME/.smartcd/scripts$HOME/src/gitrepo/personal/ansible/provision-win-tomcat/bash_enter" state-smartcd-provision-win-tomcat
  for name in CLAUDE.md AGENTS.md GEMINI.md; do
    link_optional "$base/workspace/CLAUDE.md" "$HOME/src/gitrepo/personal/$name" "workspace:$name"
  done
}

secret_present() {
  local service="$1" account="$2"
  if [[ "$account" == '*' ]]; then security find-generic-password -s "$service" >/dev/null 2>&1
  else security find-generic-password -s "$service" -a "$account" >/dev/null 2>&1; fi
}

check_secrets() {
  local service account purpose command missing_hint=0 has_missing=0 keychain_checked=0
  if [[ "$mode" == dry-run && -n "$from_host" ]]; then report secrets "would pull secrets from $from_host"; fi
  if [[ "$mode" == setup && -n "$from_host" && -t 0 ]]; then
    while IFS='|' read -r service account purpose command <&3; do
      [[ -n "$service" && "$service" != \#* ]] || continue
      local probe_account="$account"
      [[ "$probe_account" != USER ]] || probe_account="$(id -un)"
      if ! secret_present "$service" "$probe_account"; then has_missing=1; break; fi
    done 3< "${manifest_dir}/secrets.${role}.list"
    if (( has_missing )); then
      if "${REPO_ROOT}/bin/k3dm-machine-secrets" pull --from "$from_host" --role "$role"; then :
      else record_failure secret-pull 'missing (see output above)'; fi
    fi
  fi
  while IFS='|' read -r service account purpose command <&3; do
    [[ -n "$service" && "$service" != \#* ]] || continue
    if (( ! keychain_checked )); then
      keychain_checked=1
      if security show-keychain-info "$HOME/Library/Keychains/login.keychain-db" >/dev/null 2>&1; then report keychain:login ok
      else record_failure keychain:login "locked (reads will fail in this session; run from a local Terminal)"; fi
    fi
    local lookup_account="$account"
    if [[ "$account" == USER ]]; then lookup_account="$(id -un)"; fi
    if secret_present "$service" "$lookup_account"; then report "secret:${service}:${account}" ok
    elif [[ "$secrets_mode" == skip ]]; then record_failure "secret:${service}" 'missing (skipped: SECRETS=skip)'
    elif [[ "$command" == operator:* ]]; then record_failure "secret:${service}" "missing ($command)"
    elif [[ "$mode" == setup && -t 0 ]]; then
      if (( ! missing_hint )) && [[ -z "$from_host" ]]; then
        printf 'Moving from another Mac? Rerun with FROM=<old Mac hostname> to copy these items (docs/howto/machine-setup.md).\n' >/dev/tty
        missing_hint=1
      fi
      printf 'Missing Keychain item %s (%s). Run setup command now? [y/N] ' "$service" "$purpose" >/dev/tty
      local answer; read -r answer </dev/tty || answer=''
      if [[ "$answer" == y || "$answer" == Y ]]; then
        if [[ "$command" == bin/* ]]; then command="${REPO_ROOT}/$command"; fi
        if bash -c "$command" </dev/tty; then report "secret:${service}" installed
        else record_failure "secret:${service}" missing; fi
      else record_failure "secret:${service}" missing; fi
    else record_failure "secret:${service}" missing; fi
  done 3< "${manifest_dir}/secrets.${role}.list"
}

ensure_operator_include() {
  local config="$HOME/.ssh/config" backup="$HOME/.ssh/config.pre-machine-setup" temp
  [[ "$mode" == setup ]] || return 0
  if [[ -f "$config" ]] && grep -Fxq 'Include ~/.ssh/config.d/operator' "$config"; then
    chmod 600 "$config"
    return 0
  fi
  if [[ -L "$config" ]]; then
    local target
    target="$(readlink "$config")"
    if [[ ! -w "$config" ]]; then report ssh:config "skipped (linked; add the Include in $(display_path "$target"))"; return; fi
    temp="$(mktemp "$HOME/.ssh/config.XXXXXX")"
    { printf '%s\n' 'Include ~/.ssh/config.d/operator'; cat "$config"; } > "$temp"
    cat "$temp" > "$config"; rm -f "$temp"
    return
  fi
  if [[ -e "$config" && ! -e "$backup" ]]; then cp -p "$config" "$backup"; fi
  temp="$(mktemp "$HOME/.ssh/config.XXXXXX")"
  { printf '%s\n' 'Include ~/.ssh/config.d/operator'; if [[ -f "$config" ]]; then cat "$config"; fi; } > "$temp"
  chmod 600 "$temp"
  mv "$temp" "$config"
}

copy_files() {
  local list="${manifest_dir}/files.${role}.list" path target partial
  [[ -r "$list" ]] || return 0
  while IFS= read -r path <&3 || [[ -n "$path" ]]; do
    path="${path%%#*}"; path="${path//[$'\t\r ']/}"
    [[ -n "$path" ]] || continue
    if [[ ! "$path" =~ ^[A-Za-z0-9._/-]+$ || "$path" == /* || "$path" == *..* || "$path" != */* ]]; then record_failure "file:${path}" 'rejected (bad path)'; continue; fi
    target="$HOME/$path"
    if [[ -L "$target" && ! -s "$target" ]]; then record_failure "file:~/${path}" 'skipped (linked target unavailable)'; continue; fi
    if [[ -s "$target" ]]; then
      [[ "$path" != .ssh/config.d/operator ]] || ensure_operator_include
      report "file:~/${path}" ok; continue
    fi
    if [[ -z "$from_host" || "$mode" == check ]]; then record_failure "file:~/${path}" 'missing (rerun with FROM=<old Mac hostname> to copy it)'; continue; fi
    if [[ ! "$from_host" =~ ^[A-Za-z0-9.-]+$ ]]; then record_failure "file:~/${path}" 'missing (invalid FROM host)'; continue; fi
    if [[ "$mode" == dry-run ]]; then report "file:~/${path}" "would copy from $from_host"; continue; fi
    mkdir -p "${target%/*}"; chmod 700 "${target%/*}"
    partial="${target}.k3dm-partial"
    if scp -q -o ConnectTimeout=10 -- "${from_host}:${path}" "$partial" && [[ -s "$partial" ]]; then
      chmod 600 "$partial"; mv "$partial" "$target"
      [[ "$path" != .ssh/config.d/operator ]] || ensure_operator_include
      report "file:~/${path}" "copied from $from_host"
    else
      rm -f "$partial"; record_failure "file:~/${path}" "missing (copy from $from_host failed)"
    fi
  done 3< "$list"
}

install_e2e_publish_back() {
  [[ "$role" == hub ]] || return 0
  local user host value conf="$HOME/.config/k3d-manager/e2e-remote.env" ssh_dir="$HOME/.ssh" auth="$HOME/.ssh/authorized_keys"
  if ! user="$(id -un 2>/dev/null)" || ! host="$(scutil --get LocalHostName 2>/dev/null)"; then
    record_failure e2e-publish-back 'missing (cannot determine local identity)'; return
  fi
  value="${user}@${host}.local"
  if [[ ! "$value" =~ ^[A-Za-z0-9._@-]+$ ]]; then record_failure e2e-publish-back 'missing (invalid publish-back host)'; return; fi

  local remote_line='' key_type='' key_blob='' comment='' from_value=''
  if [[ -n "$from_host" ]]; then
    remote_line="$(ssh -o BatchMode=yes -o ConnectTimeout=10 -- "$from_host" 'grep e2e-m2-publisher "$HOME/.ssh/authorized_keys"' 2>/dev/null | head -n 1 || true)"
    if [[ -z "$remote_line" ]]; then record_failure e2e-publish-back-key 'missing (old hub key unavailable)'; return; fi
    if [[ "$remote_line" =~ (^|,)from=\"([0-9./,]+)\" ]]; then from_value="${BASH_REMATCH[2]}"; else record_failure e2e-publish-back-key 'invalid old hub publisher entry'; return; fi
    if [[ "$remote_line" =~ (^|[[:space:]])(ssh-ed25519)[[:space:]]+([A-Za-z0-9+/]+=*)[[:space:]]+(e2e-m2-publisher@[A-Za-z0-9._-]+) ]]; then
      key_type="${BASH_REMATCH[2]}"; key_blob="${BASH_REMATCH[3]}"; comment="${BASH_REMATCH[4]}"
    else record_failure e2e-publish-back-key 'invalid old hub publisher entry'; return
    fi
  elif [[ -e "$auth" ]]; then
    if [[ -r "$auth" ]] && grep -q 'e2e-m2-publisher' "$auth"; then
      remote_line="$(grep -m1 'e2e-m2-publisher' "$auth")"
    fi
  fi
  if [[ -n "$remote_line" && -z "$from_host" ]]; then
    if [[ "$remote_line" =~ (^|[[:space:]])(ssh-ed25519)[[:space:]]+([A-Za-z0-9+/]+=*)[[:space:]]+(e2e-m2-publisher@[A-Za-z0-9._-]+) ]]; then
      key_type="${BASH_REMATCH[2]}"; key_blob="${BASH_REMATCH[3]}"; comment="${BASH_REMATCH[4]}"
      if [[ "$remote_line" =~ (^|,)from=\"([0-9./,]+)\" ]]; then from_value="${BASH_REMATCH[2]}"; else from_value=''; fi
    else record_failure e2e-publish-back-key 'invalid local publisher entry'; return
    fi
  fi

  local conf_status=missing
  if [[ -f "$conf" ]]; then
    if grep -Fqx "E2E_M2_PUBLISH_BACK_HOST=$value" "$conf"; then conf_status=ok
    elif grep -q '^E2E_M2_PUBLISH_BACK_HOST=' "$conf"; then conf_status=wrong
    else conf_status=missing; fi
  fi
  local auth_status=missing new_entry=''
  if [[ -n "$key_blob" && -n "$from_value" ]]; then
    new_entry="from=\"$from_value\",command=\"$REPO_ROOT/scripts/k3d-manager e2e_result_publish\",restrict,no-pty,no-agent-forwarding,no-port-forwarding,no-X11-forwarding $key_type $key_blob $comment"
    if [[ -f "$auth" ]] && grep -Fqx "$new_entry" "$auth"; then auth_status=ok; else auth_status=wrong; fi
  fi
  if [[ "$auth_status" == missing && -z "$from_host" ]]; then
    record_failure e2e-publish-back-key 'missing (rerun with FROM=<old hub> to copy the e2e publisher key)'
    return
  fi
  if [[ "$mode" == check ]]; then
    if [[ "$conf_status" == ok ]]; then report e2e-publish-back-conf ok; else record_failure e2e-publish-back-conf "$conf_status"; fi
    if [[ "$auth_status" == ok ]]; then report e2e-publish-back-key ok; else record_failure e2e-publish-back-key "$auth_status"; fi
    return
  fi
  if [[ "$mode" == dry-run ]]; then
    if [[ "$conf_status" == ok ]]; then report e2e-publish-back-conf ok
    elif [[ "$conf_status" == wrong ]]; then report e2e-publish-back-conf 'would update'
    else report e2e-publish-back-conf 'would write'; fi
    if [[ "$auth_status" == ok ]]; then report e2e-publish-back-key ok
    elif [[ "$auth_status" == wrong ]]; then report e2e-publish-back-key 'would update'
    else report e2e-publish-back-key 'would write'; fi
    return
  fi
  if [[ "$conf_status" != ok ]]; then
    local previous='' tmp
    if [[ -f "$conf" ]]; then previous="$(sed -n 's/^E2E_M2_PUBLISH_BACK_HOST=//p' "$conf" | head -n1)"; fi
    if ! mkdir -p "${conf%/*}" || ! chmod 700 "${conf%/*}"; then record_failure e2e-publish-back-conf missing; return; fi
    tmp="$(mktemp "${conf%/*}/.e2e-remote.XXXXXX")" || { record_failure e2e-publish-back-conf missing; return; }
    chmod 600 "$tmp"
    if [[ -f "$conf" ]]; then
      python3 - "$conf" "$tmp" "E2E_M2_PUBLISH_BACK_HOST=" "E2E_M2_PUBLISH_BACK_HOST=$value" <<'PYTHON'
import os, sys
source, target, prefix, replacement = sys.argv[1:]
with open(source, 'rb') as stream: lines = stream.readlines()
prefix = prefix.encode(); replacement = replacement.encode()
found = False; output = []
for line in lines:
    if not found and line.startswith(prefix):
        ending = b'\r\n' if line.endswith(b'\r\n') else b'\n' if line.endswith(b'\n') else b''
        output.append(replacement + ending); found = True
    else: output.append(line)
if not found: output.append(replacement + (b'' if output and not output[-1].endswith(b'\n') else b'\n'))
with open(target, 'wb') as stream: stream.write(b''.join(output))
PYTHON
    else printf 'E2E_M2_PUBLISH_BACK_HOST=%s\n' "$value" > "$tmp"; fi
    if ! chmod 600 "$tmp" || ! mv "$tmp" "$conf"; then rm -f "$tmp"; record_failure e2e-publish-back-conf missing; return; fi
    if [[ "$conf_status" == wrong ]]; then report e2e-publish-back-conf "updated (was $previous)"; else report e2e-publish-back-conf installed; fi
  else report e2e-publish-back-conf ok; fi
  if [[ "$auth_status" != ok ]]; then
    if ! mkdir -p "$ssh_dir" || ! chmod 700 "$ssh_dir"; then record_failure e2e-publish-back-key missing; return; fi
    local tmp_auth; tmp_auth="$(mktemp "$ssh_dir/.authorized_keys.XXXXXX")" || { record_failure e2e-publish-back-key missing; return; }
    if [[ -f "$auth" ]]; then
      python3 - "$auth" "$tmp_auth" "$new_entry" <<'PYTHON'
import sys
source, target, replacement = sys.argv[1:]
with open(source, 'rb') as stream: lines = stream.readlines()
replacement = replacement.encode(); marker = b'e2e-m2-publisher'
found = False; output = []
for line in lines:
    if not found and marker in line:
        ending = b'\r\n' if line.endswith(b'\r\n') else b'\n' if line.endswith(b'\n') else b''
        output.append(replacement + ending); found = True
    else: output.append(line)
if not found: output.append(replacement + (b'' if output and not output[-1].endswith(b'\n') else b'\n'))
with open(target, 'wb') as stream: stream.write(b''.join(output))
PYTHON
    else printf '%s\n' "$new_entry" > "$tmp_auth"; fi
    if ! chmod 600 "$tmp_auth" || ! mv "$tmp_auth" "$auth"; then rm -f "$tmp_auth"; record_failure e2e-publish-back-key missing; return; fi
    report e2e-publish-back-key installed
  else report e2e-publish-back-key ok; fi
}

is_hub_agent() {
  case "$1" in install-token-rotator|install-cleanup|install-node-health-watch|install-sandbox-reaper|install-vault-port-forward|install-prometheus-port-forward|install-hub-pushgateway-port-forward|install-hub-loki-port-forward|install-alertmanager-port-forward|install-alertmanager-auth-proxy|install-cloud-bridge|bin/k3dm-webhook-setup|bin/k3dm-hermes-setup|bin/k3dm-heartbeat-setup) return 0 ;; *) return 1 ;; esac
}

agent_label() {
  case "$1" in
    install-token-rotator) printf '%s' webhook-token-rotate ;;
    bin/k3dm-*-setup) local name="${1#bin/k3dm-}"; printf '%s' "${name%-setup}" ;;
    install-*) printf '%s' "${1#install-}" ;;
  esac
}

render_heartbeat() {
  local target="$1" candidate_dir="$HOME/.local/share/k3d-manager/heartbeat-candidates"
  if [[ ! -e "$candidate_dir/com.k3d-manager.heartbeat.plist" ]]; then
    if ! "$REPO_ROOT/$target" --config "$REPO_ROOT/scripts/etc/heartbeat/checks.example.json" --output-dir "$candidate_dir" --platform launchd </dev/tty >/dev/null; then
      record_failure "agent:${target}" 'missing (candidate render failed)'; return
    fi
  fi
  report "agent:${target}" 'not loaded (optional; review candidates: docs/howto/independent-heartbeats.md)'
}

perform_agent_install() {
  local target="$1"
  if [[ "$target" == bin/* || "$target" == install-sudoers ]]; then
    if [[ ! -t 0 ]]; then record_failure "agent:${target}" 'missing (TTY required)'; return; fi
  fi
  if [[ "$target" == bin/k3dm-heartbeat-setup ]]; then render_heartbeat "$target"; return; fi
  if [[ "$target" == bin/* ]]; then
    if "$REPO_ROOT/$target" </dev/tty; then report "agent:${target}" installed; else record_failure "agent:${target}" missing; fi
  elif log_install make -C "$REPO_ROOT" "$target"; then report "agent:${target}" installed
  else record_failure "agent:${target}" 'missing (see machine-setup.log)'; fi
}

run_one_agent() {
  local target="$1" label
  if [[ "$target" == smartcd-install ]]; then install_smartcd; return; fi
  if [[ "$role" != hub ]] && is_hub_agent "$target"; then record_failure "agent:${target}" 'skipped (hub only)'; return; fi
  label="$(agent_label "$target")"
  if [[ "$target" == install-sudoers && -f "$sudoers_file" ]]; then report "agent:${target}" ok; return; fi
  if [[ -n "$label" && -f "$HOME/Library/LaunchAgents/com.k3d-manager.${label}.plist" ]]; then report "agent:${target}" ok; return; fi
  if [[ "$mode" != setup ]]; then
    if [[ "$target" == bin/k3dm-heartbeat-setup ]]; then
      report "agent:${target}" 'not loaded (optional; review candidates: docs/howto/independent-heartbeats.md)'
    else record_failure "agent:${target}" missing; fi
    return
  fi
  if [[ "$agents_mode" == skip ]]; then report "agent:${target}" 'skipped (AGENTS=skip)'; return; fi
  perform_agent_install "$target"
}

run_agents() {
  local target
  while IFS= read -r target <&3 || [[ -n "$target" ]]; do
    target="${target%%#*}"; target="${target//[$'\t\r ']/}"
    [[ -n "$target" ]] || continue
    run_one_agent "$target"
  done 3< "${manifest_dir}/agents.${role}.list"
}

check_ai_clis() {
  [[ "$role" == hub || "$role" == worker ]] || return 0
  local name wrapper_dir="${AGY_WRAPPER_DIR:-$HOME/.local/share/k3d-manager/bin}"
  if [[ -L "$wrapper_dir/agy" ]] && [[ "$(readlink "$wrapper_dir/agy")" == "$REPO_ROOT/bin/k3dm-agy" ]]; then
    report 'agy wrapper:' present
  else
    report 'agy wrapper:' 'absent (warning; transcript collector is the data source)'
  fi
  for name in agy gemini; do
    if (PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"; export PATH; hash -r; command -v "$name" >/dev/null 2>&1); then
      report "ai:${name}" ok
    elif [[ "$name" == gemini ]]; then
      report "ai:${name}" "skipped (optional; deprecated)"
    else
      record_failure "ai:${name}" missing
    fi
  done
}

ensure_ec2_ssh_key() {
  [[ "$role" == hub ]] || return 0
  local key="$HOME/.ssh/k3d-manager-key.pem" public="$HOME/.ssh/k3d-manager-key.pub"
  if [[ -e "$key" || -L "$key" ]]; then report 'ec2 ssh key:' present; return; fi
  if [[ "$mode" != setup ]]; then record_failure 'ec2 ssh key:' missing; return; fi
  if mkdir -p "$HOME/.ssh" && (umask 077; ssh-keygen -q -t ed25519 -N "" -C "k3d-manager@$(hostname -s)" -f "$key" >/dev/null 2>&1) && chmod 600 "$key" && mv "$key.pub" "$public"; then
    report 'ec2 ssh key:' present
  else
    record_failure 'ec2 ssh key:' missing
  fi
}

if [[ "$mode" == setup ]]; then
  role_dir="${XDG_CONFIG_HOME:-$HOME/.config}/k3d-manager"
  mkdir -p "$role_dir"
  printf '%s\n' "$role" > "$role_dir/machine-role"
fi

preflight
ensure_ec2_ssh_key
if (( brew_available )); then install_tools; else report brew-phase 'skipped (Homebrew unavailable)'; fi
install_promtool
check_ai_clis
ensure_python_tools
install_repos
switch_ssh_remotes
check_completion_dirs
install_state_chain
check_secrets
copy_files
install_e2e_publish_back
run_agents
exit "$failed"
