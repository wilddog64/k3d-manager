#!/usr/bin/env bash
set -euo pipefail

role_file="${XDG_CONFIG_HOME:-$HOME/.config}/k3d-manager/machine-role"
role=missing
if [[ -r "$role_file" ]]; then
  role="$(cat "$role_file")"
  [[ -n "$role" ]] || role=missing
fi
if [[ "${K3DM_ALLOW_LOCAL_HUB:-0}" == 1 || "$role" == hub ]]; then
  exit 0
fi
printf 'ERROR: %s: role %s; run acg-up on the hub machine. Run make machine-setup ROLE=hub on the hub, or set K3DM_ALLOW_LOCAL_HUB=1.\n' "$role_file" "$role" >&2
exit 1
