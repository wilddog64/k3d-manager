#!/usr/bin/env python3
"""Poll the cloud-requests branch and execute its read-only requests."""

import json
import os
import queue
import re
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts" / "lib"))

from webhook import config as webhook_config
from webhook.auth import _get_cloud_runner_token, _get_reader_token
from webhook.cloud_actions import ACTION_ALLOWLIST, JOB_ID_RE
from webhook.make_targets import MAKE_TARGETS
from webhook.proc import _spawn_capture_text
from webhook.redact import scrub_credentials
from webhook.log import get_logger


_LOG = get_logger("cloud-bridge")


MAX_REQUEST_BYTES = 8 * 1024
MAX_PER_TICK = 10
REQUEST_TTL_SECONDS = 30 * 60
HTTP_TIMEOUT = min(float(os.environ.get("K3DM_CLOUD_BRIDGE_HTTP_TIMEOUT", "300")), REQUEST_TTL_SECONDS)
ID_RE = re.compile(r"[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]{0,63}")
FETCH_REFSPEC = "+refs/heads/cloud-requests:refs/heads/cloud-requests"
REQUIRED_FIELDS = {"schema", "action", "args", "requested_by", "requested_at", "expires_at"}
ARTIFACT_KEEP = max(1, int(os.environ.get("K3DM_CLOUD_ARTIFACT_KEEP", "50")))
TERMINAL_JOB_STATES = ("success", "failed", "killed")
MAX_JUNIT_BYTES = 512 * 1024
SLOW_ACTIONS = frozenset({"health"})
LIFECYCLE_TIMEOUTS = {"sandbox-up": 3600, "sandbox-down": 1800}


def _positive_env(name, default):
    try:
        value = float(os.environ.get(name, str(default)))
    except (TypeError, ValueError):
        return default
    return value if value > 0 else default


ACTIVE_POLL_SECONDS = _positive_env("K3DM_CLOUD_BRIDGE_ACTIVE_POLL", 5)
IDLE_POLL_SECONDS = _positive_env("K3DM_CLOUD_BRIDGE_IDLE_POLL", 60)
IDLE_AFTER_SECONDS = _positive_env("K3DM_CLOUD_BRIDGE_IDLE_AFTER", 600)


def _now():
    return datetime.now(timezone.utc)


def _parse_timestamp(value):
    if not isinstance(value, str):
        raise ValueError("timestamp must be a string")
    parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    if parsed.tzinfo is None:
        raise ValueError("timestamp must include a timezone")
    return parsed.astimezone(timezone.utc)


def validate_request(raw, now=None):
    """Return (request, reason), with validation in the contract's order."""
    if not isinstance(raw, dict):
        return None, "request is not a JSON object"
    if set(raw) != REQUIRED_FIELDS:
        return None, "request fields are not exactly the required six"
    if raw["schema"] != 1:
        return None, "unsupported schema"
    action = raw["action"]
    if action not in ACTION_ALLOWLIST:
        return None, "unknown action"
    args = raw["args"]
    if not isinstance(args, dict):
        return None, "args is not an object"
    _, _, allowed, _ = ACTION_ALLOWLIST[action]
    if set(args) - set(allowed):
        return None, "unexpected argument"
    if set(allowed) - set(args):
        return None, "missing argument"
    for key, value in args.items():
        if not isinstance(value, str) or not allowed[key].fullmatch(value):
            return None, f"invalid {key}"
    try:
        expires_at = _parse_timestamp(raw["expires_at"])
    except (TypeError, ValueError, OverflowError):
        return None, "invalid expires_at"
    if expires_at <= (now or _now()):
        return None, "request expired"
    return raw, None


def validate_request_bytes(data, now=None):
    """Validate the bounded blob before JSON decoding it."""
    if len(data) >= MAX_REQUEST_BYTES:
        return None, "request exceeds size cap"
    try:
        raw = json.loads(data)
    except (UnicodeDecodeError, json.JSONDecodeError):
        return None, "request is not valid JSON"
    return validate_request(raw, now=now)


def prepare_request(request_id, raw, processed, now=None):
    """Consume an id before validation; return (request, rejection response)."""
    if request_id in processed:
        return None, None
    processed.add(request_id)
    request, reason = validate_request(raw, now=now)
    if reason:
        action = raw.get("action", "") if isinstance(raw, dict) else ""
        return None, _response(request_id, action, "rejected", 0, reason=reason)
    return request, None


def _response(request_id, action, status, http_status, body=None, reason=None):
    result = {
        "schema": 1,
        "id": request_id,
        "action": action,
        "status": status,
        "http_status": http_status,
        "completed_at": _now().isoformat().replace("+00:00", "Z"),
    }
    if status == "rejected":
        result["reason"] = reason or "request rejected"
    else:
        result["body"] = body
    return result


def _git(repo, args, env=None, timeout=30):
    rc, output, timed_out = _spawn_capture_text(["git", *args], cwd=repo, env=env, timeout=timeout)
    if timed_out or rc != 0:
        raise RuntimeError(output.strip() or "git command failed")
    return output


def _remote_url(root):
    return _git(root, ["config", "--get", "remote.origin.url"]).strip()


def _ensure_bare_repo(repo, root):
    if repo.exists():
        return
    repo.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    _git(repo.parent, ["clone", "--bare", _remote_url(root), str(repo)], timeout=120)


def _fetch(repo):
    _git(repo, ["fetch", "origin", FETCH_REFSPEC], timeout=120)
    return _git(repo, ["rev-parse", "FETCH_HEAD"]).strip()


def _remote_tip(repo):
    output = _git(repo, ["ls-remote", "origin", "refs/heads/cloud-requests"], timeout=30)
    return output.split()[0] if output.split() else None


def _processed(repo, ref):
    try:
        return set(_git(repo, ["show", f"{ref}:ledger/processed.txt"]).splitlines())
    except RuntimeError:
        return set()


def _request_ids(repo, ref):
    names = _git(repo, ["ls-tree", "-r", "--name-only", ref, "requests/"]).splitlines()
    return [name.removeprefix("requests/").removesuffix(".json") for name in names
            if name.startswith("requests/") and name.endswith(".json")
            and ID_RE.fullmatch(name.removeprefix("requests/").removesuffix(".json"))]


def _read_request(repo, ref, request_id):
    size = int(_git(repo, ["cat-file", "-s", f"{ref}:requests/{request_id}.json"]).strip())
    if size >= MAX_REQUEST_BYTES:
        return None, "request exceeds size cap"
    try:
        raw = _git(repo, ["show", f"{ref}:requests/{request_id}.json"]).encode()
    except RuntimeError:
        return None, "request is not readable"
    return validate_request_bytes(raw)


def _request_body(request):
    action = request["action"]
    method, _, _, fixed = ACTION_ALLOWLIST[action]
    if method == "GET":
        return b""
    if fixed is None:
        return b"{}"
    if isinstance(fixed, dict):
        return json.dumps({**request["args"], **fixed}, sort_keys=True).encode()
    return json.dumps(
        {"target": fixed, "args": request["args"]}, sort_keys=True).encode()


def _call_webhook(request):
    action = request["action"]
    method, path_template, _, _ = ACTION_ALLOWLIST[action]
    path = path_template.format(**request["args"])
    target = ACTION_ALLOWLIST[action][3]
    token = _get_cloud_runner_token() if target in ("e2e-remote", "e2e") or action in LIFECYCLE_TIMEOUTS else _get_reader_token()
    headers = {"Authorization": f"Bearer {token}"}
    data = _request_body(request)
    http_request = urllib.request.Request(
        f"http://127.0.0.1:7443{path}", data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(http_request, timeout=HTTP_TIMEOUT) as response:
            payload = response.read()
            try:
                body = json.loads(payload)
            except (UnicodeDecodeError, json.JSONDecodeError):
                body = payload.decode(errors="replace")
            return _response("", action, "ok", response.status, body=body)
    except urllib.error.HTTPError as error:
        try:
            body = json.loads(error.read())
        except (OSError, UnicodeDecodeError, json.JSONDecodeError):
            body = {"error": "webhook HTTP error"}
        return _response("", action, "error", error.code, body=body)
    except (OSError, TimeoutError, ValueError):
        return _response("", action, "error", 0, body={"error": "webhook request failed"})


_slow_requests = queue.Queue()
_slow_responses = queue.Queue()
_slow_pending = set()
_slow_worker_started = False


def _slow_worker():
    while True:
        request_id, request = _slow_requests.get()
        try:
            _slow_responses.put((request_id, _call_webhook(request)))
        except Exception as error:  # pragma: no cover - defensive boundary around worker code
            _slow_responses.put((request_id, _response("", request["action"], "error", 0,
                                                       body={"error": str(error)})))
        finally:
            _slow_requests.task_done()


def _queue_slow_request(request_id, request):
    global _slow_worker_started
    if not _slow_worker_started:
        threading.Thread(target=_slow_worker, name="cloud-bridge-slow", daemon=True).start()
        _slow_worker_started = True
    _slow_pending.add(request_id)
    _slow_requests.put((request_id, request))


def _completed_slow_requests():
    while True:
        try:
            request_id, response = _slow_responses.get_nowait()
        except queue.Empty:
            return
        _slow_pending.discard(request_id)
        yield request_id, response


def _iso_utc(timestamp):
    return datetime.fromtimestamp(timestamp, timezone.utc).isoformat().replace("+00:00", "Z")


def _published_artifacts(repo, ref, job_id):
    """Return the artifact paths already committed for job_id, or [] when none exist."""
    rc, output, timed_out = _spawn_capture_text(
        ["git", "grep", "-l", "-F", f'"job_id": "{job_id}"', ref, "--", "artifacts/*/summary.json"],
        cwd=repo, timeout=30)
    if timed_out or rc != 0 or not output.strip():
        return []
    request_dir = output.strip().splitlines()[0].removeprefix(f"{ref}:").rsplit("/", 1)[0]
    names = _git(repo, ["ls-tree", "-r", "--name-only", ref, request_dir + "/"]).splitlines()
    return sorted(name for name in names if name.startswith(request_dir + "/"))


def job_artifacts(repo, ref, request_id, request, response):
    """Return (blobs, paths) for a job-status response that first observes a finished job."""
    if request.get("action") != "job-status" or response.get("status") != "ok":
        return {}, []
    body = response.get("body")
    if not isinstance(body, dict) or body.get("status") not in TERMINAL_JOB_STATES:
        return {}, []
    job_id = request["args"]["job_id"]
    published = _published_artifacts(repo, ref, job_id)
    if published:
        return {}, published
    try:
        job_dir = Path(webhook_config._safe_job_dir(job_id))
        finished_at = _iso_utc((job_dir / "status").stat().st_mtime)
    except (ValueError, OSError):
        return {}, []
    summary = {
        "schema": 1,
        "request_id": request_id,
        "job_id": job_id,
        "job_status": body["status"],
        "http_status": response.get("http_status"),
        "finished_at": finished_at,
    }
    try:
        target = (job_dir / "target").read_text().strip()
    except OSError:
        target = ""
    if target in MAKE_TARGETS:
        summary["target"] = target
    prefix = f"artifacts/{request_id}"
    blobs = {f"{prefix}/summary.json": (json.dumps(summary, sort_keys=True) + "\n").encode()}
    junit = job_dir / "junit.xml"
    try:
        if junit.is_file() and junit.stat().st_size <= MAX_JUNIT_BYTES:
            blobs[f"{prefix}/junit.xml"] = scrub_credentials(junit.read_text(errors="replace")).encode()
    except OSError:
        pass
    return blobs, sorted(blobs)


def _stale_artifact_paths(repo, parent, request_id):
    """Return paths of artifact trees beyond the keep window, oldest request ids first."""
    try:
        names = _git(repo, ["ls-tree", "--name-only", parent, "artifacts/"]).splitlines()
    except RuntimeError:
        return []
    ids = sorted({name.removeprefix("artifacts/") for name in names if name.startswith("artifacts/")}
                 | {request_id})
    stale = ids[:-ARTIFACT_KEEP]
    if not stale:
        return []
    listed = _git(repo, ["ls-tree", "-r", "--name-only", parent, *[f"artifacts/{item}/" for item in stale]])
    return listed.splitlines()


def _read_watching(repo, ref):
    try:
        raw = _git(repo, ["show", f"{ref}:ledger/watching.txt"])
    except RuntimeError:
        return []
    entries = []
    for line in raw.splitlines():
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(entry, dict) and {"request_id", "job_id", "created_at", "timeout"} <= set(entry):
            entries.append(entry)
    return entries


def _watch_entry(request_id, request, response):
    body = response.get("body")
    if not (request["action"].startswith("make-") or request["action"] in LIFECYCLE_TIMEOUTS) or not isinstance(body, dict):
        return None
    if body.get("status") != "queued" or not JOB_ID_RE.fullmatch(str(body.get("job_id", ""))):
        return None
    target = ACTION_ALLOWLIST[request["action"]][3]
    timeout = LIFECYCLE_TIMEOUTS.get(request["action"], MAKE_TARGETS.get(target, {}).get("timeout", 300))
    return {"request_id": request_id, "job_id": body["job_id"], "created_at": time.time(),
            "timeout": timeout}


def _write_commit(repo, parent, request_id, response, artifacts=None, watch_add=None,
                  watch_remove=None, final=False, record_processed=True):
    artifacts = artifacts or {}
    response_bytes = (json.dumps(response, sort_keys=True) + "\n").encode()
    try:
        ledger = _git(repo, ["show", f"{parent}:ledger/processed.txt"])
    except RuntimeError:
        ledger = ""
    if record_processed and request_id not in ledger.splitlines():
        ledger += request_id + "\n"
    ledger_bytes = ledger.encode()
    watching = _read_watching(repo, parent)
    if watch_remove:
        watching = [entry for entry in watching if entry.get("request_id") != watch_remove]
    if watch_add:
        watching = [entry for entry in watching if entry.get("request_id") != watch_add["request_id"]]
        watching.append(watch_add)
    with tempfile.NamedTemporaryFile(dir=repo, prefix="index.", delete=False) as handle:
        index_path = handle.name
    env = os.environ.copy()
    env["GIT_INDEX_FILE"] = index_path
    try:
        _git(repo, ["read-tree", parent], env=env)
        response_file = Path(index_path + ".response")
        ledger_file = Path(index_path + ".ledger")
        response_file.write_bytes(response_bytes)
        ledger_file.write_bytes(ledger_bytes)
        ledger_hash = _git(repo, ["hash-object", "-w", str(ledger_file)], env=env).strip()
        if not final:
            response_hash = _git(repo, ["hash-object", "-w", str(response_file)], env=env).strip()
            _git(repo, ["update-index", "--add", "--cacheinfo",
                        f"100644,{response_hash},responses/{request_id}.json"], env=env)
        _git(repo, ["update-index", "--add", "--cacheinfo", f"100644,{ledger_hash},ledger/processed.txt"], env=env)
        if watch_add or watch_remove:
            watching_file = Path(index_path + ".watching")
            watching_file.write_bytes("".join(json.dumps(entry, sort_keys=True) + "\n"
                                                   for entry in watching).encode())
            watching_hash = _git(repo, ["hash-object", "-w", str(watching_file)], env=env).strip()
            _git(repo, ["update-index", "--add", "--cacheinfo",
                        f"100644,{watching_hash},ledger/watching.txt"], env=env)
        if artifacts:
            artifact_file = Path(index_path + ".artifact")
            for path, blob in sorted(artifacts.items()):
                artifact_file.write_bytes(blob)
                blob_hash = _git(repo, ["hash-object", "-w", str(artifact_file)], env=env).strip()
                _git(repo, ["update-index", "--add", "--cacheinfo", f"100644,{blob_hash},{path}"], env=env)
            stale = _stale_artifact_paths(repo, parent, request_id)
            if stale:
                empty_tree = Path(index_path + ".worktree")
                empty_tree.mkdir()
                try:
                    _git(repo, ["update-index", "--force-remove", "--", *stale],
                         env={**env, "GIT_WORK_TREE": str(empty_tree)})
                finally:
                    empty_tree.rmdir()
        response_path = f"responses/{request_id}{'.final' if final else ''}.json"
        if final:
            final_response_file = Path(index_path + ".final-response")
            final_response_file.write_bytes(response_bytes)
            final_response_hash = _git(repo, ["hash-object", "-w", str(final_response_file)], env=env).strip()
            _git(repo, ["update-index", "--add", "--cacheinfo",
                        f"100644,{final_response_hash},{response_path}"], env=env)
        tree = _git(repo, ["write-tree"], env=env).strip()
        message = "cloud final response" if final else "cloud response"
        commit = _git(repo, ["commit-tree", tree, "-p", parent, "-m", message], env=env,
                      timeout=30).strip()
        _git(repo, ["update-ref", "refs/heads/cloud-requests", commit, parent], env=env)
        _git(repo, ["push", "--force-with-lease=refs/heads/cloud-requests:" + parent,
                    "origin", f"{commit}:refs/heads/cloud-requests"], timeout=120)
        return commit
    finally:
        for path in (Path(index_path), Path(index_path + ".response"), Path(index_path + ".ledger"),
                     Path(index_path + ".artifact"), Path(index_path + ".watching"),
                     Path(index_path + ".final-response")):
            try:
                path.unlink()
            except OSError:
                pass


def process_tick(repo, root, last_tip=None):
    remote_tip = _remote_tip(repo)
    changed = last_tip is None or remote_tip != last_tip
    ref = _fetch(repo) if changed else last_tip
    processed = _processed(repo, ref)
    processed_this_tick = 0
    for request_id, response in _completed_slow_requests():
        if request_id in processed:
            continue
        response["id"] = request_id
        ref = _write_commit(repo, ref, request_id, response)
        processed.add(request_id)
        processed_this_tick += 1
    for entry in _read_watching(repo, ref)[:MAX_PER_TICK]:
        age = time.time() - float(entry["created_at"])
        if age > float(entry["timeout"]) + 600:
            final_response = _response(entry["request_id"], "job-status", "error", 0,
                                       body={"status": "error", "reason": "watch expired"})
            final_response["reason"] = "watch expired"
            ref = _write_commit(repo, ref, entry["request_id"], final_response,
                                watch_remove=entry["request_id"], final=True, record_processed=False)
            processed_this_tick += 1
            continue
        watch_request = {"action": "job-status", "args": {"job_id": entry["job_id"]}}
        response = _call_webhook(watch_request)
        body = response.get("body")
        if response.get("status") != "ok" or not isinstance(body, dict) or body.get("status") not in TERMINAL_JOB_STATES:
            continue
        response["id"] = entry["request_id"]
        artifacts, paths = job_artifacts(repo, ref, entry["request_id"], watch_request, response)
        if paths:
            response["artifacts"] = paths
        ref = _write_commit(repo, ref, entry["request_id"], response, artifacts,
                            watch_remove=entry["request_id"], final=True, record_processed=False)
        processed_this_tick += 1
    if not changed:
        return ref, processed_this_tick
    for request_id in _request_ids(repo, ref):
        if request_id in processed:
            continue
        artifacts = {}
        raw, read_error = _read_request(repo, ref, request_id)
        if read_error:
            response = _response(request_id, "", "rejected", 0, reason=read_error)
        else:
            request, response = prepare_request(request_id, raw, processed)
            if response is None:
                if request["action"] in SLOW_ACTIONS:
                    if request_id not in _slow_pending:
                        _queue_slow_request(request_id, request)
                    continue
                response = _call_webhook(request)
                response["id"] = request_id
                body = response.get("body")
                if request["action"] == "job-status" and isinstance(body, dict) and "output" in body:
                    body["output"] = scrub_credentials(body["output"])
                artifacts, paths = job_artifacts(repo, ref, request_id, request, response)
                if paths:
                    response["artifacts"] = paths
                watch_add = _watch_entry(request_id, request, response)
                if watch_add:
                    ref = _write_commit(repo, ref, request_id, response, artifacts, watch_add=watch_add)
                else:
                    ref = _write_commit(repo, ref, request_id, response, artifacts)
                processed.add(request_id)
                processed_this_tick += 1
                if processed_this_tick >= MAX_PER_TICK:
                    return None, processed_this_tick
                continue
        processed.add(request_id)
        ref = _write_commit(repo, ref, request_id, response, artifacts)
        processed.add(request_id)
        processed_this_tick += 1
        if processed_this_tick >= MAX_PER_TICK:
            return None, processed_this_tick
    return ref, processed_this_tick


def _next_sleep(now, last_activity):
    if now - last_activity < IDLE_AFTER_SECONDS:
        return ACTIVE_POLL_SECONDS
    return IDLE_POLL_SECONDS


def main():
    root = Path(os.environ.get("K3DM_REPO_ROOT", ROOT))
    repo = Path(os.environ.get("K3DM_CLOUD_BRIDGE_REPO",
                              str(Path.home() / ".k3d-manager" / "cloud-bridge" / "repo.git")))
    _ensure_bare_repo(repo, root)
    last_tip = None
    last_activity = time.monotonic()
    while True:
        try:
            last_tip, processed_count = process_tick(repo, root, last_tip=last_tip)
            if processed_count:
                last_activity = time.monotonic()
        except (RuntimeError, OSError, ValueError) as error:
            _LOG.error("%s", error)
            last_tip = None
        time.sleep(_next_sleep(time.monotonic(), last_activity))


if __name__ == "__main__":
    main()
